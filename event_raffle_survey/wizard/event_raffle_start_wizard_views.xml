<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_start_wizard_form_survey" model="ir.ui.view">
        <field name="name">event.raffle.start.wizard.form.survey</field>
        <field name="model">event.raffle.start.wizard</field>
        <field name="inherit_id" ref="event_raffle.event_raffle_start_wizard_form" />
        <field name="arch" type="xml">
            <field name="copy_strategy" position="after">
                <!-- Closing a survey archives it: without active_test, a
                     closed survey would vanish from this list. -->
                <field
                    name="survey_id"
                    invisible="copy_strategy != 'survey_only'"
                    required="copy_strategy == 'survey_only'"
                    context="{'active_test': False}"
                    options="{'no_create': True}"
                />
                <!-- Optional filter on the chosen survey's questions; the
                     list links existing questions and creates none. -->
                <field name="survey_question_ids" invisible="copy_strategy != 'survey_only' or not survey_id">
                    <list create="0">
                        <field name="title" />
                        <field name="question_type" />
                    </list>
                </field>
                <field
                    name="survey_question_match"
                    widget="radio"
                    options="{'horizontal': true}"
                    invisible="copy_strategy != 'survey_only' or not survey_id or not survey_question_ids"
                />
            </field>
        </field>
    </record>
</odoo>
