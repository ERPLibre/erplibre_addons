<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="devops_cg_field_view_form" model="ir.ui.view">
        <field name="name">devops_cg_field_form</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group style="background-color: #dc0527; color: white;" invisible="not has_error">
                        <field name="has_error_msg" nolabel="1" />
                    </group>
                    <group>
                        <group>
                            <field name="type" />
                            <field name="string" />
                            <field name="relation" invisible="type not in ['many2one', 'many2many', 'one2many']" />
                            <field
                                name="relation_manual"
                                invisible="type not in ['many2one', 'many2many', 'one2many'] or relation"
                            />
                            <field name="field_relation" invisible="type != 'one2many'" />
                            <field name="field_relation_manual" invisible="type != 'one2many' or field_relation" />
                            <field name="relation_ref" invisible="type != 'many2many'" />
                            <field name="related_manual" />
                            <field name="currency_field" />
                            <field name="compute_method" />
                            <field name="tracking" />
                            <!--                            <field name="related_field_id" />-->
                            <field name="help" />
                        </group>
                    </group>
                    <group name="group_model">
                        <field name="model_id" />
                    </group>
                    <notebook>
                        <page string="Workspace">
                            <field name="devops_workspace_ids" />
                        </page>
                        <page name="page_information" string="Information">
                            <group>
                                <group>
                                    <field name="sequence" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="devops_cg_field_view_graph" model="ir.ui.view">
        <field name="name">devops_cg_field_graph</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <graph string="DevOps code generator module model field">
                <field name="name" type="row" />
                <field name="help" type="row" />
                <field name="model_id" type="row" />
                <field name="type" type="row" />
            </graph>
        </field>
    </record>

    <record id="devops_cg_field_view_kanban" model="ir.ui.view">
        <field name="name">devops_cg_field_kanban</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="help" />
                <field name="model_id" />
                <field name="type" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="help" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="model_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="type" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="devops_cg_field_view_pivot" model="ir.ui.view">
        <field name="name">devops_cg_field_pivot</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <pivot string="DevOps code generator module model field">
                <field name="name" type="row" />
                <field name="help" type="row" />
                <field name="model_id" type="row" />
                <field name="type" type="row" />
            </pivot>
        </field>
    </record>

    <record id="devops_cg_field_view_search" model="ir.ui.view">
        <field name="name">devops_cg_field_search</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <search string="DevOps code generator module model field">
                <filter name="name" string="Name" domain="[('name','!=',False)]" />
                <filter name="help" string="Help" domain="[('help','!=',False)]" />
                <filter name="model_id" string="Model" domain="[('model_id','!=',False)]" />
                <filter name="type" string="Type" domain="[('type','!=',False)]" />
            </search>
        </field>
    </record>

    <record id="devops_cg_field_view_tree" model="ir.ui.view">
        <field name="name">devops_cg_field_tree</field>
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <list decoration-danger="has_error">
                <field name="has_error" column_invisible="True" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="model_id" />
                <field name="type" />
                <field name="relation" />
                <field name="relation_manual" />
                <field name="field_relation" />
                <field name="field_relation_manual" />
                <field name="currency_field" />
                <field name="compute_method" />
                <field name="tracking" />
                <field name="help" />
            </list>
        </field>
    </record>

    <record id="devops_cg_field_code_generator_module_model_field_action_window" model="ir.actions.act_window">
        <field name="name">Code generator module model field</field>
        <field name="res_model">devops.cg.field</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>
</odoo>
