<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_devops_workspace_conf_form" model="ir.ui.view">
        <field name="name">devops.workspace form</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <form string="DevOps Workspace">
                <header>
                    <button
                        name="%(erplibre_devops.action_devops_plan_action)d"
                        string="Action"
                        type="action"
                        class="btn btn-secondary"
                        context="{'default_root_workspace_id': id, 'default_user_id': uid}"
                        invisible="(not is_installed or is_conflict_mode_exec) and not is_me"
                    />
                    <button
                        name="action_install_workspace"
                        string="Install"
                        type="object"
                        class="oe_highlight"
                        invisible="is_installed or is_conflict_mode_exec"
                        context="{'force_reinstall_workspace': True}"
                    />
                    <button
                        name="action_install_me_workspace"
                        string="Me"
                        type="object"
                        class="oe_highlight"
                        invisible="is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="refresh_installation_state"
                        string="Refresh installation state"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_check"
                        string="Status"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_start"
                        string="Start"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_running or is_conflict_mode_exec"
                    />
                    <button
                        name="action_start"
                        string="Start"
                        type="object"
                        class="btn-success"
                        invisible="not is_installed or not is_running or is_conflict_mode_exec"
                    />
                    <button
                        name="action_stop"
                        string="Stop"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or not is_running or is_conflict_mode_exec"
                    />
                    <button
                        name="action_stop"
                        string="Stop"
                        type="object"
                        class="btn-success"
                        invisible="not is_installed or is_running or is_conflict_mode_exec"
                    />
                    <button
                        name="action_reboot"
                        string="Reboot"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_reboot"
                        string="Hard Reboot"
                        type="object"
                        class="oe_highlight"
                        context="{'default_exec_reboot_process': True}"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_update"
                        string="Update"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_open_local_view"
                        string="Open browser"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_parse_code"
                        string="Parse code"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_installed or is_conflict_mode_exec"
                    />
                    <button
                        name="action_install_workspace"
                        string="Re-install"
                        type="object"
                        class="oe_highlight"
                        context="{'force_reinstall_workspace': True}"
                        groups="base.group_no_one"
                        invisible="is_conflict_mode_exec"
                    />
                    <button
                        name="action_install_workspace"
                        string="Re-install full"
                        type="object"
                        class="oe_highlight"
                        context="{'force_reinstall_workspace': True, 'install_dev_workspace': True}"
                        groups="base.group_no_one"
                        invisible="is_conflict_mode_exec"
                    />
                    <button
                        name="action_clear_error_exec"
                        string="Clear error exec"
                        type="object"
                        class="btn-danger"
                        invisible="devops_exec_error_count == 0 or not is_installed"
                    />
                </header>
                <div class="oe_title">
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <div class="badge-pill badge-success float-right" invisible="not is_me">Same instance</div>
                <div name="button_box" class="oe_button_box">
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />

                    <button
                        name="%(erplibre_devops.devops_exec_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_devops_workspace': id, 'search_default_group_devops_exec_bundle_id': 1}"
                        invisible="devops_exec_count == 0"
                    >
                        <field name="devops_exec_count" string="Executions" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_test_plan_exec_test_plan_exec_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_workspace_id': id}"
                        invisible="devops_test_plan_exec_count == 0"
                    >
                        <field name="devops_test_plan_exec_count" string="Test plan executions" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_code_todo_code_todo_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_workspace_id': id}"
                        invisible="devops_code_todo_count == 0"
                    >
                        <field name="devops_code_todo_count" string="Code TODO" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_test_result_test_result_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_workspace_id': id}"
                        invisible="devops_test_result_count == 0"
                    >
                        <field name="devops_test_result_count" string="Test results" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_plan_cg_plan_cg_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_workspace_id': id}"
                        invisible="plan_cg_count == 0"
                    >
                        <field name="plan_cg_count" string="Plans CG" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_exec_error_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_devops_workspace': id}"
                        invisible="devops_exec_error_count == 0"
                    >
                        <field name="devops_exec_error_count" string="Errors" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_new_project_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_devops_workspace': id}"
                        invisible="new_project_count == 0"
                    >
                        <field name="new_project_count" string="Generations" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_exec_bundle_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_devops_workspace': id}"
                        invisible="devops_exec_bundle_count == 0"
                    >
                        <field name="devops_exec_bundle_count" string="Bundles" widget="statinfo" />
                    </button>
                    <button
                        name="%(erplibre_devops.devops_exec_bundle_action_window)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        context="{'search_default_devops_workspace': id, 'search_default_root': 1}"
                        invisible="devops_exec_bundle_root_count == 0"
                    >
                        <field name="devops_exec_bundle_root_count" string="Bundles root" widget="statinfo" />
                    </button>
                </div>
                <div class="bg-danger" invisible="not is_conflict_mode_exec">
                    <h3>Error:</h3>
                    Cannot support this execution mode with source mode 'docker'.
                </div>
                <field name="is_conflict_mode_exec" invisible="True" />
                <field name="is_installed" invisible="True" />
                <field name="is_me" invisible="True" />
                <field name="is_robot" invisible="True" />
                <field name="mode_exec" invisible="True" />
                <group>
                    <group string="Basic">
                        <field name="system_id" />
                        <field name="folder" />
                        <field name="folder_odoo_version" invisible="select_installation not in ['odoo_workspace']" />
                        <field name="select_installation" />
                    </group>
                    <group string="Execution">
                        <field name="is_debug_log" />
                        <field name="show_error_chatter" />
                        <field name="exec_reboot_process" invisible="mode_exec == 'docker' or not is_me" />
                    </group>
                </group>
                <group name="instance" string="Instance">
                    <field name="erplibre_mode" />
                    <field name="is_running" />
                </group>
                <group>
                    <group string="Info" invisible="not is_installed">
                        <field name="url_instance" string="URL" widget="url" />
                        <field name="url_instance_database_manager" string="URL Database" widget="url" />
                    </group>
                    <group string="Network" invisible="not is_installed">
                        <button
                            name="action_network_change_port_random"
                            string="Random port"
                            type="object"
                            class="oe_highlight"
                            invisible="not exec_reboot_process"
                        />
                        <button
                            name="action_network_change_port_default"
                            string="Default port"
                            type="object"
                            class="oe_highlight"
                            invisible="not exec_reboot_process or not is_me"
                        />
                        <field name="port_http" readonly="not exec_reboot_process" />
                        <field name="port_longpolling" readonly="not exec_reboot_process" />
                    </group>
                    <group string="Git">
                        <field name="git_branch" />
                        <field name="git_url" />
                    </group>
                    <group string="Docker" invisible="not is_installed">
                        <field name="workspace_docker_id" />
                        <field name="docker_compose_id" />
                    </group>
                    <group string="DB" invisible="not is_installed">
                        <button name="action_restore_db_image" string="Restore" type="object" class="oe_highlight" />
                        <field name="image_db_selection" />
                        <field name="db_name" />
                    </group>
                    <group string="Module" invisible="not is_installed">
                        <button
                            name="action_module_install_erplibre_odoo_18"
                            string="Install erplibre base odoo 18"
                            type="object"
                            class="oe_highlight"
                        />
                    </group>
                    <group string="Action">
                        <button name="action_open_terminal" string="Terminal" type="object" class="oe_highlight" />
                        <button
                            name="action_open_directory"
                            string="Open directory"
                            type="object"
                            class="oe_highlight"
                        />
                    </group>
                    <group string="IDE">
                        <field name="ide_pycharm" />
                    </group>
                    <group string="External project">
                        <field name="instance_exec_external_project_ids" />
                    </group>
                </group>
                <notebook invisible="not is_installed">
                    <page name="status" string="Status">
                        <group string="Instance">
                            <field name="db_is_restored" />
                            <field name="has_error_restore_db" />
                        </group>
                    </page>
                    <page name="code_generator" string="Code">
                        <group>
                            <field name="plan_cg_ids" />
                        </group>
                    </page>
                    <page name="makefile" string="Makefile">
                        <button
                            name="action_add_makefile"
                            string="Refresh makefile target"
                            type="object"
                            class="oe_highlight"
                        />
                        <field name="log_makefile_target_ids" />
                    </page>
                    <page name="log" string="Log">
                        <group>
                            <field name="log_workspace" />
                        </group>
                    </page>
                    <page name="install" string="Install">
                        <group>
                            <group>
                                <button
                                    name="action_poetry_install"
                                    string="Poetry install"
                                    type="object"
                                    class="oe_highlight"
                                />
                            </group>
                        </group>
                    </page>
                    <page name="exec" string="Execution">
                        <field name="devops_exec_ids" />
                    </page>
                    <page name="exec_bundle" string="Bundle exec">
                        <field name="devops_exec_bundle_root_ids" />
                    </page>
                    <page name="exec_error" string="Error exec">
                        <field name="devops_exec_error_ids" />
                    </page>
                    <page name="docker_page" string="Docker action">
                        <group string="Docker build">
                            <field name="docker_build_odoo_version" string="Odoo version" />
                            <button
                                name="action_docker_build_odoo"
                                string="Launch docker build"
                                type="object"
                                class="oe_highlight"
                            />
                            <field name="log_action_docker_build_odoo" />
                        </group>
                    </page>
                </notebook>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_devops_workspace_conf_search" model="ir.ui.view">
        <field name="name">devops.workspace search</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="folder" />
                <field name="folder_odoo_version" />
                <filter name="is_me" string="Is me" domain="[('is_me','=',True)]" />
                <filter name="is_robot" string="Is robot" domain="[('is_robot','=',True)]" />
                <filter
                    name="has_docker_compose"
                    string="Has docker compose"
                    domain="[('docker_compose_id','!=',False)]"
                />
                <group string="Group By" expand="1">
                    <filter name="system_id" string="System" context="{'group_by':'system_id'}" />
                    <filter name="folder" string="Folder" context="{'group_by':'folder'}" />
                    <filter
                        name="folder_odoo_version"
                        string="Folder odoo workspace"
                        context="{'group_by':'folder_odoo_version'}"
                    />
                    <filter name="db_name" string="Database name" context="{'group_by':'db_name'}" />
                    <filter name="db_is_restored" string="DB is restored" context="{'group_by':'db_is_restored'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_devops_workspace_conf_list" model="ir.ui.view">
        <field name="name">devops.workspace list</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="folder" />
                <field name="folder_odoo_version" />
                <field name="system_id" />
                <field name="erplibre_mode" />
                <field name="is_robot" />
                <field name="is_installed" />
                <field name="is_running" />
                <button
                    name="%(erplibre_devops.action_devops_plan_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-star"
                    context="{'default_root_workspace_id': id, 'default_user_id': uid}"
                    invisible="not is_me"
                    help="Plan action wizard"
                    title="Wizard"
                />
                <button
                    name="action_update"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-level-up"
                    invisible="not is_me"
                    help="Update erplibre_devops, can crash..."
                    title="Update"
                />
                <button
                    name="action_reboot"
                    type="object"
                    class="oe_stat_button bg-success"
                    icon="fa-refresh"
                    invisible="not is_me"
                    help="Soft reboot"
                    title="Reboot"
                />
                <field name="is_me" />
                <button
                    name="action_open_workspace_pycharm"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-code"
                    invisible="system_method != 'local'"
                    title="Open Pycharm"
                />
                <field name="system_method" />
                <button
                    name="action_open_terminal"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-terminal"
                    title="Open terminal"
                />
                <button
                    name="action_open_directory"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-folder"
                    title="Open directory"
                />
                <button
                    name="action_open_local_view"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-desktop"
                    title="Open local view"
                />
                <button
                    name="action_reboot"
                    type="object"
                    icon="fa-refresh"
                    context="{'default_exec_reboot_process': True}"
                    class="oe_stat_button bg-danger"
                    title="Hard reboot"
                />
            </list>
        </field>
    </record>

    <record id="devops_workspace_view_graph" model="ir.ui.view">
        <field name="name">devops_workspace_graph</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <graph string="Devops workspace">
                <field name="name" type="row" />
            </graph>
        </field>
    </record>

    <record id="devops_workspace_view_kanban" model="ir.ui.view">
        <field name="name">devops_workspace_kanban</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="is_installed" />
                <field name="is_me" />
                <field name="is_robot" />
                <field name="is_running" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="text-success float-right mb4" t-if="record.is_installed.raw_value">
                                        <i class="fa fa-circle" aria-label="Ok" role="img" title="Ok" />
                                    </li>
                                    <li class="text-danger float-right mb4" t-if="!record.is_installed.raw_value">
                                        <i class="fa fa-circle" aria-label="Invalid" role="img" title="Invalid" />
                                    </li>
                                    <li class="text-success float-right mb4" t-if="record.is_me.raw_value">
                                        <i class="fa fa-circle" aria-label="Ok" role="img" title="Ok" />
                                    </li>
                                    <li class="text-danger float-right mb4" t-if="!record.is_me.raw_value">
                                        <i class="fa fa-circle" aria-label="Invalid" role="img" title="Invalid" />
                                    </li>
                                    <li class="text-success float-right mb4" t-if="record.is_robot.raw_value">
                                        <i class="fa fa-circle" aria-label="Ok" role="img" title="Ok" />
                                    </li>
                                    <li class="text-danger float-right mb4" t-if="!record.is_robot.raw_value">
                                        <i class="fa fa-circle" aria-label="Invalid" role="img" title="Invalid" />
                                    </li>
                                    <li class="text-success float-right mb4" t-if="record.is_running.raw_value">
                                        <i class="fa fa-circle" aria-label="Ok" role="img" title="Ok" />
                                    </li>
                                    <li class="text-danger float-right mb4" t-if="!record.is_running.raw_value">
                                        <i class="fa fa-circle" aria-label="Invalid" role="img" title="Invalid" />
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="devops_workspace_view_pivot" model="ir.ui.view">
        <field name="name">devops_workspace_pivot</field>
        <field name="model">devops.workspace</field>
        <field name="arch" type="xml">
            <pivot string="Devops workspace">
                <field name="name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="action_devops_check_workspace_conf_form" model="ir.actions.act_window">
        <field name="name">Automated devops_workspaces</field>
        <field name="res_model">devops.workspace</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>

    <record id="action_server_devops_workspace_check" model="ir.actions.server">
        <field name="name">Check workspace(s)</field>
        <field name="model_id" ref="model_devops_workspace" />
        <field name="binding_model_id" ref="model_devops_workspace" />
        <field name="state">code</field>
        <field name="code">records.action_check()</field>
    </record>

    <record id="action_server_devops_workspace_open_terminal_folder" model="ir.actions.server">
        <field name="name">Open terminal folder workspace(s)</field>
        <field name="model_id" ref="model_devops_workspace" />
        <field name="binding_model_id" ref="model_devops_workspace" />
        <field name="state">code</field>
        <field name="code">records.action_open_terminal()</field>
    </record>

    <record id="action_server_devops_workspace_reboot" model="ir.actions.server">
        <field name="name">Reboot workspace(s)</field>
        <field name="model_id" ref="model_devops_workspace" />
        <field name="binding_model_id" ref="model_devops_workspace" />
        <field name="state">code</field>
        <field name="code">records.action_reboot()</field>
    </record>

    <record id="action_server_devops_workspace_start" model="ir.actions.server">
        <field name="name">Start workspace(s)</field>
        <field name="model_id" ref="model_devops_workspace" />
        <field name="binding_model_id" ref="model_devops_workspace" />
        <field name="state">code</field>
        <field name="code">records.action_start()</field>
    </record>

    <record id="action_server_devops_workspace_stop" model="ir.actions.server">
        <field name="name">Stop workspace(s)</field>
        <field name="model_id" ref="model_devops_workspace" />
        <field name="binding_model_id" ref="model_devops_workspace" />
        <field name="state">code</field>
        <field name="code">records.action_stop()</field>
    </record>
</odoo>
