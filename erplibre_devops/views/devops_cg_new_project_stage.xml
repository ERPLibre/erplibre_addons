<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="devops_cg_new_project_stage_search" model="ir.ui.view">
        <field name="name">Stage - Search</field>
        <field name="model">devops.cg.new_project.stage</field>
        <field name="arch" type="xml">
            <search string="Stage Search">
                <field name="name" />
                <field name="sequence" />
            </search>
        </field>
    </record>

    <record id="devops_cg_new_project_stage_form" model="ir.ui.view">
        <field name="name">devops.cg.new_project.stage.form</field>
        <field name="model">devops.cg.new_project.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <group>
                    <group>
                        <field name="name" />
                        <field name="fold" />
                        <field name="description" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="devops_cg_new_project_stage_tree" model="ir.ui.view">
        <field name="name">devops.cg.new_project.stage.list</field>
        <field name="model">devops.cg.new_project.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="devops_cg_new_project_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">devops.cg.new_project.stage</field>
    </record>
</odoo>
