<odoo>
    <record id="erplibre_code_stash_view_list" model="ir.ui.view">
        <field name="name">erplibre.code.stash.list</field>
        <field name="model">erplibre.code.stash</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state == 'missing'">
                <field name="git_fetch_allowed" column_invisible="1" />
                <!-- hides the Reapply button on a server started without the dev option -->
                <field name="date" />
                <field name="path" />
                <field name="sha" />
                <field name="message" optional="hide" />
                <field name="command" optional="show" />
                <field name="run_id" optional="show" />
                <field name="state" widget="badge" />
                <button
                    name="action_reapply"
                    type="object"
                    string="Reapply"
                    icon="fa-share"
                    groups="base.group_no_one"
                    invisible="state not in ('kept', 'conflict') or not git_fetch_allowed"
                />
            </list>
        </field>
    </record>

    <record id="erplibre_code_stash_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.stash.form</field>
        <field name="model">erplibre.code.stash</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="git_fetch_allowed" invisible="1" />
                    <!-- hides the Reapply button on a server started without the dev option -->
                    <button
                        name="action_reapply"
                        type="object"
                        string="Reapply"
                        class="btn-primary"
                        groups="base.group_no_one"
                        invisible="state not in ('kept', 'conflict') or not git_fetch_allowed"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sha" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="path" />
                            <field name="message" />
                            <field name="command" />
                        </group>
                        <group>
                            <field name="run_id" />
                            <field name="date" />
                        </group>
                    </group>
                    <field name="log" nolabel="1" class="font-monospace" invisible="not log" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="erplibre_code_stash_view_search" model="ir.ui.view">
        <field name="name">erplibre.code.stash.search</field>
        <field name="model">erplibre.code.stash</field>
        <field name="arch" type="xml">
            <search>
                <field name="path" />
                <field name="sha" />
                <field name="run_id" />
                <filter name="kept" string="Kept" domain="[('state', '=', 'kept')]" />
                <group expand="0" string="Group By">
                    <filter name="group_path" string="Repository" context="{'group_by': 'path'}" />
                    <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="erplibre_code_stash_action" model="ir.actions.act_window">
        <field name="name">Stashes</field>
        <field name="res_model">erplibre.code.stash</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No stash kept</p>
            <p>
                A pull or a return to a snapshot that stashes the modified files
                of a repository and keeps the stash lists it here, with the
                command that reapplies it.
            </p>
        </field>
    </record>

    <menuitem
        id="erplibre_code_stash_menu"
        name="Stashes"
        parent="erplibre_info.erplibre_info_menu_technical"
        action="erplibre_code_stash_action"
        sequence="60"
    />
</odoo>
