<odoo>
    <record id="erplibre_code_run_view_list" model="ir.ui.view">
        <field name="name">erplibre.code.run.list.git.fetch</field>
        <field name="model">erplibre.code.run</field>
        <field name="inherit_id" ref="erplibre_info.erplibre_code_run_view_list" />
        <field name="arch" type="xml">
            <field name="date_end" position="after">
                <field name="plan_count" optional="show" />
            </field>
        </field>
    </record>

    <record id="erplibre_code_run_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.run.form.git.fetch</field>
        <field name="model">erplibre.code.run</field>
        <field name="inherit_id" ref="erplibre_info.erplibre_code_run_view_form" />
        <field name="arch" type="xml">
            <field name="server_actions_allowed" position="after">
                <field name="git_fetch_allowed" invisible="1" />
                <!-- hides the buttons that write the clones on a server started without the dev option -->
                <field name="can_apply" invisible="1" />
                <!-- hides the apply buttons of a dry run with nothing to apply -->
                <field name="pull_blocked" invisible="1" />
                <!-- hides the restart and install steps while a repository is left mid-operation -->
                <field name="deps_to_install" invisible="1" />
                <!-- shows the dependency installation after a pull -->
            </field>
            <button name="action_refresh" position="after">
                <button
                    name="action_apply"
                    type="object"
                    string="Apply"
                    class="btn-primary"
                    groups="base.group_no_one"
                    invisible="run_type != 'dry_run' or not can_apply or not git_fetch_allowed"
                />
                <button
                    name="action_pull_apply"
                    type="object"
                    string="Apply the pull"
                    class="btn-primary"
                    groups="base.group_no_one"
                    invisible="run_type != 'pull_dry_run' or not can_apply or not git_fetch_allowed"
                />
                <button
                    name="action_snapshot_revert"
                    type="object"
                    string="Return to the snapshot"
                    class="btn-primary"
                    groups="base.group_no_one"
                    invisible="run_type != 'snapshot_revert_dry_run' or not can_apply or not git_fetch_allowed"
                />
                <button
                    name="action_deps_install"
                    type="object"
                    string="Install the Python dependencies"
                    class="btn-primary"
                    groups="base.group_no_one"
                    invisible="run_type not in ('pull_apply', 'snapshot_revert') or state != 'done' or not deps_to_install or pull_blocked or not git_fetch_allowed"
                />
                <button
                    name="action_restart_upgrade"
                    type="object"
                    string="Upgrade the modules and restart"
                    class="btn-primary"
                    groups="base.group_no_one"
                    invisible="run_type not in ('apply', 'pull_apply', 'pull_restore', 'deps_install', 'snapshot_revert') or state != 'done' or not upgrade_module_ids or pull_blocked or not server_actions_allowed"
                />
                <button
                    name="action_restart"
                    type="object"
                    string="Restart the server"
                    groups="base.group_no_one"
                    invisible="run_type not in ('apply', 'pull_apply', 'pull_restore', 'deps_install', 'snapshot_revert') or state != 'done' or pull_blocked or not server_actions_allowed"
                />
            </button>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="run_type not in ('dry_run', 'pull_dry_run', 'snapshot_revert_dry_run') or not apply_note"
                >
                    <field name="apply_note" readonly="1" />
                </div>
                <div class="alert alert-danger" role="alert" invisible="not pull_blocked">
                    A repository is left mid-operation: fix it in a terminal
                    before restarting.
                </div>
                <div class="alert alert-info" role="alert" invisible="not deps_to_install or pull_blocked">
                    The Python dependencies changed: install them, or restart
                    without installing.
                </div>
            </xpath>
            <xpath expr="//group[@name='run_what']/field[@name='user_id']" position="after">
                <field name="odoo_version" invisible="not odoo_version" />
                <field name="pull_mode" invisible="not pull_mode" />
                <field name="pull_strategy" invisible="not pull_strategy" />
                <field name="auto_apply" invisible="not auto_apply" />
                <field name="pull_path" invisible="not pull_path" />
                <field name="backup_id" invisible="not backup_id" />
                <field name="revert_snapshot_id" invisible="not revert_snapshot_id" />
                <field name="revert_root" invisible="run_type not in ('snapshot_revert_dry_run', 'snapshot_revert')" />
                <field name="approve_modules" invisible="not approve_modules" />
                <field name="parent_id" invisible="not parent_id or run_type in ('pull_restore', 'deps_install')" />
                <field
                    name="parent_id"
                    string="Applied pull"
                    invisible="not parent_id or run_type not in ('pull_restore', 'deps_install')"
                />
            </xpath>
            <field name="exit_code" position="after">
                <field name="pass_dir" invisible="not pass_dir" />
            </field>
            <page name="report" position="after">
                <page
                    string="Plan"
                    name="plan"
                    invisible="run_type not in ('dry_run', 'apply', 'pull_dry_run', 'pull_apply', 'snapshot_revert_dry_run', 'snapshot_revert')"
                >
                    <group>
                        <field name="plan_count" />
                        <field name="plan_paths" />
                        <field name="shallow_paths" invisible="not shallow_paths" />
                        <field name="approve_deepen" invisible="run_type != 'pull_apply' or not shallow_paths" />
                        <field name="clone_paths" invisible="not clone_paths" />
                        <field name="approve_clone" invisible="run_type != 'pull_apply' or not clone_paths" />
                        <field name="left_paths" />
                        <field name="revert_targets" invisible="not revert_targets" groups="base.group_no_one" />
                    </group>
                    <field
                        name="child_ids"
                        invisible="run_type not in ('dry_run', 'pull_dry_run', 'snapshot_revert_dry_run')"
                    />
                </page>
                <page
                    string="Backups"
                    name="backups"
                    invisible="run_type not in ('pull_apply', 'snapshot_revert') or not backup_ids"
                    groups="base.group_no_one"
                >
                    <p class="text-muted">
                        Each pulled repository keeps a branch on its HEAD of
                        before the pull. Restore moves the repository back to
                        it; Delete removes the branch.
                    </p>
                    <field name="backup_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="path" />
                            <field name="branch_name" />
                            <field name="original_branch" />
                            <field name="detached" optional="hide" />
                            <field name="sha" optional="hide" />
                            <field name="state" widget="badge" />
                            <button
                                name="action_restore"
                                type="object"
                                string="Restore"
                                icon="fa-undo"
                                invisible="state != 'kept' or not parent.git_fetch_allowed"
                            />
                            <button
                                name="action_delete"
                                type="object"
                                string="Delete"
                                icon="fa-trash"
                                confirm="Delete the backup branch?"
                                invisible="state not in ('kept', 'restored') or not parent.git_fetch_allowed"
                            />
                        </list>
                    </field>
                </page>
                <page string="Stashes" name="stashes" invisible="not stash_ids" groups="base.group_no_one">
                    <p class="text-muted">
                        The modified files of a repository the pass moved, kept
                        in the stash list of its clone. Reapply puts them back on
                        a clean tree; the stash stays in the list either way.
                    </p>
                    <field name="stash_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="path" />
                            <field name="sha" />
                            <field name="message" optional="hide" />
                            <field name="command" optional="show" />
                            <field name="date" optional="hide" />
                            <field name="state" widget="badge" />
                            <button
                                name="action_reapply"
                                type="object"
                                string="Reapply"
                                icon="fa-share"
                                invisible="state not in ('kept', 'conflict') or not parent.git_fetch_allowed"
                            />
                        </list>
                    </field>
                </page>
                <page
                    string="Modules to upgrade"
                    name="modules"
                    invisible="run_type not in ('apply', 'pull_apply', 'pull_restore', 'deps_install', 'snapshot_revert')"
                >
                    <p class="text-muted">
                        These installed modules are upgraded at the next start
                        of the server, once marked with "Upgrade the modules
                        and restart".
                    </p>
                    <field name="upgrade_module_ids" invisible="1" />
                    <!-- hides the upgrade button when no module changed -->
                    <h5>Code changed by the apply</h5>
                    <p class="text-muted">
                        A file of the module differs between the commit before
                        and the commit after the apply, whatever its version.
                    </p>
                    <field name="code_changed_module_ids" nolabel="1">
                        <list>
                            <field name="name" />
                            <field name="latest_version" />
                            <field name="state" />
                        </list>
                    </field>
                    <h5>Version pending</h5>
                    <p class="text-muted">
                        The version of the manifest on disk differs from the
                        version in the database.
                    </p>
                    <field name="version_pending_module_ids" nolabel="1">
                        <list>
                            <field name="name" />
                            <field name="latest_version" />
                            <field name="state" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
