<odoo>
    <record id="erplibre_code_snapshot_repo_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.snapshot.repo.form.git.fetch</field>
        <field name="model">erplibre.code.snapshot.repo</field>
        <field name="inherit_id" ref="erplibre_info_git.erplibre_code_snapshot_repo_view_form" />
        <field name="arch" type="xml">
            <field name="is_active_version" position="before">
                <field name="git_fetch_allowed" invisible="1" />
                <!-- hides the Pull button on a server started without the dev option -->
            </field>
            <button name="action_load_commits" position="after">
                <button
                    name="action_pull"
                    type="object"
                    string="Pull"
                    icon="fa-download"
                    groups="base.group_no_one"
                    invisible="not git_fetch_allowed or not is_active_version or state in ('absent', 'erreur')"
                />
            </button>
        </field>
    </record>
</odoo>
