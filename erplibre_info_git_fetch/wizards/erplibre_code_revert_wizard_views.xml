<odoo>
    <record id="erplibre_code_revert_wizard_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.revert.wizard.form</field>
        <field name="model">erplibre.code.revert.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    The dry run compares each repository with the commit and the
                    branch the snapshot recorded: the commits the return leaves
                    behind, the local commits only a backup branch will keep, the
                    modified trees. It may fetch a missing commit; nothing moves
                    until its apply step is confirmed.
                </div>
                <field name="newer_modules_html" nolabel="1" readonly="1" invisible="not newer_modules_html" />
                <group>
                    <field name="snapshot_id" />
                    <field name="repo_count" />
                    <field name="include_root" />
                    <field name="erplibre_branch" invisible="not include_root" />
                    <field name="erplibre_head" invisible="not include_root" />
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start the dry run" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
