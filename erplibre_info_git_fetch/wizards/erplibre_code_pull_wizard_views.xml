<odoo>
    <record id="erplibre_code_pull_wizard_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.pull.wizard.form</field>
        <field name="model">erplibre.code.pull.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    The dry run fetches the remotes and shows what the pull would
                    do: the incoming commits, the modified trees, the shallow
                    clones, the new repositories. Nothing moves until its apply
                    step is confirmed.
                </div>
                <group>
                    <field name="repo_line_id" invisible="not repo_line_id" />
                    <field name="mode" widget="radio" />
                    <field name="strategy" widget="radio" />
                </group>
                <separator string="Apply without stopping at the dry run" />
                <div class="text-muted">
                    Apply runs the dry run, then its apply step as soon as it is
                    done, pinned to what it found: each repository gets a backup
                    branch, a conflicting repository is put back where it was, and
                    nothing is pushed. The dry run report stays available.
                </div>
                <group>
                    <field name="approve_deepen" />
                    <field name="approve_clone" />
                    <field name="database_name" />
                    <field name="typed_database_name" />
                    <field name="understood" />
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start the dry run" class="btn-primary" />
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-danger"
                        invisible="not understood"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
