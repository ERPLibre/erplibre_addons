#. module: mail_linkup_community
#: model:mail.template,body_html:mail_linkup_community.mail_template_linkup_urgent_report
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    An urgent report waits in the moderation queue. The members are told it is handled within\n"
"                    <t t-out=\"ctx.get('linkup_urgent_hours') or ''\">24</t>\n"
"                    hours.\n"
"                </p>\n"
"                <p style=\"margin: 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('linkup_console_url')\" style=\"background-color: #2B5C9E; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 6px;\">Open the moderation</a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: mail_linkup_community
#: model:mail.template,body_html:mail_linkup_community.mail_template_linkup_banned
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>After a report, the moderation of LinkUp closed your account for a breach of the terms of use. This address can no longer open an account.</p>\n"
"                <p>\n"
"                    To contest this decision, answer this email or write to\n"
"                    <t t-out=\"object.company_id.email or ''\">the address of the community</t>\n"
"                    within\n"
"                    <t t-out=\"ctx.get('linkup_appeal_days') or ''\">14</t>\n"
"                    days.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: mail_linkup_community
#: model:mail.template,body_html:mail_linkup_community.mail_template_linkup_verify_email
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>Confirm that this address is yours: until then, LinkUp sends none of your reflections and invitations.</p>\n"
"                <p style=\"margin: 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('linkup_verify_url')\" style=\"background-color: #2B5C9E; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 6px;\">Confirm my address</a>\n"
"                </p>\n"
"                <p style=\"font-size: 12px;\">\n"
"                    This link lasts\n"
"                    <t t-out=\"ctx.get('linkup_verify_hours') or ''\">24</t>\n"
"                    hours and serves once. If you did not sign up on LinkUp, ignore this email.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: mail_linkup_community
#: model:mail.template,body_html:mail_linkup_community.mail_template_linkup_signup_existing
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>Somebody, maybe you, tried to sign up on LinkUp with this address. An account already uses it: log in with this address, or choose a new password if you forgot it.</p>\n"
"                <p style=\"margin: 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('linkup_login_url')\" style=\"background-color: #2B5C9E; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 6px;\">Log in</a>\n"
"                </p>\n"
"                <p>\n"
"                    <a t-att-href=\"ctx.get('linkup_reset_url')\">Choose a new password</a>\n"
"                </p>\n"
"                <p style=\"font-size: 12px;\">If it was not you, ignore this email: your account has not changed.</p>\n"
"            </div>\n"
"        "
msgstr ""

