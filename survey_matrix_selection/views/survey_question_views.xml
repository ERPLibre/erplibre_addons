<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="survey_question_form" model="ir.ui.view">
        <field name="name">survey.question.view.form.inherit.matrix.selection</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='matrix_subtype']" position="after">
                <field name="matrix_type_selection" attrs="{'invisible': [('matrix_subtype', '!=', 'simple')]}" />
            </xpath>
        </field>
    </record>
</odoo>
