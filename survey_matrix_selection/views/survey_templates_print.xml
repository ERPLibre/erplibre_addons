<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Survey result view inherit to view input of custom question types -->
    <template id="survey_page_print" name="Survey: print page(Inherit)" inherit_id="survey.survey_page_print">
        <xpath expr="//t[@t-if=&quot;question.question_type == 'matrix'&quot;]" position="before">
            <t
                t-if="question.question_type == 'matrix' and question.matrix_subtype == 'simple' and question.matrix_type_selection"
            >
                <t t-set="is_page_print" t-value="true" />
                <t t-call="survey_matrix_selection.question_matrix_selection" />
            </t>
        </xpath>
    </template>
</odoo>
