<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Job Functions -->
    <record id="job_function_action_process_sync_data" model="queue.job.function">
        <field name="model_id" ref="erplibre_sync_external_data.model_sync_data_exec" />
        <field name="method">action_process_sync_data</field>
        <field name="allow_commit" eval="True"/>
    </record>

    <record id="job_function_action_transform" model="queue.job.function">
        <field name="model_id" ref="erplibre_sync_external_data.model_sync_data_transform" />
        <field name="method">action_transform</field>
        <field name="channel_id" ref="job_channel_sync_data_transform" />
    </record>

    <record id="job_function_queue_ticket_to_transform" model="queue.job.function">
        <field name="model_id" ref="erplibre_sync_external_data.model_sync_data_transform" />
        <field name="method">queue_ticket_to_transform</field>
        <field name="channel_id" ref="job_channel_sync_data_transform" />
    </record>

    <record id="job_function_queue_end_transform" model="queue.job.function">
        <field name="model_id" ref="erplibre_sync_external_data.model_sync_data_transform" />
        <field name="method">queue_end_transform</field>
        <field name="channel_id" ref="job_channel_sync_data_transform" />
    </record>
</odoo>
