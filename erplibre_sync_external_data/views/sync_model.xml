<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sync_model_view_form" model="ir.ui.view">
        <field name="name">sync_model_form</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="sequence" />
                        <field name="model_name" />
                        <field name="scenario" />
                        <field name="description" />
                        <field name="spreadsheet_extraction_metadata" widget="ace" />
                    </group>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="sync_model_view_graph" model="ir.ui.view">
        <field name="name">sync_model_graph</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <graph string="Sync model">
                <field name="name" type="row" />
                <field name="model_name" type="row" />
                <field name="scenario" type="row" />
                <field name="spreadsheet_extraction_metadata" type="row" />
            </graph>
        </field>
    </record>

    <record id="sync_model_view_kanban" model="ir.ui.view">
        <field name="name">sync_model_kanban</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="model_name" />
                <field name="scenario" />
                <field name="spreadsheet_extraction_metadata" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="model_name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="scenario" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="spreadsheet_extraction_metadata" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sync_model_view_list" model="ir.ui.view">
        <field name="name">sync_model_list</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" optional="hide" />
                <field name="model_name" />
                <field name="scenario" />
                <field name="spreadsheet_extraction_metadata" optional="hide" />
            </list>
        </field>
    </record>

    <record id="sync_model_view_pivot" model="ir.ui.view">
        <field name="name">sync_model_pivot</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <pivot string="Sync model">
                <field name="name" type="row" />
                <field name="model_name" type="row" />
                <field name="scenario" type="row" />
                <field name="spreadsheet_extraction_metadata" type="row" />
            </pivot>
        </field>
    </record>

    <record id="sync_model_view_search" model="ir.ui.view">
        <field name="name">sync_model_search</field>
        <field name="model">sync.model</field>
        <field name="arch" type="xml">
            <search string="Sync model">
                <field name="name" string="" />
                <field name="model_name" string="" />
                <field name="scenario" string="" />
            </search>
        </field>
    </record>

    <record id="sync_model_model_action_window" model="ir.actions.act_window">
        <field name="name">Model</field>
        <field name="res_model">sync.model</field>
        <field name="view_mode">kanban,pivot,list,graph,form</field>
    </record>
</odoo>
