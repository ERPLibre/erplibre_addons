<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sync_data_create_view_form" model="ir.ui.view">
        <field name="name">sync_data_create_form</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="res_model" />
                        <field name="res_id" />
                        <field name="sync_data_exec_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sync_data_create_view_graph" model="ir.ui.view">
        <field name="name">sync_data_create_graph</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <graph string="Sync data create">
                <field name="name" type="row" />
                <field name="res_model" type="row" />
                <field name="res_id" type="row" />
                <field name="sync_data_exec_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="sync_data_create_view_kanban" model="ir.ui.view">
        <field name="name">sync_data_create_kanban</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="res_model" />
                <field name="res_id" />
                <field name="sync_data_exec_id" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="res_model" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="res_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="sync_data_exec_id" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sync_data_create_view_list" model="ir.ui.view">
        <field name="name">sync_data_create_list</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="res_model" />
                <field name="res_id" />
                <field name="sync_data_exec_id" />
            </list>
        </field>
    </record>

    <record id="sync_data_create_view_pivot" model="ir.ui.view">
        <field name="name">sync_data_create_pivot</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <pivot string="Sync data create">
                <field name="name" type="row" />
                <field name="res_model" type="row" />
                <field name="res_id" type="row" />
                <field name="sync_data_exec_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="sync_data_create_view_search" model="ir.ui.view">
        <field name="name">sync_data_create_search</field>
        <field name="model">sync.data.create</field>
        <field name="arch" type="xml">
            <search string="Sync data create">
                <field name="name" string="" />
                <field name="res_model" string="" />
                <field name="res_id" string="" />
                <field name="sync_data_exec_id" string="Sync Data Exec" />
                <group expand="1" string="Group by">
                    <filter
                        string="Sync Data Exec"
                        name="groupby_sync_data_exec"
                        context="{'group_by':'sync_data_exec_id'}"
                    />
                    <filter string="Model" name="groupby_model" context="{'group_by':'res_model'}" />
                </group>
                <searchpanel>
                    <field name="sync_data_exec_id" string="Sync Data Exec" icon="fa-th-list" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="sync_data_create_data_create_action_window" model="ir.actions.act_window">
        <field name="name">Data create</field>
        <field name="res_model">sync.data.create</field>
        <field name="view_mode">kanban,pivot,list,graph,form</field>
    </record>
</odoo>
