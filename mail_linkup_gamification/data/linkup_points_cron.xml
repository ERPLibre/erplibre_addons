<odoo noupdate="1">
    <!-- Compares the karma of each member with the sum of their ledger
         lines; a difference is logged as an error and given to the LinkUp
         administrators as an activity (LU-NF-043). -->
    <record id="ir_cron_linkup_points_check" model="ir.cron">
        <field name="name">LinkUp: check the karma against the points ledger</field>
        <field name="model_id" ref="model_linkup_points_ledger" />
        <field name="state">code</field>
        <field name="code">model._cron_check_karma()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
