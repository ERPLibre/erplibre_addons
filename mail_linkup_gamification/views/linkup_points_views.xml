<odoo>
    <record id="linkup_points_rule_view_list" model="ir.ui.view">
        <field name="name">linkup.points.rule.list</field>
        <field name="model">linkup.points.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" readonly="id" />
                <field name="name" />
                <field name="points" />
                <field name="beneficiaries" />
                <field name="daily_cap" optional="show" />
                <field name="weekly_cap" optional="show" />
                <field name="pair_daily_cap" optional="show" />
                <field name="pair_weekly_cap" optional="show" />
                <field name="pair_lifetime_cap" optional="show" />
                <field name="cap_group" optional="hide" />
                <field name="decay" optional="show" />
                <field name="resets_decay" optional="hide" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="linkup_points_rule_action" model="ir.actions.act_window">
        <field name="name">Point rules</field>
        <field name="res_model">linkup.points.rule</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="linkup_points_ledger_view_list" model="ir.ui.view">
        <field name="name">linkup.points.ledger.list</field>
        <field name="model">linkup.points.ledger</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" />
                <field name="user_id" />
                <field name="rule_id" />
                <field name="points" sum="Total" />
                <field name="partner_user_id" />
                <field name="capped" />
                <field name="cap_reason" />
                <field name="reflet_id" optional="hide" />
                <field name="event_key" optional="hide" />
            </list>
        </field>
    </record>

    <record id="linkup_points_ledger_view_search" model="ir.ui.view">
        <field name="name">linkup.points.ledger.search</field>
        <field name="model">linkup.points.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="partner_user_id" />
                <field name="rule_id" />
                <filter name="capped" string="Capped" domain="[('capped', '=', True)]" />
                <group>
                    <filter name="group_user" string="Beneficiary" context="{'group_by': 'user_id'}" />
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="linkup_points_ledger_action" model="ir.actions.act_window">
        <field name="name">Points ledger</field>
        <field name="res_model">linkup.points.ledger</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_linkup_points"
        name="Points"
        parent="mail_linkup_reflet.menu_linkup_root"
        groups="mail_linkup_reflet.group_linkup_admin"
        sequence="50"
    />
    <menuitem
        id="menu_linkup_points_rule"
        name="Point rules"
        parent="menu_linkup_points"
        action="linkup_points_rule_action"
        groups="mail_linkup_reflet.group_linkup_admin"
        sequence="10"
    />
    <menuitem
        id="menu_linkup_points_ledger"
        name="Points ledger"
        parent="menu_linkup_points"
        action="linkup_points_ledger_action"
        groups="mail_linkup_reflet.group_linkup_admin"
        sequence="20"
    />
</odoo>
