#. module: erplibre_sign_oca_signature_stamp
#: model_terms:ir.ui.view,arch_db:erplibre_sign_oca_signature_stamp.res_config_settings_view_form
msgid ""
"Draw a frame and metadata around each signature of the signed documents. A "
"template can force it on or off."
msgstr ""
"Dessine un cadre et des méta-données autour de chaque signature des "
"documents signés. Un modèle peut l'imposer ou l'interdire."

#. module: erplibre_sign_oca_signature_stamp
