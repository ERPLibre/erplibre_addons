<templates xml:space="preserve">

    <!-- Le panneau d'appel montre les echanges precedents avec la meme
         personne. Un appel se decroche mieux en sachant qu'on a deja parle
         trois fois cette semaine. -->
    <t
    t-name="erplibre_voip_contact.CallHistorique"
    t-inherit="voip_oca.Call"
    t-inherit-mode="extension"
  >

        <xpath expr="//div[hasclass('pt-2')]" position="after">
            <div
        class="d-flex flex-column px-3 pt-2"
        t-if="historique.appels.length"
      >
                <span>Historique</span>
                <div class="o_erplibre_voip_historique small my-2">
                    <t
            t-foreach="historique.appels"
            t-as="passe"
            t-key="passe.id"
          >
                        <div class="d-flex justify-content-between py-1">
                            <span>
                                <i t-att-class="iconeHistorique(passe)" />
                                <span
                  class="mx-2"
                  t-esc="dateHistorique(passe)"
                />
                            </span>
                            <span
                class="text-muted"
                t-esc="dureeHistorique(passe)"
              />
                        </div>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Un numero inconnu n'offrait aucune issue : ni fiche a ouvrir, ni
             fiche a creer. Le bouton de creation prend la place laissee vide
             par celui qui ouvre la fiche. -->
        <xpath expr="//button[@title='Info contact']" position="after">
            <button
        t-if="!(voip.partner and voip.partner.id)"
        class="btn btn-secondary p-3 rounded-circle"
        title="Nouveau contact"
        t-on-click="onCreerContact"
      >
                <i class="fa fa-fw fa-lg fa-user-plus" />
            </button>
        </xpath>

    </t>

</templates>
