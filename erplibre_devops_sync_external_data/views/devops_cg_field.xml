<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="devops_cg_field_view_form" model="ir.ui.view">
        <field name="name">devops_cg_field_form</field>
        <field name="inherit_id" ref="erplibre_devops.devops_cg_field_view_form" />
        <field name="model">devops.cg.field</field>
        <field name="arch" type="xml">
            <group name="group_model" position="after">
                <group string="External sync data">
                    <field name="enable_sync_external" />
                </group>
                <group invisible="not enable_sync_external">
                    <field name="sync_external_is_primary" />
                    <field name="sync_external_associate_header_name" />
                    <field name="sync_external_value_map" />
                </group>
            </group>
        </field>
    </record>
</odoo>
