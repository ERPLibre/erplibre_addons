<odoo>

    <!-- Seuls le nom, le profil et les surcharges de configuration
         s'écrivent à la main ; le reste vient des remontées du poste. Le
         champ `active` ne figure qu'au gestionnaire : le client web
         n'offre « Archiver » que s'il est dans la vue. -->
    <record id="view_streamdeck_workstation_list" model="ir.ui.view">
        <field name="name">streamdeck.workstation.list</field>
        <field name="model">streamdeck.workstation</field>
        <field name="arch" type="xml">
            <list decoration-muted="not token_active"
                  decoration-warning="silent_since">
                <header>
                    <button name="%(action_streamdeck_pairing_wizard)d"
                            type="action"
                            string="Add a workstation"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="user_id" optional="show"/>
                <field name="os_name" optional="hide"/>
                <field name="os_version" optional="hide"/>
                <field name="gnome_shell" optional="hide"/>
                <field name="extension_version" optional="show"/>
                <field name="deck_program" optional="hide"/>
                <field name="service_state"
                       widget="badge"
                       decoration-success="service_state == 'active'"
                       decoration-danger="service_state == 'failed'"
                       decoration-warning="service_state == 'inactive'"
                       optional="show"/>
                <field name="last_report" optional="show"/>
                <field name="silent_since" optional="show"/>
                <field name="token_active" optional="show"/>
                <field name="lost_events_total" optional="hide"/>
                <field name="config_state"
                       widget="badge"
                       decoration-success="config_state == 'applied'"
                       decoration-warning="config_state in ('pending', 'drift')"
                       decoration-danger="config_state == 'refused'"
                       optional="hide"/>
                <field name="active" column_invisible="True"
                       groups="erplibre_streamdeck.group_streamdeck_manager"/>
            </list>
        </field>
    </record>

    <record id="view_streamdeck_workstation_form" model="ir.ui.view">
        <field name="name">streamdeck.workstation.form</field>
        <field name="model">streamdeck.workstation</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_revoke_token"
                            type="object"
                            string="Revoke the token"
                            invisible="not token_active"
                            confirm="The workstation will stop reporting until it is enrolled again. Revoke its token?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"
                            groups="erplibre_streamdeck.group_streamdeck_manager"/>
                    <field name="active" invisible="True"
                           groups="erplibre_streamdeck.group_streamdeck_manager"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Workstation">
                            <field name="user_id" readonly="True"
                                   options="{'no_open': True}"/>
                            <field name="os_name" readonly="True"/>
                            <field name="os_version" readonly="True"/>
                            <field name="gnome_shell" readonly="True"/>
                            <field name="erplibre_branch" readonly="True"/>
                            <field name="erplibre_commit" readonly="True"/>
                        </group>
                        <group string="Deck">
                            <field name="extension_version" readonly="True"/>
                            <field name="contract_version" readonly="True"/>
                            <field name="deck_program" readonly="True"/>
                            <field name="service_state" readonly="True"/>
                            <field name="service_state_since" readonly="True"/>
                        </group>
                        <group string="Reports">
                            <field name="token_active" readonly="True"/>
                            <field name="token_created" readonly="True"/>
                            <field name="token_last_used" readonly="True"/>
                            <field name="last_report" readonly="True"/>
                            <field name="silent_since" readonly="True"
                                   invisible="not silent_since"/>
                            <field name="lost_events_total" readonly="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Decks" name="decks">
                            <field name="device_ids" readonly="True">
                                <list>
                                    <field name="model_name"/>
                                    <field name="serial"/>
                                    <field name="connected"/>
                                    <field name="connected_since"/>
                                    <field name="last_seen"/>
                                    <field name="firmware" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Events" name="events">
                            <field name="event_ids" readonly="True">
                                <list>
                                    <field name="at"/>
                                    <field name="label"/>
                                    <field name="kind" optional="hide"/>
                                    <field name="device_id"/>
                                    <field name="service_state" optional="hide"/>
                                    <field name="received_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <!-- L'employé choisit un profil « au choix » tant
                             que celui en place l'est aussi, et surcharge
                             les réglages libres de son poste ; seul le
                             gestionnaire assigne n'importe quel profil et
                             pose un verrou. Les gardes du serveur
                             (`_check_profile_pick`, lignes) tiennent ces
                             bornes : la vue ne fait que les montrer. -->
                        <page string="Configuration" name="configuration">
                            <div class="alert alert-warning" role="alert"
                                 invisible="not config_too_old">
                                The extension of this workstation is too old
                                for Odoo to pilot its deck: piloting starts
                                with contract 1.3 of the extension.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not config_several_models">
                                Decks of several models are connected to this
                                workstation: the settings of their models
                                apply by ascending USB product id, the highest
                                one winning.
                            </div>
                            <div class="alert alert-info" role="status"
                                 invisible="not config_ask">
                                Waiting for the employee's choice: keep the
                                local values of these settings or take
                                Odoo's.
                                <field name="config_ask" readonly="True"/>
                            </div>
                            <group>
                                <group string="Profile">
                                    <field name="config_profile_id"
                                           options="{'no_create': True}"
                                           groups="erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="config_profile_id"
                                           domain="[('selectable', '=', True)]"
                                           readonly="config_profile_id and not config_profile_selectable"
                                           options="{'no_create': True, 'no_open': True}"
                                           groups="!erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="config_profile_selectable"
                                           invisible="True"/>
                                    <field name="config_several_models"
                                           invisible="True"/>
                                    <field name="config_too_old"
                                           invisible="True"/>
                                    <field name="config_first_choice"
                                           readonly="True"/>
                                </group>
                                <group string="State">
                                    <field name="config_state" readonly="True"
                                           widget="badge"
                                           decoration-success="config_state == 'applied'"
                                           decoration-warning="config_state in ('pending', 'drift')"
                                           decoration-danger="config_state == 'refused'"/>
                                    <field name="config_revision" readonly="True"/>
                                    <field name="config_applied_revision"
                                           readonly="True"/>
                                    <field name="config_pending_since"
                                           readonly="True"
                                           invisible="not config_pending_since"/>
                                    <field name="config_reason" readonly="True"
                                           invisible="not config_reason"/>
                                </group>
                            </group>
                            <separator string="Effective configuration"/>
                            <field name="config_effective_html" nolabel="1"
                                   readonly="True"/>
                            <separator string="Overrides of this workstation"/>
                            <field name="config_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="key"
                                           groups="erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="key" readonly="locked"
                                           groups="!erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="value"
                                           groups="erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="value" readonly="locked"
                                           groups="!erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="locked"
                                           groups="erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="locked" readonly="True"
                                           groups="!erplibre_streamdeck.group_streamdeck_manager"/>
                                    <field name="source" readonly="True"/>
                                </list>
                            </field>
                            <separator string="Key layouts of the connected decks"/>
                            <field name="config_layouts_html" nolabel="1"
                                   readonly="True"/>
                            <separator string="Key layouts of this workstation"/>
                            <field name="layout_ids" nolabel="1">
                                <list>
                                    <field name="usb_product_id"/>
                                    <field name="name"/>
                                    <field name="locked"/>
                                    <field name="in_file"/>
                                    <field name="source"/>
                                </list>
                            </field>
                            <group>
                                <field name="deck_plugins" readonly="True"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_streamdeck_workstation_search" model="ir.ui.view">
        <field name="name">streamdeck.workstation.search</field>
        <field name="model">streamdeck.workstation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="device_ids" string="Deck serial number"
                       filter_domain="[('device_ids.serial', 'ilike', self)]"/>
                <filter name="enrolled" string="Enrolled"
                        domain="[('token_active', '=', True)]"/>
                <filter name="not_enrolled" string="Not enrolled"
                        domain="[('token_active', '=', False)]"/>
                <separator/>
                <filter name="service_failed" string="Deck service failed"
                        domain="[('service_state', '=', 'failed')]"/>
                <filter name="silent" string="Silent"
                        domain="[('silent_since', '!=', False)]"/>
                <separator/>
                <filter name="config_pending" string="Configuration pending"
                        domain="[('config_state', '=', 'pending')]"/>
                <filter name="config_refused" string="Configuration refused"
                        domain="[('config_state', '=', 'refused')]"/>
                <separator/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="Employee"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_service_state" string="Deck service"
                            context="{'group_by': 'service_state'}"/>
                    <filter name="group_extension" string="Extension version"
                            context="{'group_by': 'extension_version'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- « Mes postes » se borne à l'utilisateur courant, gestionnaire
         compris ; « Parc › Postes » montre ce que les règles ouvrent. -->
    <record id="action_streamdeck_my_workstations" model="ir.actions.act_window">
        <field name="name">My workstations</field>
        <field name="res_model">streamdeck.workstation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No workstation reports to this database yet
            </p>
            <p>
                Click Add a workstation to get a pairing code, then enroll
                this database from the preferences of the ERPLibre Home
                extension on the workstation.
            </p>
        </field>
    </record>

    <record id="action_streamdeck_fleet_workstations" model="ir.actions.act_window">
        <field name="name">Workstations</field>
        <field name="res_model">streamdeck.workstation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_user': 1}</field>
    </record>

</odoo>
