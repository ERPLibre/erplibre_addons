<odoo>

    <!-- Le pas du cron donne la granularité des délais de la surveillance.
         Chaque passage est idempotent : un poste n'est marqué muet qu'une
         fois, une activité ne s'ouvre que si aucune n'est ouverte. -->
    <data noupdate="1">

        <record id="ir_cron_streamdeck_watch" model="ir.cron">
            <field name="name">Stream Deck: watch workstations and decks</field>
            <field name="model_id" ref="model_streamdeck_monitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_watch()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
