<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm_lead_view_form_website_generator" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_website_plan" class="oe_stat_button" icon="fa-globe" type="object">
                    <!--                        <i class="fa fa-arrow-right"/>-->
                    <!--                                        Setup Token-->
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">New Website</span>
                    </div>
                </button>
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_get_website"
                    class="oe_stat_button"
                    icon="fa-sitemap"
                    type="object"
                    attrs="{'invisible': [('website_generator_count','=', 0)]}"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="website_generator_count" />
                        </span>
                        <span class="o_stat_text">Websites plan</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
