<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='generate_lead_setting_container']" position="after">
                <h2>Website generator</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="crm_website_generator">
                        <div class="o_setting_right_pane">
                            <label for="company_id" />
                            <div class="text-muted">CRM website generator</div>
                        </div>
                        <div class="o_setting_right_pane">
                            <span>
                                Domain base:
                                <field name="website_generator_base_domain" />
                            </span>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
