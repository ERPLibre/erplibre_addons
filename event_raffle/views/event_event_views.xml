<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_event_view_form_raffle" model="ir.ui.view">
        <field name="name">event.event.form.raffle</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_start_raffle" type="object"
                        string="Démarrer un tirage" class="btn-primary"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_raffle_winners" type="object"
                        class="oe_stat_button" icon="fa-trophy">
                    <field name="raffle_winner_count" widget="statinfo"
                           string="Gagnants"/>
                </button>
                <button name="action_view_raffles" type="object"
                        class="oe_stat_button" icon="fa-random">
                    <field name="raffle_count" widget="statinfo"
                           string="Tirages"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
