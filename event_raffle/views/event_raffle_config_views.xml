<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_config_view_form" model="ir.ui.view">
        <field name="name">event.raffle.config.form</field>
        <field name="model">event.raffle.config</field>
        <field name="arch" type="xml">
            <form string="Raffle Settings" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Default Raffle Settings</h1>
                    </div>
                    <group>
                        <group string="Wheel">
                            <field name="default_theme" />
                            <field name="default_remove_winner" />
                            <field name="default_spin_duration" />
                            <field name="default_spin_turns" />
                            <field name="default_pointer_angle" />
                        </group>
                        <group string="Celebration &amp; Animation">
                            <field name="default_winner_celebration" />
                            <field name="default_show_fireworks" />
                            <field name="default_show_tux" />
                            <field name="default_belly_logo" />
                            <field name="default_tux_animation" />
                            <field name="default_flag_text" />
                        </group>
                    </group>
                    <p class="text-muted">These values are applied by default when a new raffle is created.</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_raffle_config" model="ir.actions.act_window">
        <field name="name">Default Settings</field>
        <field name="res_model">event.raffle.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="raffle_config_singleton" />
        <field name="target">current</field>
    </record>
</odoo>
