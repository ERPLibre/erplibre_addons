<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_raffle_start_wizard_form" model="ir.ui.view">
        <field name="name">event.raffle.start.wizard.form</field>
        <field name="model">event.raffle.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Start a Raffle">
                <group>
                    <field name="event_id" readonly="1" />
                    <field name="name" placeholder="Raffle..." />
                    <field name="copy_strategy" />
                    <field name="remove_winner" />
                    <field name="context_note" placeholder="Context..." />
                </group>
                <footer>
                    <button string="Start" name="action_start" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
