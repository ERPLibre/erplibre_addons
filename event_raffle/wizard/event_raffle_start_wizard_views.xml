<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_raffle_start_wizard_form" model="ir.ui.view">
        <field name="name">event.raffle.start.wizard.form</field>
        <field name="model">event.raffle.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Démarrer un tirage">
                <group>
                    <field name="event_id" readonly="1"/>
                    <field name="name" placeholder="Tirage..."/>
                    <field name="copy_strategy"/>
                    <field name="remove_winner"/>
                    <field name="context_note" placeholder="Contexte..."/>
                </group>
                <footer>
                    <button string="Démarrer" name="action_start"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
