#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "<%(tag)s> cannot be hidden."
msgstr "<%(tag)s> ne peut pas être masqué."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "<%(tag)s> cannot move."
msgstr "<%(tag)s> ne peut pas être déplacé."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "<%(tag)s> replaces its content: nothing dropped into it shows."
msgstr ""
"<%(tag)s> remplace son contenu : rien de ce qui y est déposé ne s'affiche."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_editor.py:0
msgid ""
"A GeoEngine view needs a geo field on %(model)s: add one to its form and "
"Apply first."
msgstr "Une vue GeoEngine demande un champ géographique sur %(model)s : ajoutez-en un à son formulaire, puis appliquez d'abord."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A JSON field shows in a form or a list only."
msgstr "Un champ JSON s'affiche seulement dans un formulaire ou une liste."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid ""
"A Python keyword, a namespace of Odoo (ir, res, base, web, bus, report) or a"
" model that takes no access right. The x_ prefix avoids this case."
msgstr "Un mot-clé Python, un espace de noms d'Odoo (ir, res, base, web, bus, report) ou un modèle qui ne prend aucun droit d'accès. Le préfixe x_ évite ce cas."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_editor.js:0
msgid "A bar, line or pie chart of the records, grouped and measured."
msgstr "Un graphique à barres, à lignes ou en secteurs des enregistrements, regroupés et mesurés."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_timeline.js:0
msgid "A boolean field: true shows the event over the whole day."
msgstr "Un champ booléen : vrai affiche l'événement sur toute la journée."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_inspector.xml:0
msgid ""
"A browser that opened this calendar before keeps the last scale used on it."
msgstr ""
"Un navigateur qui a déjà ouvert ce calendrier garde la dernière échelle "
"utilisée."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A calendar needs a stored date field on %(model)s."
msgstr "Un calendrier demande un champ date stocké sur %(model)s."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A change cannot add <%(tag)s>."
msgstr "Une modification ne peut pas ajouter <%(tag)s>."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A change cannot write the attribute %(attribute)s."
msgstr "Une modification ne peut pas écrire l'attribut %(attribute)s."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_change.py:0
msgid ""
"A change is on a view, on the default view of a model not created yet, or on"
" a view the project adds: one of them."
msgstr ""
"Un changement porte sur une vue, sur la vue par défaut d'un modèle pas "
"encore créé, ou sur une vue que le projet ajoute : l'une d'elles."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_change.py:0
msgid ""
"A change of a model not created yet is on its form, list or search view, in "
"its project."
msgstr ""
"Un changement d'un modèle pas encore créé porte sur sa vue formulaire, liste"
" ou recherche, dans son projet."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_change.py:0
msgid "A change of a view the project adds is on that view, in its project."
msgstr ""
"Un changement d'une vue que le projet ajoute porte sur cette vue, dans son "
"projet."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_model.py:0
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A chatter needs the module mail (Discuss)."
msgstr "Un fil de discussion demande le module mail (Discussion)."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_editor.js:0
msgid "A chronological band, provided by web_timeline (OCA)."
msgstr "Frise chronologique, fournie par web_timeline (OCA)."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_outline.xml:0
msgid ""
"A click selects the element on the canvas. Drag a row, or press Alt+Up or Alt+Down, to move it; a\n"
"                filled dot marks a change of the draft."
msgstr ""
"Un clic sélectionne l'élément dans le canevas. Glissez une ligne, ou "
"appuyez sur Alt+Haut ou Alt+Bas, pour la déplacer ; un point plein marque un "
"changement du brouillon."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A color rule cannot compare %(name)s, a %(type)s field."
msgstr ""
"Une règle de couleur ne peut pas comparer %(name)s, un champ %(type)s."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_inspector.js:0
msgid "A condition on a record keeps its id: the generated module carries it."
msgstr "Une condition sur un enregistrement garde son identifiant : le module généré le porte."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_timeline.js:0
msgid ""
"A date or date and time field of the model. Required: without it, the "
"timeline places nothing."
msgstr ""
"Champ date ou date et heure du modèle. Obligatoire : sans lui, la frise ne "
"place rien."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_timeline.js:0
msgid "A date or date and time field. Required."
msgstr "Un champ date ou date et heure. Requis."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A field of %(parent)s also shows on the models that inherit it."
msgstr "Un champ de %(parent)s apparaît aussi sur les modèles qui en héritent."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A field of type %(type)s does not take the option %(option)s."
msgstr "Un champ de type %(type)s ne prend pas l'option %(option)s."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A filter needs at least one condition."
msgstr "Un filtre demande au moins une condition."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid ""
"A geo field goes among the fields a GeoEngine view loads, not in its info "
"box."
msgstr "Un champ géographique va parmi les champs que charge une vue GeoEngine, pas dans sa fenêtre d'information."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A geo field shows as a map in a form only."
msgstr "Un champ géographique s'affiche en carte dans un formulaire seulement."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_security.xml:0
msgid "A global rule applies to everyone, administrators included."
msgstr "Une règle globale s'applique à tous, administrateurs compris."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A group goes in an app of the project: choose it."
msgstr "Un groupe va dans une application du projet : choisissez-la."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_group.py:0
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A group needs a name."
msgstr "Un groupe a besoin d'un nom."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_security.xml:0
msgid "A group of the rule left the database: choose its groups again."
msgstr "Groupe supprimé depuis : choisissez ses groupes à nouveau."

#. module: erplibre_studio
#: model:ir.model.fields,help:erplibre_studio.field_erplibre_studio_access__group_line_id
msgid "A group the project creates, instead of an existing group."
msgstr "Un groupe que le projet crée, au lieu d'un groupe existant."

#. module: erplibre_studio
#: model:ir.model.fields,help:erplibre_studio.field_erplibre_studio_access__group_id
msgid "A group with an external id: the module refers to it."
msgstr "Un groupe qui a un identifiant externe : le module y fait référence."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A hierarchy needs a many2one from %(model)s to itself."
msgstr "Une hiérarchie demande un many2one de %(model)s vers lui-même."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_geo_layer.py:0
msgid "A layer belongs to a GeoEngine view."
msgstr "Une couche appartient à une vue GeoEngine."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_geo_layer.py:0
msgid "A layer belongs to the project of its view."
msgstr "Une couche appartient au projet de sa vue."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A many2many shows in a form, a list or a kanban only."
msgstr ""
"Un many2many s'affiche dans un formulaire, une liste ou un kanban seulement."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_editor.js:0
msgid "A map of geo fields with layers, provided by base_geoengine (OCA)."
msgstr "Une carte de champs géographiques en couches, fournie par base_geoengine (OCA)."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A measure takes no interval."
msgstr "Une mesure ne prend pas d'intervalle."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A measure takes no interval: remove the interval first."
msgstr "Une mesure ne prend pas d'intervalle : retirez d'abord l'intervalle."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_models.xml:0
msgid "A menu that opens an action takes no submenu: it is not listed."
msgstr ""
"Un menu qui ouvre une action ne prend pas de sous-menu : il n'est pas listé."

#. module: erplibre_studio
#. odoo-python
#: code:addons/erplibre_studio/models/erplibre_studio_model.py:0
#: code:addons/erplibre_studio/models/erplibre_studio_project.py:0
msgid "A model needs a label."
msgstr "Un modèle demande un libellé."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_models_space.js:0
msgid "A model of a module: its name does not change."
msgstr "Modèle d'un module : son nom ne se change pas."

#. module: erplibre_studio
#. odoo-javascript
#: code:addons/erplibre_studio/static/src/editor/studio_security.js:0
msgid "A model shows here as soon as a change of the project touches it."
msgstr ""
"Les modèles apparaissent ici dès qu'un changement du projet les touche."

#. module: erplibre_studio
#: model:ir.model.fields,help:erplibre_studio.field_erplibre_studio_access__model
#: model:ir.model.fields,help:erplibre_studio.field_erplibre_studio_rule__model
