<templates xml:space="preserve">
    <t t-inherit="erplibre_developer.DeveloperDrawer" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_erplibre_dev_inspect')]" position="before">
            <button
                t-if="canCustomize"
                class="btn btn-sm btn-secondary o_erplibre_studio_customize"
                title="Customize this view"
                t-on-click="customizeView"
            >
                <i class="fa fa-paint-brush" />
            </button>
            <button
                t-if="canCustomizeSearch"
                class="btn btn-sm btn-secondary o_erplibre_studio_customize_search"
                title="Customize the search view"
                t-on-click="customizeSearchView"
            >
                <i class="fa fa-search" />
            </button>
        </xpath>
    </t>
</templates>
