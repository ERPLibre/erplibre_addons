<templates xml:space="preserve">
    <!-- The tab Groups of the security space: the apps of the project, each
         with its groups as a chain of levels, the existing apps the project
         names; the inspector on the right holds the form of an app or of a
         group. -->
    <t t-name="erplibre_studio.AppsPanel">
        <main class="flex-grow-1 overflow-auto p-3" aria-label="Apps and groups of the project">
            <t t-slot="head" />
            <div
                role="tabpanel"
                id="o_erplibre_studio_security_panel"
                aria-labelledby="o_erplibre_studio_security_tab_apps"
                class="o_erplibre_studio_apps_panel"
            >
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <p class="small text-muted mb-0 flex-grow-1">
                        Each group belongs to an app. A group that implies another one gives its rights too: its
                        members become members of the other one.
                    </p>
                    <button
                        type="button"
                        class="btn btn-sm btn-secondary o_erplibre_studio_new_app"
                        t-att-disabled="props.busy"
                        t-on-click="newApp"
                    >
                        <i class="fa fa-plus me-1" aria-hidden="true" />
                        New app
                    </button>
                </div>
                <div
                    t-if="props.error"
                    class="alert alert-danger py-1 px-2 small o_erplibre_studio_apps_error"
                    role="alert"
                    t-esc="props.error"
                />
                <div t-if="!apps.length" class="text-muted small mb-3 o_erplibre_studio_no_app">
                    No app: a model goes under an existing menu, or in an app made by its dialog.
                </div>
                <section
                    t-foreach="apps"
                    t-as="app"
                    t-key="app.id"
                    class="o_erplibre_studio_app_card card mb-3"
                    t-att-data-app="app.xml_name"
                    t-att-aria-labelledby="'o_erplibre_studio_app_' + app.id"
                >
                    <t t-set="open" t-value="isOpen('app:' + app.id)" />
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                        <button
                            type="button"
                            class="btn btn-sm btn-link text-body p-0 o_erplibre_studio_app_toggle"
                            t-att-aria-expanded="open ? 'true' : 'false'"
                            t-att-aria-controls="'o_erplibre_studio_app_body_' + app.id"
                            t-att-aria-label="toggleLabel(app.name)"
                            t-on-click="() => this.toggleCard('app:' + app.id)"
                        >
                            <i class="fa fa-fw" t-att-class="open ? 'fa-caret-down' : 'fa-caret-right'" aria-hidden="true" />
                        </button>
                        <t t-set="icon" t-value="iconOf(app)" />
                        <img t-if="icon" t-att-src="icon.url" alt="" width="28" height="28" />
                        <span class="d-flex flex-column">
                            <span
                                class="fw-bold o_erplibre_studio_app_name"
                                t-att-id="'o_erplibre_studio_app_' + app.id"
                                t-esc="app.name"
                            />
                            <code class="small" t-esc="app.xml_name" />
                        </span>
                        <span class="badge text-bg-primary">App of the project</span>
                        <span
                            class="badge o_erplibre_studio_app_state"
                            t-att-class="app.applied ? 'text-bg-success' : 'text-bg-warning'"
                        >
                            <t t-if="app.applied">in the database</t>
                            <t t-else="">created by Apply</t>
                        </span>
                        <span class="small text-muted" t-esc="groupCountText(app)" />
                        <span class="ms-auto d-inline-flex gap-2">
                            <button
                                type="button"
                                class="btn btn-sm btn-link p-0 o_erplibre_studio_edit_app"
                                t-att-aria-label="editLabel(app.name)"
                                t-att-title="editLabel(app.name)"
                                t-att-disabled="props.busy"
                                t-on-click="() => this.editApp(app)"
                            >
                                <i class="fa fa-pencil" aria-hidden="true" />
                            </button>
                            <button
                                type="button"
                                class="btn btn-sm btn-link text-danger p-0 o_erplibre_studio_remove_app"
                                t-att-aria-label="removeLabel(app.name)"
                                t-att-title="removeLabel(app.name)"
                                t-att-disabled="props.busy"
                                t-on-click="() => this.removeApp(app)"
                            >
                                <i class="fa fa-trash" aria-hidden="true" />
                            </button>
                        </span>
                    </div>
                    <div
                        t-if="open"
                        class="card-body d-flex flex-column gap-2 o_erplibre_studio_app_groups"
                        t-att-id="'o_erplibre_studio_app_body_' + app.id"
                    >
                        <div
                            t-if="chainWarning(app)"
                            class="alert alert-warning py-1 px-2 small mb-0 o_erplibre_studio_chain_warning"
                            role="status"
                        >
                            These groups show as checkboxes in developer mode only in the user form: make each one imply
                            the previous one to get a selection.
                        </div>
                        <t t-set="chain" t-value="levels(app)" />
                        <div t-if="!chain.length" class="text-muted small">No group.</div>
                        <ol t-else="" class="list-unstyled d-flex flex-column gap-1 mb-0 o_erplibre_studio_chain">
                            <t t-foreach="chain" t-as="entry" t-key="entry.group.id">
                                <li
                                    t-if="entry_index"
                                    class="small text-muted ps-3 o_erplibre_studio_chain_link"
                                    t-att-data-linked="entry.linked ? '1' : '0'"
                                >
                                    <i
                                        class="fa me-1"
                                        t-att-class="entry.linked ? 'fa-long-arrow-up' : 'fa-chain-broken'"
                                        aria-hidden="true"
                                    />
                                    <t t-if="entry.linked">implies the level above</t>
                                    <t t-else="">no link</t>
                                </li>
                                <li
                                    class="o_erplibre_studio_group border rounded p-2 d-flex flex-wrap align-items-center gap-2"
                                    t-att-class="{'o_erplibre_studio_group_selected': isGroupSelected(entry.group)}"
                                    t-att-data-group="entry.group.xml_name"
                                >
                                    <button
                                        type="button"
                                        class="btn btn-link p-0 text-body text-start text-decoration-none o_erplibre_studio_group_pick"
                                        t-att-aria-pressed="isGroupSelected(entry.group) ? 'true' : 'false'"
                                        t-att-disabled="props.busy"
                                        t-on-click="() => this.editGroup(entry.group)"
                                    >
                                        <span
                                            class="badge text-bg-secondary me-1 o_erplibre_studio_group_level"
                                            t-esc="levelText(app, entry)"
                                        />
                                        <span class="fw-bold o_erplibre_studio_group_name" t-esc="entry.group.name" />
                                        <span
                                            class="small text-muted ms-1 o_erplibre_studio_group_members"
                                            t-esc="membersLabel(entry.group)"
                                        />
                                    </button>
                                    <span class="d-inline-flex flex-wrap align-items-center gap-1 small">
                                        <span
                                            t-if="entry.group.implied.length or entry.group.implied_groups.length"
                                            class="text-muted"
                                        >
                                            implies
                                        </span>
                                        <span
                                            t-foreach="entry.group.implied"
                                            t-as="implied"
                                            t-key="implied[0]"
                                            class="badge text-bg-primary o_erplibre_studio_group_implied"
                                            t-esc="implied[1]"
                                        />
                                        <span
                                            t-foreach="entry.group.implied_groups"
                                            t-as="implied"
                                            t-key="implied[0]"
                                            class="badge border text-body o_erplibre_studio_group_implied_existing"
                                            t-esc="implied[1]"
                                        />
                                        <span
                                            t-foreach="entry.group.missing_implied"
                                            t-as="xmlid"
                                            t-key="xmlid"
                                            class="badge text-bg-danger o_erplibre_studio_missing_group"
                                            role="alert"
                                            t-esc="missingText(xmlid)"
                                        />
                                    </span>
                                    <span class="ms-auto d-inline-flex gap-2">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-link p-0 o_erplibre_studio_edit_group"
                                            t-att-aria-label="editLabel(entry.group.name)"
                                            t-att-title="editLabel(entry.group.name)"
                                            t-att-disabled="props.busy"
                                            t-on-click="() => this.editGroup(entry.group)"
                                        >
                                            <i class="fa fa-pencil" aria-hidden="true" />
                                        </button>
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-link text-danger p-0 o_erplibre_studio_remove_group"
                                            t-att-aria-label="removeLabel(entry.group.name)"
                                            t-att-title="removeLabel(entry.group.name)"
                                            t-att-disabled="props.busy"
                                            t-on-click="() => this.removeGroup(entry.group)"
                                        >
                                            <i class="fa fa-trash" aria-hidden="true" />
                                        </button>
                                    </span>
                                </li>
                            </t>
                        </ol>
                        <div
                            t-if="app.chain and chain.length > 1"
                            role="note"
                            class="d-flex gap-2 align-items-start border rounded p-2 small o_erplibre_studio_chain_note"
                        >
                            <i class="fa fa-info-circle mt-1" aria-hidden="true" />
                            <span>
                                <strong>Shown as one selection in the user form.</strong>
                                The groups form a chain: choosing a level gives the levels below it.
                            </span>
                        </div>
                        <div
                            t-foreach="lossesOf(app)"
                            t-as="loss"
                            t-key="loss.line_id + '-' + loss.via[0]"
                            role="alert"
                            class="alert alert-danger d-flex flex-wrap align-items-start gap-2 py-2 px-2 small mb-0 o_erplibre_studio_group_loss"
                            t-att-data-group="loss.line_id"
                        >
                            <i class="fa fa-exclamation-triangle mt-1" aria-hidden="true" />
                            <span class="flex-grow-1">
                                <strong class="d-block" t-esc="lossTitle(loss)" />
                                <span t-esc="lossText(loss)" />
                            </span>
                            <button
                                t-if="loss.via_line_id"
                                type="button"
                                class="btn btn-sm btn-outline-danger o_erplibre_studio_restore_implied"
                                t-att-disabled="props.busy"
                                t-on-click="() => this.restoreImplication(loss)"
                            >
                                Restore the implication
                            </button>
                        </div>
                        <div>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary o_erplibre_studio_new_group"
                                t-att-disabled="props.busy"
                                t-on-click="() => this.newGroup(app)"
                            >
                                <i class="fa fa-plus me-1" aria-hidden="true" />
                                <t t-esc="addLevelLabel(app)" />
                            </button>
                        </div>
                    </div>
                </section>
                <section
                    t-foreach="existingApps"
                    t-as="category"
                    t-key="category.id"
                    class="o_erplibre_studio_existing_app card mb-3"
                    t-att-data-category="category.id"
                    t-att-aria-labelledby="'o_erplibre_studio_category_' + category.id"
                >
                    <t t-set="open" t-value="isOpen('category:' + category.id, false)" />
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                        <button
                            type="button"
                            class="btn btn-sm btn-link text-body p-0 o_erplibre_studio_app_toggle"
                            t-att-aria-expanded="open ? 'true' : 'false'"
                            t-att-aria-controls="'o_erplibre_studio_category_body_' + category.id"
                            t-att-aria-label="toggleLabel(category.name)"
                            t-on-click="() => this.toggleCard('category:' + category.id, false)"
                        >
                            <i class="fa fa-fw" t-att-class="open ? 'fa-caret-down' : 'fa-caret-right'" aria-hidden="true" />
                        </button>
                        <span class="fw-bold" t-att-id="'o_erplibre_studio_category_' + category.id" t-esc="category.name" />
                        <span class="badge border text-body">Existing app</span>
                        <span class="small text-muted">no group of the project</span>
                    </div>
                    <div
                        t-if="open"
                        class="card-body small d-flex flex-column gap-2"
                        t-att-id="'o_erplibre_studio_category_body_' + category.id"
                    >
                        <span class="text-muted">
                            The groups of this app come from the installed modules. The project may imply them from its
                            own groups, without changing them.
                        </span>
                        <span class="d-flex flex-wrap gap-1">
                            <span
                                t-foreach="category.groups"
                                t-as="name"
                                t-key="name_index"
                                class="badge border text-body"
                                t-esc="name"
                            />
                        </span>
                    </div>
                </section>
            </div>
        </main>
        <aside class="o_erplibre_studio_sidebar border-start overflow-auto p-3" aria-label="Inspector">
            <t t-if="state.appForm" t-call="erplibre_studio.AppForm" />
            <t t-elif="state.groupForm" t-call="erplibre_studio.GroupForm" />
            <div t-else="" class="small text-muted o_erplibre_studio_help">
                Click a group to edit it: its name, the groups it implies, its members.
            </div>
        </aside>
    </t>

    <!-- The form of an app: name, icon, position of its menu. -->
    <t t-name="erplibre_studio.AppForm">
        <t t-set="form" t-value="state.appForm" />
        <div class="o_erplibre_studio_app_form small d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-2 o_erplibre_studio_inspector_head">
                <span
                    class="o_erplibre_studio_glyph o_erplibre_studio_glyph_large o_erplibre_studio_glyph_container"
                    aria-hidden="true"
                >
                    <i class="fa fa-th-large" />
                </span>
                <div class="o_erplibre_studio_inspector_name">
                    <div class="fw-bold fs-6 text-truncate">
                        <t t-if="form.id" t-esc="form.name" />
                        <t t-else="">New app</t>
                    </div>
                    <div class="text-muted">App of the project</div>
                </div>
            </div>
            <fieldset class="o_erplibre_studio_fieldset">
                <legend class="o_erplibre_studio_section_title">App</legend>
                <label class="form-label mb-0" for="o_erplibre_studio_app_form_name">Name</label>
                <input
                    id="o_erplibre_studio_app_form_name"
                    class="form-control form-control-sm mb-2 o_erplibre_studio_app_form_name"
                    aria-required="true"
                    t-att-class="{'is-invalid': !form.name.trim()}"
                    t-att-aria-invalid="form.name.trim() ? 'false' : 'true'"
                    t-model="form.name"
                />
                <label class="form-label mb-0" for="o_erplibre_studio_app_form_sequence">Position of the menu</label>
                <input
                    id="o_erplibre_studio_app_form_sequence"
                    type="number"
                    class="form-control form-control-sm o_erplibre_studio_app_form_sequence"
                    t-model="form.menu_sequence"
                />
            </fieldset>
            <fieldset class="o_erplibre_studio_fieldset">
                <legend id="o_erplibre_studio_app_form_icons_label" class="o_erplibre_studio_section_title">
                    Icon of the app
                </legend>
                <div
                    class="d-flex flex-wrap gap-1 o_erplibre_studio_icons"
                    role="group"
                    aria-labelledby="o_erplibre_studio_app_form_icons_label"
                >
                    <button
                        t-foreach="icons"
                        t-as="icon"
                        t-key="icon.value"
                        type="button"
                        class="btn btn-light p-1 border o_erplibre_studio_icon"
                        t-att-class="{'border-primary border-2 o_erplibre_studio_icon_selected': isIcon(icon.value)}"
                        t-att-data-value="icon.value"
                        t-att-title="icon.label"
                        t-att-aria-pressed="isIcon(icon.value) ? 'true' : 'false'"
                        t-on-click="() => this.setIcon(icon.value)"
                    >
                        <img t-att-src="icon.url" t-att-alt="icon.label" width="32" height="32" />
                    </button>
                </div>
            </fieldset>
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-secondary ms-auto" t-on-click="closeForms">Cancel</button>
                <button
                    type="button"
                    class="btn btn-sm btn-primary o_erplibre_studio_save_app"
                    t-att-disabled="props.busy or !form.name.trim()"
                    t-on-click="saveApp"
                >
                    Save
                </button>
            </div>
        </div>
    </t>

    <!-- The form of a group: name, the groups it implies, its members, comment. -->
    <t t-name="erplibre_studio.GroupForm">
        <t t-set="form" t-value="state.groupForm" />
        <t t-set="group" t-value="groupOfForm" />
        <div class="o_erplibre_studio_group_form small d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-2 o_erplibre_studio_inspector_head">
                <span
                    class="o_erplibre_studio_glyph o_erplibre_studio_glyph_large o_erplibre_studio_glyph_container"
                    aria-hidden="true"
                >
                    <i class="fa fa-users" />
                </span>
                <div class="o_erplibre_studio_inspector_name">
                    <div class="fw-bold fs-6 text-truncate" t-esc="groupFormTitle" />
                    <div class="text-muted" t-esc="groupFormKind" />
                </div>
            </div>
            <fieldset class="o_erplibre_studio_fieldset">
                <legend class="o_erplibre_studio_section_title">Group</legend>
                <label class="form-label mb-0" for="o_erplibre_studio_group_form_name">Name</label>
                <input
                    id="o_erplibre_studio_group_form_name"
                    class="form-control form-control-sm mb-2 o_erplibre_studio_group_form_name"
                    aria-required="true"
                    t-model="form.name"
                />
                <div class="d-flex justify-content-between gap-2">
                    <span class="text-muted">App</span>
                    <span t-esc="appName(form.app_id)" />
                </div>
                <div t-if="group" class="d-flex justify-content-between gap-2">
                    <span class="text-muted">Identifier</span>
                    <code class="text-break" t-esc="project.module_name + '.' + group.xml_name" />
                </div>
            </fieldset>
            <fieldset class="o_erplibre_studio_fieldset">
                <legend class="o_erplibre_studio_section_title">Implies</legend>
                <div id="o_erplibre_studio_group_lines_label" class="form-label mb-1">The groups of the project</div>
                <div
                    class="d-flex flex-column gap-1 mb-2 o_erplibre_studio_group_form_lines"
                    role="group"
                    aria-labelledby="o_erplibre_studio_group_lines_label"
                >
                    <label
                        t-foreach="impliableLines"
                        t-as="line"
                        t-key="line.id"
                        class="d-flex gap-2 align-items-start border rounded p-2 mb-0 o_erplibre_studio_implied_line"
                        t-att-data-id="line.id"
                    >
                        <input
                            type="checkbox"
                            class="form-check-input mt-1"
                            t-att-checked="isImpliedLine(line.id)"
                            t-att-disabled="isInheritedLine(line.id)"
                            t-on-change="(ev) => this.setImpliedLine(line.id, ev.target.checked)"
                        />
                        <span class="d-flex flex-column">
                            <span t-esc="lineLabel(line)" />
                            <span class="text-muted" t-esc="impliedNote(line)" />
                        </span>
                    </label>
                    <div t-if="!impliableLines.length" class="text-muted">No other group in the project.</div>
                </div>
                <div id="o_erplibre_studio_group_existing_label" class="form-label mb-1">The existing groups</div>
                <div
                    class="d-flex flex-wrap align-items-center gap-1 o_erplibre_studio_group_form_existing"
                    role="group"
                    aria-labelledby="o_erplibre_studio_group_existing_label"
                >
                    <span
                        t-foreach="form.implied_group_ids"
                        t-as="groupId"
                        t-key="groupId"
                        class="badge text-bg-secondary o_erplibre_studio_implied_group"
                        t-att-data-id="groupId"
                    >
                        <t t-esc="existingGroupLabel(groupId)" />
                        <button
                            type="button"
                            class="btn-close btn-close-white ms-1 align-middle o_erplibre_studio_chip_remove"
                            t-att-aria-label="removeChipLabel(existingGroupLabel(groupId))"
                            t-att-title="removeChipLabel(existingGroupLabel(groupId))"
                            t-on-click="() => this.removeImpliedGroup(groupId)"
                        />
                    </span>
                    <select
                        class="form-select form-select-sm w-auto o_erplibre_studio_add_implied_group"
                        aria-label="Add an existing group"
                        t-on-change="(ev) => this.addImpliedGroup(ev)"
                    >
                        <option value="">Add an existing group…</option>
                        <option
                            t-foreach="impliableGroups"
                            t-as="choice"
                            t-key="choice.id"
                            t-att-value="choice.id"
                            t-esc="choice.name"
                        />
                    </select>
                </div>
                <div class="form-text">
                    A user of the group also gets the groups it implies. The Settings are never offered: a group of
                    the project does not give the administration of the database.
                </div>
            </fieldset>
            <fieldset t-if="group" class="o_erplibre_studio_fieldset o_erplibre_studio_group_form_members">
                <legend class="o_erplibre_studio_section_title">Members</legend>
                <t t-set="members" t-value="membersOf(group)" />
                <div t-if="!group.applied" class="text-muted">Apply creates the group: it has no member yet.</div>
                <div t-elif="!members" class="text-muted">The members could not be read.</div>
                <t t-else="">
                    <div class="mb-1" t-esc="membersLabel(group)" />
                    <ul t-if="members.users.length" class="list-unstyled d-flex flex-column gap-1 mb-0">
                        <li
                            t-foreach="members.users"
                            t-as="user"
                            t-key="user.id"
                            class="d-flex align-items-center gap-2 o_erplibre_studio_member"
                        >
                            <span class="flex-grow-1 o_erplibre_studio_member_name" t-esc="user.name" />
                            <span
                                class="badge"
                                t-att-class="user.direct ? 'border text-body' : 'text-bg-primary'"
                                t-esc="memberTag(user)"
                            />
                        </li>
                    </ul>
                    <div t-if="members.more" class="text-muted">…</div>
                </t>
            </fieldset>
            <div>
                <label class="form-label mb-0" for="o_erplibre_studio_group_form_comment">Comment</label>
                <textarea
                    id="o_erplibre_studio_group_form_comment"
                    class="form-control form-control-sm o_erplibre_studio_group_form_comment"
                    rows="2"
                    t-model="form.comment"
                />
            </div>
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-secondary ms-auto" t-on-click="closeForms">Cancel</button>
                <button
                    type="button"
                    class="btn btn-sm btn-primary o_erplibre_studio_save_group"
                    t-att-disabled="props.busy or !form.name.trim()"
                    t-on-click="saveGroup"
                >
                    Save
                </button>
            </div>
        </div>
    </t>
</templates>
