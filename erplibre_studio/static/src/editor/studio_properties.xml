<templates xml:space="preserve">
    <!-- A new properties field: its container many2one, where the
         properties are defined on the comodel, then its label. -->
    <t t-name="erplibre_studio.PropertiesDialog">
        <Dialog title.translate="New properties field" size="'md'" contentClass="'o_erplibre_studio_properties_dialog'">
            <div class="mb-2 small text-muted">
                On
                <span class="fw-bold" t-esc="props.modelLabel" />
                <code class="ms-1" t-esc="props.model" />
            </div>
            <div
                t-if="state.error"
                class="alert alert-danger py-1 px-2 small o_erplibre_studio_properties_error"
                role="alert"
                t-esc="state.error"
            />
            <div t-if="state.loading" class="text-muted small">
                <i class="fa fa-spinner fa-spin me-1" />
                Loading…
            </div>
            <div
                t-elif="state.containers and !containers.length"
                class="small text-muted o_erplibre_studio_properties_empty"
            >
                Add a many2one field first: the properties are defined on the record it points to.
            </div>
            <t t-elif="containers.length">
                <fieldset class="mb-3 o_erplibre_studio_properties_containers">
                    <legend class="fs-6 fw-bold">Container</legend>
                    <div class="form-text mt-0 mb-2">
                        The many2one whose record holds the list of properties.
                    </div>
                    <div t-foreach="containers" t-as="item" t-key="item.name" class="form-check">
                        <input
                            t-att-id="'o_erplibre_studio_container_' + item.name"
                            type="radio"
                            class="form-check-input o_erplibre_studio_properties_container"
                            name="o_erplibre_studio_properties_container"
                            t-att-value="item.name"
                            t-att-checked="item.name === state.container"
                            t-att-disabled="state.saving"
                            t-on-change="() => this.setContainer(item.name)"
                        />
                        <label class="form-check-label" t-att-for="'o_erplibre_studio_container_' + item.name">
                            <t t-esc="containerLabel(item)" />
                            <code class="ms-1 small" t-esc="item.name" />
                            <span t-if="item.pending" class="badge text-bg-info ms-1">new</span>
                        </label>
                    </div>
                </fieldset>
                <fieldset t-if="container" class="mb-3 o_erplibre_studio_properties_definition">
                    <legend class="fs-6 fw-bold" t-esc="definedOnLabel" />
                    <div t-foreach="definitions" t-as="item" t-key="item.name" class="form-check">
                        <input
                            t-att-id="'o_erplibre_studio_definition_' + item.name"
                            type="radio"
                            class="form-check-input o_erplibre_studio_properties_existing"
                            name="o_erplibre_studio_properties_definition"
                            t-att-value="item.name"
                            t-att-checked="state.mode === 'existing' and item.name === state.definition"
                            t-att-disabled="state.saving"
                            t-on-change="() => this.setDefinition(item.name)"
                        />
                        <label class="form-check-label" t-att-for="'o_erplibre_studio_definition_' + item.name">
                            <t t-esc="item.label" />
                            <code class="ms-1 small" t-esc="item.name" />
                        </label>
                    </div>
                    <div class="form-check">
                        <input
                            id="o_erplibre_studio_definition_create"
                            type="radio"
                            class="form-check-input o_erplibre_studio_properties_create"
                            name="o_erplibre_studio_properties_definition"
                            value="create"
                            t-att-checked="state.mode === 'create'"
                            t-att-disabled="state.saving"
                            t-on-change="() => this.setMode('create')"
                        />
                        <label class="form-check-label" for="o_erplibre_studio_definition_create" t-esc="createLabel" />
                    </div>
                    <div t-if="state.mode === 'create'" class="ms-4 mt-1">
                        <label class="form-label mb-0" for="o_erplibre_studio_definition_new_name">Technical name</label>
                        <input
                            id="o_erplibre_studio_definition_new_name"
                            class="form-control form-control-sm font-monospace o_erplibre_studio_properties_new_name"
                            t-att-class="{'is-invalid': nameCheck and nameCheck.status !== 'available'}"
                            autocomplete="off"
                            spellcheck="false"
                            t-att-value="state.newName"
                            aria-describedby="o_erplibre_studio_definition_name_status"
                            t-on-input="(ev) => this.setNewName(ev.target.value)"
                        />
                        <div
                            t-if="props.checkName"
                            id="o_erplibre_studio_definition_name_status"
                            class="small mt-1 o_erplibre_studio_properties_name_status"
                            t-att-class="nameCheck ? (nameCheck.status === 'available' ? 'text-success-emphasis' : 'text-danger-emphasis') : 'text-muted'"
                            t-att-data-status="nameCheck ? nameCheck.status : (newNameEmpty ? 'empty' : '')"
                            role="status"
                            aria-live="polite"
                        >
                            <t t-if="newNameEmpty">Type a technical name.</t>
                            <t t-elif="state.nameChecking or !nameCheck">Checking…</t>
                            <t t-else="" t-esc="nameCheck.message" />
                        </div>
                    </div>
                </fieldset>
                <div class="mb-2">
                    <label class="form-label" for="o_erplibre_studio_properties_label">Label</label>
                    <input
                        id="o_erplibre_studio_properties_label"
                        class="form-control form-control-sm o_erplibre_studio_properties_label"
                        aria-required="true"
                        t-model="state.label"
                    />
                </div>
            </t>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary o_erplibre_studio_properties_save"
                    t-att-disabled="!canSave"
                    t-on-click="save"
                >
                    Create
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
