<templates xml:space="preserve">
    <t t-name="erplibre_studio.Editor">
        <div
            class="o_erplibre_studio o_action d-flex flex-column h-100 bg-view"
            t-att-data-view-type="viewType"
            t-att-data-space="state.space"
            t-att-data-level="state.level"
        >
            <header
                class="o_erplibre_studio_toolbar o_erplibre_studio_topbar d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom"
            >
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <span class="o_erplibre_studio_logo d-inline-flex align-items-center justify-content-center rounded text-bg-primary">
                        <i class="fa fa-paint-brush" aria-hidden="true" />
                    </span>
                    <span class="fw-bold">Studio</span>
                    <nav
                        t-if="data.view"
                        class="o_erplibre_studio_title d-flex flex-wrap align-items-center gap-1 small text-muted min-w-0"
                        aria-label="Edited view"
                    >
                        <span class="text-truncate" t-esc="data.model_name" />
                        <i class="fa fa-angle-right" aria-hidden="true" />
                        <span class="text-body fw-bold" t-esc="viewTypeLabel(viewType)" />
                    </nav>
                </div>
                <div
                    t-if="!state.loading and !state.error and viewTabs.length"
                    class="d-flex flex-wrap align-items-center gap-1"
                >
                    <div
                        role="tablist"
                        class="o_erplibre_studio_view_tabs d-flex flex-wrap gap-1 p-1 rounded bg-200"
                        t-att-aria-label="viewTabsLabel"
                    >
                        <button
                            t-foreach="viewTabs"
                            t-as="tab"
                            t-key="tab.type"
                            role="tab"
                            class="btn btn-sm o_erplibre_studio_view_tab"
                            t-att-class="tab.type === viewType ? 'btn-light fw-bold shadow-sm' : 'btn-link text-body'"
                            t-att-aria-selected="tab.type === viewType and state.space === 'view' ? 'true' : 'false'"
                            t-att-data-view-type="tab.type"
                            t-att-disabled="state.busy"
                            t-on-click="() => this.switchViewType(tab.type)"
                        >
                            <t t-esc="tab.label" />
                            <span
                                t-if="tab.added and tab.pending"
                                class="badge text-bg-info ms-1 o_erplibre_studio_view_tab_new"
                                title="Added by the project: Apply creates it"
                            >NEW</span>
                            <span
                                t-if="tab.changes"
                                class="badge rounded-pill text-bg-info ms-1 o_erplibre_studio_view_tab_changes"
                                t-att-title="changesTitle(tab.changes)"
                                t-esc="tab.changes"
                            />
                        </button>
                    </div>
                    <Dropdown t-if="data.view_list" state="menus.views" menuClass="'o_erplibre_studio_view_menu'">
                        <button
                            class="btn btn-sm btn-outline-primary o_erplibre_studio_add_view"
                            aria-haspopup="menu"
                            t-att-disabled="state.busy"
                        >
                            <i class="fa fa-plus me-1" aria-hidden="true" />
                            Add a view
                        </button>
                        <t t-set-slot="content">
                            <div class="dropdown-header d-flex align-items-center gap-2">
                                <span class="fw-bold" t-esc="viewTabsLabel" />
                                <code t-if="detailed" class="o_erplibre_studio_tech" t-esc="data.model" />
                            </div>
                            <div class="dropdown-header small text-uppercase" role="presentation">
                                In the project or the model
                            </div>
                            <button
                                t-foreach="viewTabs"
                                t-as="tab"
                                t-key="tab.type"
                                role="menuitem"
                                class="dropdown-item o-navigable d-flex align-items-center gap-2 o_erplibre_studio_view_menu_open"
                                t-att-data-view-type="tab.type"
                                t-att-disabled="state.busy"
                                t-on-click="() => this.switchViewType(tab.type)"
                            >
                                <span class="d-flex flex-column lh-sm min-w-0">
                                    <span class="d-flex align-items-center gap-1">
                                        <span class="fw-bold" t-esc="tab.label" />
                                        <span
                                            t-if="tab.added"
                                            class="badge text-bg-info o_erplibre_studio_view_menu_tag"
                                            data-origin="project"
                                        >Project</span>
                                        <span
                                            t-else=""
                                            class="badge text-bg-secondary o_erplibre_studio_view_menu_tag"
                                            data-origin="model"
                                        >Model</span>
                                        <span t-if="tab.pending" class="badge text-bg-warning">created by Apply</span>
                                    </span>
                                    <code
                                        t-if="detailed and tab.xml_id"
                                        class="small text-muted text-truncate o_erplibre_studio_tech"
                                        t-esc="tab.xml_id"
                                    />
                                </span>
                                <span class="ms-auto small text-primary">Open</span>
                            </button>
                            <div class="dropdown-divider" role="separator" />
                            <div class="dropdown-header small text-uppercase" role="presentation">To add</div>
                            <t t-foreach="addableViews" t-as="entry" t-key="entry.type">
                                <button
                                    t-if="entry.reason_code === 'no_view'"
                                    role="menuitem"
                                    class="dropdown-item o-navigable d-flex align-items-start gap-2 text-wrap o_erplibre_studio_view_menu_add"
                                    t-att-data-view-type="entry.type"
                                    t-att-disabled="state.busy or !project"
                                    t-att-title="project ? '' : chooseProjectTitle"
                                    t-on-click="() => this.addView(entry.type)"
                                >
                                    <span class="d-flex flex-column lh-sm">
                                        <span class="fw-bold" t-esc="entry.label" />
                                        <span class="small text-muted" t-esc="viewTypeDescription(entry.type)" />
                                        <span class="small text-muted">
                                            Adding creates the default view of this type in the project, then opens it.
                                        </span>
                                        <span
                                            t-if="entry.description"
                                            class="small text-muted o_erplibre_studio_view_menu_creates"
                                            t-esc="entry.description"
                                        />
                                    </span>
                                    <span class="ms-auto align-self-center btn btn-sm btn-primary">Add</span>
                                </button>
                                <div
                                    t-else=""
                                    role="menuitem"
                                    aria-disabled="true"
                                    class="dropdown-item-text d-flex flex-column small o_erplibre_studio_view_menu_unavailable"
                                    t-att-data-view-type="entry.type"
                                    t-att-data-reason="entry.reason_code"
                                >
                                    <span class="d-flex align-items-center gap-1">
                                        <span class="fw-bold" t-esc="entry.label" />
                                        <span t-if="entry.reason_code === 'needs_module'" class="badge text-bg-secondary">
                                            not installed
                                        </span>
                                    </span>
                                    <span class="text-muted" t-esc="entry.reason" />
                                    <span
                                        t-if="viewTypeDescription(entry.type)"
                                        class="text-muted o_erplibre_studio_view_menu_description"
                                        t-esc="viewTypeDescription(entry.type)"
                                    />
                                </div>
                            </t>
                            <p
                                t-if="!addableViews.length"
                                class="dropdown-item-text small text-muted mb-0 o_erplibre_studio_view_menu_none"
                            >
                                Everything the studio edits for this model is already here.
                            </p>
                            <t t-if="unsupportedViews.length">
                                <div class="dropdown-divider" role="separator" />
                                <div class="dropdown-header small text-uppercase" role="presentation">
                                    Not supported by the studio
                                </div>
                                <div
                                    t-foreach="unsupportedViews"
                                    t-as="entry"
                                    t-key="entry.type"
                                    role="menuitem"
                                    aria-disabled="true"
                                    class="dropdown-item-text d-flex flex-column small o_erplibre_studio_view_menu_unavailable"
                                    t-att-data-view-type="entry.type"
                                    t-att-data-reason="entry.reason_code"
                                >
                                    <span class="fw-bold" t-esc="entry.label" />
                                    <span class="text-muted" t-esc="entry.reason" />
                                </div>
                            </t>
                        </t>
                    </Dropdown>
                </div>
                <Dropdown
                    t-if="!state.loading and !state.error"
                    state="menus.project"
                    disabled="state.busy"
                    menuClass="'o_erplibre_studio_project_menu'"
                >
                    <button
                        class="btn btn-sm btn-light border d-flex align-items-center gap-2 text-start o_erplibre_studio_project_select"
                        aria-haspopup="menu"
                        t-att-data-project="state.projectId || ''"
                        t-att-disabled="state.busy"
                    >
                        <i class="fa fa-cube text-primary" aria-hidden="true" />
                        <span class="d-flex flex-column lh-sm">
                            <span t-if="project" class="fw-bold" t-esc="project.name" />
                            <span t-elif="state.projectId === 'new'" class="fw-bold">New project…</span>
                            <span t-else="" class="fw-bold">Choose a project…</span>
                            <span t-if="project" class="small text-muted" t-esc="project.module_name" />
                        </span>
                        <span
                            t-if="project"
                            class="badge rounded-pill o_erplibre_studio_state"
                            t-att-class="project.state === 'draft' ? 'text-bg-info' : 'text-bg-success'"
                            t-att-data-state="project.state"
                            t-esc="project.state_label"
                        />
                    </button>
                    <t t-set-slot="content">
                        <div class="dropdown-header">Projects</div>
                        <button
                            t-foreach="data.projects or []"
                            t-as="item"
                            t-key="item.id"
                            role="menuitemradio"
                            class="dropdown-item o-navigable d-flex align-items-center gap-2 o_erplibre_studio_project_item"
                            t-att-aria-checked="item.id === state.projectId ? 'true' : 'false'"
                            t-att-data-project="item.id"
                            t-on-click="() => this.selectProject(item.id)"
                        >
                            <i
                                class="fa fa-fw"
                                t-att-class="item.id === state.projectId ? 'fa-check' : ''"
                                aria-hidden="true"
                            />
                            <span class="d-flex flex-column lh-sm">
                                <span t-esc="item.name" />
                                <span class="small text-muted" t-esc="item.module_name" />
                            </span>
                        </button>
                        <div class="dropdown-divider" role="separator" />
                        <button
                            role="menuitem"
                            class="dropdown-item o-navigable o_erplibre_studio_project_item"
                            data-project="new"
                            t-on-click="() => this.selectProject('new')"
                        >
                            <i class="fa fa-fw fa-plus" aria-hidden="true" />
                            New project…
                        </button>
                        <button
                            role="menuitem"
                            class="dropdown-item o-navigable o_erplibre_studio_project_item"
                            data-project=""
                            t-on-click="() => this.selectProject('')"
                        >
                            <i class="fa fa-fw" aria-hidden="true" />
                            Without a project
                        </button>
                    </t>
                </Dropdown>
                <!-- The display level: Simple shows the view as a user sees
                     it, Detailed adds its technical names. The note sits
                     under the switch: the top bar stays on one line. -->
                <div
                    t-if="!state.loading and !state.error"
                    class="o_erplibre_studio_level_box d-flex flex-column align-items-center"
                >
                    <div
                        role="group"
                        class="o_erplibre_studio_level d-inline-flex gap-1 p-1 rounded bg-200"
                        aria-label="Display level of the editor"
                    >
                        <button
                            type="button"
                            class="btn btn-sm o_erplibre_studio_level_option"
                            t-att-class="state.level === 'simple' ? 'btn-light fw-bold shadow-sm text-primary' : 'btn-link text-body'"
                            data-level="simple"
                            t-att-aria-pressed="state.level === 'simple' ? 'true' : 'false'"
                            t-on-click="() => this.setLevel('simple')"
                        >
                            Simple
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm o_erplibre_studio_level_option"
                            t-att-class="state.level === 'detailed' ? 'btn-light fw-bold shadow-sm text-primary' : 'btn-link text-body'"
                            data-level="detailed"
                            t-att-aria-pressed="state.level === 'detailed' ? 'true' : 'false'"
                            t-on-click="() => this.setLevel('detailed')"
                        >
                            Detailed
                        </button>
                    </div>
                    <span class="text-muted o_erplibre_studio_level_note">Remembered for your account</span>
                </div>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-1">
                    <t t-if="project">
                        <button
                            class="btn btn-sm btn-light border o_erplibre_studio_undo"
                            t-att-disabled="state.busy or !data.changes.length"
                            title="Remove the last change of this view (Ctrl+Z)"
                            aria-label="Remove the last change of this view"
                            aria-keyshortcuts="Control+Z"
                            t-on-click="() => this.projectAction('action_undo')"
                        >
                            <i class="fa fa-undo" aria-hidden="true" />
                        </button>
                        <button
                            class="btn btn-sm o_erplibre_studio_preview_toggle"
                            t-att-class="previewOn ? 'btn-primary' : 'btn-light border'"
                            t-att-aria-pressed="previewOn ? 'true' : 'false'"
                            t-att-title="data.view and data.view.pending ? pendingPreviewTitle : draftPreviewTitle"
                            t-att-disabled="state.busy"
                            t-on-click="togglePreview"
                        >
                            <i class="fa fa-eye me-1" aria-hidden="true" />
                            Preview
                        </button>
                        <div class="btn-group o_erplibre_studio_apply_group">
                            <button
                                class="btn btn-sm btn-primary o_erplibre_studio_apply_bar"
                                t-att-disabled="state.busy or project.state !== 'draft' or !project.item_count or nameBlockerCount"
                                t-att-title="applyBarTitle"
                                t-on-click="applyFromBar"
                            >
                                Apply
                                <span
                                    class="badge rounded-pill text-bg-light ms-1 o_erplibre_studio_apply_count"
                                    t-esc="changeCount"
                                />
                            </button>
                            <Dropdown state="menus.apply" position="'bottom-end'" disabled="state.busy">
                                <button
                                    class="btn btn-sm btn-primary dropdown-toggle-split o_erplibre_studio_apply_menu"
                                    aria-haspopup="menu"
                                    aria-label="Other actions of the project"
                                    title="Other actions of the project"
                                    t-att-disabled="state.busy"
                                >
                                    <i class="fa fa-caret-down" aria-hidden="true" />
                                </button>
                                <t t-set-slot="content">
                                    <button
                                        role="menuitem"
                                        class="dropdown-item o-navigable o_erplibre_studio_discard"
                                        t-att-disabled="state.busy or project.state !== 'draft'"
                                        title="Back to the changes of the last Apply"
                                        t-on-click="() => this.runApplyMenu('discard')"
                                    >
                                        <i class="fa fa-fw fa-eraser" aria-hidden="true" />
                                        Discard
                                    </button>
                                    <button
                                        role="menuitem"
                                        class="dropdown-item o-navigable text-danger o_erplibre_studio_revert"
                                        t-att-disabled="state.busy or !canRevert"
                                        title="Remove from the database everything the project created, once confirmed"
                                        t-on-click="() => this.runApplyMenu('revert')"
                                    >
                                        <i class="fa fa-fw fa-history" aria-hidden="true" />
                                        Revert
                                    </button>
                                    <div class="dropdown-divider" role="separator" />
                                    <button
                                        t-if="data.spreadsheet_available and spreadsheetViewType"
                                        role="menuitem"
                                        class="dropdown-item o-navigable o_erplibre_studio_send_spreadsheet"
                                        t-att-disabled="state.busy or !viewApplied"
                                        title="Create a spreadsheet that reads the data of this view"
                                        t-on-click="() => this.runApplyMenu('spreadsheet')"
                                    >
                                        <i class="fa fa-fw fa-table" aria-hidden="true" />
                                        Send to a spreadsheet
                                    </button>
                                    <button
                                        role="menuitem"
                                        class="dropdown-item o-navigable o_erplibre_studio_open_project"
                                        title="Open the form of the project"
                                        t-on-click="() => this.runApplyMenu('project')"
                                    >
                                        <i class="fa fa-fw fa-cube" aria-hidden="true" />
                                        Open the project
                                    </button>
                                </t>
                            </Dropdown>
                        </div>
                    </t>
                    <button
                        class="btn btn-sm btn-link text-body o_erplibre_studio_close"
                        title="Close the studio"
                        aria-label="Close the studio"
                        t-on-click="close"
                    >
                        <i class="fa fa-times fa-lg" aria-hidden="true" />
                    </button>
                </div>
            </header>
            <div
                t-if="!state.loading and !state.error and (state.projectId === 'new' or !(data.projects or []).length)"
                class="o_erplibre_studio_new_project d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom bg-light"
            >
                <span>A project makes one module:</span>
                <input
                    class="form-control form-control-sm w-auto o_erplibre_studio_new_name"
                    placeholder="Project name"
                    t-model="state.newProject.name"
                />
                <input
                    class="form-control form-control-sm w-auto o_erplibre_studio_new_module"
                    placeholder="technical_name"
                    t-model="state.newProject.module_name"
                />
                <button class="btn btn-sm btn-primary o_erplibre_studio_create_project" t-on-click="createProject">
                    Create
                </button>
            </div>
            <div t-if="state.loading" class="p-3 text-muted">
                <i class="fa fa-spinner fa-spin" />
                Loading…
            </div>
            <div t-elif="state.error" class="alert alert-warning m-3 o_erplibre_studio_error" t-esc="state.error" />
            <div t-else="" class="d-flex flex-grow-1 overflow-hidden">
                <nav class="o_erplibre_studio_rail d-flex flex-column gap-1 p-1 border-end" aria-label="Studio spaces">
                    <button
                        t-foreach="spaces"
                        t-as="space"
                        t-key="space.id"
                        class="btn btn-sm d-flex flex-column align-items-center gap-1 o_erplibre_studio_rail_item"
                        t-att-class="space.id === state.space ? 'btn-light text-primary fw-bold o_erplibre_studio_rail_active' : 'btn-link text-body'"
                        t-att-data-space="space.id"
                        t-att-aria-current="space.id === state.space ? 'page' : false"
                        t-att-title="space.disabled ? chooseProjectTitle : ''"
                        t-att-disabled="space.disabled or state.busy"
                        t-on-click="() => this.openSpace(space.id)"
                    >
                        <i class="fa fa-lg" t-att-class="space.icon" aria-hidden="true" />
                        <span class="small" t-esc="space.label" />
                        <span
                            t-if="space.count"
                            class="badge rounded-pill text-bg-info o_erplibre_studio_rail_count"
                            t-esc="space.count"
                        />
                    </button>
                </nav>
                <t t-if="state.space === 'view'">
                    <aside
                        class="o_erplibre_studio_palette o_erplibre_studio_left d-flex flex-column border-end"
                        aria-label="Panel of the view"
                    >
                        <div
                            role="tablist"
                            class="o_erplibre_studio_left_tabs d-flex gap-1 p-1 m-2 mb-0 rounded bg-200"
                            aria-label="Panel of the view"
                        >
                            <button
                                role="tab"
                                class="btn btn-sm flex-grow-1 o_erplibre_studio_left_tab"
                                t-att-class="state.leftTab === 'palette' ? 'btn-light fw-bold shadow-sm' : 'btn-link text-body'"
                                data-panel="palette"
                                t-att-aria-selected="state.leftTab === 'palette' ? 'true' : 'false'"
                                t-on-click="() => this.setLeftTab('palette')"
                            >
                                Palette
                            </button>
                            <button
                                role="tab"
                                class="btn btn-sm flex-grow-1 o_erplibre_studio_left_tab"
                                t-att-class="state.leftTab === 'plan' ? 'btn-light fw-bold shadow-sm' : 'btn-link text-body'"
                                data-panel="plan"
                                t-att-aria-selected="state.leftTab === 'plan' ? 'true' : 'false'"
                                t-on-click="() => this.setLeftTab('plan')"
                            >
                                Plan
                                <span
                                    t-if="viewChangeCount"
                                    class="badge rounded-pill text-bg-info ms-1 o_erplibre_studio_plan_count"
                                    t-esc="viewChangeCount"
                                />
                            </button>
                        </div>
                        <div role="tabpanel" class="flex-grow-1 overflow-auto p-2">
                            <div
                                t-if="state.leftTab === 'palette' and previewOn"
                                class="o_erplibre_studio_palette_paused border rounded p-3 small bg-200"
                                role="status"
                            >
                                <div class="fw-bold mb-1">
                                    <i class="fa fa-pause-circle me-1" aria-hidden="true" />
                                    Palette paused
                                </div>
                                The preview shows the view as a user sees it. Leave the preview to drag fields.
                            </div>
                            <StudioPalette
                                t-elif="state.leftTab === 'palette'"
                                editor="editor"
                                data="data"
                                viewType="viewType"
                                palette="state.palette"
                            />
                            <StudioOutline
                                t-else=""
                                editor="editor"
                                data="data"
                                viewType="viewType"
                                selected="state.selected"
                                outline="state.outline"
                            />
                        </div>
                    </aside>
                    <main
                        class="o_erplibre_studio_canvas flex-grow-1 overflow-auto p-3"
                        t-att-class="{'o_erplibre_studio_busy': state.busy}"
                        t-on-click="onCanvasClick"
                        t-on-keydown="onCanvasKey"
                        t-on-dragover="() => editor.overCanvas()"
                        t-on-dragleave="(ev) => editor.leaveCanvas(ev)"
                    >
                        <t t-if="panel" t-call="erplibre_studio.Panel.{{panel}}" />
                        <t t-elif="state.preview" t-call="erplibre_studio.ViewPreview" />
                        <t t-else="">
                            <div
                                t-if="addedView"
                                role="status"
                                class="alert alert-info d-flex flex-wrap align-items-center gap-2 py-2 small o_erplibre_studio_added_banner"
                                t-att-data-applied="addedView.applied ? 'true' : 'false'"
                            >
                                <i class="fa fa-check-circle" aria-hidden="true" />
                                <span class="flex-grow-1" t-esc="addedViewNotice" />
                                <code t-if="detailed" class="small o_erplibre_studio_tech" t-esc="addedView.xml_id" />
                                <button
                                    class="btn btn-sm btn-outline-danger o_erplibre_studio_remove_view"
                                    t-att-disabled="state.busy"
                                    t-on-click.stop="removeAddedView"
                                >
                                    Remove from the draft
                                </button>
                            </div>
                            <!-- The focus on a block of a form: the bar that says
                                 which block and leaves it, else the bar of the
                                 full form that goes back to the last one. -->
                            <div
                                t-if="focusEntry"
                                class="o_erplibre_studio_focus_bar d-flex flex-wrap align-items-center gap-2 mb-2"
                            >
                                <span class="o_erplibre_studio_focus_badge d-inline-flex align-items-center gap-1">
                                    <i class="fa fa-crosshairs" aria-hidden="true" />
                                    Focus
                                </span>
                                <nav
                                    class="o_erplibre_studio_focus_path d-flex flex-wrap align-items-center gap-1 min-w-0"
                                    aria-label="Path of the block in focus"
                                >
                                    <button
                                        type="button"
                                        class="btn btn-link btn-sm p-1 o_erplibre_studio_focus_form"
                                        t-on-click.stop="() => this.leaveFocus()"
                                        t-esc="viewTypeLabel(viewType)"
                                    />
                                    <t t-foreach="focusCrumbs" t-as="crumb" t-key="crumb.key">
                                        <i class="fa fa-angle-right" aria-hidden="true" />
                                        <span
                                            class="o_erplibre_studio_focus_crumb"
                                            t-att-class="{'fw-bold text-body': crumb_last}"
                                            t-att-aria-current="crumb_last ? 'location' : false"
                                            t-esc="crumb.label"
                                        />
                                    </t>
                                </nav>
                                <span class="o_erplibre_studio_focus_esc ms-auto d-inline-flex align-items-center gap-1">
                                    <kbd>Esc</kbd>
                                    <span>to leave</span>
                                </span>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-light border o_erplibre_studio_focus_leave"
                                    t-on-click.stop="() => this.leaveFocus()"
                                >
                                    <i class="fa fa-times me-1" aria-hidden="true" />
                                    Leave focus
                                </button>
                            </div>
                            <div
                                t-elif="focusLastEntry"
                                class="o_erplibre_studio_full_bar d-flex flex-wrap align-items-center gap-2 mb-2"
                            >
                                <span class="fw-bold">Full form</span>
                                ·
                                <span class="o_erplibre_studio_full_text">all blocks open</span>
                                <button
                                    type="button"
                                    class="btn btn-sm ms-auto o_erplibre_studio_full_back"
                                    t-on-click.stop="() => this.backToFocus()"
                                >
                                    <i class="fa fa-crosshairs me-1" aria-hidden="true" />
                                    <t t-esc="focusBackLabel" />
                                </button>
                            </div>
                            <nav
                                class="o_erplibre_studio_crumbs d-flex flex-wrap align-items-center gap-1 small text-muted mb-2"
                                aria-label="Path of the selection"
                            >
                                <span t-esc="viewTypeLabel(viewType)" />
                                <t t-foreach="selectionTrail" t-as="crumb" t-key="crumb.path">
                                    <i class="fa fa-angle-right" aria-hidden="true" />
                                    <button
                                        class="btn btn-sm btn-link p-0 o_erplibre_studio_crumb"
                                        t-att-class="crumb_last ? 'text-body fw-bold' : 'text-muted'"
                                        t-att-data-path="crumb.path"
                                        t-att-aria-current="crumb_last ? 'location' : false"
                                        t-on-click.stop="() => this.reveal(crumb.path)"
                                        t-esc="crumb.label"
                                    />
                                </t>
                                <span
                                    t-if="detailed"
                                    class="o_erplibre_studio_tech o_erplibre_studio_crumbs_tech ms-auto d-inline-flex flex-wrap align-items-center gap-2 min-w-0"
                                >
                                    <code
                                        class="o_erplibre_studio_xml_id text-truncate"
                                        t-att-title="data.view.xml_id or data.view.name"
                                        t-esc="data.view.xml_id or data.view.name"
                                    />
                                    <span
                                        t-if="inheritedText"
                                        class="o_erplibre_studio_inherited"
                                        t-esc="inheritedText"
                                    />
                                </span>
                            </nav>
                            <StudioCanvas
                                editor="editor"
                                data="data"
                                viewType="viewType"
                                project="project"
                                busy="state.busy"
                                dragging="state.dragging"
                                hook="state.hook"
                                dropScope="state.dropScope"
                                hookNear="state.hookNear"
                                template="state.template"
                                filterForm="state.filterForm"
                                lane="state.timelineLane"
                                geoLayer="state.geoLayer"
                                focus="focusEntry ? focusEntry.path : null"
                                level="state.level"
                            />
                        </t>
                    </main>
                    <aside class="o_erplibre_studio_sidebar border-start d-flex flex-column" aria-label="Inspector">
                        <StudioInspector
                            editor="editor"
                            data="data"
                            viewType="viewType"
                            selected="state.selected"
                            busy="state.busy"
                            colors="state.colors"
                            comodels="state.comodels"
                            tab="state.inspectorTab"
                            hasProject="!!project"
                            lane="['timeline', 'calendar', 'leaflet_map'].includes(viewType) ? state.timelineLane : null"
                            preview="previewInfo"
                            geoLayer="viewType === 'geoengine' ? state.geoLayer : null"
                        />
                    </aside>
                </t>
                <t t-elif="state.space === 'security'">
                    <StudioSecuritySpace
                        t-if="project and panel"
                        editor="editor"
                        project="project"
                        choices="state.choices"
                        tab="panel"
                        busy="state.busy"
                    />
                </t>
                <t t-elif="state.space === 'models'">
                    <StudioModelsSpace
                        t-if="project"
                        editor="editor"
                        project="project"
                        screenModel="params.resModel or false"
                        mailAvailable="!!data.mail_available"
                        busy="state.busy"
                    />
                </t>
                <t t-else="">
                    <StudioReview
                        t-if="project"
                        t-key="reviewKey"
                        editor="editor"
                        project="project"
                        busy="state.busy"
                    />
                </t>
            </div>
            <!-- What the keyboard did to a block (announce): rendered always,
                 so that a screen reader hears its text change. -->
            <div class="visually-hidden o_erplibre_studio_live" aria-live="polite" aria-atomic="true" t-esc="state.announce" />
            <footer
                t-if="!state.loading and !state.error"
                class="o_erplibre_studio_status d-flex flex-wrap align-items-center gap-3 px-3 py-1 border-top small"
                role="status"
            >
                <t t-if="project">
                    <span class="d-inline-flex align-items-center gap-1 o_erplibre_studio_status_state">
                        <i
                            class="fa fa-circle small"
                            t-att-class="project.state === 'draft' ? 'text-info' : 'text-success'"
                            aria-hidden="true"
                        />
                        <t t-esc="statusText" />
                    </span>
                    <span t-if="focusStatus" class="o_erplibre_studio_status_focus" t-esc="focusStatus" />
                    <span
                        t-if="nameBlockerCount"
                        class="fw-bold text-danger-emphasis o_erplibre_studio_name_blockers"
                        t-esc="nameBlockerText"
                    />
                    <span t-if="previewLabel" class="o_erplibre_studio_status_preview" t-esc="previewLabel" />
                    <span class="ms-auto o_erplibre_studio_status_applied" t-esc="appliedText" />
                </t>
                <span t-else="" class="text-muted">No project: the edits need a project.</span>
            </footer>
        </div>
    </t>

    <!-- The preview of a view of the database with the draft: a banner
         that says how it renders, the view types of the model, the view. -->
    <t t-name="erplibre_studio.ViewPreview">
        <div class="o_erplibre_studio_view_preview d-flex flex-column gap-3">
            <section
                class="o_erplibre_studio_preview_banner border rounded p-3 d-flex flex-wrap align-items-start gap-3 bg-info-subtle border-info-subtle text-info-emphasis"
                data-kind="view"
                aria-label="Mode of the preview"
            >
                <i class="fa fa-eye fa-lg mt-1" aria-hidden="true" />
                <div class="flex-grow-1 min-w-0">
                    <h2 class="h6 mb-1 o_erplibre_studio_preview_title">The view with the draft</h2>
                    <p class="mb-0 small">
                        The server renders this view with the draft of the project, on the records of the database. Nothing is saved: the form opens read-only.
                    </p>
                </div>
                <button
                    type="button"
                    class="btn-close o_erplibre_studio_preview_close"
                    aria-label="Leave the preview"
                    title="Leave the preview"
                    t-on-click="leavePreview"
                />
            </section>
            <section aria-label="Render of the preview">
                <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
                    <div class="nav nav-tabs flex-grow-1" role="tablist" aria-label="View of the preview">
                        <button
                            t-foreach="viewTabs"
                            t-as="tab"
                            t-key="tab.type"
                            type="button"
                            role="tab"
                            class="nav-link py-1 px-2 o_erplibre_studio_preview_type"
                            t-att-class="{'active': tab.type === viewType}"
                            t-att-aria-selected="tab.type === viewType ? 'true' : 'false'"
                            t-att-data-view-type="tab.type"
                            t-att-disabled="state.busy"
                            t-on-click="() => this.switchViewType(tab.type)"
                            t-esc="tab.label"
                        />
                    </div>
                    <span class="small text-muted">Records of the database, as you read them</span>
                </div>
                <div class="o_erplibre_studio_preview border rounded">
                    <View t-props="previewProps" t-key="previewKey" />
                </div>
            </section>
        </div>
    </t>
</templates>
