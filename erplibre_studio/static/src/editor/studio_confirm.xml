<templates xml:space="preserve">
    <!-- What an action removes from the database, section by section, then
         the action; a refusal of the server replaces its button. -->
    <t t-name="erplibre_studio.ConfirmDialog">
        <Dialog title="props.title" size="'lg'" contentClass="'o_erplibre_studio_confirm_dialog'">
            <div
                t-if="state.stale"
                class="alert alert-warning o_erplibre_studio_confirm_stale"
                role="alert"
            >
                What the action removes changed since it was shown: check it again before confirming.
            </div>
            <div
                t-if="state.refused"
                class="alert alert-danger o_erplibre_studio_confirm_refused"
                role="alert"
                t-esc="state.refused"
            />
            <p t-esc="props.intro" />
            <div t-if="!sections.length and !changesRemoved" class="text-muted o_erplibre_studio_confirm_empty">
                Nothing.
            </div>
            <section
                t-foreach="sections"
                t-as="section"
                t-key="section.key"
                class="o_erplibre_studio_confirm_section mb-2"
                t-att-data-section="section.key"
            >
                <h6 class="mb-1">
                    <t t-esc="section.title" />
                    <span
                        class="badge text-bg-light ms-1 o_erplibre_studio_confirm_count"
                        t-esc="section.items.length"
                    />
                </h6>
                <ul class="mb-1 small">
                    <li
                        t-foreach="section.items"
                        t-as="item"
                        t-key="item_index"
                        class="o_erplibre_studio_confirm_item"
                        t-att-class="{'text-danger fw-bold': item.warn}"
                        t-esc="item.text"
                    />
                </ul>
            </section>
            <p t-if="changesRemoved" class="small o_erplibre_studio_confirm_changes" t-esc="changesText" />
            <t t-set-slot="footer">
                <button
                    t-if="!state.refused"
                    class="btn btn-danger o_erplibre_studio_confirm_button"
                    t-att-disabled="state.running"
                    t-on-click="confirm"
                    t-esc="props.confirmLabel"
                />
                <button class="btn btn-secondary o_erplibre_studio_confirm_cancel" t-on-click="props.close">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <!-- The undo of one change with the changes that depend on it. The
         cancel button does not read « Cancel »: in French it would read
         like the action itself. -->
    <t t-name="erplibre_studio.ChangeRemovalDialog">
        <Dialog title.translate="Undo a change" size="'md'" contentClass="'o_erplibre_studio_change_removal_dialog'">
            <p t-esc="intro" />
            <ul t-if="items.length" class="small o_erplibre_studio_change_removal_items">
                <li
                    t-foreach="items"
                    t-as="item"
                    t-key="item.id"
                    class="o_erplibre_studio_change_removal_item"
                    t-att-data-id="item.id"
                >
                    <t t-esc="item.sentence or item.summary" />
                    <!-- At the Simple level (removal.plain), the name of
                         the view of another view for a reader, nothing for
                         this one; else the code of the view. -->
                    <t t-if="!props.removal.plain"> · <code class="text-muted o_erplibre_studio_change_removal_view" t-esc="item.view" /></t>
                    <t t-elif="item.place"> · <span class="text-muted o_erplibre_studio_change_removal_view" t-esc="item.place" /></t>
                    <t t-if="item.applied"> · <span class="badge text-bg-secondary">applied</span></t>
                </li>
            </ul>
            <div
                t-if="appliedNote"
                class="alert alert-warning small mb-0 o_erplibre_studio_change_removal_applied"
                role="alert"
                t-esc="appliedNote"
            />
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary o_erplibre_studio_change_removal_confirm"
                    t-att-disabled="state.running"
                    t-on-click="confirm"
                    t-esc="confirmLabel"
                />
                <button class="btn btn-secondary o_erplibre_studio_change_removal_cancel" t-on-click="props.close">
                    Change nothing
                </button>
            </t>
        </Dialog>
    </t>
</templates>
