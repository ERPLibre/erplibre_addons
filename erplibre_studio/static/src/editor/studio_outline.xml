<templates xml:space="preserve">
    <!-- The plan of the view: a filter, « All | Modified », the tree of
         its blocks, the legend of its marks. -->
    <t t-name="erplibre_studio.Outline">
        <t t-set="shown" t-value="result" />
        <div class="o_erplibre_studio_outline d-flex flex-column gap-2 h-100">
            <div class="input-group input-group-sm">
                <span class="input-group-text">
                    <i class="fa fa-search" aria-hidden="true" />
                </span>
                <input
                    type="text"
                    class="form-control o_erplibre_studio_outline_filter"
                    t-att-placeholder="filterPlaceholder"
                    aria-label="Filter the plan"
                    t-model="outline.filter"
                />
                <button
                    t-if="outline.filter"
                    class="btn btn-outline-secondary o_erplibre_studio_outline_clear"
                    title="Clear the filter"
                    aria-label="Clear the filter"
                    t-on-click="clearFilter"
                >
                    <i class="fa fa-times" aria-hidden="true" />
                </button>
            </div>
            <div class="d-flex align-items-center gap-1">
                <div role="group" class="d-flex gap-1" aria-label="Show">
                    <button
                        class="btn btn-sm rounded-pill py-0 o_erplibre_studio_outline_all"
                        t-att-class="outline.changedOnly ? 'btn-outline-secondary' : 'btn-primary'"
                        t-att-aria-pressed="outline.changedOnly ? 'false' : 'true'"
                        t-on-click="() => this.showChanged(false)"
                    >
                        All
                    </button>
                    <button
                        class="btn btn-sm rounded-pill py-0 o_erplibre_studio_outline_changed"
                        t-att-class="outline.changedOnly ? 'btn-primary' : 'btn-outline-secondary'"
                        t-att-aria-pressed="outline.changedOnly ? 'true' : 'false'"
                        t-on-click="() => this.showChanged(true)"
                    >
                        Modified ·
                        <t t-esc="changeCount" />
                    </button>
                </div>
                <span class="ms-auto small text-muted o_erplibre_studio_outline_count" t-esc="countLabel(shown)" />
            </div>
            <t t-set="active" t-value="activePath(shown.rows)" />
            <ul role="tree" class="list-unstyled mb-0 o_erplibre_studio_outline_tree" t-att-aria-label="treeLabel">
                <li
                    t-foreach="shown.rows"
                    t-as="row"
                    t-key="row.block.path"
                    role="treeitem"
                    class="o_erplibre_studio_outline_row d-flex align-items-center rounded"
                    t-att-class="{
                        'o_erplibre_studio_outline_selected': row.block.path === props.selected,
                        'o_erplibre_studio_outline_context': row.context,
                        'o_erplibre_studio_outline_removed': isGhost(row.block),
                        'o_erplibre_studio_outline_focus': isFocused(row.block),
                    }"
                    t-att-style="'padding-left: ' + (row.depth * 0.75) + 'rem'"
                    t-att-aria-level="row.depth + 1"
                    t-att-aria-selected="row.block.path === props.selected ? 'true' : 'false'"
                    t-att-aria-expanded="isContainer(row.block) ? (row.open ? 'true' : 'false') : undefined"
                    t-att-data-path="row.block.path"
                    t-att-data-kind="row.block.kind"
                    t-att-data-name="row.block.name"
                    t-att-tabindex="row.block.path === active ? '0' : '-1'"
                    t-on-keydown="(ev) => this.onTreeKey(ev, row, shown.rows)"
                    t-on-focus="() => this.state.focus = row.block.path"
                >
                    <button
                        t-if="isContainer(row.block)"
                        class="btn btn-sm btn-link text-body p-0 o_erplibre_studio_outline_toggle"
                        tabindex="-1"
                        t-att-aria-label="toggleLabel(row)"
                        t-att-title="toggleLabel(row)"
                        t-att-aria-expanded="row.open ? 'true' : 'false'"
                        t-att-disabled="filtering"
                        t-on-click="() => this.toggle(row)"
                    >
                        <i class="fa fa-fw" t-att-class="row.open ? 'fa-angle-down' : 'fa-angle-right'" aria-hidden="true" />
                    </button>
                    <span t-else="" class="o_erplibre_studio_outline_spacer" aria-hidden="true" />
                    <!-- A div, not a button: a mousedown on a button starts no
                         drag in Firefox. The keys are those of the row. -->
                    <div
                        class="btn btn-sm d-flex align-items-center gap-1 flex-grow-1 min-w-0 text-start px-1 o_erplibre_studio_outline_pick"
                        tabindex="-1"
                        t-att-class="{'fw-bold': isContainer(row.block) and !row.context}"
                        t-att-draggable="canDrag(row.block) ? 'true' : 'false'"
                        t-att-title="detailed and row.block.name ? row.block.name : false"
                        t-on-click="() => this.pick(row.block)"
                        t-on-dragstart="(ev) => this.startDrag(ev, row.block)"
                        t-on-dragend="() => this.endDrag()"
                    >
                        <span
                            class="o_erplibre_studio_glyph"
                            t-att-class="{'o_erplibre_studio_glyph_container': isContainer(row.block)}"
                            aria-hidden="true"
                            t-esc="glyph(row.block)"
                        />
                        <t t-set="technical" t-value="detailed and technicalName(row.block)" />
                        <span t-if="technical" class="d-flex flex-column flex-grow-1 min-w-0 lh-sm">
                            <span class="text-truncate o_erplibre_studio_outline_label" t-esc="label(row.block)" />
                            <code
                                class="small text-muted text-truncate fw-normal o_erplibre_studio_tech o_erplibre_studio_outline_tech"
                                t-esc="technical"
                            />
                        </span>
                        <span t-else="" class="text-truncate flex-grow-1 o_erplibre_studio_outline_label" t-esc="label(row.block)" />
                        <span
                            t-if="isContainer(row.block) and count(row.block)"
                            class="small text-muted fw-normal"
                            t-esc="count(row.block)"
                        />
                        <span
                            t-if="detailed and row.block.changed"
                            class="small fw-bold text-info-emphasis o_erplibre_studio_outline_tag"
                            t-esc="changeLabel(row.block)"
                        />
                        <!-- The folded container: how many changes it holds. -->
                        <t t-set="holds" t-value="holdsCount(row)" />
                        <span
                            t-if="holds"
                            role="img"
                            class="o_erplibre_studio_margin_count o_erplibre_studio_outline_holds"
                            t-att-aria-label="holdsLabel(holds)"
                            t-att-title="holdsLabel(holds)"
                            t-esc="holds"
                        />
                        <!-- The dot of the row's own change, as on the canvas:
                             filled, or a ring for a change that hides; its
                             kinds as text for a screen reader. -->
                        <t t-set="dot" t-value="rowDot(row.block)" />
                        <t t-if="dot">
                            <span class="o_erplibre_studio_margin_dot" t-att-data-dot="dot.dot" aria-hidden="true" />
                            <span class="visually-hidden o_erplibre_studio_outline_dot_text" t-esc="dot.label" />
                        </t>
                    </div>
                    <!-- The « + » of the row (rowAdds): out of the tab
                         order, Insert reaches the list from the row. -->
                    <button
                        t-foreach="rowAdds(row)"
                        t-as="add"
                        t-key="add.kind"
                        type="button"
                        tabindex="-1"
                        class="btn btn-sm o_erplibre_studio_outline_add"
                        t-att-class="{'o_erplibre_studio_outline_add_shown': add.kind === 'after' or add.open}"
                        t-att-data-add="add.kind"
                        t-att-aria-label="add.label"
                        t-att-title="add.label"
                        t-att-aria-haspopup="add.kind === 'tab' ? false : 'dialog'"
                        t-att-aria-expanded="add.kind === 'tab' ? false : (add.open ? 'true' : 'false')"
                        t-on-click.stop="() => this.runAdd(add, row.block)"
                    >
                        <i class="fa fa-plus" aria-hidden="true" />
                    </button>
                </li>
            </ul>
            <p t-if="!shown.rows.length" class="small text-muted mb-0 o_erplibre_studio_outline_empty" t-esc="emptyLabel" />
            <div class="small text-muted border-top pt-2 mt-auto">
                <p class="mb-1 o_erplibre_studio_outline_legend">
                    Filled dot: added or modified. Ring: hidden or removed. Number: changes folded inside the block.
                </p>
                <p class="mb-0">
                    A click selects the element on the canvas. Drag a row, or press Alt+Up or Alt+Down, to move it.
                </p>
                <p t-if="props.viewType === 'form'" class="mb-0 mt-1 o_erplibre_studio_outline_insert_help">
                    The + of a row opens the same list as the margin of the form: after the selected element, or at the end of a container. Insert opens it from the keyboard.
                </p>
            </div>
        </div>
    </t>
</templates>
