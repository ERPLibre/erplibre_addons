<templates xml:space="preserve">
    <!-- The palette: a search box, then a section per kind of item; the
         heading of a section carries « data-tab » (new, existing, layout,
         other). An item is a draggable div around a button: the button is
         the tab stop and takes Enter and Space, whose click bubbles to the
         single click handler of the div; it takes no pointer event, so
         the mouse reaches the div and a drag starts in every browser. -->
    <t t-name="erplibre_studio.Palette">
        <div class="o_erplibre_studio_palette_body d-flex flex-column gap-3 h-100">
            <!-- With the focus on a block of a form: where a click adds. -->
            <t t-set="target" t-value="focusTarget" />
            <div t-if="target" class="o_erplibre_studio_palette_target border rounded p-2 d-flex flex-column gap-1" role="status">
                <span class="o_erplibre_studio_section_title">Additions go into</span>
                <span class="o_erplibre_studio_palette_target_block d-flex align-items-center gap-2 fw-bold">
                    <i class="fa fa-crosshairs" aria-hidden="true" />
                    <t t-esc="target.block" />
                </span>
                <span class="small o_erplibre_studio_palette_target_where" t-esc="target.where" />
                <span class="small text-muted">A click adds at the insertion point; dragging still works.</span>
            </div>
            <div class="input-group input-group-sm">
                <span class="input-group-text">
                    <i class="fa fa-search" aria-hidden="true" />
                </span>
                <input
                    type="text"
                    class="form-control o_erplibre_studio_palette_filter"
                    placeholder="Search a field or a type"
                    aria-label="Search the palette"
                    t-model="palette.filter"
                />
            </div>
            <section t-if="allows('add_field')" class="o_erplibre_studio_palette_section">
                <h2 class="o_erplibre_studio_section_title mb-2" data-tab="new">New fields</h2>
                <div class="o_erplibre_studio_type_grid">
                    <div
                        t-foreach="shownTypes"
                        t-as="item"
                        t-key="item.ttype"
                        class="o_erplibre_studio_palette_item o_erplibre_studio_new_field d-flex align-items-center gap-2 border rounded px-2 py-1"
                        t-att-data-type="item.ttype"
                        t-att-title="item.label"
                        draggable="true"
                        t-on-dragstart="(ev) => this.startDrag(ev, {kind: 'new', ttype: item.ttype})"
                        t-on-dragend="() => this.endDrag()"
                        t-on-click="() => this.add({kind: 'new', ttype: item.ttype})"
                    >
                        <button
                            type="button"
                            class="o_erplibre_studio_pick o_erplibre_studio_palette_add flex-nowrap gap-2 w-100"
                            t-att-aria-label="itemLabel(item.label)"
                        >
                            <span class="o_erplibre_studio_glyph o_erplibre_studio_glyph_container" aria-hidden="true" t-esc="item.glyph" />
                            <span class="text-truncate" t-esc="item.label" />
                        </button>
                    </div>
                </div>
                <div t-if="query and !shownTypes.length" class="small text-muted">No field type matches.</div>
                <button
                    t-if="foldsTypes"
                    class="btn btn-sm btn-link px-0 o_erplibre_studio_more_types"
                    t-att-aria-expanded="palette.more ? 'true' : 'false'"
                    t-on-click="toggleMore"
                >
                    <t t-if="palette.more">Show fewer types</t>
                    <t t-else="" t-esc="moreTypesLabel" />
                </button>
            </section>
            <section class="o_erplibre_studio_palette_section">
                <button
                    class="btn btn-sm w-100 d-flex align-items-center justify-content-between px-0 o_erplibre_studio_section_toggle"
                    data-tab="existing"
                    t-att-aria-expanded="existingOpen ? 'true' : 'false'"
                    t-on-click="toggleExisting"
                >
                    <span class="o_erplibre_studio_section_title" t-esc="existingLabel" />
                    <i class="fa" t-att-class="existingOpen ? 'fa-angle-down' : 'fa-angle-right'" aria-hidden="true" />
                </button>
                <t t-if="existingOpen">
                    <div t-if="offersInterval" class="mb-2 small">
                        <label class="form-label mb-0" for="o_erplibre_studio_interval">Interval of a date grouping</label>
                        <select
                            id="o_erplibre_studio_interval"
                            class="form-select form-select-sm o_erplibre_studio_interval"
                            t-model="palette.interval"
                        >
                            <option t-foreach="intervals" t-as="item" t-key="item[0]" t-att-value="item[0]" t-esc="item[1]" />
                        </select>
                    </div>
                    <div
                        t-foreach="existingFields"
                        t-as="item"
                        t-key="item.name"
                        class="o_erplibre_studio_palette_item o_erplibre_studio_existing_field d-flex flex-wrap align-items-center gap-1 rounded px-2 py-1 mb-1"
                        t-att-data-name="item.name"
                        t-att-title="detailed ? item.type : false"
                        draggable="true"
                        t-on-dragstart="(ev) => this.startDrag(ev, {kind: 'existing', name: item.name, axes: item.axes, special: item.special})"
                        t-on-dragend="() => this.endDrag()"
                        t-on-click="() => this.add({kind: 'existing', name: item.name, axes: item.axes, special: item.special})"
                    >
                        <button
                            type="button"
                            class="o_erplibre_studio_pick o_erplibre_studio_palette_add gap-1 w-100"
                            t-att-aria-label="existingItemLabel(item)"
                        >
                            <span class="text-truncate flex-grow-1" t-esc="item.string" />
                            <code t-if="detailed" class="small text-muted text-truncate o_erplibre_studio_tech" t-esc="item.name" />
                            <span
                                t-foreach="item.axes or []"
                                t-as="axis"
                                t-key="axis"
                                class="badge text-bg-light o_erplibre_studio_axis_badge"
                                t-esc="axisLabel(axis)"
                            />
                        </button>
                    </div>
                    <div t-if="query and !existingFields.length" class="small text-muted">No field matches.</div>
                    <div class="small text-muted mt-1">The fields already in the view are left out.</div>
                </t>
            </section>
            <section t-if="layoutItems.length" class="o_erplibre_studio_palette_section o_erplibre_studio_layout">
                <h2 class="o_erplibre_studio_section_title mb-2" data-tab="layout">Layout</h2>
                <div
                    t-foreach="layoutItems"
                    t-as="item"
                    t-key="item.kind"
                    class="o_erplibre_studio_palette_item d-flex align-items-center gap-2 border rounded px-2 py-1 mb-1"
                    t-att-class="item.className"
                    t-att-data-kind="item.kind"
                    draggable="true"
                    t-on-dragstart="(ev) => this.startDrag(ev, {kind: item.kind})"
                    t-on-dragend="() => this.endDrag()"
                    t-on-click="() => this.add({kind: item.kind})"
                >
                    <button
                        type="button"
                        class="o_erplibre_studio_pick o_erplibre_studio_palette_add flex-nowrap gap-2 w-100"
                        t-att-aria-label="itemLabel(item.label)"
                    >
                        <i class="fa text-muted" t-att-class="item.icon" aria-hidden="true" />
                        <span t-esc="item.label" />
                    </button>
                </div>
            </section>
            <section t-if="allows('add_widget')" class="o_erplibre_studio_palette_section">
                <h2 class="o_erplibre_studio_section_title mb-2" data-tab="other">Other</h2>
                <label class="small text-muted mb-1" for="o_erplibre_studio_ribbon_title">Ribbon on the card</label>
                <input
                    id="o_erplibre_studio_ribbon_title"
                    class="form-control form-control-sm mb-1 o_erplibre_studio_ribbon_title"
                    placeholder="Ribbon text"
                    t-model="palette.ribbon.title"
                />
                <select
                    class="form-select form-select-sm mb-1 o_erplibre_studio_ribbon_color"
                    aria-label="Ribbon color"
                    t-model="palette.ribbon.bg_color"
                >
                    <option t-foreach="ribbonColors" t-as="color" t-key="color" t-att-value="color" t-esc="color" />
                </select>
                <div
                    class="o_erplibre_studio_palette_item o_erplibre_studio_widget border rounded px-2 py-1 mb-1"
                    data-widget="web_ribbon"
                    draggable="true"
                    t-on-dragstart="(ev) => this.startDrag(ev, {kind: 'widget', widget: 'web_ribbon'})"
                    t-on-dragend="() => this.endDrag()"
                    t-on-click="() => this.add({kind: 'widget', widget: 'web_ribbon'})"
                >
                    <button
                        type="button"
                        class="o_erplibre_studio_pick o_erplibre_studio_palette_add flex-nowrap gap-2 w-100"
                        t-att-aria-label="itemLabel(ribbonLabel)"
                    >
                        <i class="fa fa-bookmark text-muted" aria-hidden="true" />
                        <span>Ribbon</span>
                    </button>
                </div>
            </section>
            <p t-if="viewType === 'timeline'" class="small text-muted border-top pt-2 mt-auto mb-0">
                Drag a date field onto Start date or End date, a many2one or a many2many onto Group by.
            </p>
            <p t-elif="viewType === 'calendar'" class="small text-muted border-top pt-2 mt-auto mb-0">
                Drag a date field onto Start date or End date, a field onto Color, or any field into the popover.
            </p>
            <p t-elif="viewType === 'leaflet_map'" class="small text-muted border-top pt-2 mt-auto mb-0">
                Drag a decimal field onto Latitude or Longitude, a text onto the popup, an image onto Marker image; a new Decimal or Text field dropped on a lane is created for it.
            </p>
            <p t-elif="viewType === 'form' and target" class="small text-muted border-top pt-2 mt-auto mb-0 o_erplibre_studio_palette_hint">
                To target another block, click its folded line or use the Plan.
            </p>
            <p t-elif="viewType === 'form'" class="small text-muted border-top pt-2 mt-auto mb-0 o_erplibre_studio_palette_hint">
                Dragging still works. Shorter: hover the space between two fields and click the +.
            </p>
            <p t-else="" class="small text-muted border-top pt-2 mt-auto mb-0">
                Drag an item onto a drop zone of the canvas, or press Enter on it: it goes into the selected group or page, after the selected element, else at the end of the view.
            </p>
        </div>
    </t>
</templates>
