<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_doc_intervenant_view_form" model="ir.ui.view">
        <field name="name">construction_doc_intervenant_form</field>
        <field name="model">construction.doc_intervenant</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="courriel" class="oe_edit_only" />
                        <h1>
                            <field name="courriel" />
                        </h1>
                    </div>
                    <group>
                        <field name="file_no_line" />
                        <field name="nom" />
                        <field name="partner_id" />
                        <field name="role" />
                        <field name="type_label" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_doc_intervenant_view_list" model="ir.ui.view">
        <field name="name">construction_doc_intervenant_list</field>
        <field name="model">construction.doc_intervenant</field>
        <field name="arch" type="xml">
            <list>
                <field name="courriel" />
                <field name="file_no_line" />
                <field name="nom" />
                <field name="partner_id" />
                <field name="role" />
                <field name="type_label" />
            </list>
        </field>
    </record>

    <record id="construction_doc_intervenant_view_search" model="ir.ui.view">
        <field name="name">construction_doc_intervenant_search</field>
        <field name="model">construction.doc_intervenant</field>
        <field name="arch" type="xml">
            <search string="Construction doc intervenant">
                <field name="courriel" string="Courriel" />
                <field name="nom" string="Nom" />
                <field name="partner_id" string="Partner" />
                <field name="role" string="Rôle" />
                <field name="type_label" string="Type" />
                <group expand="1" string="Group by">
                    <filter string="Partner" name="groupby_partner" context="{'group_by':'partner_id'}" />
                </group>
                <searchpanel>
                    <field name="partner_id" string="Partner" icon="fa-th-list" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="construction_doc_intervenant_doc_intervenant_action_window" model="ir.actions.act_window">
        <field name="name">Doc intervenant</field>
        <field name="res_model">construction.doc_intervenant</field>
    </record>
</odoo>
