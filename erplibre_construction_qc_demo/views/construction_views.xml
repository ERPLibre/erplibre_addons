<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_doc_soumission_view_list" model="ir.ui.view">
        <field name="name">construction.doc_soumission.list</field>
        <field name="model">construction.doc_soumission</field>
        <field name="arch" type="xml">
            <list>
                <field name="numero_soumission" />
                <field name="nom_chantier" />
                <field name="code_projet" />
                <field name="entrepreneur_name" />
                <field name="montant" />
                <field name="actif" />
                <field name="coordonnees_gps" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="project_id" />
            </list>
        </field>
    </record>
    <record id="construction_doc_soumission_view_form" model="ir.ui.view">
        <field name="name">construction.doc_soumission.form</field>
        <field name="model">construction.doc_soumission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="numero_soumission" />
                        <field name="nom_chantier" />
                        <field name="code_projet" />
                        <field name="entrepreneur_name" />
                        <field name="montant" />
                        <field name="date_soumission" />
                        <field name="statut" />
                        <field name="actif" />
                        <field name="coordonnees_gps" />
                        <field name="latitude" />
                        <field name="longitude" />
                        <field name="file_no_line" />
                        <field name="project_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="construction_doc_facture_view_list" model="ir.ui.view">
        <field name="name">construction.doc_facture.list</field>
        <field name="model">construction.doc_facture</field>
        <field name="arch" type="xml">
            <list>
                <field name="no_facture" />
                <field name="numero_soumission" />
                <field name="date_echeance" />
                <field name="montant_paye" />
                <field name="fournisseur" />
                <field name="project_id" />
            </list>
        </field>
    </record>
    <record id="construction_doc_facture_view_form" model="ir.ui.view">
        <field name="name">construction.doc_facture.form</field>
        <field name="model">construction.doc_facture</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="no_facture" />
                        <field name="numero_soumission" />
                        <field name="date_echeance" />
                        <field name="montant_paye" />
                        <field name="fournisseur" />
                        <field name="file_no_line" />
                        <field name="project_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="construction_doc_soumission_action" model="ir.actions.act_window">
        <field name="name">Soumissions</field>
        <field name="res_model">construction.doc_soumission</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="construction_doc_facture_action" model="ir.actions.act_window">
        <field name="name">Factures</field>
        <field name="res_model">construction.doc_facture</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_construction_qc_root" name="Construction QC" />
    <menuitem id="menu_construction_doc_soumission" name="Soumissions" parent="menu_construction_qc_root" action="construction_doc_soumission_action" sequence="10" />
    <menuitem id="menu_construction_doc_facture" name="Factures" parent="menu_construction_qc_root" action="construction_doc_facture_action" sequence="20" />
</odoo>
