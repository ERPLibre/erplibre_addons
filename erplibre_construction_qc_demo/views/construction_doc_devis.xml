<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_doc_devis_view_form" model="ir.ui.view">
        <field name="name">construction_doc_devis_form</field>
        <field name="model">construction.doc_devis</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="client_email" class="oe_edit_only" />
                        <h1>
                            <field name="client_email" />
                        </h1>
                    </div>
                    <group>
                        <field name="client_name" />
                        <field name="crm_lead_id" />
                        <field name="file_no_line" />
                        <field name="montant" />
                        <field name="nom_chantier" />
                        <field name="numero_devis" />
                        <field name="partner_id" />
                        <field name="sale_order_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="construction_doc_devis_view_list" model="ir.ui.view">
        <field name="name">construction_doc_devis_list</field>
        <field name="model">construction.doc_devis</field>
        <field name="arch" type="xml">
            <list>
                <field name="client_email" />
                <field name="client_name" />
                <field name="crm_lead_id" />
                <field name="file_no_line" />
                <field name="montant" />
                <field name="nom_chantier" />
                <field name="numero_devis" />
                <field name="partner_id" />
                <field name="sale_order_id" />
            </list>
        </field>
    </record>

    <record id="construction_doc_devis_view_search" model="ir.ui.view">
        <field name="name">construction_doc_devis_search</field>
        <field name="model">construction.doc_devis</field>
        <field name="arch" type="xml">
            <search string="Construction doc devis">
                <field name="client_email" string="Client Email" />
                <field name="client_name" string="Client Name" />
                <field name="crm_lead_id" string="Crm Lead" />
                <field name="nom_chantier" string="Nom Chantier" />
                <field name="numero_devis" string="Numero Devis" />
                <field name="partner_id" string="Partner" />
                <field name="sale_order_id" string="Sale Order" />
                <group expand="1" string="Group by">
                    <filter string="Crm Lead" name="groupby_crm_lead" context="{'group_by':'crm_lead_id'}" />
                    <filter string="Partner" name="groupby_partner" context="{'group_by':'partner_id'}" />
                    <filter string="Sale Order" name="groupby_sale_order" context="{'group_by':'sale_order_id'}" />
                </group>
                <searchpanel>
                    <field name="crm_lead_id" string="Crm Lead" icon="fa-th-list" />
                    <field name="partner_id" string="Partner" icon="fa-th-list" />
                    <field name="sale_order_id" string="Sale Order" icon="fa-th-list" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="construction_doc_devis_doc_devis_action_window" model="ir.actions.act_window">
        <field name="name">Doc devis</field>
        <field name="res_model">construction.doc_devis</field>
    </record>
</odoo>
