msgstr ""

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r75
msgid ""
"A .git file not pointing into .repo/ holds the clone back; the old repo "
"layout and a .git pointing into .repo/ count as repo's"
msgstr ""

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r27
msgid ""
"A BMP model given a non-PNG image rejects "
"format_mismatch:bmp_model_requires_png"
msgstr ""

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r117
msgid "A CHANGELOG entry describes the extension"
msgstr ""

