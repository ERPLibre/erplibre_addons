msgstr ""
"debian:12, almalinux:9, rocky:9, nixos:25.11, proxmox:9 listés UNSUPPORTED "
"avec une raison et sans VM"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r41
