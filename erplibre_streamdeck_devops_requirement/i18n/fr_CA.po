#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r72
msgid "--all is required (without it repo lists only checked-out projects)"
msgstr "--all est requis (sans lui, repo ne liste que les projets extraits)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r11
msgid ""
"--check also requires graphical-session.target active, checked after the "
"deck so a deck-less skip keeps its reason"
msgstr ""
"--check exige aussi que graphical-session.target soit actif, vérifié après "
"le deck pour qu'un saut faute de deck garde sa raison"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r10
msgid ""
"--check exits 0 only when program != none, venv python exists, a USB device "
"of vendor 0fd9 is present; else non-zero with a reason"
msgstr ""
"--check se termine avec le code 0 seulement si le programme n'est pas none, "
"que le python du venv existe et qu'un périphérique USB du fabricant 0fd9 est"
" présent ; sinon il se termine avec un code non nul et donne une raison"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r50
msgid ""
"--dry-run prints 'games: clone <url> at <revision> into <dir>' or 'games: "
"keep <dir>' (with its reason), at the Stream Deck level only"
msgstr ""
"--dry-run affiche 'games: clone <url> at <revision> into <dir>' ou 'games: "
"keep <dir>' (avec sa raison), au niveau Stream Deck seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r73
msgid ""
"--dry-run prints family, GNOME version, package commands (extras one per "
"line), migration, files; with --uninstall the files and keys, no package "
"command; changes nothing, no sudo; the base lists neither rule nor venv, "
"--stream-deck lists both"
msgstr ""
"--dry-run affiche la famille, la version de GNOME, les commandes de paquets "
"(un extra par ligne), la migration, les fichiers ; avec --uninstall, les "
"fichiers et les clés, aucune commande de paquet ; ne change rien, sans sudo "
"; la base ne liste ni règle ni venv, --stream-deck liste les deux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r23
msgid ""
"--dry-run prints the unit path, the settings it would write and whether it "
"would enable"
msgstr ""
"--dry-run affiche le chemin de l'unité, les réglages qu'il écrirait et s'il "
"activerait l'unité"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r74
msgid ""
"--extension-only runs the extension step alone: no sudo, no OS check, no "
"package; without gettext it fails at the translations naming the package"
msgstr ""
"--extension-only lance l'étape de l'extension seule : sans sudo, sans "
"vérification du système, sans paquet ; sans gettext, elle échoue aux "
"traductions en nommant le paquet"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r40
msgid ""
"--extension-only with --stream-deck or --uninstall is a usage error, exit 1"
msgstr ""
"--extension-only avec --stream-deck ou --uninstall est une erreur d'usage, "
"code de sortie 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r75
msgid "--list-plugins neither opens the deck nor takes the lock"
msgstr "--list-plugins n'ouvre pas le deck et ne prend pas le verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r74
msgid "--list-plugins prints one line per plugin and exits 0"
msgstr ""
"--list-plugins affiche une ligne par plugin et se termine avec le code 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r121
msgid ""
"--list-plugins reads the settings, so the ids in DECK_PLUGINS_OFF print as "
"off"
msgstr ""
"--list-plugins lit les réglages, pour que les identifiants de "
"DECK_PLUGINS_OFF s'affichent comme coupés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r76
msgid ""
"--list-plugins reports the result of the import; a setup failure shows only "
"at a real start"
msgstr ""
"--list-plugins rapporte le résultat de l'import ; un échec de setup "
"n'apparaît qu'au vrai démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r65
msgid "--no-enable skips the enable step"
msgstr "--no-enable saute l'étape d'activation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r129
msgid ""
"--no-enable still runs the extension step, so the migration carries an "
"existing enabled state to the new UUID"
msgstr ""
"--no-enable lance quand même l'étape de l'extension, pour que la migration "
"reporte un état activé existant sur le nouvel UUID"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r19
msgid ""
"--stream-deck writes the settings keeping keys the options do not set, "
"writes the unit, daemon-reload"
msgstr ""
"--stream-deck écrit les réglages en gardant les clés que les options ne "
"fixent pas, écrit l'unité, puis daemon-reload"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r70
msgid ""
"--uninstall --stream-deck is idempotent: a second run calls nothing and "
"exits 0"
msgstr ""
"--uninstall --stream-deck est idempotent : une seconde exécution n'appelle "
"rien et se termine avec le code 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r69
msgid ""
"--uninstall --stream-deck removes only the rule (then reload) and the venv; "
"the extension stays installed and enabled"
msgstr ""
"--uninstall --stream-deck retire seulement la règle (puis recharge) et le "
"venv ; l'extension reste installée et activée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r22
msgid ""
"--uninstall and --uninstall --stream-deck: stop, disable, remove unit, "
"daemon-reload, remove settings"
msgstr ""
"--uninstall et --uninstall --stream-deck : stop, disable, retrait de "
"l'unité, daemon-reload, retrait des réglages"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r54
msgid "--uninstall does not delete games/"
msgstr "--uninstall ne supprime pas games/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r68
msgid ""
"--uninstall removes the UUID from enabled-extensions, the symlink, the udev "
"rule (then reload), .venv.streamdeck; never system packages"
msgstr ""
"--uninstall retire l'UUID d'enabled-extensions, le lien symbolique, la règle"
" udev (puis recharge), .venv.streamdeck ; jamais les paquets système"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r71
msgid ""
"--uninstall that cannot read/write enabled-extensions still removes the "
"rest, prints its summary, then exits 1 naming the UUID"
msgstr ""
"Un --uninstall qui ne peut pas lire ou écrire enabled-extensions retire "
"quand même le reste, affiche son bilan, puis se termine avec le code 1 en "
"nommant l'UUID"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r67
msgid ""
"--with-extras (both levels): mpv, yt-dlp, nmap, keepassxc, xdotool, system "
"lz4; one command per extra; a missing extra warns, never fatal"
msgstr ""
"--with-extras (les deux niveaux) : mpv, yt-dlp, nmap, keepassxc, xdotool, "
"lz4 du système ; une commande par extra ; un extra manquant avertit, jamais "
"fatal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r18
msgid "--with-extras keeps its meaning (optional tools)"
msgstr "--with-extras garde son sens (outils optionnels)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r116
msgid ""
"-h/--help prints the usage, the settings and the exit codes and exits 0; an "
"unknown argument prints the usage on stderr and exits 2; neither takes the "
"lock nor imports app"
msgstr ""
"-h/--help affiche l'usage, les réglages et les codes de sortie et se termine"
" avec le code 0 ; un argument inconnu affiche l'usage sur stderr et se "
"termine avec le code 2 ; ni l'un ni l'autre ne prend le verrou ni n'importe "
"app"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r28
msgid ".gitignore ignores script/stream_deck/games/save/"
msgstr ".gitignore ignore script/stream_deck/games/save/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r27
msgid ".gitignore keeps ignoring script/stream_deck/save/"
msgstr ".gitignore ignore toujours script/stream_deck/save/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r14
msgid ""
"/api/restart re-executes the gallery from its own path; a gallery started "
"before an update must be restarted"
msgstr ""
"/api/restart réexécute la galerie depuis son propre chemin ; une galerie "
"démarrée avant une mise à jour doit être relancée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r46
msgid ""
"/etc/os-release maps to debian/rhel/suse/arch (ID, then ID_LIKE); unknown or"
" unreadable exits 2"
msgstr ""
"/etc/os-release se ramène à debian/rhel/suse/arch (ID, puis ID_LIKE) ; "
"inconnu ou illisible, code de sortie 2"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r75
msgid ""
"A .git file not pointing into .repo/ holds the clone back; the old repo "
"layout and a .git pointing into .repo/ count as repo's"
msgstr ""
"Un fichier .git qui ne pointe pas dans .repo/ retient le clone ; l'ancienne "
"disposition de repo et un .git qui pointe dans .repo/ comptent comme "
"appartenant à repo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r27
msgid ""
"A BMP model given a non-PNG image rejects "
"format_mismatch:bmp_model_requires_png"
msgstr ""
"Un modèle BMP qui reçoit une image autre que PNG la rejette avec "
"format_mismatch:bmp_model_requires_png"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r117
msgid "A CHANGELOG entry describes the extension"
msgstr "Une entrée du CHANGELOG décrit l'extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r53
msgid ""
"A Claude session file with no time stamp keeps the /proc existence check"
msgstr ""
"Un fichier de session Claude sans horodatage garde la vérification "
"d'existence dans /proc"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r21
msgid ""
"A Filesystem.writeFile failure (disk full) aborts the extraction, surfaces "
"the error and never writes the sentinel"
msgstr ""
"Un échec de Filesystem.writeFile (disque plein) interrompt l'extraction, "
"remonte l'erreur et n'écrit jamais le témoin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r28
msgid ""
"A JPEG model given a non-JPEG image rejects "
"format_mismatch:jpeg_model_requires_jpeg"
msgstr ""
"Un modèle JPEG qui reçoit une image autre que JPEG la rejette avec "
"format_mismatch:jpeg_model_requires_jpeg"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r113
msgid ""
"A SIGTERM during a build resets the deck and exits 143; SigtermExit passes "
"through the guard and the loader"
msgstr ""
"Un SIGTERM pendant une construction réinitialise le deck et se termine avec "
"le code 143 ; SigtermExit traverse la garde et le chargeur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r133
msgid ""
"A Stream Deck package missing from Leap 16.0/EL10 shows as FAILED(install-"
"stream-deck) after the base passed stage 1"
msgstr ""
"Un paquet Stream Deck absent de Leap 16.0/EL10 apparaît comme "
"FAILED(install-stream-deck) après que la base a réussi l'étape 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r27
msgid ""
"A Stream Deck user reads and renames their workstations and revokes their "
"tokens, reads the decks their workstations have had and the events of their "
"workstations and of those decks"
msgstr ""
"Un utilisateur Stream Deck lit et renomme ses postes et en révoque les "
"jetons, lit les decks que ses postes ont eus et les événements de ses postes"
" et de ces decks"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r22
msgid ""
"A background part of the extension detects the decks, by GUdev events or "
"else an asynchronous poll every 10 seconds, whether the deck indicator is "
"shown or not; the indicator reads that same part"
msgstr ""
"Une partie de fond de l'extension détecte les decks, par les événements "
"GUdev ou sinon par un sondage asynchrone toutes les 10 secondes, que "
"l'indicateur du deck soit affiché ou non ; l'indicateur lit cette même "
"partie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r48
msgid ""
"A branch or local work stays; the summary says so, and reports a failed "
"fetch"
msgstr ""
"Une branche ou du travail local reste en place ; le résumé le dit, et "
"signale un fetch raté"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r07
msgid ""
"A broken symbolic link met while walking a directory (ENOENT on stat) is "
"skipped, not fatal"
msgstr ""
"Un lien symbolique brisé rencontré pendant le parcours d'un répertoire "
"(ENOENT au stat) est ignoré, pas fatal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r20
msgid "A busy plugin's page tick and home tick are skipped"
msgstr "Le tick de page et le tick d'accueil d'un plugin occupé sont sautés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r30
msgid "A busy plugin's polls are skipped"
msgstr "Les sondages d'un plugin occupé sont sautés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r125
msgid ""
"A cached master password that has not expired skips the prompt; a confirmed "
"password is cached"
msgstr ""
"Un mot de passe maître en cache encore valide évite la demande ; un mot de "
"passe confirmé est mis en cache"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r56
msgid ""
"A call of a moved script by its old path fails; the make target names keep "
"working"
msgstr ""
"Un appel d'un script déplacé par son ancien chemin échoue ; les noms des "
"cibles make fonctionnent toujours"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r73
msgid ""
"A clone that repo will not extract stays; without repo ready nothing "
"changes; without games nothing happens"
msgstr ""
"Un clone que repo n'extraira pas reste en place ; sans repo prêt, rien ne "
"change ; sans jeux, rien ne se passe"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r42
msgid "A commit on a non-editable slug is rejected with RepoNotEditableError"
msgstr ""
"Un commit sur un slug non modifiable est refusé avec RepoNotEditableError"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r86
msgid ""
"A commit rewriting goldens lists each golden and its reason; a golden that "
"changes without a behaviour change is a bug"
msgstr ""
"Un commit qui réécrit des goldens liste chacun avec sa raison ; un golden "
"qui change sans changement de comportement est un bogue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r29
msgid "A corrupted PNG rejects image_decode_failed"
msgstr "Un PNG corrompu est rejeté avec image_decode_failed"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r22
msgid ""
"A corrupted legacy JSON file is logged and skipped; the settings keep their "
"defaults"
msgstr ""
"Un ancien fichier JSON corrompu est journalisé puis ignoré ; les réglages "
"gardent leurs valeurs par défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r03
msgid "A cron detects the silent workstations"
msgstr "Un cron détecte les postes muets"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r05
msgid "A dashboard tap opens what the key showed at the last render"
msgstr ""
"Un appui sur le tableau de bord ouvre ce que la touche montrait au dernier "
"rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r43
msgid ""
"A deck declared by another workstation moves to it without confirmation, "
"with a changed-workstation event that keeps the former and the new "
"workstation"
msgstr ""
"Un deck déclaré par un autre poste passe à ce poste sans confirmation, avec "
"un événement « changé de poste » qui garde l'ancien et le nouveau poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r09
msgid "A deck held elsewhere runs no game, exit 2"
msgstr "Un deck tenu ailleurs ne lance aucun jeu, code de sortie 2"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r38
msgid ""
"A deck program in a game holds the lock through the inherited fd; one with "
"closed fds runs under the game ancestor and takes the lock over when the "
"game releases it"
msgstr ""
"Un programme du deck dans un jeu tient le verrou par le descripteur hérité ;"
" un programme aux descripteurs fermés tourne sous l'ancêtre du jeu et "
"reprend le verrou quand le jeu le libère"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r13
msgid ""
"A deck unplugged for long writes no event of its own: the unplugged event "
"already dates it, and only the activity comes from the delay"
msgstr ""
"Un deck débranché longtemps n'écrit aucun événement propre : l'événement « "
"débranché » le date déjà, et seule l'activité naît du délai"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r23
msgid ""
"A deck without a readable serial (sysfs serial first, lsusb next) is "
"inventoried without a serial, owned by its workstation through the key "
"workstation, USB product id and USB port, never merged with another "
"workstation's deck"
msgstr ""
"Un deck sans numéro de série lisible (serial de sysfs d'abord, lsusb "
"ensuite) est inventorié sans numéro, propre à son poste par la clé poste, "
"identifiant produit USB et port USB, jamais fusionné avec le deck d'un autre"
" poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r17
msgid ""
"A detected local instance has the shape: type local, local_path, port, url"
msgstr ""
"Une instance locale détectée a la forme : type local, local_path, port, url"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r52b
msgid ""
"A different error (type or message) of the same call is journaled at once"
msgstr ""
"Une erreur différente (type ou message) du même appel est inscrite au "
"journal aussitôt"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r74
msgid ""
"A drained job's flash ends the pass; a job press after an expired flash "
"renders first"
msgstr ""
"Le clignotement d'une tâche vidée termine le passage ; un appui de tâche "
"après un clignotement expiré fait d'abord un rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r47
msgid "A face that raises paints its key empty"
msgstr "Une face qui lève peint sa touche vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r18
msgid "A failed archive fetch raises BundleNotShippedError(slug)"
msgstr ""
"Un échec du téléchargement de l'archive lève BundleNotShippedError(slug)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r16
msgid ""
"A failed deck service and a silent workstation open their activity on the "
"workstation, a deck unplugged for long and a deck that changed workstation "
"on the deck; both carry a thread and activities"
msgstr ""
"Un service du deck en échec et un poste muet ouvrent leur activité sur le "
"poste, un deck débranché longtemps et un deck changé de poste sur le deck ; "
"les deux portent un fil et des activités"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r37
msgid ""
"A failed fire-and-forget write emits writeFailed {deckId, key, reason} once "
"per key and reason until a success"
msgstr ""
"Une écriture sans attente de réponse qui échoue émet writeFailed {deckId, "
"key, reason} une fois par touche et par raison, jusqu'à un succès"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r73
msgid ""
"A failed job is journaled with its traceback once per plugin and error; a "
"clean job re-arms the journal"
msgstr ""
"Une tâche en échec est inscrite au journal avec sa trace une fois par plugin"
" et par erreur ; une tâche réussie réarme le journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r108
msgid "A failed rebase is aborted and notifies Manual merge required"
msgstr "Un rebase en échec est annulé et notifie Manual merge required"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r32
msgid ""
"A failed report is silent apart from the status the extension shows: no "
"notification, no log line"
msgstr ""
"Une remontée en échec reste silencieuse hormis l'état que l'extension "
"affiche : ni notification, ni ligne de journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r82
msgid ""
"A failed transfer or encoding rejects the setKeyImage call with its reason"
msgstr ""
"Un transfert ou un encodage échoué rejette l'appel setKeyImage avec sa "
"raison"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r40
msgid ""
"A failing command of the migration warns on stderr and the script exits 0"
msgstr ""
"Une commande de la migration qui échoue avertit sur stderr et le script rend"
" 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r31
msgid "A failing read keeps the previous cached data"
msgstr "Un read qui échoue garde la donnée précédente en cache"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r107
msgid ""
"A failing stage command gives FAILED(<command>), the first failed check "
"FAILED(<check>); both skip the rest"
msgstr ""
"Une commande d'étape en échec donne FAILED(<command>), le premier contrôle "
"en échec FAILED(<check>) ; les deux sautent le reste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r32
msgid "A failing store or active is isolated by the guard"
msgstr "Un store ou un active qui échoue est isolé par la garde"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r52
msgid ""
"A failure is journaled once, and again only after the call has succeeded"
msgstr ""
"Un échec est inscrit au journal une fois, et de nouveau seulement après une "
"réussite de l'appel"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_defects_r47
msgid ""
"A file whose access the user restricted keeps that restriction when the deck"
" rewrites it."
msgstr ""
"Un fichier dont l'utilisateur a restreint l'accès garde cette restriction "
"quand le deck le réécrit."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r124
msgid ""
"A film row has a sub-menu Browser / mpv / Edit; Add film sits at the bottom"
msgstr ""
"Une ligne de film a un sous-menu Browser / mpv / Edit ; Add film se trouve "
"en bas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r03b
msgid ""
"A fixture face failure is journaled once per key, its journal label carrying"
" the key"
msgstr ""
"L'échec d'une face de fixture est inscrit une fois par touche au journal, "
"son libellé portant la touche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r50
msgid "A fixture or tile press that raises is journaled and flashes ERR"
msgstr ""
"Un appui sur une fixture ou une tuile qui lève est inscrit au journal et "
"fait clignoter ERR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r58
msgid "A fixture whose place raises or returns non-integers is skipped"
msgstr ""
"Une fixture dont place lève ou rend autre chose que des entiers est sautée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r29
msgid "A flash overlays the pressed key and its four neighbours"
msgstr "Un flash recouvre la touche appuyée et ses quatre voisines"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r89
msgid ""
"A game imports games_cli.py only: no game imports a sibling game, deck_lock "
"or anything above the games repository"
msgstr ""
"Un jeu n'importe que games_cli.py : aucun jeu n'importe un jeu voisin, "
"deck_lock ni quoi que ce soit au-dessus du dépôt des jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r77
msgid "A goto to an unknown page sends the deck home with one journal line"
msgstr ""
"Un goto vers une page inconnue renvoie le deck à l'accueil avec une ligne au"
" journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r47
msgid "A granted deck that is not open is opened through the attach path"
msgstr ""
"Un deck autorisé qui n'est pas ouvert est ouvert par le chemin de "
"rattachement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r20
msgid ""
"A gunzip or tar parse error mid-stream raises BundleCorruptError, aborts the"
" extraction and never writes the sentinel"
msgstr ""
"Une erreur de gunzip ou d'analyse tar en cours de flux lève "
"BundleCorruptError, interrompt l'extraction et n'écrit jamais le témoin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r49
msgid "A home button press that raises is journaled and flashes ERR"
msgstr ""
"Un appui sur un bouton d'accueil qui lève est inscrit au journal et fait "
"clignoter ERR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r36
msgid "A home_tick returning True asks a render, at most one render per pass"
msgstr ""
"Un home_tick qui rend True demande un rendu, au plus un rendu par passage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r45
msgid "A home_tick that raises is journaled and the deck keeps going"
msgstr "Un home_tick qui lève est inscrit au journal et le deck continue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r24
msgid "A job's page change happens when then runs, once the result is known"
msgstr ""
"Le changement de page d'une tâche a lieu quand then s'exécute, une fois le "
"résultat connu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r75
msgid "A job's read after its action goes into the cache before the render"
msgstr ""
"La lecture qu'une tâche fait après son action entre dans le cache avant le "
"rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r11
msgid ""
"A job's result is handed back at the start of the next pass: the busy mark "
"is cleared, then then(ctx, result, error) runs through the guard"
msgstr ""
"Le résultat d'une tâche est rendu au début du passage suivant : la marque "
"d'occupation est effacée, puis then(ctx, result, error) s'exécute sous la "
"garde"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r94
msgid "A job's work takes no argument and does not touch ctx"
msgstr "Le work d'une tâche ne prend aucun argument et ne touche pas à ctx"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r09
msgid "A job's worker thread is a daemon and is never joined"
msgstr ""
"Le fil d'exécution d'une tâche est un démon et n'est jamais attendu (join)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r24b
msgid "A journal line is exactly '[erplibre-home] <plugin>: <reason>'"
msgstr ""
"Une ligne du journal est exactement '[erplibre-home] <plugin>: <reason>'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r51
msgid ""
"A kept games/ without the games is named in the summary (dotted names, "
"dangling links, a count of game files)"
msgstr ""
"Un games/ conservé sans les jeux est nommé dans le résumé (noms commençant "
"par un point, liens brisés, nombre de fichiers de jeux)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r57
msgid "A key already taken is skipped by a later fixture"
msgstr "Une touche déjà prise est sautée par une fixture ultérieure"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r57
msgid "A leftover __pycache__/game_*.pyc file is harmless"
msgstr "Un fichier __pycache__/game_*.pyc resté en place est sans effet"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r09
msgid ""
"A lent deck follows its current workstation; an employee whose workstation "
"held it keeps reading the deck and its events from their first holding on, "
"those at the later holders included, never the events from before that "
"holding, the holder's workstation nor its other decks"
msgstr ""
"Un deck prêté suit son poste actuel ; un employé dont un poste l'a détenu "
"garde la lecture du deck et de ses événements depuis sa première détention, "
"ceux des détenteurs suivants compris, jamais les événements d'avant cette "
"détention, le poste du détenteur ni ses autres decks"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r130
msgid ""
"A local instance's sub-menu offers the KeePassXC actions configured through "
"Edit instance"
msgstr ""
"Le sous-menu d'une instance locale offre les actions KeePassXC configurées "
"par « Modifier l'instance »"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r07
msgid ""
"A locked workstation is accepted as silent: it goes silent after the delay "
"and is heard again at unlock, like a workstation off for the night"
msgstr ""
"Un poste verrouillé est accepté comme muet : il devient muet après le délai "
"et revient au déverrouillage, comme un poste éteint la nuit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r51
msgid ""
"A major outside shell-version exits 2 ('GNOME <v> not in shell-version')"
msgstr ""
"Une version majeure hors de shell-version se termine avec le code 2 ('GNOME "
"<v> not in shell-version')"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r128
msgid "A malformed film URL is passed to the player as is"
msgstr "Une URL de film mal formée est transmise telle quelle au lecteur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r115
msgid "A manual checklist lives in test/manual.md"
msgstr "Une liste de vérification manuelle se trouve dans test/manual.md"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r45
msgid "A media row is labelled Name · episode · position"
msgstr "Une ligne de média s'intitule Nom · épisode · position"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r42
msgid ""
"A migration that cannot run (non-zero exit, missing execute bit) never "
"blocks the install"
msgstr ""
"Une migration qui ne peut pas tourner (code de sortie non nul, bit "
"d'exécution absent) ne bloque jamais l'installation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r58
msgid "A migration that cannot start is logged, never fatal"
msgstr "Une migration qui ne peut pas démarrer est journalisée, jamais fatale"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r51
msgid ""
"A new migration creates the SQLite table editable_repos(slug PK, "
"baseline_sha NOT NULL, build_id NOT NULL, promoted_at INTEGER NOT NULL, "
"head_sha)"
msgstr ""
"Une nouvelle migration crée la table SQLite editable_repos(slug PK, "
"baseline_sha NOT NULL, build_id NOT NULL, promoted_at INTEGER NOT NULL, "
"head_sha)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r48
msgid "A non-KeyFace face paints its key empty"
msgstr "Une face qui n'est pas un KeyFace peint sa touche vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r42
msgid ""
"A page handle that raises is journaled, flashes ERR and sends the deck home"
msgstr ""
"Un handle de page qui lève est inscrit au journal, fait clignoter ERR et "
"renvoie le deck à l'accueil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r43
msgid ""
"A page render that raises is journaled and the home screen is drawn instead"
msgstr ""
"Un rendu de page qui lève est inscrit au journal et l'écran d'accueil est "
"dessiné à sa place"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r44
msgid "A page tick that raises sends the deck home"
msgstr "Un tick de page qui lève renvoie le deck à l'accueil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r73
msgid "A page whose keys() raises refuses its plugin"
msgstr "Une page dont keys() lève fait refuser son plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r18
msgid ""
"A pairing code has 8 characters without ambiguity (no 0/O, 1/I), works for "
"10 minutes, once, for the employee who asked for it, and only that employee "
"reads it"
msgstr ""
"Un code d'appairage a 8 caractères sans ambiguïté (ni 0/O, ni 1/I), vaut 10 "
"minutes, une seule fois, pour l'employé qui l'a demandé, et seul cet employé"
" le lit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r15
msgid ""
"A paths[] entry holds {id (UUID v4), label, path, default_cmd 'claude "
"--resume'}"
msgstr ""
"Une entrée de paths[] porte {id (UUID v4), label, path, default_cmd 'claude "
"--resume'}"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r72
msgid ""
"A plugin is busy only once its job's thread has started; a start failure "
"raises and leaves the plugin free"
msgstr ""
"Un plugin n'est occupé qu'une fois le fil de sa tâche démarré ; un échec de "
"démarrage lève une exception et laisse le plugin libre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r72
msgid ""
"A plugin is refused, with one journal line, when its import raises, it has "
"no PLUGIN, its api is wrong, its setup raises or one of its page ids is a "
"duplicate"
msgstr ""
"Un plugin est refusé, avec une ligne au journal, quand son import lève, "
"qu'il n'a pas de PLUGIN, que son api est fausse, que son setup lève ou qu'un"
" de ses identifiants de page est en double"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r03
msgid "A plugin that raises is isolated; the deck keeps running"
msgstr "Un plugin qui lève est isolé ; le deck continue de tourner"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r62
msgid ""
"A plugin turned off loses its button, fixtures and tiles; the other buttons "
"close up"
msgstr ""
"Un plugin coupé perd son bouton, ses fixtures et ses tuiles ; les autres "
"boutons se resserrent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r20
msgid ""
"A plugin's id is its file stem, set by the loader; TODO lists the plugins by"
" file name without importing them"
msgstr ""
"L'identifiant d'un plugin est le nom de son fichier sans extension, fixé par"
" le chargeur ; TODO liste les plugins par nom de fichier sans les importer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r25
msgid "A poll runs active under the lock, read without it, and store under it"
msgstr ""
"Un sondage exécute active sous le verrou, read sans lui, et store sous lui"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r10
msgid ""
"A preserveExistingArchives flag, off by default, skips re-archiving the "
"repositories that did not change"
msgstr ""
"Un drapeau preserveExistingArchives, désactivé par défaut, évite de "
"réarchiver les dépôts qui n'ont pas changé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r18
msgid ""
"A press on a busy plugin's fixtures or dashboard tiles flashes ERR without "
"calling the plugin"
msgstr ""
"Un appui sur les fixtures ou les tuiles du tableau de bord d'un plugin "
"occupé fait clignoter ERR sans appeler le plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r17
msgid ""
"A press that would reach a busy plugin (page handler, home button) flashes "
"ERR without calling the plugin"
msgstr ""
"Un appui qui atteindrait un plugin occupé (gestionnaire de page, bouton "
"d'accueil) fait clignoter ERR sans appeler le plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r10
msgid ""
"A pressed key shows '…' in colors.BUSY while its job runs, repainted by "
"every render, only on the job's page"
msgstr ""
"Une touche pressée affiche « … » en colors.BUSY pendant sa tâche, repeinte à"
" chaque rendu, seulement sur la page de la tâche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r50b
msgid "A process that started exactly at born_by plus the slack is alive"
msgstr "Un processus démarré exactement à born_by plus la marge est vivant"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r33
msgid ""
"A recorded flash blocks every tick; once it expires, the kernel renders and "
"the pass ends"
msgstr ""
"Un flash enregistré bloque chaque tick ; à son expiration, le noyau fait le "
"rendu et le passage se termine"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r56
msgid "A recycled session is dropped from the dashboard and the session page"
msgstr ""
"Une session recyclée est retirée du tableau de bord et de la page de session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r73
msgid ""
"A reinstall that rewrites an enabled unit runs reenable; a disabled one "
"stays disabled"
msgstr ""
"Une réinstallation qui réécrit une unité activée lance reenable ; une unité "
"désactivée le reste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r123
msgid ""
"A remote instance entry is stored as type remote with a UUID; an unknown "
"auto_login_method is normalised to selenium"
msgstr ""
"Une entrée d'instance distante est stockée avec le type remote et un UUID ; "
"un auto_login_method inconnu est normalisé en selenium"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r58
msgid "A rename change over 500 lines needs a maintainer's prior agreement"
msgstr ""
"Une modification de renommage de plus de 500 lignes exige l'accord préalable"
" d'un mainteneur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r43
msgid ""
"A repo-managed games/ whose .git is a symlink is never moved by the "
"installer"
msgstr ""
"Un games/ géré par repo dont le .git est un lien symbolique n'est jamais "
"déplacé par l'installateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r26
msgid ""
"A revoked token, or the token of an archived employee or of an account that "
"is not a Stream Deck user, is refused with a code the extension shows as "
"enrollment revoked"
msgstr ""
"Un jeton révoqué, ou le jeton d'un employé archivé ou d'un compte qui n'est "
"pas utilisateur Stream Deck, est refusé avec un code que l'extension affiche"
" comme inscription révoquée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r18
msgid ""
"A running GNOME Shell session keeps the old gallery path until the next "
"login"
msgstr ""
"Une session GNOME Shell ouverte garde l'ancien chemin de la galerie jusqu'à "
"la prochaine ouverture de session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r78
msgid "A scan longer than 30 s is killed and notified, and keeps its results"
msgstr ""
"Une analyse de plus de 30 s est tuée et signalée par une notification, et "
"garde ses résultats"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r134
msgid ""
"A second full --uninstall changes nothing (no rewrite of enabled-extensions)"
" and exits 0"
msgstr ""
"Un second --uninstall complet ne change rien (aucune réécriture d'enabled-"
"extensions) et se termine avec le code 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r16
msgid ""
"A sentinel present over an empty extracted directory counts as an eviction "
"and triggers a re-extraction"
msgstr ""
"Un témoin présent sur un répertoire extrait vide compte comme une éviction "
"et déclenche une réextraction"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r59
msgid "A session page renders only on change: Claude status, mpv title"
msgstr ""
"Une page de session ne fait son rendu que sur changement : état Claude, "
"titre mpv"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r58
msgid "A session page's tick goes home when the session is gone"
msgstr ""
"Le tick d'une page de session ramène à l'accueil quand la session a disparu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r55
msgid "A session whose pid is 0 or absent is kept"
msgstr "Une session dont le pid vaut 0 ou est absent est gardée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r54
msgid "A settings file without GAMES reads as on"
msgstr "Un fichier de réglages sans GAMES se lit comme on"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r90
msgid ""
"A shared test helper installs stub PIL, StreamDeck and translator modules"
msgstr ""
"Un utilitaire de test partagé installe des modules PIL, StreamDeck et "
"translator factices"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r122
msgid "A shutdown never takes ctx.locked() nor waits for a thread that does"
msgstr ""
"Un arrêt ne prend jamais ctx.locked() et n'attend jamais un fil qui le prend"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r51
msgid ""
"A shutdown that raises is journaled and the next plugin's shutdown still "
"runs"
msgstr ""
"Un arrêt qui lève est inscrit au journal et l'arrêt du plugin suivant "
"s'exécute quand même"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r40
msgid ""
"A slug identifies exactly one manifest project (archive, index, Documents "
"copy, editable_repos primary key)"
msgstr ""
"Un slug désigne exactement un projet du manifeste (archive, index, copie "
"dans Documents, clé primaire d'editable_repos)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r20
msgid ""
"A solved activity closes with action_feedback, kept done, the feedback "
"\"Resolved at <time>: <what happened>\" in the language of its user and the "
"time in their time zone, UTC without one; a deck service that leaves failed "
"for any other state closes it, naming the new state"
msgstr ""
"Une activité réglée se ferme par action_feedback, gardée faite, le retour « "
"Résolu à <heure> : <ce qui s'est passé> » dans la langue de son utilisateur "
"et l'heure dans son fuseau, UTC à défaut ; un service du deck qui quitte "
"l'état en échec pour n'importe quel autre la ferme, en nommant le nouvel "
"état"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r26
msgid ""
"A store that returns True asks for one render; a pass renders at most once"
msgstr ""
"Un store qui rend True demande un rendu ; un passage fait au plus un rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r97
msgid "A subprocess failure notifies and logs under the program's prefix"
msgstr ""
"L'échec d'un sous-processus notifie et journalise sous le préfixe du "
"programme"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r03
msgid ""
"A tile face failure is journaled once per key, its journal label carrying "
"the key"
msgstr ""
"L'échec d'une face de tuile est inscrit une fois par touche au journal, son "
"libellé portant la touche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r77
msgid ""
"A tracked game file edited before the pull blocks it; INSTALL says what to "
"do"
msgstr ""
"Un fichier de jeu suivi, modifié avant le pull, bloque celui-ci ; INSTALL "
"dit quoi faire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r71
msgid ""
"A user plugin with a repository plugin's id replaces it, with one journal "
"line; turning the id off turns both off"
msgstr ""
"Un plugin de l'utilisateur portant l'identifiant d'un plugin du dépôt le "
"remplace, avec une ligne au journal ; couper l'identifiant coupe les deux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r05
msgid ""
"A workstation enrolls by pairing code, by the employee's API key, or by "
"login and password"
msgstr ""
"Un poste s'inscrit par code d'appairage, par la clé d'API de l'employé, ou "
"par identifiant et mot de passe"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r16
msgid ""
"A workstation is identified by an HMAC-SHA256 of /etc/machine-id keyed by "
"the Linux user and the destination's URL and database: two Odoo cannot match"
" it, the raw id never leaves it"
msgstr ""
"Un poste est identifié par un HMAC-SHA256 de /etc/machine-id avec pour clé "
"l'utilisateur Linux et l'URL et la base de la destination : deux Odoo ne "
"peuvent pas le recouper, l'identifiant brut ne le quitte jamais"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r04
msgid ""
"A workstation is silent after one hour without a report, a delay set in the "
"Settings; a workstation off for the night goes silent every evening and is "
"heard again at its first report"
msgstr ""
"Un poste est muet après une heure sans remontée, délai réglé dans les "
"Paramètres ; un poste éteint la nuit devient muet chaque soir et revient à "
"sa première remontée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r01
msgid ""
"A workstation reports to several Odoo databases, each a local instance of "
"the extension or a remote one given by URL and database, with its own "
"enrollment and token"
msgstr ""
"Un poste remonte vers plusieurs bases Odoo, chacune une instance locale de "
"l'extension ou une instance distante donnée par son URL et sa base, avec sa "
"propre inscription et son propre jeton"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r43
msgid ""
"A write to a read-only repository is impossible at compile time, and "
"BundleCodeService throws ReadOnlyError at runtime"
msgstr ""
"Une écriture dans un dépôt en lecture seule est impossible à la compilation,"
" et BundleCodeService lève ReadOnlyError à l'exécution"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r62
msgid ""
"A wrong master password notifies, clears the cache and prompts again once"
msgstr ""
"Un mot de passe maître erroné notifie, vide le cache et redemande une fois"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r55
msgid ""
"Absent games means no games/games_cli.py; the settings library holds "
"deck_games_present and deck_games_absent_message, one line naming make "
"erplibre_home_streamdeck_install and games_cli.py"
msgstr ""
"Des jeux absents veulent dire aucun games/games_cli.py ; la bibliothèque de "
"réglages contient deck_games_present et deck_games_absent_message, une ligne"
" qui nomme make erplibre_home_streamdeck_install et games_cli.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r99
msgid ""
"Accepted consequence: a user plugin's key 0 is unusable while the plugin is "
"busy"
msgstr ""
"Conséquence acceptée : la touche 0 d'un plugin de l'utilisateur est "
"inutilisable pendant que le plugin est occupé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r90
msgid "Accepted risk: a page changes one loop pass after its job's work ends"
msgstr ""
"Risque accepté : une page change un passage de boucle après la fin du "
"travail de sa tâche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r91
msgid "Accepted risk: a render shows data up to one poll period old"
msgstr ""
"Risque accepté : un rendu affiche une donnée vieille d'au plus une période "
"de sondage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r92
msgid ""
"Accepted risk: a wall-clock change shifts process start times; the 5 s slack"
" absorbs NTP adjustments"
msgstr ""
"Risque accepté : un changement de l'horloge murale décale les heures de "
"démarrage des processus ; la marge de 5 s absorbe les ajustements NTP"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r93
msgid ""
"Accepted risk: goldens are rewritten from the package, so the per-commit "
"list of rewritten goldens is the review surface"
msgstr ""
"Risque accepté : les goldens sont réécrits depuis le paquet, donc la liste "
"par commit des goldens réécrits est la surface de revue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r50
msgid ""
"Accepted versions read from metadata.json shell-version with tr/grep/sed (no"
" python3), one-line or multi-line array"
msgstr ""
"Versions acceptées lues dans shell-version de metadata.json avec tr/grep/sed"
" (sans python3), tableau sur une ou plusieurs lignes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r61
msgid "After a failing step, the migration goes on with the next step"
msgstr "Après une étape en échec, la migration passe à l'étape suivante"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r53
msgid ""
"After a rebuild, the app warns that a newer baseline is available; the user "
"re-promotes (losing the edits) or stays; nothing merges automatically"
msgstr ""
"Après une recompilation, l'application avertit qu'une référence plus récente"
" est disponible ; l'utilisateur repromeut (en perdant ses modifications) ou "
"reste ; rien ne fusionne automatiquement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r63
msgid ""
"After a rebuild, the newly shipped archive replaces a non-editable Cache "
"extraction"
msgstr ""
"Après une recompilation, l'archive nouvellement livrée remplace une "
"extraction non modifiable dans le Cache"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r105
msgid "After autologin, reboot the VM and wait for ssh"
msgstr "Après la connexion automatique, redémarrer la VM et attendre ssh"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r36
msgid ""
"After promotion the slug routes to EditableCodeService, otherwise to "
"BundleCodeService in archive mode"
msgstr ""
"Après la promotion, le slug est dirigé vers EditableCodeService, sinon vers "
"BundleCodeService en mode archive"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r09
msgid ""
"An ENOENT on the top-level readdirSync(root) is caught with a clear message "
"and re-thrown only after one retry"
msgstr ""
"Un ENOENT sur le readdirSync(root) de premier niveau est intercepté avec un "
"message clair et n'est relancé qu'après une nouvelle tentative"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r10
msgid ""
"An ERPLibre runner runs the tests of an Odoo module on a throwaway database "
"and sends each test's verdict to the registry as a Python test"
msgstr ""
"Un lanceur d'ERPLibre lance les tests d'un module Odoo sur une base jetable "
"et envoie le verdict de chaque test au registre comme test Python"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r23
msgid ""
"An activity and a thread are read with their record: an employee reads those"
" of their workstations and of the decks they read, a deck's from their first"
" holding on, never those of another employee's workstation; only a Stream "
"Deck manager modifies or deletes what others posted on a workstation"
msgstr ""
"Une activité et un fil se lisent avec leur enregistrement : un employé lit "
"ceux de ses postes et des decks qu'il lit, ceux d'un deck à partir de sa "
"première détention, jamais ceux du poste d'un autre employé ; seul un "
"gestionnaire Stream Deck modifie ou supprime ce que d'autres ont posté sur "
"un poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r06
msgid ""
"An activity closes by itself, with \"Resolved at <time>\" in its thread, "
"once its problem is solved: deck service running again, workstation heard "
"again, deck plugged in again; never two open activities for one problem"
msgstr ""
"Une activité se ferme seule, « Résolu à <heure> » à son fil, une fois son "
"problème réglé : service du deck reparti, poste revenu, deck rebranché ; "
"jamais deux activités ouvertes pour un même problème"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r21
msgid ""
"An archived workstation and a workstation without token never go silent; "
"archiving it, the departure of its employee, unenrolling it or revoking its "
"token closes its open activities, with \"archived\" or \"unenrolled\", and "
"clears its silent mark"
msgstr ""
"Un poste archivé et un poste sans jeton ne deviennent jamais muets ; "
"l'archiver, le départ de son employé, le désinscrire ou révoquer son jeton "
"ferme ses activités ouvertes, avec « archivé » ou « désinscrit », et efface "
"sa marque de poste muet"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_deploy_r04
msgid ""
"An automatic login on the user's machine would open the session without a "
"password."
msgstr ""
"Une connexion automatique sur le poste de l'utilisateur ouvrirait la session"
" sans mot de passe."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r04
msgid ""
"An employee gets a pairing code in Odoo from Stream Deck › My workstations ›"
" Add a workstation"
msgstr ""
"Un employé obtient un code d'appairage dans Odoo par Stream Deck › Mes "
"postes › Ajouter un poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r10
msgid ""
"An employee reads the events of a deck from the time they first held it: the"
" first holder reads them all, a lender keeps all those from their holding "
"on, those at the borrower included, and a borrower reads none from before "
"their arrival; the manager reads them all"
msgstr ""
"Un employé lit les événements d'un deck à partir du moment où il l'a détenu "
"pour la première fois : le premier détenteur les lit tous, un prêteur garde "
"tous ceux qui suivent sa détention, y compris ceux de l'emprunteur, et un "
"emprunteur n'en lit aucun d'avant son arrivée ; le gestionnaire les lit tous"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r70
msgid "An id listed in DECK_PLUGINS_OFF is never imported"
msgstr "Un identifiant listé dans DECK_PLUGINS_OFF n'est jamais importé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r29
msgid "An inactive poll is not read"
msgstr "Un sondage inactif n'est pas lu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r74
msgid ""
"An init leaving a repo-managed games/ out copies save/ to games.save-<date>/"
msgstr ""
"Un init qui laisse de côté un games/ géré par repo copie save/ dans "
"games.save-<date>/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r79
msgid "An invalid CIDR is skipped with a notification"
msgstr "Un CIDR invalide est ignoré avec une notification"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r71
msgid ""
"An invalid value has no default: Enter does not replace it, an explicit "
"choice is needed"
msgstr ""
"Une valeur invalide n'a pas de défaut : Entrée ne la remplace pas, un choix "
"explicite est nécessaire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r46
msgid ""
"An items() that raises, even midway, contributes no tile; the next providers"
" fill the keys"
msgstr ""
"Un items() qui lève, même en cours de route, n'apporte aucune tuile ; les "
"fournisseurs suivants remplissent les touches"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r110b
msgid "An open error is journaled again when it changes"
msgstr ""
"Une erreur d'ouverture est de nouveau inscrite au journal quand elle change"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r46
msgid "An unanswered permission dialog times out after 30 s"
msgstr "Une boîte de dialogue de permission sans réponse expire après 30 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r33
msgid "An unknown deck rejects no_such_deck"
msgstr "Un deck inconnu est rejeté avec no_such_deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r88
msgid ""
"An unknown settings value is a usage error of whoever wrote it, not silently"
" taken (RESTART_AFTER_GAME accepts yes or no)"
msgstr ""
"Une valeur de réglage inconnue est une erreur d'utilisation de qui l'a "
"écrite, jamais acceptée en silence (RESTART_AFTER_GAME accepte yes ou no)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r48
msgid ""
"An unwritable target raises OSError, which gives an ERR flash and a journal "
"line"
msgstr ""
"Une cible non inscriptible lève OSError, ce qui donne un clignotement ERR et"
" une ligne au journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r29
msgid ""
"Ancestor rule accepts the game PID only when its start time matches; a "
"reused PID of a dead wrapper is not taken for the game"
msgstr ""
"La règle de l'ancêtre n'accepte le PID du jeu que si son heure de démarrage "
"concorde ; le PID réutilisé d'un enrobeur mort n'est pas pris pour le jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r14
msgid ""
"AndroidManifest declares usb.host with required=false, a USB_DEVICE_ATTACHED"
" intent filter and the meta-data @xml/streamdeck_devices"
msgstr ""
"AndroidManifest déclare usb.host avec required=false, un filtre d'intention "
"USB_DEVICE_ATTACHED et la méta-donnée @xml/streamdeck_devices"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r37
msgid "Anti-goal: a report slowed down by the monitoring"
msgstr "Anti-objectif : une remontée ralentie par la surveillance"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r39
msgid ""
"Anti-goal: a secret in clear on the workstation, in its settings or in a log"
msgstr ""
"Anti-objectif : un secret en clair sur le poste, dans ses réglages ou dans "
"un journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r34
msgid ""
"Anti-goal: an activity created while the Settings disable the activities"
msgstr ""
"Anti-objectif : une activité créée alors que les Paramètres désactivent les "
"activités"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r40
msgid ""
"Anti-goal: an employee who sees another employee's workstation; the only "
"exception is the record of a deck their workstation had, and its events, "
"read only"
msgstr ""
"Anti-objectif : un employé qui voit le poste d'un autre ; la seule exception"
" est la fiche d'un deck que son poste a eu, et ses événements, en lecture"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r36
msgid ""
"Anti-goal: an employee who sees the activities or the thread of another "
"employee's workstation"
msgstr ""
"Anti-objectif : un employé qui voit les activités ou le fil du poste d'un "
"autre employé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r41
msgid ""
"Anti-goal: an extension that slows GNOME Shell down when Odoo is slow or "
"absent"
msgstr ""
"Anti-objectif : une extension qui ralentit GNOME Shell quand Odoo est lent "
"ou absent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r35
msgid ""
"Anti-goal: an unenrolled or archived workstation that alerts without end"
msgstr "Anti-objectif : un poste désinscrit ou archivé qui alerte sans fin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r38
msgid ""
"Anti-goal: identifying data in the code, the data, the comments or the "
"commits"
msgstr ""
"Anti-objectif : une donnée identifiante dans le code, les données, les "
"commentaires ou les commits"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r42
msgid ""
"Anti-goal: identifying data in the code, the demo data, the comments or the "
"commits"
msgstr ""
"Anti-objectif : une donnée identifiante dans le code, les données de démo, "
"les commentaires ou les commits"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r33
msgid ""
"Anti-goal: two open activities for one problem, on the same record, of the "
"same type, for the same user"
msgstr ""
"Anti-objectif : deux activités ouvertes pour un même problème, sur le même "
"enregistrement, du même type, pour le même utilisateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r42
msgid ""
"Any other existing directory is left alone (one holding the games, the old "
"repo layout)"
msgstr ""
"Tout autre répertoire existant est laissé tel quel (un répertoire qui "
"contient les jeux, l'ancienne disposition de repo)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r129
msgid "Any settings change triggers a sync"
msgstr "Toute modification des réglages déclenche une synchronisation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r57
msgid "App backgrounded (onPause): sessions stay alive"
msgstr "Application en arrière-plan (onPause) : les sessions restent vivantes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r58
msgid ""
"App destroyed: close every session (app_destroyed) and unregister the "
"receivers"
msgstr ""
"Application détruite : fermer toutes les sessions (app_destroyed) et "
"désinscrire les récepteurs"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r09
msgid ""
"Arch/Tumbleweed may be UNSUPPORTED; any other UNSUPPORTED fails the run"
msgstr ""
"Arch/Tumbleweed peuvent être UNSUPPORTED ; tout autre UNSUPPORTED fait "
"échouer l'exécution"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r08
msgid ""
"Archiving an employee revokes the tokens and archives the workstations; "
"workstations, decks and history stay visible to the manager"
msgstr ""
"Archiver un employé révoque ses jetons et archive ses postes ; postes, decks"
" et historique restent visibles du gestionnaire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r104
msgid ""
"At enable, the sync repository is pulled with git pull --rebase, theirs "
"winning a conflict"
msgstr ""
"À l'activation, le dépôt de synchronisation est tiré par git pull --rebase, "
"la version distante (theirs) l'emportant en cas de conflit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r21
msgid ""
"At shutdown, queued job results are dropped without calling then once "
"running is false"
msgstr ""
"À l'arrêt, les résultats de tâche en attente sont abandonnés sans appeler "
"then une fois running à faux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r21b
msgid ""
"At shutdown, the application sets running to false first, before waiting for"
" the lock"
msgstr ""
"À l'arrêt, l'application met d'abord running à faux, avant d'attendre le "
"verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r04
msgid "Autologin only inside the long test's VMs, never on the user's machine"
msgstr ""
"Connexion automatique seulement dans les VM du test long, jamais sur le "
"poste de l'utilisateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r104
msgid ""
"Autologin per family: ubuntu /etc/gdm3/custom.conf, debian "
"/etc/gdm3/daemon.conf, rhel/arch /etc/gdm/custom.conf [daemon] keys, suse "
"DISPLAYMANAGER_AUTOLOGIN"
msgstr ""
"Connexion automatique par famille : ubuntu /etc/gdm3/custom.conf, debian "
"/etc/gdm3/daemon.conf, rhel/arch clés [daemon] de /etc/gdm/custom.conf, suse"
" DISPLAYMANAGER_AUTOLOGIN"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r54
msgid ""
"Automatic reopen of a deck whose session closed itself: 3 attempts, after 2,"
" 4 and 8 s"
msgstr ""
"Réouverture automatique d'un deck dont la session s'est fermée d'elle-même :"
" 3 tentatives, après 2, 4 et 8 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r59
msgid "Autostart: enable/disable via systemctl --user"
msgstr "Démarrage auto : enable/disable par systemctl --user"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r91
msgid ""
"Backend parsers: wpctl status, bluetoothctl, gdbus tuples, TODO registry "
"pruning, _label_for_timer"
msgstr ""
"Analyseurs des moteurs : wpctl status, bluetoothctl, tuples gdbus, élagage "
"du registre TODO, _label_for_timer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r79
msgid ""
"Base entry runs ./script/install/install_erplibre_home.sh, Stream Deck entry"
" with --stream-deck, live through exec_command_live"
msgstr ""
"L'entrée de base lance ./script/install/install_erplibre_home.sh, l'entrée "
"Stream Deck avec --stream-deck, en direct par exec_command_live"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r103
msgid ""
"Base install: exit 2 -> UNSUPPORTED(<reason>), exit 1 -> FAILED(install), "
"the rest skipped"
msgstr ""
"Installation de base : code de sortie 2 -> UNSUPPORTED(<reason>), code de "
"sortie 1 -> FAILED(install), le reste sauté"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r25
msgid "Base level gets no service"
msgstr "Le niveau de base n'a aucun service"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_defects_r88
msgid ""
"Between concurrent writers of todo_terminals.json, the last write wins. No "
"README states this non-goal."
msgstr ""
"Entre des écrivains concurrents de todo_terminals.json, la dernière écriture"
" l'emporte. Aucun README n'énonce ce non-objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r23
msgid "Binary data crosses the bridge as base64"
msgstr "Les données binaires traversent le pont en base64"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r76
msgid ""
"Bluetooth handlers act on the cached state; without data they flash ERR and "
"start no job"
msgstr ""
"Les gestionnaires Bluetooth agissent sur l'état en cache ; sans donnée, ils "
"font clignoter ERR et ne lancent aucune tâche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r26
msgid ""
"BmpEncoder applies the reference rotation and flips and the Pillow layout, "
"byte-identical"
msgstr ""
"BmpEncoder applique la rotation et les retournements de référence et la "
"disposition de Pillow, à l'octet près"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r85
msgid "Both ticked: only the --stream-deck command runs"
msgstr "Les deux cochées : seule la commande --stream-deck s'exécute"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r94
msgid ""
"CLI --only, --extras (Ubuntu 24.04 only), --dry-run, --garder, --detruire, "
"--detruire --dry-run"
msgstr ""
"Ligne de commande --only, --extras (Ubuntu 24.04 seulement), --dry-run, "
"--garder, --detruire, --detruire --dry-run"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r05
msgid ""
"CONTRACT.md, Command line: --meta prints one JSON object and exits 0 within "
"5 s without opening the deck; the required keys are present; readers ignore "
"unknown keys"
msgstr ""
"CONTRACT.md, ligne de commande : --meta affiche un seul objet JSON et se "
"termine avec le code 0 en moins de 5 s sans ouvrir le deck ; les clés "
"requises sont présentes ; les lecteurs ignorent les clés inconnues"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r04
msgid ""
"CONTRACT.md, Command line: -h and --help exit 0, an unknown argument exits "
"2, both before the PIL and Stream Deck imports"
msgstr ""
"CONTRACT.md, ligne de commande : -h et --help se terminent avec le code 0, "
"un argument inconnu se termine avec le code 2, les deux avant les imports de"
" PIL et de Stream Deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r02
msgid ""
"CONTRACT.md, Description: the first line of a game's module docstring "
"describes the game in one sentence"
msgstr ""
"CONTRACT.md, description : la première ligne de la docstring du module d'un "
"jeu décrit le jeu en une phrase"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r13
msgid ""
"CONTRACT.md, Gallery: GET /api/games returns the --meta objects with id and "
"saves added"
msgstr ""
"CONTRACT.md, galerie : GET /api/games renvoie les objets --meta, avec id et "
"saves ajoutés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r14
msgid ""
"CONTRACT.md, Gallery: GET /launch/<id> answers 2xx when the game starts, "
"otherwise {\"error\": line} with 403 when the games are off and 404 for an "
"unknown id"
msgstr ""
"CONTRACT.md, galerie : GET /launch/<id> répond 2xx quand le jeu démarre, "
"sinon {\"error\": ligne} avec 403 quand les jeux sont désactivés et 404 pour"
" un id inconnu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r12
msgid ""
"CONTRACT.md, Gallery: the gallery serves on port 8042 and the extension "
"talks to it there"
msgstr ""
"CONTRACT.md, galerie : la galerie sert sur le port 8042 et l'extension lui "
"parle à ce port"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r16
msgid ""
"CONTRACT.md, Gallery: the other routes (/stop, /api/restart, /api/saves…) "
"serve the gallery's own page only"
msgstr ""
"CONTRACT.md, galerie : les autres routes (/stop, /api/restart, /api/saves…) "
"ne servent que la page de la galerie elle-même"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r01
msgid ""
"CONTRACT.md, Layout: a game is an executable game_<id>.py at the root of the"
" games repository, <id> matches [a-z0-9]+, and every root game_*.py is a "
"game"
msgstr ""
"CONTRACT.md, disposition : un jeu est un fichier game_<id>.py exécutable à "
"la racine du dépôt des jeux, <id> respecte [a-z0-9]+, et tout game_*.py à la"
" racine est un jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r90
msgid ""
"CONTRACT.md, Playing: a game played without an option exits 0 when the "
"player quits"
msgstr ""
"CONTRACT.md, partie : un jeu lancé sans option se termine avec le code 0 "
"quand le joueur quitte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r06
msgid ""
"CONTRACT.md, Playing: without an option a game opens the first deck and "
"never takes the deck lock itself"
msgstr ""
"CONTRACT.md, partie : sans option, un jeu ouvre le premier deck et ne prend "
"jamais lui-même le verrou du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r22
msgid ""
"CONTRACT.md, Versioning: a change the other side can see bumps MAJOR, an "
"optional addition bumps MINOR"
msgstr ""
"CONTRACT.md, gestion des versions : un changement visible de l'autre côté "
"incrémente MAJOR, un ajout facultatif incrémente MINOR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r20
msgid ""
"CONTRACT.md, what the games rely on: erplibre_home_settings.sh defines "
"deck_games_enabled and deck_games_message"
msgstr ""
"CONTRACT.md, ce dont les jeux dépendent : erplibre_home_settings.sh définit "
"deck_games_enabled et deck_games_message"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r18
msgid ""
"CONTRACT.md, what the games rely on: the ERPLibre checkout root is three "
"levels above the games repository"
msgstr ""
"CONTRACT.md, ce dont les jeux dépendent : la racine du checkout ERPLibre est"
" trois niveaux au-dessus du dépôt des jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r19
msgid ""
"CONTRACT.md, what the games rely on: the hand-over exits 4 when GAMES is not"
" on, before stopping anything"
msgstr ""
"CONTRACT.md, ce dont les jeux dépendent : la passation se termine avec le "
"code 4 quand GAMES n'est pas à on, avant d'arrêter quoi que ce soit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r21
msgid ""
"CONTRACT.md, what the games rely on: the interpreter is "
".venv.streamdeck/bin/python"
msgstr ""
"CONTRACT.md, ce dont les jeux dépendent : l'interpréteur est "
".venv.streamdeck/bin/python"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r28
msgid ""
"CONTROLLER_REL in lib/deck-service.js stays the checkout-relative path "
"script/stream_deck/erplibre_controller.py"
msgstr ""
"CONTROLLER_REL de lib/deck-service.js reste le chemin "
"script/stream_deck/erplibre_controller.py, relatif à la racine du checkout"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r13
msgid ""
"Cache data lives under ~/.cache/erplibre-home/; erplibre_controller.py and "
"indicators/device.js share controller.pid"
msgstr ""
"Les données de cache sont sous ~/.cache/erplibre-home/ ; "
"erplibre_controller.py et indicators/device.js partagent controller.pid"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r26
msgid "Cache entries expire after their TTL; invalidate removes an entry"
msgstr ""
"Les entrées du cache expirent après leur durée de vie (TTL) ; invalidate "
"retire une entrée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r18
msgid ""
"Capability-based API: capabilities are a subset of keys, dials, lcd, "
"infobars and touchpoints"
msgstr ""
"API fondée sur les capacités : les capacités sont un sous-ensemble de keys, "
"dials, lcd, infobars et touchpoints"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r24
msgid "Capitalization rule: ERPLibreHome, erplibre-home, erplibre_home"
msgstr "Règle de casse : ERPLibreHome, erplibre-home, erplibre_home"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r14
msgid ""
"Catalogues are JSON stored in string keys; invalid or non-array JSON reads "
"as []"
msgstr ""
"Les catalogues sont du JSON stocké dans des clés de type chaîne ; un JSON "
"invalide ou qui n'est pas un tableau se lit comme []"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r09
msgid ""
"Checkout quoted for systemd (spaces, % doubled), $ written as is; systemd "
"loads it; refused characters stop the install"
msgstr ""
"Checkout cité pour systemd (espaces, % doublé), $ écrit tel quel ; systemd "
"charge l'unité ; des caractères refusés arrêtent l'installation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r60
msgid ""
"Claude session page: a change of message, description or colour also renders"
msgstr ""
"Page de session Claude : un changement de message, de description ou de "
"couleur déclenche aussi un rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r92
msgid ""
"Claude session status derivation: notification, then stop, then tool, then "
"active"
msgstr ""
"Dérivation de l'état d'une session Claude : notification, puis stop, puis "
"tool, puis active"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r52
msgid ""
"Claude sessions: only non-zero ts_* stamps count toward the oldest stamp"
msgstr ""
"Sessions Claude : seuls les horodatages ts_* non nuls comptent pour le plus "
"ancien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r51
msgid ""
"Claude sessions: the oldest time stamp is born_by; a recycled pid is "
"dropped, the original process is kept"
msgstr ""
"Sessions Claude : l'horodatage le plus ancien sert de born_by ; un pid "
"recyclé est écarté, le processus d'origine est gardé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r102
msgid ""
"Code step: install git with the family manager, scp the bundle, git clone "
"<bundle> ~/git/erplibre, checkout <HEAD sha>; never GitHub"
msgstr ""
"Étape du code : installer git avec le gestionnaire de la famille, scp du "
"bundle, git clone <bundle> ~/git/erplibre, checkout <HEAD sha> ; jamais "
"GitHub"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r17
msgid ""
"Concurrent ensureExtracted calls for one slug share a single in-flight "
"promise"
msgstr ""
"Des appels concurrents d'ensureExtracted pour un même slug partagent une "
"seule promesse en cours"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r11
msgid "Configuration data lives under ~/.config/erplibre-home/"
msgstr "Les données de configuration sont sous ~/.config/erplibre-home/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r126
msgid "Configured hosts show only when network-read-ssh-config is on"
msgstr ""
"Les hôtes configurés ne s'affichent que si network-read-ssh-config est "
"activé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r23
msgid ""
"Context members: geo, set_key, goto/home, render, dbus, settings, style, t"
msgstr ""
"Membres du contexte : geo, set_key, goto/home, render, dbus, settings, "
"style, t"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r91
msgid ""
"Contract 1.1: /launch/<id> answers 503 with an error line when no terminal "
"can run the game; the extension shows that line"
msgstr ""
"Contrat 1.1 : /launch/<id> répond 503 avec une ligne d'erreur quand aucun "
"terminal ne peut lancer le jeu ; l'extension affiche cette ligne"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r95
msgid ""
"Contract 1.1: ERPLibre never reads the saves, so moving them is a contract "
"1.1 change, not 2.0"
msgstr ""
"Contrat 1.1 : ERPLibre ne lit jamais les sauvegardes, leur déplacement est "
"donc un changement de contrat 1.1, et non 2.0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r11
msgid ""
"Contract 1.1: saves live in $XDG_DATA_HOME/erplibre-home/streamdeck/save/; "
"files of the former save/ move there, never over an existing file; djscratch"
" finds its recorded WAV paths again"
msgstr ""
"Contrat 1.1 : les sauvegardes vivent dans $XDG_DATA_HOME/erplibre-"
"home/streamdeck/save/ ; les fichiers de l'ancien save/ y sont déplacés, "
"jamais par-dessus un fichier existant ; djscratch retrouve les chemins WAV "
"qu'il a enregistrés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r78
msgid ""
"Contract 1.1: the games repository stands alone (README, requirements hint; "
"without ERPLibre the gallery reads no GAMES setting and runs no hand-over)"
msgstr ""
"Contrat 1.1 : le dépôt des jeux est autonome (README, indication sur les "
"dépendances ; sans ERPLibre, la galerie ne lit aucun réglage GAMES et ne "
"lance aucune passation)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r65
msgid ""
"Contract 2.0: the extension sends X-Stream-Deck-Gallery: 1 on /launch/<id>"
msgstr ""
"Contrat 2.0 : l'extension envoie X-Stream-Deck-Gallery: 1 sur /launch/<id>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r66
msgid ""
"Contracts 1.2 and 2.0: the gallery listens on 127.0.0.1 only, checks Host "
"and Sec-Fetch-Site, and requires its header on routes that act, which a "
"client without Sec-Fetch-Site cannot add"
msgstr ""
"Contrats 1.2 et 2.0 : la galerie n'écoute que sur 127.0.0.1, vérifie Host et"
" Sec-Fetch-Site, et exige son en-tête sur les routes qui agissent, en-tête "
"qu'un client sans Sec-Fetch-Site ne peut pas ajouter"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r67
msgid "Copy hostname and Copy IP copy the host's name and address"
msgstr ""
"« Copier le nom d'hôte » et « Copier l'IP » copient le nom et l'adresse de "
"l'hôte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r58
msgid ""
"Copy username and Copy password read the entry through keepassxc-cli and put"
" it in St.Clipboard"
msgstr ""
"« Copier le nom d'utilisateur » et « Copier le mot de passe » lisent "
"l'entrée par keepassxc-cli et la placent dans St.Clipboard"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r35
msgid "Custom… opens a modal text dialog and runs the typed command"
msgstr ""
"« Personnalisé… » ouvre une boîte de dialogue modale de saisie et lance la "
"commande tapée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r04
msgid ""
"D-Bus signatures: OpenPath(s)->b, OpenFilm(s,s)->b, OpenInstance(s,s)->b, "
"ScanNetwork()->s, ListDevices/ListPaths/ListFilms/ListInstances()->s"
msgstr ""
"Signatures D-Bus : OpenPath(s)->b, OpenFilm(s,s)->b, OpenInstance(s,s)->b, "
"ScanNetwork()->s, ListDevices/ListPaths/ListFilms/ListInstances()->s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r80
msgid ""
"DECK_PLUGINS_OFF defaults to ''; deck_plugin_ids gives the file stems of "
"both plugin directories, sorted, without importing them"
msgstr ""
"DECK_PLUGINS_OFF vaut '' par défaut ; deck_plugin_ids donne les noms de "
"fichier sans extension des deux répertoires de plugins, triés, sans les "
"importer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r78
msgid ""
"DECK_PLUGINS_OFF is a comma-separated list, blanks allowed, empty by "
"default; the shell and Python read it the same way"
msgstr ""
"DECK_PLUGINS_OFF est une liste séparée par des virgules, espaces permises, "
"vide par défaut ; le shell et Python la lisent de la même façon"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r68
msgid "DECK_PLUGINS_OFF is read through the shell settings library"
msgstr "DECK_PLUGINS_OFF est lu par la bibliothèque de réglages shell"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r85
msgid ""
"DECK_PROGRAM defaults to tiler; the service unit knows the exit codes 2, 3 "
"and 143"
msgstr ""
"DECK_PROGRAM vaut tiler par défaut ; l'unité du service connaît les codes de"
" sortie 2, 3 et 143"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r04
msgid ""
"DECK_PROGRAM tiler (default) / controller / none, each mapped to its script "
"(the tiler is the package erplibre_streamdeck)"
msgstr ""
"DECK_PROGRAM tiler (défaut) / controller / none, chacun associé à son script"
" (le tiler est le paquet erplibre_streamdeck)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r05
msgid ""
"DECK_PROGRAM=tiler keeps its value and meaning: tiler maps to the deck "
"program, controller to erplibre_controller.py"
msgstr ""
"DECK_PROGRAM=tiler garde sa valeur et son sens : tiler désigne le programme "
"du deck, controller désigne erplibre_controller.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r61
msgid ""
"DECK_SESSION_REFRESH_SEC accepts 0.5 to 60 and defaults to 1; an invalid "
"value gives 1"
msgstr ""
"DECK_SESSION_REFRESH_SEC accepte de 0.5 à 60 et vaut 1 par défaut ; une "
"valeur invalide donne 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r34
msgid ""
"DEFAULTS['GAMES'] is 'on' and GAMES_VALUES is ('on', 'off'); the shell and "
"Python read the same values from DEFAULTS"
msgstr ""
"DEFAULTS['GAMES'] vaut 'on' et GAMES_VALUES vaut ('on', 'off') ; le shell et"
" Python lisent les mêmes valeurs à partir de DEFAULTS"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r48
msgid "DRM sites play in the browser only, and the README says so"
msgstr ""
"Les sites à DRM ne se lisent que dans le navigateur, et le README le dit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r59
msgid ""
"Dashboard keys are the keys left from row 1 on; provider orders are mpv 10, "
"claude 20, timers 30, todo 40"
msgstr ""
"Les touches du tableau de bord sont les touches restantes à partir de la "
"rangée 1 ; les ordres des fournisseurs sont mpv 10, claude 20, timers 30, "
"todo 40"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r76
msgid ""
"Decisions: direct HID over USB OTG, capability-based API, serial number as "
"persistent identity, TypeScript canvas encoding with a Java BMP fallback"
msgstr ""
"Décisions : HID direct par USB OTG, API fondée sur les capacités, numéro de "
"série comme identité persistante, encodage par canvas en TypeScript avec "
"repli BMP en Java"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_defects
msgid "Deck defects"
msgstr "Défauts du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r44
msgid ""
"Deck keys sn:<serial> and nosn:<workstation>:<product>:<port> cannot "
"collide, and a serial outside [A-Za-z0-9._-]{1,64} is refused 400 "
"bad_request"
msgstr ""
"Les clés de deck sn:<numéro> et nosn:<poste>:<produit>:<port> ne peuvent pas"
" se confondre, et un numéro de série hors de [A-Za-z0-9._-]{1,64} est refusé"
" en 400 bad_request"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r26
msgid "Deck lock at $XDG_RUNTIME_DIR/erplibre-home/deck.lock"
msgstr "Verrou du deck dans $XDG_RUNTIME_DIR/erplibre-home/deck.lock"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_plugin
msgid "Deck plugin package"
msgstr "Paquet de plugins du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r60
msgid ""
"Deck program rewrites DECK_PROGRAM and restarts the unit only when it was "
"active"
msgstr ""
"Programme du deck réécrit DECK_PROGRAM et ne relance l'unité que si elle "
"était active"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_service
msgid "Deck service and menu"
msgstr "Service et menu du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r81
msgid ""
"DeckInfo shape: deckId, model, productId, rows, cols, keyCount, "
"keyImage{w,h,format}, dialCount, lcd (Plus), infoBars (Neo), touchPoints, "
"firmwareVersion, capabilities"
msgstr ""
"Forme de DeckInfo : deckId, model, productId, rows, cols, keyCount, "
"keyImage{w,h,format}, dialCount, lcd (Plus), infoBars (Neo), touchPoints, "
"firmwareVersion, capabilities"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r58
msgid ""
"DecompressionStream needs WebView 80 or later; a device without it gets a "
"clear error"
msgstr ""
"DecompressionStream exige une WebView 80 ou plus récente ; un appareil qui "
"ne l'a pas reçoit une erreur claire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r10
msgid ""
"Default top-bar order: summary, device, network, erplibre, media, pencil, "
"controller"
msgstr ""
"Ordre par défaut de la barre du haut : summary, device, network, erplibre, "
"media, pencil, controller"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r56
msgid "Design documents written before the rename keep their file names"
msgstr ""
"Les documents de conception antérieurs au renommage gardent leurs noms de "
"fichier"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r101
msgid ""
"Desktop through _qemu_erplibre_remote_cmd(None, desktop='gnome') (desktop "
"only, no clone, no Odoo)"
msgstr ""
"Bureau par _qemu_erplibre_remote_cmd(None, desktop='gnome') (bureau "
"seulement, sans clone, sans Odoo)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r01
msgid ""
"Detect supported Elgato models over USB OTG (vendor 0x0fd9), several decks "
"at once via a hub"
msgstr ""
"Détecter les modèles Elgato pris en charge par USB OTG (fournisseur 0x0fd9),"
" plusieurs decks à la fois par un concentrateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r88
msgid "Device Status and Show details open as modals"
msgstr ""
"« Statut » de l'indicateur « Périphérique » et « Afficher les détails » "
"s'ouvrent en fenêtres modales"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r56
msgid ""
"Diagnosis runs the same probes and prints the fixing command for each probe "
"not as expected (make erplibre_home_streamdeck_install, log out and back in,"
" systemctl --user start …)"
msgstr ""
"Diagnostic lance les mêmes sondes et affiche la commande qui corrige chaque "
"sonde hors de l'attendu (make erplibre_home_streamdeck_install, fermer puis "
"rouvrir la session, systemctl --user start …)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r44
msgid ""
"Diagnosis: for a game, close the game first; last resort kill on every "
"process holding the lock"
msgstr ""
"Diagnostic : pour un jeu, fermer d'abord le jeu ; en dernier recours, kill "
"sur chaque processus qui tient le verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r66
msgid ""
"Diagnostic API: listAllUsbDevices, requestPermissionForUsb, setDebugLogging "
"with rawInputReport, setReaderMode/getReaderMode applied at the next open, "
"legacy setReaderUseBulk/getReaderUseBulk"
msgstr ""
"API de diagnostic : listAllUsbDevices, requestPermissionForUsb, "
"setDebugLogging avec rawInputReport, setReaderMode/getReaderMode appliqués à"
" la prochaine ouverture, setReaderUseBulk/getReaderUseBulk hérités"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_ext_r121
msgid ""
"Dragging reorders whole indicators through button-order; reordering single "
"rows of the legacy menus is out of scope. The README does not state this "
"non-goal."
msgstr ""
"Le glisser-déposer réordonne des indicateurs entiers par button-order ; "
"réordonner une à une les lignes des anciens menus est hors du périmètre. Le "
"README n'énonce pas ce non-objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r54
msgid ""
"EPEL (dnf install -y epel-release) only on AlmaLinux/Rocky and only with "
"--stream-deck"
msgstr ""
"EPEL (dnf install -y epel-release) seulement sur AlmaLinux/Rocky et "
"seulement avec --stream-deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r52
msgid ""
"ERPLIBRE_HOME_OS_RELEASE and ERPLIBRE_HOME_GNOME_VERSION override the two "
"reads"
msgstr ""
"ERPLIBRE_HOME_OS_RELEASE et ERPLIBRE_HOME_GNOME_VERSION remplacent les deux "
"lectures"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_deploy
msgid "ERPLibre Home deployment"
msgstr "Déploiement d'ERPLibre Home"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_rename
msgid "ERPLibre Home rename"
msgstr "Renommage en ERPLibre Home"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r35
msgid ""
"ERPLibre tracks nothing under script/stream_deck/games/ and ignores the path"
msgstr ""
"ERPLibre ne suit rien sous script/stream_deck/games/ et ignore ce chemin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r05
msgid ""
"ERPLibre's bundle checker handles the archive layout: the archive key, the "
"indexUrl sidecar, './'-prefixed tar members, and every promised file present"
" (a missing one is refused)"
msgstr ""
"Le vérificateur de bundle d'ERPLibre gère la disposition en archive : la clé"
" archive, l'index compagnon indexUrl, les membres tar préfixés par './', et "
"la présence de chaque fichier promis (un fichier manquant est refusé)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r05b
msgid ""
"ERPLibre's bundle checker refuses a manifest fileCount that differs from the"
" number of files in the index"
msgstr ""
"Le vérificateur de bundle d'ERPLibre refuse un fileCount du manifeste qui "
"diffère du nombre de fichiers de l'index"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r01b
msgid ""
"ERPLibre's bundle checker refuses a repository that has neither archive nor "
"pack, and names the expected pack"
msgstr ""
"Le vérificateur de bundle d'ERPLibre refuse un dépôt qui n'a ni archive ni "
"paquet, et nomme le paquet attendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r79
msgid "ERPLibre's side of the games is documented in doc/streamdeck_game.md"
msgstr "Le côté ERPLibre des jeux est documenté dans doc/streamdeck_game.md"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r25
msgid ""
"ERPLibre's tests check that games_contract and the clone's CONTRACT_VERSION "
"share MAJOR"
msgstr ""
"Les tests d'ERPLibre vérifient que games_contract et le CONTRACT_VERSION du "
"clone partagent le même MAJOR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r62
msgid ""
"ERPLibre-side tests run in a reduced checkout (test/streamdeck_checkout.py, "
"a fake games/ with games_cli.py), with one test per entry point for an "
"absent games/"
msgstr ""
"Les tests côté ERPLibre s'exécutent dans un checkout réduit "
"(test/streamdeck_checkout.py, un faux games/ avec games_cli.py), avec un "
"test par point d'entrée pour un games/ absent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r101
msgid "Each .po compiles to locale/<lang>/LC_MESSAGES/<domain>.mo"
msgstr "Chaque .po se compile en locale/<lang>/LC_MESSAGES/<domain>.mo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r84
msgid ""
"Each after-phase block runs its installer in the VM checkout chained with &&"
" (failure makes the VM red)"
msgstr ""
"Chaque bloc de la phase after lance son installateur dans le checkout de la "
"VM, enchaîné par && (un échec met la VM au rouge)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r03
msgid ""
"Each archive carries index.json at its root, and a sidecar {slug}.index.json"
" sits next to the archive"
msgstr ""
"Chaque archive porte index.json à sa racine, et un index compagnon "
"{slug}.index.json se trouve à côté de l'archive"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r35
msgid "Each bulk OUT page has a 500 ms timeout"
msgstr "Chaque page bulk OUT a un délai d'expiration de 500 ms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r21
msgid ""
"Each call carries its protocol version MAJOR.MINOR (1.0): Odoo refuses an "
"unknown MAJOR with a code the extension shows, and accepts a newer MINOR, "
"ignoring the keys it does not know"
msgstr ""
"Chaque appel porte sa version de protocole MAJEUR.MINEUR (1.0) : Odoo refuse"
" une MAJEURE inconnue avec un code que l'extension affiche, et accepte une "
"MINEURE plus récente en ignorant les clés qu'il ne connaît pas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r93
msgid ""
"Each command and check writes '── contrôle <name> : réussi/ÉCHEC', then its "
"commands; a failure adds each raw reply"
msgstr ""
"Chaque commande et chaque contrôle écrit '── contrôle <name> : "
"réussi/ÉCHEC', puis ses commandes ; un échec ajoute chaque réponse brute"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r19
msgid "Each game target runs script/stream_deck/games/game_<id>.py"
msgstr "Chaque cible de jeu lance script/stream_deck/games/game_<id>.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r29
msgid "Each indicator has a default symbolic icon"
msgstr "Chaque indicateur a une icône symbolique par défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r103
msgid "Each indicator's destroy() cleans up, and disable() destroys them all"
msgstr ""
"Le destroy() de chaque indicateur fait le ménage, et disable() les détruit "
"tous"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r01
msgid ""
"Each manifest repository ships as one .tar.gz archive, not as loose files, "
"so the APK stays under the ZIP entry limit"
msgstr ""
"Chaque dépôt du manifeste est livré en une seule archive .tar.gz, et non en "
"fichiers épars, pour que l'APK reste sous la limite d'entrées ZIP"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r04
msgid ""
"Each manifest.json entry carries url, name, path, slug, revision, "
"archive=repos/{slug}.tar.gz, indexUrl=repos/{slug}.index.json, fileCount, "
"uncompressedBytes and compressedBytes"
msgstr ""
"Chaque entrée de manifest.json porte url, name, path, slug, revision, "
"archive=repos/{slug}.tar.gz, indexUrl=repos/{slug}.index.json, fileCount, "
"uncompressedBytes et compressedBytes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r34
msgid ""
"Each page tick runs at its own period, with its own stamps cleared at loop "
"start; the first pass runs every due tick"
msgstr ""
"Chaque tick de page tourne à sa propre période, avec ses propres horodatages"
" effacés au début de la boucle ; le premier passage exécute chaque tick dû"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r28
msgid "Each poll keeps its own time stamp"
msgstr "Chaque sondage garde son propre horodatage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r17
msgid ""
"Each problem has its own activity type, four noupdate types that serve as "
"the key against duplicates and filter My activities by problem; only the "
"monitoring opens activities of these types"
msgstr ""
"Chaque problème a son propre type d'activité, quatre types noupdate qui "
"servent de clé contre les doublons et filtrent Mes activités par problème ; "
"seule la surveillance ouvre des activités de ces types"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r93
msgid "Each reference file names its inputs"
msgstr "Chaque fichier de référence nomme ses entrées"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r37
msgid ""
"Editable files live under Directory.Data repos/{slug}/; listDir hides .git; "
"readFile decodes base64 to UTF-8"
msgstr ""
"Les fichiers modifiables vivent sous Directory.Data repos/{slug}/ ; listDir "
"masque .git ; readFile décode le base64 en UTF-8"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r20
msgid "Enable only with --autostart; the installer never starts the unit"
msgstr ""
"Activation (enable) seulement avec --autostart ; l'installateur ne démarre "
"jamais l'unité"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r61
msgid ""
"Enable: UUID added to enabled-extensions without duplicate, removed from "
"disabled-extensions first, disable-user-extensions false"
msgstr ""
"Activation : UUID ajouté à enabled-extensions sans doublon, retiré d'abord "
"de disabled-extensions, disable-user-extensions à false"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r02
msgid ""
"Enabled means ACTIVE in a running session: GetExtensionInfo state 1 and "
"empty error; enabled-extensions alone is not enough"
msgstr ""
"Activée signifie ACTIVE dans une session ouverte : GetExtensionInfo à l'état"
" 1 et error vide ; enabled-extensions seul ne suffit pas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r19
msgid ""
"Enabling the activities for the manager or for both needs a named manager, "
"chosen among the Stream Deck managers; a manager archived since gets "
"nothing, a warning without name is logged, and the employee part is still "
"created"
msgstr ""
"Activer les activités pour le gestionnaire ou pour les deux demande un "
"gestionnaire nommé, choisi parmi les gestionnaires Stream Deck ; un "
"gestionnaire archivé depuis ne reçoit rien, un avertissement sans nom est "
"journalisé, et la part de l'employé est créée quand même"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r15
msgid ""
"Events are born on the workstation, dated and with a unique id, and Odoo "
"keeps each id once; the full state sent with them sets the current "
"inventory, and Odoo never infers an event from a state change"
msgstr ""
"Les événements naissent sur le poste, datés et avec un identifiant unique, "
"et Odoo garde chaque identifiant une fois ; l'état complet envoyé avec eux "
"fait l'inventaire courant, et Odoo ne déduit jamais un événement d'un écart "
"d'état"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r127
msgid "Every UI and notification string is wrapped in _()"
msgstr "Chaque chaîne d'interface et de notification est enveloppée dans _()"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r17
msgid ""
"Every deck Makefile entry point runs $(STREAMDECK_PY); unittest targets "
"$(STREAMDECK_PY) -m unittest; vosk via $(STREAMDECK_PY) -m pip install vosk,"
" never pip install --user"
msgstr ""
"Chaque point d'entrée du deck dans le Makefile lance $(STREAMDECK_PY) ; les "
"cibles unittest, $(STREAMDECK_PY) -m unittest ; vosk par $(STREAMDECK_PY) -m"
" pip install vosk, jamais pip install --user"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r02
msgid ""
"Every feature is a plugin, found by a directory scan, that exposes PLUGIN; "
"the repository ships 11 plugins"
msgstr ""
"Chaque fonction est un plugin, trouvé par un balayage de répertoire, qui "
"expose PLUGIN ; le dépôt livre 11 plugins"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r50
msgid ""
"Every game and the gallery: same argparse rules; the gallery adds its exit "
"codes, a game says how the deck is handed over; neither scans the games nor "
"serves"
msgstr ""
"Chaque jeu et la galerie : mêmes règles argparse ; la galerie ajoute ses "
"codes de sortie, un jeu dit comment le deck est cédé ; aucun ne parcourt les"
" jeux ni ne sert"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r59
msgid ""
"Every game is executable, starts with its shebang, answers --meta and "
"imports no sibling module but games_cli; no game holds sys.path code"
msgstr ""
"Chaque jeu est exécutable, commence par son shebang, répond à --meta et "
"n'importe aucun module voisin sauf games_cli ; aucun jeu ne contient de code"
" sys.path"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r63
msgid ""
"Every label/message has fr and en keys in todo_i18n.py; test_todo_menu "
"follows the structure"
msgstr ""
"Chaque libellé et message a ses clés fr et en dans todo_i18n.py ; "
"test_todo_menu suit la structure"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r38b
msgid "Every launch pushes its path to recent-paths"
msgstr "Chaque lancement ajoute son chemin à recent-paths"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r53
msgid "Every new TODO string has a French and an English text"
msgstr ""
"Chaque nouvelle chaîne de TODO a un texte français et un texte anglais"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r16
msgid ""
"Every path goes through paths.py; REPO_ROOT/script/todo/todo.py and "
"STREAM_DECK_DIR/translator_stream.py exist"
msgstr ""
"Chaque chemin passe par paths.py ; REPO_ROOT/script/todo/todo.py et "
"STREAM_DECK_DIR/translator_stream.py existent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r27
msgid ""
"Every relative path the extension's READMEs name resolves inside the "
"extension's repository"
msgstr ""
"Chaque chemin relatif que nomment les README de l'extension se résout dans "
"le dépôt de l'extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r26
msgid ""
"Every render, handle, tick, home_tick, tile and fixture callback runs with "
"the kernel lock held"
msgstr ""
"Chaque rappel render, handle, tick, home_tick, tile et fixture s'exécute "
"avec le verrou du noyau tenu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r93
msgid ""
"Every streamdeck_<game> target sits behind streamdeck_games_guard, which "
"refuses with GAMES off while the deck program target runs"
msgstr ""
"Chaque cible streamdeck_<game> passe par streamdeck_games_guard, qui refuse "
"quand GAMES est à off, alors que la cible du programme du deck, elle, "
"s'exécute"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r52b
msgid ""
"Exact submenu positions [1] Games, [2] Status, [3] Service, [4] Deck "
"program, [5] Autostart, [6] Diagnosis, [7] Install local, [8] Install Stream"
" Deck local, [9] Uninstall, [10] Extension"
msgstr ""
"Positions exactes du sous-menu : [1] Jeux, [2] État, [3] Service, [4] "
"Programme du deck, [5] Démarrage auto, [6] Diagnostic, [7] Installation "
"locale, [8] Installation Stream Deck locale, [9] Désinstallation, [10] "
"Extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r12
msgid ""
"ExecStart execs the venv python on the program; the entry point does not "
"hold the lock itself"
msgstr ""
"ExecStart exécute (exec) le python du venv sur le programme ; le point "
"d'entrée ne tient pas lui-même le verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r86
msgid ""
"ExecStart passes no argument, so under the unit exit 2 still means a busy "
"lock and RestartPreventExitStatus=2 3 keeps its meaning"
msgstr ""
"ExecStart ne passe aucun argument : sous l'unité, le code de sortie 2 "
"signifie toujours un verrou occupé et RestartPreventExitStatus=2 3 garde son"
" sens"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r53
msgid ""
"Execute holds no install entry of its own: the two install methods run from "
"submenu entries [7]/[8], unchanged in behaviour"
msgstr ""
"Exécution n'a aucune entrée d'installation à elle : les deux méthodes "
"d'installation se lancent des entrées [7]/[8] du sous-menu, au comportement "
"inchangé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r13
msgid ""
"Exit 2 (lock taken) and 3 (no visual deck) are not restarted; they are "
"deck_lock.BUSY_EXIT / NO_DECK_EXIT"
msgstr ""
"Les codes de sortie 2 (verrou pris) et 3 (aucun deck visuel) n'entraînent "
"aucune relance ; ce sont deck_lock.BUSY_EXIT / NO_DECK_EXIT"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r80
msgid "Exit 2 shows the UNSUPPORTED: reason, not a stack of errors"
msgstr ""
"Le code de sortie 2 affiche la raison UNSUPPORTED:, pas une pile d'erreurs"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r45
msgid ""
"Exit codes 0/2/1: 2 with one stderr line 'UNSUPPORTED: ...'; the EXIT trap "
"maps foreign codes (100, 127, 2) to 1"
msgstr ""
"Codes de sortie 0/2/1 : 2 avec une seule ligne stderr 'UNSUPPORTED: ...' ; "
"le piège EXIT ramène les codes étrangers (100, 127, 2) à 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r08
msgid ""
"Expected GNOME is a claim: measured on every VM, mismatch reported, table "
"corrected from reports"
msgstr ""
"Le GNOME attendu est une hypothèse : mesuré sur chaque VM, l'écart signalé, "
"la table corrigée d'après les rapports"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r110
msgid "Export and Reset cover every schema key"
msgstr "« Exporter » et « Réinitialiser » couvrent chaque clé du schéma"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r64
msgid ""
"Extension Start deck program: systemctl --user start on the unit when its "
"file exists, direct controller launch otherwise; Restart deck restarts the "
"unit in the same case"
msgstr ""
"Démarrer le programme du deck, dans l'extension : systemctl --user start sur"
" l'unité quand son fichier existe, sinon lancement direct du contrôleur ; "
"Redémarrer le deck relance l'unité dans le même cas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r118
msgid ""
"Extension detection on a real GNOME session (TileWindow in the D-Bus "
"introspection)"
msgstr ""
"Détection de l'extension dans une vraie session GNOME (TileWindow dans "
"l'introspection D-Bus)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r62
msgid ""
"Extension entry: make erplibre_home_reload or gnome-extensions prefs "
"erplibre-home@technolibre.ca"
msgstr ""
"Entrée Extension : make erplibre_home_reload ou gnome-extensions prefs "
"erplibre-home@technolibre.ca"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r65
msgid ""
"Extension reads ActiveState, SubState, Result, ExecMainCode, ExecMainStatus "
"in a bounded series after a start, without blocking the shell; gaps <= "
"RestartSec=3"
msgstr ""
"L'extension lit ActiveState, SubState, Result, ExecMainCode, ExecMainStatus "
"en une série bornée après un démarrage, sans bloquer le shell ; écarts <= "
"RestartSec=3"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r57
msgid ""
"Extension step runs tools/migrate_legacy.py first, every run, before the "
"symlink; once per install whatever the entry point"
msgstr ""
"L'étape de l'extension lance tools/migrate_legacy.py d'abord, à chaque "
"exécution, avant le lien symbolique ; une fois par installation, quel que "
"soit le point d'entrée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r66
msgid ""
"Extracted files have the right contents: the base64 of the tar entry bytes"
msgstr ""
"Les fichiers extraits ont le bon contenu : le base64 des octets de l'entrée "
"tar"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r24
msgid ""
"Extraction creates the directories once beforehand and writes in parallel, "
"in Promise.all chunks of 16"
msgstr ""
"L'extraction crée les répertoires une seule fois au préalable et écrit en "
"parallèle, par lots Promise.all de 16"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r23
msgid ""
"Extraction emits a progress event {slug, written, total, currentPath} per "
"entry, so the UI shows a progress bar"
msgstr ""
"L'extraction émet un événement de progression {slug, written, total, "
"currentPath} par entrée, pour que l'interface affiche une barre de "
"progression"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r15
msgid ""
"Feature reports: brightness 0x03 0x08 <pct> clamped to 0..100, reset 0x03 "
"0x02 (SET_REPORT 0x21)"
msgstr ""
"Rapports de fonctionnalité : luminosité 0x03 0x08 <pct> bornée à 0..100, "
"réinitialisation 0x03 0x02 (SET_REPORT 0x21)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r66
msgid ""
"Files starting with _ are skipped; a file stem that is not a valid id is "
"refused"
msgstr ""
"Les fichiers qui commencent par _ sont ignorés ; un nom de fichier qui n'est"
" pas un identifiant valide est refusé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r106
msgid ""
"Five stages in order on the same VM, each with its command and checks; check"
" names unique"
msgstr ""
"Cinq étapes dans l'ordre sur la même VM, chacune avec sa commande et ses "
"contrôles ; noms de contrôle uniques"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r55b
msgid "Fixture orders: mic 10, layout shortcuts 20"
msgstr "Ordres des fixtures : micro 10, raccourcis de disposition 20"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r90
msgid ""
"Follow-up sub-projects: TypeScript service, Bluetooth plugin, port of the "
"Tiler modes without TILE, LAYOUT and DEV RELOAD"
msgstr ""
"Sous-projets de suivi : service TypeScript, plugin Bluetooth, portage des "
"modes du Tiler sans TILE, LAYOUT ni DEV RELOAD"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r83
msgid ""
"Follow-up: the extension hides its Games submenu when the games are absent"
msgstr ""
"Suivi : l'extension masque son sous-menu des jeux quand les jeux sont "
"absents"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r34
msgid "Fresh runs claude in the path"
msgstr "Fresh lance claude dans le chemin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r62
msgid ""
"GAMES is set from TODO › Stream Deck › Games on/off or by hand in the "
"settings file. install_erplibre_home.sh has no option for it, as "
"erplibre:script/stream_deck/INSTALL.base.md describes."
msgstr ""
"GAMES se règle depuis TODO › Stream Deck › Jeux on/off ou à la main dans le "
"fichier de réglages. install_erplibre_home.sh n'a aucune option pour lui, "
"comme le décrit erplibre:script/stream_deck/INSTALL.base.md."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r31
msgid ""
"GAMES lives in erplibre-home/streamdeck.conf under $XDG_CONFIG_HOME, or "
"under ~/.config when that variable is unset"
msgstr ""
"GAMES vit dans erplibre-home/streamdeck.conf sous $XDG_CONFIG_HOME, ou sous "
"~/.config quand cette variable n'est pas définie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r46
msgid ""
"GAMES never gates the deck entry point's --check, make streamdeck, "
"streamdeck_erplibre, streamdeck_tiler, streamdeck_translator_doctor or "
"streamdeck_gallery"
msgstr ""
"GAMES ne bloque jamais le --check du point d'entrée du deck, make "
"streamdeck, streamdeck_erplibre, streamdeck_tiler, "
"streamdeck_translator_doctor ni streamdeck_gallery"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r70
msgid "GAMES never gates the deck entry point's launch path, outside --check"
msgstr ""
"GAMES ne bloque jamais le chemin de lancement du point d'entrée du deck, "
"hors --check"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r69
msgid ""
"GAMES never gates the other translator targets (streamdeck_translator_test, "
"_stream, _unittest, _install_*)"
msgstr ""
"GAMES ne bloque jamais les autres cibles du traducteur "
"(streamdeck_translator_test, _stream, _unittest, _install_*)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r32
msgid ""
"GAMES=on or no GAMES line enables the games; off disables them; any other "
"value, an empty GAMES= included, disables them"
msgstr ""
"GAMES=on ou l'absence de ligne GAMES active les jeux ; off les désactive ; "
"toute autre valeur, GAMES= vide compris, les désactive"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r36
msgid ""
"GJS readLink built on Gio.File.query_info('standard::symlink-target', "
"NOFOLLOW_SYMLINKS); Gio injected, never statically imported"
msgstr ""
"readLink GJS bâti sur Gio.File.query_info('standard::symlink-target', "
"NOFOLLOW_SYMLINKS) ; Gio injecté, jamais importé statiquement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_ext
msgid "GNOME extension indicators"
msgstr "Indicateurs de l'extension GNOME"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r13
msgid ""
"GSettings defaults for the catalogues, terminal-claude-cmd, erplibre-*, "
"network-*, device-auto-refresh-sec, icon-overrides, git sync, schema-version"
" 1 and migration-done false"
msgstr ""
"Valeurs par défaut GSettings des catalogues, de terminal-claude-cmd, "
"erplibre-*, network-*, device-auto-refresh-sec, icon-overrides, de la "
"synchronisation git, de schema-version 1 et de migration-done false"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r48
msgid ""
"Gallery launcher (gallery_server.py, _game_bash_cmd) runs each game through "
"the helper; the restart loop (r + Enter) stays inside one hand-over"
msgstr ""
"Le lanceur de la galerie (gallery_server.py, _game_bash_cmd) lance chaque "
"jeu par l'outil de passation ; la boucle de relance (r + Entrée) reste dans "
"une seule passation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_grepo
msgid "Games repository"
msgstr "Dépôt des jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_gsplit
msgid "Games split"
msgstr "Séparation des jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r25
msgid ""
"Generated .md and .fr.md files are rebuilt with mmg from their .base.md, "
"never edited by hand"
msgstr ""
"Les fichiers .md et .fr.md générés se reconstruisent avec mmg à partir de "
"leur .base.md, jamais à la main"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r77
msgid "Goal: a new model needs only a new DeckSpec"
msgstr "Objectif : un nouveau modèle ne demande qu'un nouveau DeckSpec"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r35b
msgid "HOME_REFRESH_SEC = 2.0: the home screen redraws every two seconds"
msgstr ""
"HOME_REFRESH_SEC = 2.0 : l'écran d'accueil se redessine toutes les deux "
"secondes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r30
msgid ""
"Hand-over step 1: an active unit, or activating while it waits to restart, "
"is stopped and remembered"
msgstr ""
"Passation, étape 1 : une unité active, ou en activation pendant qu'elle "
"attend sa relance, est arrêtée et retenue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r31
msgid ""
"Hand-over step 2: the command runs in the foreground under the lock held as "
"game by deck_lock.py game <command>; a busy deck runs no game"
msgstr ""
"Passation, étape 2 : la commande tourne au premier plan sous le verrou tenu "
"au nom de game par deck_lock.py game <command> ; un deck occupé ne lance "
"aucun jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r32
msgid ""
"Hand-over step 3: if it was active and RESTART_AFTER_GAME=yes, reset-failed "
"then start; setting read after the game"
msgstr ""
"Passation, étape 3 : si l'unité était active et que RESTART_AFTER_GAME=yes, "
"reset-failed puis start ; le réglage se lit après le jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r34
msgid ""
"Hand-over step 4: exits with the game's code (a game's exit 2 passed through"
" as is)"
msgstr ""
"Passation, étape 4 : se termine avec le code du jeu (un code de sortie 2 du "
"jeu est transmis tel quel)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r25
msgid ""
"History always runs: the events Workstation silent and Workstation heard "
"again are written whatever the Settings say; only the activities depend on "
"them"
msgstr ""
"L'historique tourne toujours : les événements Poste muet et Poste revenu "
"s'écrivent quels que soient les Paramètres ; seules les activités en "
"dépendent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r53
msgid ""
"Home buttons fill row 0 by order, overflow to row 1 when the deck has 3 rows"
" or more, and the rest get no key"
msgstr ""
"Les boutons d'accueil remplissent la rangée 0 par ordre, débordent sur la "
"rangée 1 quand le deck a 3 rangées ou plus, et les autres n'ont pas de "
"touche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r64
msgid ""
"Host stanzas of the SSH config are parsed; wildcard aliases are recognised"
msgstr ""
"Les blocs Host de la configuration SSH sont analysés ; les alias à joker "
"sont reconnus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r84
msgid ""
"Hot-plug goes through a systemd alias + WantedBy, not a plain "
"SYSTEMD_USER_WANTS (which would start the service even with Autostart off)"
msgstr ""
"Le branchement à chaud passe par un alias systemd + WantedBy, pas par un "
"simple SYSTEMD_USER_WANTS (qui démarrerait le service même avec le démarrage"
" auto désactivé)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r59
msgid "Hotplug receiver for ATTACHED and DETACHED, vendor 0x0fd9 only"
msgstr ""
"Récepteur de branchement à chaud pour ATTACHED et DETACHED, fournisseur "
"0x0fd9 seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r77
msgid ""
"INSTALL.base.md: the two installer commands first, make equivalents once the"
" base is in, per-family table kept, regenerated by mmg"
msgstr ""
"INSTALL.base.md : les deux commandes de l'installateur d'abord, les "
"équivalents make une fois la base en place, la table par famille conservée, "
"régénéré par mmg"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r24
msgid "Idempotent: a second identical run leaves unit and settings untouched"
msgstr ""
"Idempotent : une seconde exécution identique laisse l'unité et les réglages "
"intacts"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r44
msgid ""
"Idempotent: a second run changes nothing and exits 0; every step checks "
"before it writes"
msgstr ""
"Idempotent : une seconde exécution ne change rien et se termine avec le code"
" 0 ; chaque étape vérifie avant d'écrire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r82
msgid "Identical decks are told apart by their serial number"
msgstr "Des decks identiques se distinguent par leur numéro de série"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r111
msgid ""
"Import validates schema_version, migrates, and sets each value with its type"
msgstr ""
"L'import valide schema_version, migre, et pose chaque valeur avec son type"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r57
msgid ""
"In archive mode, BundleCodeService lists files from the sidecar index "
"without unpacking, and reads them from the Cache with Filesystem.readFile "
"(UTF-8)"
msgstr ""
"En mode archive, BundleCodeService liste les fichiers à partir de l'index "
"compagnon sans décompresser, et les lit dans le Cache avec "
"Filesystem.readFile (UTF-8)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_rename_r43
msgid ""
"In erplibre-home-gnome-extension: CHANGELOG.md, tools/migrate_legacy.py, the"
" import fallback of lib/git-sync.js and their tests. In erplibre: the "
"CHANGELOG files and the make aliases streamdeck_tiler and "
"streamdeck_tiler_unittest of the deck program."
msgstr ""
"Dans erplibre-home-gnome-extension : CHANGELOG.md, tools/migrate_legacy.py, "
"le repli d'import de lib/git-sync.js et leurs tests. Dans erplibre : les "
"fichiers CHANGELOG et les alias make streamdeck_tiler et "
"streamdeck_tiler_unittest du programme du deck."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r62
msgid ""
"Index entries are {path, type: file|dir, size?}; only type=file entries "
"count as files"
msgstr ""
"Les entrées de l'index valent {path, type: file|dir, size?} ; seules les "
"entrées type=file comptent comme des fichiers"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r29
msgid ""
"Indicator action without the venv notifies and spawns nothing; the check "
"runs at the click, not in enable()"
msgstr ""
"Une action d'indicateur sans le venv notifie et ne lance rien ; la "
"vérification se fait au clic, pas dans enable()"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r56
msgid ""
"Input reports are parsed into keyChanged, dialRotated, dialPressed, "
"lcdTouched and neoTouched"
msgstr ""
"Les rapports d'entrée sont analysés en keyChanged, dialRotated, dialPressed,"
" lcdTouched et neoTouched"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r17
msgid ""
"Inside ERPLibre the gallery launches every game through "
"script/install/erplibre_home_handover.sh"
msgstr ""
"Dans ERPLibre, la galerie lance chaque jeu par "
"script/install/erplibre_home_handover.sh"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r16
msgid ""
"Installer options --deck-program=, --autostart, --no-restart-after-game (and"
" --restart-after-game) listed in help"
msgstr ""
"Options de l'installateur --deck-program=, --autostart, --no-restart-after-"
"game (et --restart-after-game) listées dans l'aide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_inv
msgid "Inventory"
msgstr "Inventaire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r11
msgid ""
"JPEG keys rotated 180° on XL, XL v2, Original v2, MK.2 and Neo; Plus keys "
"sent as drawn; BMP keys rotated by the encoder"
msgstr ""
"Touches JPEG pivotées de 180° sur XL, XL v2, Original v2, MK.2 et Neo ; "
"touches du Plus envoyées telles que dessinées ; touches BMP pivotées par "
"l'encodeur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r25
msgid "JPEG models: bytes passed through unchanged"
msgstr "Modèles JPEG : octets transmis sans modification"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r50
msgid "Keeping the current value writes nothing"
msgstr "Garder la valeur actuelle n'écrit rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r61
msgid "Key 0 shows NO EXT when the extension is missing and key 0 is free"
msgstr ""
"La touche 0 affiche NO EXT quand l'extension manque et que la touche 0 est "
"libre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r63
msgid "Key allocation holds with a plugin added beside the repository ones"
msgstr ""
"L'attribution des touches tient avec un plugin ajouté à côté de ceux du "
"dépôt"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r03
msgid ""
"Key grid and count per model: 15 keys (5x3) on Original v1, Original v2 and "
"MK.2, 6 (3x2) on Mini, 32 (8x4) on XL and XL v2, 8 (4x2) on Plus and Neo"
msgstr ""
"Grille et nombre de touches par modèle : 15 touches (5x3) sur Original v1, "
"Original v2 et MK.2, 6 (3x2) sur Mini, 32 (8x4) sur XL et XL v2, 8 (4x2) sur"
" Plus et Neo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r05
msgid ""
"Key image format: BMP BGR rotated 180° on Original v1, BMP BGR rotated 270° "
"on Mini, JPEG on the other models"
msgstr ""
"Format de l'image d'une touche : BMP BGR pivoté de 180° sur Original v1, BMP"
" BGR pivoté de 270° sur Mini, JPEG sur les autres modèles"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r04
msgid ""
"Key image size: 72 px on Original v1, Original v2 and MK.2, 80 on Mini, 96 "
"on XL, XL v2 and Neo, 120 on Plus"
msgstr ""
"Taille de l'image d'une touche : 72 px sur Original v1, Original v2 et MK.2,"
" 80 sur Mini, 96 sur XL, XL v2 et Neo, 120 sur Plus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r63
msgid "Keys are read back; a write that did not take exits 1"
msgstr ""
"Les clés sont relues ; une écriture qui n'a pas pris se termine avec le code"
" 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r85
msgid ""
"LCD and info-screen jobs reject image_oversized for an image larger than "
"their target"
msgstr ""
"Les tâches de l'écran LCD et de l'écran d'information rejettent avec "
"image_oversized une image plus grande que leur cible"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r68
msgid ""
"LCD: setLcdImage takes the full 800x100, setLcdRegion a rectangle; only on a"
" deck with an LCD"
msgstr ""
"LCD : setLcdImage prend l'écran entier de 800x100, setLcdRegion un rectangle"
" ; seulement sur un deck muni d'un écran LCD"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r41
msgid "Leftover saves are carried into the clone"
msgstr "Les sauvegardes restantes sont reportées dans le clone"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r50b
msgid ""
"Local instances come from the erplibre-local-pattern glob, gated by "
"erplibre-auto-detect, and are rescanned when either changes"
msgstr ""
"Les instances locales proviennent du motif glob erplibre-local-pattern, "
"conditionné par erplibre-auto-detect, et sont réanalysées quand l'un ou "
"l'autre change"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r37
msgid ""
"Lock descriptor passes to the game (pass_fds) and its children: the deck "
"stays taken while any game process runs, even after the wrapper dies"
msgstr ""
"Le descripteur du verrou passe au jeu (pass_fds) et à ses enfants : le deck "
"reste pris tant qu'un processus du jeu tourne, même après la mort de "
"l'enrobeur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r28
msgid ""
"Lock text '<PID> <program> <start>' (start = field 22 of /proc/PID/stat); "
"third field optional, older text still parses"
msgstr ""
"Texte du verrou '<PID> <program> <start>' (start = champ 22 de "
"/proc/PID/stat) ; le troisième champ est optionnel et un texte plus ancien "
"se lit encore"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r68
msgid ""
"Long test stage 2 passes --deck-program=tiler --autostart and checks "
"service-unit, is-enabled, service-condition (start leaves the unit inactive,"
" condition unmet); stages 3/4 check the service gone"
msgstr ""
"L'étape 2 du test long passe --deck-program=tiler --autostart et vérifie "
"service-unit, is-enabled, service-condition (start laisse l'unité inactive, "
"condition non remplie) ; les étapes 3/4 vérifient que le service est parti"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r67
msgid ""
"Long test: the games check follows the venv check: games/games_cli.py exists"
" and HEAD is the commit of the manifest's revision (origin/main)"
msgstr ""
"Test long : la vérification des jeux suit celle du venv : games/games_cli.py"
" existe et HEAD est le commit de la révision du manifeste (origin/main)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r60
msgid ""
"Manual device matrix: cold extraction, cache hit, cleared cache, edit, diff,"
" commit, reset, unpromote, and a reinstall that keeps Documents"
msgstr ""
"Matrice manuelle sur appareil : extraction à froid, accès au cache, cache "
"vidé, édition, diff, commit, réinitialisation, unpromote, et une "
"réinstallation qui conserve Documents"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r02
msgid ""
"Map each product ID to its model string (0x0060 original_v1, 0x0063 mini, "
"0x006d original_v2, 0x006c xl, 0x0080 mk2, 0x0084 plus, 0x009a neo, 0x008f "
"xl_v2)"
msgstr ""
"Associer chaque identifiant de produit à la chaîne de son modèle (0x0060 "
"original_v1, 0x0063 mini, 0x006d original_v2, 0x006c xl, 0x0080 mk2, 0x0084 "
"plus, 0x009a neo, 0x008f xl_v2)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r07
msgid ""
"Matrix keys are distro:version, the keys deploy_qemu.py and --only accept"
msgstr ""
"Les clés de la matrice sont distro:version, celles qu'acceptent "
"deploy_qemu.py et --only"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r30
msgid ""
"Menus: Stream Deck › My workstations (with Add a workstation) and My decks "
"for every Stream Deck user, Stream Deck › Fleet (workstations, decks, "
"events) for the manager"
msgstr ""
"Menus : Stream Deck › Mes postes (avec Ajouter un poste) et Mes decks pour "
"tout utilisateur Stream Deck, Stream Deck › Parc (postes, decks, événements)"
" pour le gestionnaire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r30
msgid ""
"Migration step 1: the old UUID is replaced in place in enabled-extensions, "
"order kept, or dropped when the new one is listed; without it the list stays"
" untouched (hot-reload copies count as the old UUID)"
msgstr ""
"Étape 1 de la migration : l'ancien UUID est remplacé sur place dans enabled-"
"extensions, ordre conservé, ou retiré quand le nouveau y figure ; sans lui, "
"la liste reste intacte (les copies de rechargement à chaud comptent comme "
"l'ancien UUID)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r31
msgid ""
"Migration step 1: the old symlink (even dangling) and the streamdeck-tiler-"
"reload-*@technolibre.ca entries are removed, their target untouched, without"
" the session bus"
msgstr ""
"Étape 1 de la migration : l'ancien lien symbolique (même brisé) et les "
"entrées streamdeck-tiler-reload-*@technolibre.ca sont retirés, leur cible "
"intacte, sans le bus de session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r32
msgid ""
"Migration step 2: dconf is copied (dump, then load) only when the new path "
"is empty and the old one holds a key"
msgstr ""
"Étape 2 de la migration : dconf est copié (dump, puis load) seulement quand "
"le nouveau chemin est vide et que l'ancien porte une clé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r33
msgid "Migration step 2: the old dconf path is left as it is, for a rollback"
msgstr ""
"Étape 2 de la migration : l'ancien chemin dconf reste tel quel, pour un "
"retour en arrière"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r60
msgid ""
"Migration step 3 covers the config and cache bases (XDG_CONFIG_HOME and "
"XDG_CACHE_HOME, by default ~/.config and ~/.cache)"
msgstr ""
"L'étape 3 de la migration couvre les bases de configuration et de cache "
"(XDG_CONFIG_HOME et XDG_CACHE_HOME, par défaut ~/.config et ~/.cache)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r65
msgid ""
"Migration step 3 moves a directory with a single os.rename within the same "
"parent, which is atomic"
msgstr ""
"L'étape 3 de la migration déplace un répertoire par un seul os.rename dans "
"le même parent, ce qui est atomique"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r59
msgid "Migration step 3: a conflict prints one line naming both paths"
msgstr ""
"Étape 3 de la migration : un conflit affiche une seule ligne qui nomme les "
"deux chemins"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r34
msgid ""
"Migration step 3: each config, state and cache directory is renamed when the"
" source exists and the destination is absent; a conflict touches neither (a "
"destination holding only empty directories counts as absent)"
msgstr ""
"Étape 3 de la migration : chaque répertoire de configuration, d'état et de "
"cache est renommé si la source existe et la destination non ; un conflit ne "
"touche ni l'une ni l'autre (une destination faite de répertoires vides "
"compte comme absente)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r63
msgid ""
"Migration step 4 counts only commands ending with /streamdeck-tiler-hook.py:"
" a settings.json that holds the new hook (new only, or both) is neither "
"rewritten nor backed up"
msgstr ""
"L'étape 4 de la migration ne compte que les commandes qui se terminent par "
"/streamdeck-tiler-hook.py : un settings.json qui porte le nouveau hook "
"(nouveau seul, ou les deux) n'est ni réécrit ni sauvegardé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r62
msgid ""
"Migration step 4 removes every legacy entry: all events in one pass and "
"every distinct legacy path"
msgstr ""
"L'étape 4 de la migration retire chaque entrée héritée : tous les événements"
" en un seul passage et chaque chemin hérité distinct"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r35
msgid ""
"Migration step 4: a settings.json entry whose command ends with /streamdeck-"
"tiler-hook.py is removed, the others kept, with one backup; "
"install_claude_hooks installs the new hook"
msgstr ""
"Étape 4 de la migration : une entrée de settings.json dont la commande se "
"termine par /streamdeck-tiler-hook.py est retirée, les autres gardées, avec "
"une seule sauvegarde ; install_claude_hooks installe le nouveau hook"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r36
msgid ""
"Migration step 4: a workstation that never installed the hooks does not get "
"them"
msgstr ""
"Étape 4 de la migration : un poste qui n'a jamais installé les hooks ne les "
"reçoit pas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r37
msgid ""
"Migration step 5: without a session bus, the list edit and dconf are skipped"
" with one line, the script exits 0 and the next run performs them; the bus "
"is found through $XDG_RUNTIME_DIR/bus"
msgstr ""
"Étape 5 de la migration : sans bus de session, la modification de la liste "
"et dconf sont sautées avec une ligne, le script rend 0 et le passage suivant"
" les fait ; le bus se trouve par $XDG_RUNTIME_DIR/bus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r38
msgid ""
"Migration step order: old hooks, bus steps, extensions, data directories, "
"new hook"
msgstr ""
"Ordre des étapes de la migration : anciens hooks, étapes sur le bus, "
"extensions, répertoires de données, nouveau hook"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r98
msgid "Missing binaries are probed, notified once, and their feature disabled"
msgstr ""
"Les binaires manquants sont détectés, signalés une seule fois, et leur "
"fonction est désactivée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_bundle
msgid "Mobile code bundle"
msgstr "Code embarqué de l'application mobile"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_mon
msgid "Monitoring"
msgstr "Surveillance"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_grepo_r81
msgid ""
"Moving the games to their own repository changes no game, no behaviour of "
"the gallery and no option of games_cli.py. No document states this non-goal."
msgstr ""
"Le déplacement des jeux dans leur propre dépôt ne change aucun jeu, aucun "
"comportement de la galerie et aucune option de games_cli.py. Aucun document "
"n'énonce ce non-objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r48
msgid ""
"Naming rule: the product takes erplibre_home, the hardware and the deck "
"programs keep streamdeck"
msgstr ""
"Règle de nommage : le produit prend erplibre_home, le matériel et les "
"programmes du deck gardent streamdeck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r10
msgid ""
"Neo: one 248x58 info screen (count=1), 2 touch points, capabilities "
"infobars/touchpoints"
msgstr ""
"Neo : un écran d'information de 248x58 (count=1), 2 points tactiles, "
"capacités infobars/touchpoints"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r50
msgid ""
"Nested end-to-end check: the UUID is ACTIVE, ERPLibreHome answers "
"DebugClaudeIndex, no indicator failed to mount"
msgstr ""
"Vérification de bout en bout imbriquée : l'UUID est ACTIVE, ERPLibreHome "
"répond à DebugClaudeIndex, aucun indicateur n'a échoué au montage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r47
msgid "NixOS exits 2"
msgstr "NixOS se termine avec le code 2"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r79
msgid ""
"No CI runner has a deck: a manual hardware matrix per model, XL v2 included"
msgstr ""
"Aucun exécuteur d'intégration continue n'a de deck : une matrice matérielle "
"manuelle par modèle, XL v2 compris"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r27
msgid ""
"No JavaScript gunzip dependency ships with the app (no added startup weight)"
msgstr ""
"Aucune dépendance gunzip JavaScript n'est livrée avec l'application (aucun "
"poids ajouté au démarrage)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r36
msgid ""
"No game is left next to the deck program; the deck program, the controller, "
"deck_lock.py, Assets/ and the install scripts stay in ERPLibre"
msgstr ""
"Aucun jeu ne reste à côté du programme du deck ; le programme du deck, le "
"contrôleur, deck_lock.py, Assets/ et les scripts d'installation restent dans"
" ERPLibre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r64
msgid "No game_tiler.py is kept for compatibility"
msgstr "Aucun game_tiler.py n'est gardé pour compatibilité"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r49
msgid "No gnome-shell exits 2 ('no GNOME Shell')"
msgstr "Sans gnome-shell, code de sortie 2 ('no GNOME Shell')"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r23
msgid "No launch_game.sh exists and nothing refers to it"
msgstr "launch_game.sh n'existe pas et rien n'y fait référence"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r61
msgid ""
"No make recipe calls a deck script through its shebang (SHEBANG_DECK "
"[\\w/]+)"
msgstr ""
"Aucune recette make n'appelle un script du deck par son shebang "
"(SHEBANG_DECK [\\w/]+)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r09
msgid ""
"No published versioned plugin API beyond PLUGIN_API = 1 and the README guide"
msgstr ""
"Aucune API de plugin publiée et versionnée au-delà de PLUGIN_API = 1 et du "
"guide du README"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r116
msgid "No reboot at stage 2; stage 5 reinstalls then reboots"
msgstr "Aucun redémarrage à l'étape 2 ; l'étape 5 réinstalle puis redémarre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r80
msgid ""
"No tag per version: ERPLibre follows main, and a MAJOR change lands on both "
"sides together"
msgstr ""
"Aucune étiquette par version : ERPLibre suit main, et un changement MAJOR "
"arrive des deux côtés en même temps"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r29
msgid ""
"Nobody writes the inventory by hand: only the routes write it, in sudo, "
"bound to the workstation of the token"
msgstr ""
"Personne n'écrit l'inventaire à la main : seules les routes l'écrivent, en "
"sudo, bornées au poste du jeton"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_inv_r36
msgid ""
"Non-goal of the inventory: Odoo never opens a connection to the workstation;"
" driving the workstation comes with a later lot."
msgstr ""
"Non-objectif de l'inventaire : Odoo n'ouvre jamais de connexion vers le "
"poste ; le pilotage du poste vient avec un lot ultérieur."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_inv_r35
msgid ""
"Non-goal of the inventory: activities, the detection of a workstation that "
"stops reporting and the Settings › Stream Deck page come with the next lot."
msgstr ""
"Non-objectif de l'inventaire : les activités, la détection d'un poste qui "
"cesse de remonter et la page Paramètres › Stream Deck viennent avec le lot "
"suivant."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_inv_r38
msgid ""
"Non-goal of the inventory: the GNOME extension ERPLibre Home is the only "
"client of the routes; the wire contract does not forbid another one."
msgstr ""
"Non-objectif de l'inventaire : l'extension GNOME ERPLibre Home est le seul "
"client des routes ; le contrat de la remontée n'en interdit pas un autre."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_inv_r37
msgid ""
"Non-goal of the inventory: the firmware stays empty rather than disputing "
"the device with the deck service; a report without firmware keeps the one "
"Odoo already has."
msgstr ""
"Non-objectif de l'inventaire : le firmware reste vide plutôt que de disputer"
" le périphérique au service deck ; une remontée sans firmware garde celui "
"qu'Odoo a déjà."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mon_r31
msgid ""
"Non-goal of the monitoring: Odoo never opens a connection to the "
"workstation; driving the workstation comes with a later lot."
msgstr ""
"Non-objectif de la surveillance : Odoo n'ouvre jamais de connexion vers le "
"poste ; le pilotage du poste vient avec un lot ultérieur."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mon_r32
msgid ""
"Non-goal of the monitoring: Odoo watches the deck service, the reports and "
"the connection of the deck, not the device itself."
msgstr ""
"Non-objectif de la surveillance : Odoo surveille le service du deck, les "
"remontées et le branchement du deck, pas l'appareil lui-même."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mon_r29
msgid ""
"Non-goal of the monitoring: a problem reaches people as an Odoo activity and"
" in the history only; the notice Odoo itself sends to the user of a new "
"activity follows their notification preference."
msgstr ""
"Non-objectif de la surveillance : un problème atteint les gens par une "
"activité Odoo et par l'historique seulement ; l'avis qu'Odoo envoie lui-même"
" à l'utilisateur d'une nouvelle activité suit sa préférence de notification."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mon_r30
msgid ""
"Non-goal of the monitoring: the Settings are global, one set of boxes and "
"delays for the whole fleet."
msgstr ""
"Non-objectif de la surveillance : les Paramètres sont globaux, un seul jeu "
"de cases et de délais pour tout le parc."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r73
msgid "Non-goal: Bluetooth control, which belongs to a separate plugin"
msgstr "Non-objectif : le contrôle Bluetooth, qui relève d'un plugin distinct"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r05
msgid ""
"Non-goal: GNOME 52+ unsupported; metadata.json declares 45-51; adding a "
"version is a separate change"
msgstr ""
"Hors objectif : GNOME 52 et plus non pris en charge ; metadata.json déclare "
"45 à 51 ; ajouter une version est un changement à part"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_deploy_r05
msgid ""
"Non-goal: GNOME 52+ unsupported; metadata.json declares 45-51; adding a version is a separate change.\n"
"\n"
"erplibre-home-gnome-extension:metadata.json declares shell-version 45 to 51, and erplibre:script/stream_deck/INSTALL.base.md names GNOME Shell 45 to 51. erplibre:long_test/README.base.md treats UNSUPPORTED on a rolling distribution as the signal to update metadata.json."
msgstr ""
"Hors objectif : GNOME 52 et plus non pris en charge ; metadata.json déclare 45 à 51 ; ajouter une version est un changement à part.\n"
"\n"
"erplibre-home-gnome-extension:metadata.json déclare shell-version 45 à 51, et erplibre:script/stream_deck/INSTALL.base.md nomme GNOME Shell 45 à 51. erplibre:long_test/README.base.md fait d'UNSUPPORTED sur une distribution en continu le signal de mettre à jour metadata.json."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r38
msgid "Non-goal: a client other than the GNOME extension"
msgstr "Non-objectif : un client autre que l'extension GNOME"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r78
msgid "Non-goal: a guaranteed frame rate per model"
msgstr "Non-objectif : une fréquence d'images garantie par modèle"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r35
msgid ""
"Non-goal: activities, the silent workstation and Settings › Stream Deck"
msgstr ""
"Non-objectif : les activités, le poste muet et Paramètres › Stream Deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r29
msgid ""
"Non-goal: an email, a push notification or any message outside the Odoo "
"activities"
msgstr ""
"Non-objectif : un courriel, une notification push ou tout message hors des "
"activités Odoo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r74
msgid "Non-goal: animations as a plugin feature"
msgstr "Non-objectif : les animations comme fonction du plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r36
msgid "Non-goal: any configuration pushed from Odoo to the workstation"
msgstr "Non-objectif : toute configuration poussée d'Odoo vers le poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r31
msgid "Non-goal: any driving of the workstation from Odoo"
msgstr "Non-objectif : tout pilotage du poste depuis Odoo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r72
msgid ""
"Non-goal: desktop-only features (tiling D-Bus, wpctl, gnome-shell reload)"
msgstr ""
"Non-objectif : les fonctions propres au bureau (tuilage par D-Bus, wpctl, "
"rechargement de gnome-shell)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r32
msgid ""
"Non-goal: monitoring the health of the deck hardware, its firmware or its "
"keys"
msgstr ""
"Non-objectif : surveiller la santé du matériel du deck, son firmware ou ses "
"touches"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r03
msgid ""
"Non-goal: no USB passthrough; the long test proves the software runs, not "
"that a key press reaches a game"
msgstr ""
"Hors objectif : aucune redirection USB vers la VM ; le test long prouve que "
"le logiciel tourne, pas qu'une touche pressée atteint un jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_deploy_r03
msgid ""
"Non-goal: no USB passthrough; the long test proves the software runs, not that a key press reaches a game.\n"
"\n"
"erplibre:long_test/README.base.md says only that a VM has no deck; no README states the non-goal itself."
msgstr ""
"Hors objectif : aucune redirection USB vers la VM ; le test long prouve que le logiciel tourne, pas qu'une touche pressée atteint un jeu.\n"
"\n"
"erplibre:long_test/README.base.md dit seulement qu'une VM n'a pas de deck ; aucun README n'énonce le hors-objectif lui-même."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r120
msgid "Non-goal: no automatic discovery of a film library"
msgstr ""
"Non-objectif : aucune découverte automatique d'une bibliothèque de films"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r75
msgid "Non-goal: no iOS support"
msgstr "Non-objectif : aucune prise en charge d'iOS"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r62
msgid "Non-goal: no installer option for GAMES"
msgstr "Non-objectif : aucune option de l'installateur pour GAMES"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r121
msgid "Non-goal: no per-row drag of the legacy menu items"
msgstr ""
"Non-objectif : pas de glisser-déposer ligne par ligne des anciens éléments "
"de menu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r65
msgid ""
"Non-goal: no read path heavier than Filesystem.readFile from the extracted "
"Cache for read-only repositories"
msgstr ""
"Hors objectif : aucun chemin de lecture plus lourd que Filesystem.readFile "
"depuis le Cache extrait pour les dépôts en lecture seule"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_bundle_r65
msgid ""
"Non-goal: no read path heavier than Filesystem.readFile from the extracted Cache for read-only repositories.\n"
"\n"
"erplibre_home_mobile:doc/SERVICES.base.md states the design but not its rationale."
msgstr ""
"Hors objectif : aucun chemin de lecture plus lourd que Filesystem.readFile depuis le Cache extrait pour les dépôts en lecture seule.\n"
"\n"
"erplibre_home_mobile:doc/SERVICES.base.md énonce la conception, mais pas sa raison."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r55
msgid ""
"Non-goal: no remote git operations (clone, push, pull); local operations "
"only"
msgstr ""
"Hors objectif : aucune opération git distante (clone, push, pull) ; "
"opérations locales seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_bundle_r55
msgid ""
"Non-goal: no remote git operations (clone, push, pull); local operations only.\n"
"\n"
"erplibre_home_mobile:doc/BUNDLE_PIPELINE.base.md lists online remote support as a possible follow-up, outside this design."
msgstr ""
"Hors objectif : aucune opération git distante (clone, push, pull) ; opérations locales seulement.\n"
"\n"
"erplibre_home_mobile:doc/BUNDLE_PIPELINE.base.md range la prise en charge des dépôts distants en ligne parmi les suites possibles, hors de cette conception."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r71
msgid "Non-goal: porting the games and Tiler modes"
msgstr "Non-objectif : porter les jeux et les modes du Tiler"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r37
msgid "Non-goal: reading the firmware while the deck service holds the device"
msgstr ""
"Non-objectif : lire le firmware pendant que le service deck tient le "
"périphérique"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r119
msgid ""
"Non-goal: the Device indicator only reads the decks and launches the deck "
"program"
msgstr ""
"Non-objectif : l'indicateur « Périphérique » ne fait que lire les decks et "
"lancer le programme du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r75
msgid "Non-goal: the design documents dated before the split keep their names"
msgstr ""
"Non-objectif : les documents de conception datés d'avant la séparation "
"gardent leur nom"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r63
msgid ""
"Non-goal: the extension does not read GAMES and keeps its Games submenu"
msgstr ""
"Non-objectif : l'extension ne lit pas GAMES et garde son sous-menu Jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r30
msgid "Non-goal: thresholds per workstation or per employee"
msgstr "Non-objectif : des seuils par poste ou par employé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r56
msgid ""
"Non-goals: no LFS, no submodules, no signed commits, no online conflict "
"resolution"
msgstr ""
"Hors objectifs : pas de LFS, pas de sous-modules, pas de commits signés, pas"
" de résolution de conflits en ligne"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_bundle_r56
msgid ""
"Non-goals: no LFS, no submodules, no signed commits, no online conflict resolution.\n"
"\n"
"No document of erplibre_home_mobile states these non-goals."
msgstr ""
"Hors objectifs : pas de LFS, pas de sous-modules, pas de commits signés, pas de résolution de conflits en ligne.\n"
"\n"
"Aucun document d'erplibre_home_mobile n'énonce ces hors objectifs."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r67
msgid ""
"Notice says why: lock holder (exit 2), no visual deck (exit 3), the --check "
"line for Result=exec-condition or the unmet condition with its three causes,"
" or the state/status of a failed or auto-restart(-queued) program"
msgstr ""
"L'avis dit pourquoi : détenteur du verrou (code de sortie 2), aucun deck "
"visuel (code de sortie 3), la ligne de --check pour Result=exec-condition ou"
" la condition non remplie avec ses trois causes, ou l'état/le statut d'un "
"programme en échec ou en auto-restart(-queued)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r12
msgid ""
"Odoo alone writes the events Workstation silent and Workstation heard again:"
" a workstation that sends one gets 400 bad_request"
msgstr ""
"Odoo seul écrit les événements Poste muet et Poste revenu : un poste qui en "
"envoie un reçoit 400 bad_request"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r01
msgid ""
"Odoo keeps the history of each deck and each workstation: deck plugged and "
"unplugged, deck service started, failed, stopped or absent, workstation "
"silent and heard again"
msgstr ""
"Odoo garde l'historique de chaque deck et de chaque poste : deck branché et "
"débranché, service du deck démarré, en échec, arrêté ou absent, poste muet "
"et poste revenu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r06
msgid ""
"Odoo sees of a workstation its host name (the default name, renamable), "
"GNOME Shell, extension and contract versions, ERPLibre branch and commit, "
"deck program, deck service state, and system name and version"
msgstr ""
"Odoo voit d'un poste son nom d'hôte (nom par défaut, renommable), les "
"versions de GNOME Shell, de l'extension et du contrat, la branche et le "
"commit ERPLibre, le programme du deck, l'état du service deck, et le nom et "
"la version du système"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r07
msgid ""
"Odoo sees of each deck its model, serial number, whether it is connected and"
" since when, when it was last seen, and its firmware when readable"
msgstr ""
"Odoo voit de chaque deck son modèle, son numéro de série, s'il est branché "
"et depuis quand, quand il a été vu pour la dernière fois, et son firmware "
"quand il est lisible"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r25
msgid ""
"Odoo serves the JSON routes enroll, report and unenroll under "
"/streamdeck/v1/, POST only; report and unenroll authenticate by the "
"workstation token, and a malformed body is 400 bad_request with nothing "
"written"
msgstr ""
"Odoo sert les routes JSON enroll, report et unenroll sous /streamdeck/v1/, "
"en POST seulement ; report et unenroll s'authentifient par le jeton du "
"poste, et un corps malformé reçoit 400 bad_request sans rien écrire"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r11
msgid ""
"Offline, the extension keeps the dated events in a bounded local queue and "
"sends them when Odoo answers again; the history carries the real time of "
"each event"
msgstr ""
"Hors ligne, l'extension garde les événements datés dans une file locale "
"bornée et les envoie quand Odoo répond de nouveau ; l'historique porte "
"l'heure réelle de chaque événement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r14b
msgid "On SIGTERM the controller resets the deck (and exits 143)"
msgstr ""
"Sur SIGTERM, le contrôleur réinitialise le deck (et se termine avec le code "
"143)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r14
msgid "On SIGTERM the tiler resets the deck and exits 143"
msgstr ""
"Sur SIGTERM, le tiler réinitialise le deck et se termine avec le code 143"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r71
msgid ""
"On a busy plugin's page, key 0 goes home without calling the plugin; other "
"keys flash ERR"
msgstr ""
"Sur la page d'un plugin occupé, la touche 0 ramène à l'accueil sans appeler "
"le plugin ; les autres touches font clignoter ERR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r38
msgid ""
"On close, the queued jobs and the taken job resolve {dropped:true}; none is "
"rejected"
msgstr ""
"À la fermeture, les tâches en file et la tâche prise se résolvent en "
"{dropped:true} ; aucune n'est rejetée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r119
msgid ""
"On failure the log gets the filtered user journal (last 200 lines), gnome-"
"extensions info, and every installer output"
msgstr ""
"En cas d'échec, le journal d'exécution reçoit le journal utilisateur filtré "
"(200 dernières lignes), gnome-extensions info et chaque sortie de "
"l'installateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r07
msgid "Once running is false, Kernel.paint draws nothing"
msgstr "Une fois running à faux, Kernel.paint ne dessine rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r06
msgid "Once running is false, Kernel.render draws nothing"
msgstr "Une fois running à faux, Kernel.render ne dessine rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r05
msgid ""
"Once the activities are enabled, four problems open one, each with its box, "
"all checked by default: deck service failed, workstation silent, deck "
"changed workstation, deck unplugged for long"
msgstr ""
"Une fois les activités activées, quatre problèmes en ouvrent une, chacun "
"avec sa case, toutes cochées par défaut : service du deck en échec, poste "
"muet, deck changé de poste, deck débranché longtemps"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r39
msgid ""
"One deck program per game: deck.inner flock; a second deck program in the "
"same game exits 2 naming the first; sequential ones both run"
msgstr ""
"Un seul programme du deck par jeu : flock sur deck.inner ; un second "
"programme du deck dans le même jeu se termine avec le code 2 en nommant le "
"premier ; des programmes successifs tournent tous les deux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r36
msgid ""
"One failed transfer keeps the session; three in a row close it as "
"usb_lost:<detail>; a clean job resets the count"
msgstr ""
"Un transfert échoué garde la session ; trois de suite la ferment avec "
"usb_lost:<detail> ; une tâche réussie remet le compte à zéro"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r99
msgid "One home_button per plugin"
msgstr "Un seul home_button par plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r11
msgid ""
"One installer is the only authority: TODO entries, make targets, QEMU tools,"
" profile and long test call install_erplibre_home.sh"
msgstr ""
"Un seul installateur fait autorité : les entrées TODO, les cibles make, les "
"outils QEMU, le profil et le test long appellent install_erplibre_home.sh"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r53
msgid ""
"One package table per family, non-interactive manager; base rows by default,"
" Stream Deck rows added (deduplicated) with --stream-deck"
msgstr ""
"Une table de paquets par famille, gestionnaire non interactif ; lignes de "
"base par défaut, lignes Stream Deck ajoutées (sans doublon) avec --stream-"
"deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r76
msgid "One scan runs at a time; its Cancellable is cancelled at destroy"
msgstr ""
"Une seule analyse s'exécute à la fois ; son Cancellable est annulé à la "
"destruction"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r41
msgid ""
"One session per deck: reserved before the permission request; other attaches"
" are refused while it is reserved or open"
msgstr ""
"Une session par deck : réservée avant la demande de permission ; les autres "
"rattachements sont refusés tant qu'elle est réservée ou ouverte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r29
msgid ""
"Only conf/git_manifest_streamdeck.csv names the games manifest, not the "
"general lists"
msgstr ""
"Seul conf/git_manifest_streamdeck.csv nomme le manifeste des jeux, pas les "
"listes générales"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r64
msgid ""
"Only showOverLockScreen lets a key press turn the screen on; otherwise a key"
" press brings the app forward only over a lit screen, else it only sends "
"keyChanged"
msgstr ""
"Seul showOverLockScreen permet à un appui de touche d'allumer l'écran ; "
"sinon un appui n'amène l'application au premier plan que sur un écran "
"allumé, et à défaut il envoie seulement keyChanged"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r06
msgid ""
"Only the manifest projects present on disk are bundled; missing ones are "
"skipped"
msgstr ""
"Seuls les projets du manifeste présents sur le disque sont embarqués ; les "
"projets absents sont ignorés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r43
msgid ""
"Only the migration and the history name the extension's former identity"
msgstr ""
"Seuls la migration et l'historique nomment l'ancienne identité de "
"l'extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r68
msgid "Open Files opens sftp://<alias> or sftp://<user>@<ip>"
msgstr "Open Files ouvre sftp://<alias> ou sftp://<user>@<ip>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r51
msgid "Open URL goes to http://localhost:<port>, falling back to 8069"
msgstr "« Ouvrir l'URL » mène à http://localhost:<port>, avec 8069 en repli"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r59
msgid "Open in KeePassXC runs keepassxc DB --keyfile K"
msgstr "« Ouvrir dans KeePassXC » lance keepassxc DB --keyfile K"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r80
msgid ""
"Open questions: per-model offsets of the input reports, origin of the Plus "
"LCD touch coordinates"
msgstr ""
"Questions ouvertes : décalages des rapports d'entrée par modèle, origine des"
" coordonnées tactiles de l'écran LCD du Plus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r83
msgid ""
"Open risk: XDG_CONFIG_HOME belongs in ~/.config/environment.d/, not only the"
" shell rc"
msgstr ""
"Risque ouvert : XDG_CONFIG_HOME doit se poser dans ~/.config/environment.d/,"
" pas seulement dans le fichier rc du shell"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r81
msgid ""
"Open risk: a deck program started by hand takes the lock first; the service "
"fails to start until it ends; Status names the holder"
msgstr ""
"Risque ouvert : un programme du deck lancé à la main prend le verrou en "
"premier ; le service ne démarre pas tant qu'il tourne ; État nomme le "
"détenteur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r80
msgid "Open risk: a game left open in a terminal keeps the deck until it ends"
msgstr ""
"Risque ouvert : un jeu laissé ouvert dans un terminal garde le deck jusqu'à "
"sa fin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r82
msgid ""
"Open risk: make streamdeck_<game> skips the hand-over and takes no lock"
msgstr ""
"Risque ouvert : make streamdeck_<game> contourne la passation et ne prend "
"aucun verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r125
msgid ""
"Open risk: software rendering under --gpu off shows as FAILED(session), "
"never hidden"
msgstr ""
"Risque ouvert : le rendu logiciel sous --gpu off apparaît comme "
"FAILED(session), jamais caché"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r126
msgid ""
"Open risk: with no USB in the VM, stage 2 proves the udev rule is written, "
"not that uaccess grants access to the deck"
msgstr ""
"Risque ouvert : sans USB dans la VM, l'étape 2 prouve que la règle udev est "
"écrite, pas que uaccess donne accès au deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r06
msgid "OpenFilm accepts the players browser and mpv (alias of OpenMedia)"
msgstr "OpenFilm accepte les lecteurs browser et mpv (alias d'OpenMedia)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r05
msgid ""
"OpenInstance accepts the actions url, login, copy_user, copy_pass, "
"open_keepass and start_server; an unknown action returns false; start_server"
" applies to a local instance only"
msgstr ""
"OpenInstance accepte les actions url, login, copy_user, copy_pass, "
"open_keepass et start_server ; une action inconnue renvoie false ; "
"start_server ne s'applique qu'à une instance locale"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r131
msgid ""
"OpenInstance lets the controller bind deck buttons to instance actions, "
"start_server included"
msgstr ""
"OpenInstance permet au controller de lier des boutons du deck à des actions "
"d'instance, start_server compris"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r39
msgid ""
"Options --stream-deck --no-enable --extension-only --with-extras --uninstall"
" --dry-run; unknown option exits 1"
msgstr ""
"Options --stream-deck --no-enable --extension-only --with-extras --uninstall"
" --dry-run ; une option inconnue se termine avec le code 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r08
msgid ""
"Out of scope of the plugin package: controller, Assets/, games, gallery"
msgstr ""
"Hors du périmètre du paquet de plugins : contrôleur, Assets/, jeux, galerie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_plugin_r08
msgid ""
"Out of scope of the plugin package: the controller (erplibre:script/stream_deck/erplibre_controller.py), erplibre:script/stream_deck/Assets/, the games and the gallery.\n"
"\n"
"The games and the gallery live in the streamdeck_game repository."
msgstr ""
"Hors du périmètre du paquet de plugins : le contrôleur (erplibre:script/stream_deck/erplibre_controller.py), erplibre:script/stream_deck/Assets/, les jeux et la galerie.\n"
"\n"
"Les jeux et la galerie vivent dans le dépôt streamdeck_game."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r77
msgid ""
"Out of scope: QEMU menu desktop path on Fedora 42/44, AlmaLinux/Rocky 10 is "
"a separate fix"
msgstr ""
"Hors périmètre : le chemin du bureau du menu QEMU sur Fedora 42/44 et "
"AlmaLinux/Rocky 10 relève d'un correctif distinct"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r88
msgid ""
"Out of scope: concurrent updates of todo_terminals.json can be lost; the "
"last write wins"
msgstr ""
"Hors périmètre : des mises à jour concurrentes de todo_terminals.json "
"peuvent se perdre ; la dernière écriture l'emporte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r81
msgid ""
"Out of scope: no change to any game, the gallery's behaviour or games_cli.py"
" options"
msgstr ""
"Hors périmètre : aucun changement à un jeu, au comportement de la galerie ni"
" aux options de games_cli.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r89
msgid ""
"Out of scope: no hardware test of the '…' mark on a real key nor of the deck"
" staying usable during a zenity dialog"
msgstr ""
"Hors périmètre : aucun test sur le matériel de la marque « … » sur une vraie"
" touche ni du deck qui reste utilisable pendant un dialogue zenity"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r55
msgid ""
"Out of scope: the Stream Deck games game_*.py and their streamdeck_<game> "
"targets keep their names"
msgstr ""
"Hors périmètre : les jeux Stream Deck game_*.py et leurs cibles "
"streamdeck_<game> gardent leurs noms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r87
msgid ""
"Out of scope: the extension's session readers and writers do no liveness "
"check"
msgstr ""
"Hors périmètre : les lecteurs et les écrivains de sessions de l'extension ne"
" vérifient pas que le processus est vivant"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r82
msgid ""
"Out of scope: the games are not published as a Python package; they run by "
"path"
msgstr ""
"Hors périmètre : les jeux ne sont pas publiés comme paquet Python ; ils "
"s'exécutent par leur chemin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r10
msgid "PLUGIN_API is exactly 1"
msgstr "PLUGIN_API vaut exactement 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r84
msgid "PLUGIN_API stays 1; additions to the plugin contract are optional"
msgstr ""
"PLUGIN_API reste à 1 ; les ajouts au contrat des plugins sont facultatifs"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r22
msgid ""
"Page ids are the 13 mode strings of the deck; the idle mode is the home "
"screen"
msgstr ""
"Les identifiants de page sont les 13 chaînes de mode du deck ; le mode "
"inactif est l'écran d'accueil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r100
msgid ""
"Page.keys may return None; the kernel computes it once and exposes it "
"through ctx.keys"
msgstr ""
"Page.keys peut rendre None ; le noyau la calcule une fois et l'expose par "
"ctx.keys"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r33
msgid ""
"Pass order: drain job results first (a drained flash ends the pass), then "
"stores, flash precedence, then the tick or home step"
msgstr ""
"Ordre du passage : vider d'abord les résultats de tâche (un clignotement "
"vidé termine le passage), puis les store, la priorité du clignotement, puis "
"l'étape de tick ou d'accueil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r108
msgid ""
"Per-check timeouts: session 300, extension-active 120, dbus 30, indicators "
"30, venv 60, stream-deck-active 120, partial-uninstall-kept 120, reinstall-"
"active 300, reinstall-indicators 30"
msgstr ""
"Délais par contrôle : session 300, extension-active 120, dbus 30, indicators"
" 30, venv 60, stream-deck-active 120, partial-uninstall-kept 120, reinstall-"
"active 300, reinstall-indicators 30"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r92
msgid ""
"Per-system .log files in a sub-directory of the run, so dernier_rapport "
"never reads them"
msgstr ""
"Fichiers .log par système dans un sous-répertoire de l'exécution, pour que "
"dernier_rapport ne les lise jamais"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r59
msgid ""
"Performance targets: 200 files under 2 s, 1500 files under 8 s, cache hit "
"under 50 ms, promotion under 5 s, diff under 200 ms, commit under 500 ms, no"
" startup cost"
msgstr ""
"Cibles de performance : 200 fichiers en moins de 2 s, 1500 fichiers en moins"
" de 8 s, accès au cache en moins de 50 ms, promotion en moins de 5 s, diff "
"en moins de 200 ms, commit en moins de 500 ms, aucun coût au démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r50
msgid "Permission denied: emit permissionDenied and open no session"
msgstr ""
"Permission refusée : émettre permissionDenied et n'ouvrir aucune session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r87
msgid "Play one game on a real deck from TODO, from make and from the gallery"
msgstr ""
"Jouer à un jeu sur un vrai deck depuis TODO, depuis make et depuis la "
"galerie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r60
msgid ""
"Plug-in with the app closed: the intent filter launches the app or the "
"system chooser, and 'open by default' grants a lasting permission"
msgstr ""
"Branchement avec l'application fermée : le filtre d'intention lance "
"l'application ou le sélecteur du système, et « ouvrir par défaut » accorde "
"une permission durable"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r19
msgid "Plugin interface dataclasses and their field types"
msgstr ""
"Classes de données de l'interface des plugins et types de leurs champs"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r02b
msgid ""
"Plugin shutdown runs with the lock held when the lock is free within 5 s"
msgstr ""
"L'arrêt d'un plugin s'exécute verrou tenu quand le verrou se libère en 5 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r02
msgid ""
"Plugin shutdown runs without the lock when the lock cannot be taken within 5"
" s, and never takes ctx.locked()"
msgstr ""
"L'arrêt d'un plugin s'exécute sans le verrou quand celui-ci ne peut pas être"
" pris en 5 s, et ne prend jamais ctx.locked()"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r94
msgid "Plugins import PIL lazily or through ui.render"
msgstr "Les plugins importent PIL à la demande ou par ui.render"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r09
msgid ""
"Plus: 4 dials, LCD 800x100, capabilities keys/dials/lcd, no info screen"
msgstr ""
"Plus : 4 molettes, écran LCD 800x100, capacités keys/dials/lcd, aucun écran "
"d'information"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r39b
msgid "Poll periods: Sound page 1 s, Bluetooth 2 s, TODO session 1 s"
msgstr "Périodes de sondage : page Son 1 s, Bluetooth 2 s, session TODO 1 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r39
msgid "Poll periods: microphone 2 s, timers 2 s, TODO home 2 s"
msgstr "Périodes de sondage : micro 2 s, minuteries 2 s, accueil TODO 2 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r100
msgid ""
"Polls run on the first pass after a page opens, so a page shows fresh data "
"within one pass"
msgstr ""
"Les sondages s'exécutent au premier passage après l'ouverture d'une page, "
"qui affiche donc une donnée fraîche en un passage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r61
msgid ""
"Power options showOverLockScreen and keepAwake: opt-in, off by default, kept"
" in SharedPreferences, read before JavaScript starts"
msgstr ""
"Options d'alimentation showOverLockScreen et keepAwake : sur adhésion, "
"désactivées par défaut, conservées dans SharedPreferences, lues avant le "
"démarrage de JavaScript"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r127
msgid ""
"Premises of the long test: GDM autologin works with --gpu off, ssh reads the"
" session bus, GetExtensionInfo gives state 1 for a symlinked extension, "
"extension.path is the unresolved symlink path"
msgstr ""
"Prémisses du test long : la connexion automatique GDM fonctionne avec --gpu "
"off, ssh lit le bus de session, GetExtensionInfo donne l'état 1 pour une "
"extension en lien symbolique, extension.path est le chemin non résolu du "
"lien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r82
msgid "Presses and jobs still journal every failure"
msgstr "Les appuis et les tâches inscrivent toujours chaque échec au journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r68
msgid ""
"Product framing: ERPLibre Home is the desktop sibling of ERPLibre Home "
"Mobile, and the Stream Deck is one input device among others"
msgstr ""
"Positionnement du produit : ERPLibre Home est le pendant de bureau "
"d'ERPLibre Home Mobile, et le Stream Deck est un périphérique d'entrée parmi"
" d'autres"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r86
msgid ""
"Profile 'ERPLibre Home (no Odoo)' next to 'ERPLibre mobile (home)' runs the "
"base installer, no make install_os, after the desktop"
msgstr ""
"Le profil 'ERPLibre Home (no Odoo)', à côté de 'ERPLibre mobile (home)', "
"lance l'installateur de base, sans make install_os, après le bureau"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r87
msgid ""
"Profile plus base tool runs it twice (no-op); plus Stream Deck tool adds the"
" level"
msgstr ""
"Le profil plus l'outil de base le lance deux fois (sans effet) ; plus "
"l'outil Stream Deck ajoute le niveau"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r32
msgid ""
"Promotion persists an editable_repos row (slug, baseline_sha, build_id, "
"promoted_at, head_sha)"
msgstr ""
"La promotion enregistre une ligne editable_repos (slug, baseline_sha, "
"build_id, promoted_at, head_sha)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r29
msgid ""
"Promotion to edit mode happens only on a user action (the Edit button), "
"never automatically"
msgstr ""
"La promotion en mode édition ne se fait que sur une action de l'utilisateur "
"(le bouton Éditer), jamais automatiquement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r38
msgid "Pushing to recent-paths puts the path first and removes duplicates"
msgstr "L'ajout à recent-paths place le chemin en tête et retire les doublons"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r63
msgid ""
"Python DEFAULTS['DECK_SESSION_REFRESH_SEC'] is '1', and session_refresh_sec "
"matches the shell"
msgstr ""
"En Python, DEFAULTS['DECK_SESSION_REFRESH_SEC'] vaut '1', et "
"session_refresh_sec concorde avec le shell"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r83
msgid ""
"QEMU label, hint and every help line and the profile label translated; help "
"non-empty"
msgstr ""
"Libellé QEMU, indice, chaque ligne d'aide et libellé du profil traduits ; "
"aide non vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r82
msgid ""
"QEMU tools erplibre_home and erplibre_home_streamdeck right after gnome_ext;"
" phase after, desktops gnome, needs_desktop, arches amd64, four families, "
"disk 1/2 GB"
msgstr ""
"Outils QEMU erplibre_home et erplibre_home_streamdeck juste après gnome_ext "
"; phase after, desktops gnome, needs_desktop, arches amd64, quatre familles,"
" disque 1/2 Go"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r06
msgid "RESTART_AFTER_GAME yes (default) / no"
msgstr "RESTART_AFTER_GAME yes (défaut) / no"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r30
msgid "RESULT_FLASH_SEC = 0.5: a result flash lasts half a second"
msgstr "RESULT_FLASH_SEC = 0.5 : un flash de résultat dure une demi-seconde"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r78
msgid ""
"Rationale: the base level runs no process (the extension lives in GNOME "
"Shell), hence no service"
msgstr ""
"Justification : le niveau de base ne lance aucun processus (l'extension vit "
"dans GNOME Shell), d'où l'absence de service"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r79
msgid ""
"Rationale: the installer never starts the unit because the program needs the"
" extension loaded at the next login"
msgstr ""
"Justification : l'installateur ne démarre jamais l'unité parce que le "
"programme a besoin de l'extension, chargée à la prochaine ouverture de "
"session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r86
msgid ""
"Re-scan USB and the device-auto-refresh-sec timer refresh the deck list"
msgstr ""
"Re-scan USB et la minuterie device-auto-refresh-sec rafraîchissent la liste "
"des decks"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r12
msgid ""
"Read-only extraction goes into the Capacitor Directory.Cache, under "
"repos/{slug}/"
msgstr ""
"L'extraction en lecture seule va dans le Directory.Cache de Capacitor, sous "
"repos/{slug}/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r55
msgid ""
"Reader: a bulk timeout means idle and the reader continues; any other USB "
"error stops the reader and starts the disconnect"
msgstr ""
"Lecteur : un délai bulk expiré signifie l'inactivité et le lecteur continue "
"; toute autre erreur USB arrête le lecteur et lance la déconnexion"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_defects_r45
msgid ""
"Reading the umask means setting it and restoring it, which is not atomic: a "
"file another thread creates in between would get the wrong permission bits."
msgstr ""
"Lire l'umask, c'est le poser puis le rétablir, ce qui n'est pas atomique : "
"un fichier qu'un autre fil crée entre les deux recevrait les mauvais bits de"
" permission."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r51
msgid ""
"Real migration on a workstation with the former extension enabled: old UUID "
"gone, new one ACTIVE, symlink gone, state directory carried over, second run"
" silent"
msgstr ""
"Migration réelle sur un poste où l'ancienne extension est activée : ancien "
"UUID disparu, nouveau ACTIVE, lien symbolique disparu, répertoire d'état "
"reporté, deuxième passage silencieux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r41
msgid "Refuses to run as root (exit 1)"
msgstr "Refuse de s'exécuter en root (code de sortie 1)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r96
msgid ""
"Refuses to start when a tracked file is modified; the dry run only warns"
msgstr ""
"Refuse de démarrer quand un fichier suivi est modifié ; l'essai à blanc ne "
"fait qu'avertir"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r12
msgid ""
"Rejected alternatives: Python installer in TODO plus a shell copy for VMs; "
"packages in cloud-init"
msgstr ""
"Solutions écartées : un installateur Python dans TODO doublé d'une copie "
"shell pour les VM ; les paquets dans cloud-init"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r38
msgid ""
"Removing the games from ERPLibre's tracking, the manifest, games_contract "
"and the installer's clone land in one commit, so a pull never removes the "
"games without bringing the installer"
msgstr ""
"Le retrait des jeux du suivi d'ERPLibre, le manifeste, games_contract et le "
"clone de l'installateur arrivent dans un seul commit : un pull ne retire "
"donc jamais les jeux sans apporter l'installateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r34
msgid "Renders and home faces never start a process"
msgstr "Les rendus et les faces d'accueil ne lancent jamais de processus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r80
msgid ""
"RepeatLog writes a failure once while it repeats, again when it changes, and"
" a recovery line; a pass after a pause starts clean"
msgstr ""
"RepeatLog inscrit un échec une fois tant qu'il se répète, de nouveau quand "
"il change, puis une ligne de rétablissement ; un passage après une pause "
"repart de zéro"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r80b
msgid "RepeatLog.FORGET_SEC is 10 s, above every poll period"
msgstr ""
"RepeatLog.FORGET_SEC vaut 10 s, au-dessus de toutes les périodes de sondage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r111
msgid "Replug values: REPLUG_POLL_SEC 2, FLAP_SEC 10, REPLUG_MAX_SEC 30"
msgstr ""
"Valeurs du rebranchement : REPLUG_POLL_SEC 2, FLAP_SEC 10, REPLUG_MAX_SEC 30"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r89
msgid ""
"Report contract: outil, dry_run, pid, etages (one niveau-1 entry per live "
"VM), extra systemes key"
msgstr ""
"Contrat du rapport : outil, dry_run, pid, etages (une entrée niveau-1 par VM"
" vivante), clé supplémentaire systemes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r120
msgid ""
"Report line per system: distro, version, gnome_attendu, gnome_mesure, "
"verdict, etape, duree_s, journal"
msgstr ""
"Ligne de rapport par système : distro, version, gnome_attendu, gnome_mesure,"
" verdict, etape, duree_s, journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r67
msgid ""
"Repository plugins load as erplibre_streamdeck.plugins.<id>, user plugins as"
" erplibre_streamdeck_user.<id>"
msgstr ""
"Les plugins du dépôt se chargent comme erplibre_streamdeck.plugins.<id>, "
"ceux de l'utilisateur comme erplibre_streamdeck_user.<id>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r95
msgid "Reset to defaults asks for confirmation first"
msgstr "« Restaurer les valeurs par défaut » demande d'abord une confirmation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r104
msgid ""
"Restoring the font scale belongs to app.build; accessibility off keeps the "
"style"
msgstr ""
"La restauration de l'échelle de police revient à app.build ; l'accessibilité"
" coupée garde le style"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r33
msgid ""
"Resume runs gnome-terminal --working-directory=PATH -- bash -lc 'claude "
"--resume; exec bash'"
msgstr ""
"« Reprendre » lance gnome-terminal --working-directory=PATH -- bash -lc "
"'claude --resume; exec bash'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r49
msgid ""
"Revision forms: branch (bare or refs/heads), tag (refs/tags), 40-hex commit"
msgstr ""
"Formes de révision : branche (nue ou refs/heads), étiquette (refs/tags), "
"commit en 40 caractères hexadécimaux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r65
msgid ""
"Risk: GAMES= or a typo disables the games; the status and the diagnosis show"
" it"
msgstr ""
"Risque : GAMES= ou une faute de frappe désactive les jeux ; l'état et le "
"diagnostic le montrent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r66
msgid ""
"Risk: exit code 4 of the hand-over overlaps a game's own exit code; the "
"stderr line is the reliable signal"
msgstr ""
"Risque : le code de sortie 4 de la passation recoupe le code de sortie "
"propre d'un jeu ; la ligne sur stderr est le signal fiable"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r86
msgid ""
"Risk: updating from an ERPLibre commit older than the move of the games runs"
" no guard and deletes games/ with the saves it holds"
msgstr ""
"Risque : une mise à jour depuis un commit ERPLibre antérieur au déplacement "
"des jeux n'exécute aucune garde et supprime games/ avec les sauvegardes "
"qu'il contient"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r42
msgid ""
"Runs as the user, from the checkout root; sudo only for system packages and "
"the udev rule"
msgstr ""
"S'exécute sous le compte de l'utilisateur, depuis la racine du checkout ; "
"sudo seulement pour les paquets système et la règle udev"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r43
msgid ""
"SIGTERM/SIGINT to the wrapper reach every descendant (SIGINT spares the "
"terminal foreground); the wrapper waits for all; stopped processes get "
"SIGCONT"
msgstr ""
"SIGTERM/SIGINT envoyés à l'enrobeur atteignent chaque descendant (SIGINT "
"épargne le premier plan du terminal) ; l'enrobeur les attend tous ; les "
"processus stoppés reçoivent SIGCONT"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r122
msgid ""
"SSH relies on the OpenSSH configuration and keys; the extension stores no "
"secret"
msgstr ""
"SSH s'appuie sur la configuration et les clés OpenSSH ; l'extension ne "
"stocke aucun secret"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r24
msgid ""
"STREAMDECK_PY := .venv.streamdeck/bin/python; a target without the venv "
"stops with 'Stream Deck venv missing: make erplibre_home_streamdeck_install'"
msgstr ""
"STREAMDECK_PY := .venv.streamdeck/bin/python ; une cible sans le venv "
"s'arrête sur 'Stream Deck venv missing: make "
"erplibre_home_streamdeck_install'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r23
msgid ""
"Schema migrations run step by step; a failed step keeps the version so that "
"it is retried"
msgstr ""
"Les migrations de schéma s'exécutent étape par étape ; une étape en échec "
"conserve la version pour être reprise"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r53
msgid ""
"Selenium auto-login runs web_login.py with the instance's .venv.erplibre"
msgstr ""
"La connexion automatique Selenium lance web_login.py avec le .venv.erplibre "
"de l'instance"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r01
msgid ""
"Separate panel indicators (controller, pencil, media, erplibre, network, "
"device), each one mounting on its own"
msgstr ""
"Indicateurs distincts dans la barre du haut (controller, pencil, media, "
"erplibre, network, device), chacun se montant indépendamment des autres"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r16
msgid ""
"Serial number and firmware read from feature reports, with report IDs per "
"generation (0x06 on v1, 0x05 on v2 and later)"
msgstr ""
"Numéro de série et micrologiciel lus dans les rapports de fonctionnalité, "
"avec des identifiants de rapport par génération (0x06 sur v1, 0x05 sur v2 et"
" suivantes)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r66
msgid ""
"Series stops at the first read where no program runs and the unit is not "
"deactivating; running at 8 s counts as started; seen running then "
"Result=success counts as started"
msgstr ""
"La série s'arrête à la première lecture où aucun programme ne tourne et où "
"l'unité n'est pas en désactivation ; un programme qui tourne à 8 s compte "
"comme démarré ; vu en marche puis Result=success compte comme démarré"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r11
msgid ""
"Service states are not new event kinds: a service_changed event carries its "
"state, and the history shows and filters it as Service started, failed, "
"stopped or absent; the report contract does not change"
msgstr ""
"Les états du service ne sont pas de nouvelles sortes d'événement : un "
"événement service_changed porte son état, et l'historique l'affiche et le "
"filtre en Service démarré, en échec, arrêté ou absent ; le contrat de "
"remontée ne change pas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r58
msgid ""
"Service: start/stop/restart via systemctl --user with output; live log "
"journalctl --user -u … -f until Ctrl-C; without the unit names the install"
msgstr ""
"Service : start/stop/restart par systemctl --user avec sa sortie ; journal "
"en direct journalctl --user -u … -f jusqu'à Ctrl-C ; sans l'unité, nomme "
"l'installation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r57
msgid ""
"Session pages tick with period 0.0, gated by last_check against "
"session_refresh_sec (1.0 by default); the PLUGIN object is never mutated"
msgstr ""
"Les pages de session font leur tick avec une période de 0.0, filtrées par "
"last_check selon session_refresh_sec (1.0 par défaut) ; l'objet PLUGIN n'est"
" jamais modifié"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r118
msgid ""
"Session-bus commands use DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id "
"-u)/bus"
msgstr ""
"Les commandes du bus de session utilisent "
"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r03
msgid ""
"Settings are plain KEY=value, never sourced; last line wins; missing "
"file/key gives the default"
msgstr ""
"Les réglages sont de simples KEY=value, jamais sourcés ; la dernière ligne "
"l'emporte ; un fichier ou une clé absents donnent le défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r02
msgid ""
"Settings file $XDG_CONFIG_HOME/erplibre-home/streamdeck.conf, read by entry "
"point, hand-over, TODO; written by installer and TODO with the same text"
msgstr ""
"Fichier de réglages $XDG_CONFIG_HOME/erplibre-home/streamdeck.conf, lu par "
"le point d'entrée, la passation et TODO ; écrit par l'installateur et TODO "
"avec le même texte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r02
msgid ""
"Settings › Stream Deck sets the detection activities: enabled or not, for "
"whom (employee, manager or both, the manager by default, a user named in the"
" Settings), for which problems and after which delays; a new database has "
"them disabled, history only"
msgstr ""
"Paramètres › Stream Deck règle les activités de détection : activées ou non,"
" pour qui (employé, gestionnaire ou les deux, le gestionnaire par défaut, un"
" utilisateur nommé dans les Paramètres), pour quels problèmes et après quels"
" délais ; une base neuve les a désactivées, historique seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r18
msgid ""
"Shebangs stay #!/usr/bin/env python3: a shebang cannot name a checkout-"
"relative path"
msgstr ""
"Les shebangs restent #!/usr/bin/env python3 : un shebang ne peut pas nommer "
"un chemin relatif au checkout"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r69
msgid ""
"Show details opens a modal with the scanned hostname, latency and ports"
msgstr ""
"« Afficher les détails » ouvre une fenêtre modale avec le nom d'hôte "
"analysé, la latence et les ports"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r26
msgid ""
"Silent since and Deck service state since come from the reports and the "
"cron, never from a write by hand; the service state date moves only when the"
" state changes"
msgstr ""
"Muet depuis et État du service du deck depuis viennent des remontées et du "
"cron, jamais d'une écriture à la main ; la date de l'état du service ne "
"bouge que quand l'état change"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r21
msgid "Slot keys: key:N, lcd, infobar:N"
msgstr "Clés d'emplacement : key:N, lcd, infobar:N"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r22
msgid ""
"Slow calls run as jobs: timers, dev_reload, layouts including shortcuts, "
"tiling, Bluetooth, Claude, mpv and TODO"
msgstr ""
"Les appels lents s'exécutent comme tâches : minuteries, dev_reload, "
"dispositions avec raccourcis, tuilage, Bluetooth, Claude, mpv et TODO"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r78
msgid ""
"Sound volume and mute presses run wpctl under the lock and read the state "
"back; the page's mute stores the microphone state"
msgstr ""
"Les appuis de volume et de sourdine du son exécutent wpctl sous le verrou et"
" relisent l'état ; la sourdine de la page enregistre l'état du micro"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r35
msgid ""
"Sound: the page poll runs while the Sound page shows, the microphone poll on"
" the home screen only"
msgstr ""
"Son : le sondage de page s'exécute pendant l'affichage de la page Son, le "
"sondage du micro sur l'accueil seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r117
msgid ""
"Stage 3 partial-uninstall-gone/-kept (link, UUID, ACTIVE); stage 4 "
"uninstall-gone; stage 5 reinstall-active, -indicators, -no-udev"
msgstr ""
"Étape 3 partial-uninstall-gone/-kept (lien, UUID, ACTIVE) ; étape 4 "
"uninstall-gone ; étape 5 reinstall-active, -indicators, -no-udev"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r52
msgid ""
"Start server opens a terminal running make run, for a local instance only"
msgstr ""
"« Démarrer le serveur » ouvre un terminal qui lance make run, pour une "
"instance locale seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r12
msgid ""
"State data lives under $XDG_STATE_HOME/erplibre-home/, with the same "
"subdirectories on the writer and reader sides"
msgstr ""
"Les données d'état sont sous $XDG_STATE_HOME/erplibre-home/, avec les mêmes "
"sous-répertoires du côté qui écrit et du côté qui lit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r46
msgid "Status and Diagnosis read the main lock only (never deck.inner)"
msgstr ""
"État et Diagnostic ne lisent que le verrou principal (jamais deck.inner)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r45
msgid ""
"Status marks a lock PID that no longer designates its writer 'no longer "
"running'; Diagnosis never offers kill on it (offers lock holders, or only "
"close it / close the game)"
msgstr ""
"État marque 'no longer running' un PID de verrou qui ne désigne plus son "
"auteur ; Diagnostic ne propose jamais de kill sur lui (il propose les "
"détenteurs du verrou, ou seulement de le fermer / de fermer le jeu)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r55
msgid ""
"Status one line each: level, extension (GetExtensionInfo state/error), "
"indicators (journal enabled and mount … failed), unit "
"(installed/enabled/active/program), lock holder, decks (0fd9, model when "
"known), udev rule, venv"
msgstr ""
"État, une ligne chacun : niveau, extension (état/erreur de "
"GetExtensionInfo), indicateurs (journal enabled et mount … failed), unité "
"(installée/activée/active/programme), détenteur du verrou, decks (0fd9, "
"modèle quand il est connu), règle udev, venv"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement.category,name:erplibre_streamdeck_devops_requirement.cat_sd_mobplug
msgid "Stream Deck mobile plugin"
msgstr "Plugin mobile du Stream Deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r73
msgid ""
"StreamDeckPlugin drives USB decks only; Bluetooth control is left to a "
"separate Capacitor plugin."
msgstr ""
"StreamDeckPlugin pilote seulement les decks USB ; le contrôle Bluetooth "
"revient à un plugin Capacitor distinct."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r75
msgid ""
"StreamDeckPlugin is Android only: it relies on the Android USB Host API."
msgstr ""
"StreamDeckPlugin est réservé à Android : il repose sur l'API USB Host "
"d'Android."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r52
msgid ""
"Submenu entries Games, Status, Service, Deck program, Autostart, Diagnosis, "
"both installs, Uninstall, Extension each dispatch to their action, numbered "
"contiguously (entries [11] to [13] follow them)"
msgstr ""
"Les entrées du sous-menu Jeux, État, Service, Programme du deck, Démarrage "
"auto, Diagnostic, les deux installations, Désinstallation et Extension "
"mènent chacune à leur action, numérotées sans trou (les entrées [11] à [13] "
"les suivent)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r69
msgid ""
"Success scenario: after --stream-deck --autostart, a login with a deck "
"plugged in brings the tiler up on the deck; a game stops it and closing it "
"brings it back"
msgstr ""
"Scénario de réussite : après --stream-deck --autostart, une ouverture de "
"session avec un deck branché fait apparaître le tiler sur le deck ; un jeu "
"l'arrête et sa fermeture le ramène"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r122
msgid ""
"Summary table on stdout; exit 0 when every in-scope system is ACTIVE (or "
"UNSUPPORTED where rolling), else 1"
msgstr ""
"Tableau récapitulatif sur stdout ; code de sortie 0 quand chaque système du "
"périmètre est ACTIVE (ou UNSUPPORTED pour une distribution en continu), "
"sinon 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r105
msgid "Sync writes are debounced on a single timer"
msgstr ""
"Les écritures de synchronisation sont regroupées sur une seule minuterie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r123
msgid ""
"TODO > Test > Long tests: plan, run and undo entries, dispatched without "
"--depth; every listed choice has a branch and the two copies of the list "
"agree"
msgstr ""
"TODO > Test > Long tests : entrées pour planifier, lancer et défaire, "
"aiguillées sans --depth ; chaque choix listé a sa branche et les deux copies"
" de la liste concordent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r82
msgid "TODO Status shows a 'Plugins off:' line when the list is not empty"
msgstr ""
"L'état de TODO affiche une ligne 'Plugins off:' quand la liste n'est pas "
"vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r78
msgid ""
"TODO Stream Deck menu has 'Install ERPLibre Home (local)' and 'Install "
"ERPLibre Home Stream Deck (local)'"
msgstr ""
"Le menu Stream Deck de TODO offre 'Install ERPLibre Home (local)' et "
"'Install ERPLibre Home Stream Deck (local)'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r20
msgid "TODO games entry launches <game>.py under .venv.streamdeck/bin/python"
msgstr ""
"L'entrée des jeux de TODO lance <game>.py sous .venv.streamdeck/bin/python"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r30
msgid ""
"TODO games entry without the venv prints the same message, translated fr/en,"
" and launches nothing"
msgstr ""
"L'entrée des jeux de TODO sans le venv affiche le même message, traduit "
"fr/en, et ne lance rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r81
msgid "TODO local-entry i18n keys in French and English in todo_i18n.py"
msgstr ""
"Clés i18n des entrées locales de TODO en français et en anglais dans "
"todo_i18n.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r69
msgid ""
"TODO › Status shows 'Session refresh: N s' only when the period is not the "
"default"
msgstr ""
"TODO › Status affiche « Session refresh: N s » seulement quand la période "
"n'est pas celle par défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r81
msgid ""
"TODO › Stream Deck › Plugins on/off lists the plugins, toggles one and "
"writes the setting, in French and English"
msgstr ""
"TODO › Stream Deck › Plugins on/off liste les plugins, en bascule un et "
"écrit le réglage, en français et en anglais"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r67
msgid ""
"TODO › Stream Deck › Session refresh shows, asks for, validates and writes "
"the period and restarts an active unit, in French and English"
msgstr ""
"TODO › Stream Deck › Session refresh affiche, demande, valide et écrit la "
"période et redémarre une unité active, en français et en anglais"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r47
msgid "TODO's games menu runs each game through the hand-over helper"
msgstr "Le menu des jeux de TODO lance chaque jeu par l'outil de passation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r38
msgid ""
"TODO: the registry polls run on the home screen and the session page; the "
"capture is a one-shot poll due at its time"
msgstr ""
"TODO : les sondages du registre s'exécutent sur l'accueil et la page de "
"session ; la capture est un sondage unique dû à son heure"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r60
msgid "Tap and render agree on every dashboard key"
msgstr "L'appui et le rendu concordent pour chaque touche du tableau de bord"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r76
msgid ""
"Targets erplibre_home_install, erplibre_home_uninstall, "
"erplibre_home_streamdeck_install, erplibre_home_streamdeck_uninstall with "
"their options"
msgstr ""
"Cibles erplibre_home_install, erplibre_home_uninstall, "
"erplibre_home_streamdeck_install, erplibre_home_streamdeck_uninstall avec "
"leurs options"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r40
msgid ""
"Terminal fallback gnome-terminal → xterm → kgx; with none of them, a "
"notification"
msgstr ""
"Repli de terminal gnome-terminal → xterm → kgx ; si aucun n'est présent, une"
" notification"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r64
msgid ""
"Test plan of the design: zero-byte and over-512-byte tar entries, a tar -cf "
"round-trip fixture, progress emission, a corrupt archive, write then diff "
"then commit then an empty diff, and every adapter method"
msgstr ""
"Plan de test de la conception : entrées tar de zéro octet et de plus de 512 "
"octets, montage d'aller-retour tar -cf, émission de la progression, archive "
"corrompue, écriture puis diff puis commit puis diff vide, et chaque méthode "
"de l'adaptateur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r95
msgid "Tests patch the module that owns a name"
msgstr "Les tests remplacent un nom dans le module qui le possède"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r63
msgid ""
"Tests that need the real clone are skipped with their reason when it is "
"absent; the suite passes with and without games/"
msgstr ""
"Les tests qui exigent le vrai clone sont sautés avec leur raison quand il "
"est absent ; la suite passe avec et sans games/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_defects_r89
msgid ""
"The '…' mark on a real key and the deck during a zenity dialog need a USB "
"deck and a GNOME session: erplibre:long_test/install_erplibre_home.py "
"installs the deck level in its virtual machines and presses no key."
msgstr ""
"La marque « … » sur une vraie touche et le deck pendant un dialogue zenity "
"demandent un deck USB et une session GNOME : "
"erplibre:long_test/install_erplibre_home.py installe le niveau deck dans ses"
" machines virtuelles et n'appuie sur aucune touche."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r14
msgid ""
"The .extracted sentinel (a timestamp) is written last; when it is present, "
"extraction returns early without fetch or writes"
msgstr ""
"Le témoin .extracted (un horodatage) est écrit en dernier ; quand il est "
"présent, l'extraction rend la main tout de suite, sans fetch ni écriture"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r96
msgid "The About preferences page shows the version from metadata.json"
msgstr ""
"La page de préférences About affiche la version tirée de metadata.json"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r37
msgid ""
"The Add path dialog offers label, path, a file chooser and recent "
"suggestions; the menu ends with a separator, Add path and Open prefs"
msgstr ""
"La boîte de dialogue « Ajouter un chemin » offre libellé, chemin, sélecteur "
"de fichier et suggestions récentes ; le menu se termine par un séparateur, «"
" Ajouter un chemin » et « Ouvrir les préférences »"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r60
msgid "The Assets/ directory stays next to erplibre_controller.py"
msgstr "Le répertoire Assets/ reste à côté de erplibre_controller.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r36
msgid "The Bluetooth poll runs only while the Bluetooth page shows"
msgstr ""
"Le sondage Bluetooth s'exécute seulement pendant l'affichage de la page "
"Bluetooth"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r89
msgid ""
"The Buttons preferences page has SwitchRows, and dragging rewrites button-"
"order"
msgstr ""
"La page de préférences « Boutons » a des SwitchRow, et un glisser-déposer "
"réécrit button-order"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r23
msgid "The CSS classes are erplibre-home-dialog and erplibre-home-btn"
msgstr "Les classes CSS sont erplibre-home-dialog et erplibre-home-btn"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r40
msgid "The Claude and mpv session loaders stay in the render and the tick"
msgstr ""
"Les chargeurs des sessions Claude et mpv restent dans le rendu et le tick"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r16
msgid ""
"The Claude hook installer tags its entries erplibre-home and backs up "
"settings.json as settings.json.bak-erplibre-home-<ts>"
msgstr ""
"L'installateur des hooks Claude marque ses entrées erplibre-home et "
"sauvegarde settings.json sous settings.json.bak-erplibre-home-<ts>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r15
msgid "The Claude hook script is hooks/erplibre-home-hook.py"
msgstr "Le script du hook Claude est hooks/erplibre-home-hook.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r03
msgid "The D-Bus methods ListPaths and ListDevices are exported"
msgstr "Les méthodes D-Bus ListPaths et ListDevices sont exportées"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r33b
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r27
msgid "The D-Bus recheck runs outside the lock"
msgstr "La revérification D-Bus s'exécute hors du verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_ext_r119
msgid ""
"The Device indicator lists the connected Stream Decks and starts or restarts"
" the deck program; configuring a deck from the extension is out of scope. "
"erplibre-home-gnome-extension:README.base.md describes the indicator in its "
"Indicators table."
msgstr ""
"L'indicateur « Périphérique » liste les Stream Deck branchés et démarre ou "
"redémarre le programme du deck ; configurer un deck depuis l'extension est "
"hors du périmètre. erplibre-home-gnome-extension:README.base.md décrit "
"l'indicateur dans sa table Indicators."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r92
msgid "The Device preferences page lists the decks and has a refresh button"
msgstr ""
"La page de préférences « Périphérique » liste les decks et a un bouton de "
"rafraîchissement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r63
msgid ""
"The ERPLibre menu ends with Add remote and Re-scan local; an instance is "
"edited through the instance dialog"
msgstr ""
"Le menu ERPLibre se termine par Add remote et Re-scan local ; une instance "
"se modifie par la boîte de dialogue d'instance"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r16
msgid "The ERPLibre submenu is hidden when it has no entry"
msgstr "Le sous-menu ERPLibre est caché quand il n'a aucune entrée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r68
msgid ""
"The ERPLibre submenu lists exactly the gallery entries whose section is "
"erplibre"
msgstr ""
"Le sous-menu ERPLibre liste exactement les entrées de la galerie dont la "
"section est erplibre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r24
msgid ""
"The ERPLibre-extension contract moves to 1.2, a MINOR version; CONTRACT.md "
"of the extension and the README of erplibre_streamdeck describe the report"
msgstr ""
"Le contrat ERPLibre-extension passe à 1.2, version MINEURE ; le CONTRACT.md "
"de l'extension et le README d'erplibre_streamdeck décrivent la remontée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r31
msgid ""
"The Games menu reads GET http://localhost:8042/api/games, and a click calls "
"/launch/<id>"
msgstr ""
"Le menu Games lit GET http://localhost:8042/api/games, et un clic appelle "
"/launch/<id>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r21
msgid ""
"The Git sync export writes erplibre-home.json and the extension's import "
"goes through syncImportPath"
msgstr ""
"L'export de la synchronisation Git écrit erplibre-home.json et l'import de "
"l'extension passe par syncImportPath"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r65
msgid "The Include directive of the SSH config is ignored"
msgstr "La directive Include de la configuration SSH est ignorée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r114
msgid ""
"The Makefile recipe test_gnome_extension checks the schema, then runs the "
"node tests"
msgstr ""
"La recette Makefile test_gnome_extension vérifie le schéma, puis lance les "
"tests node"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r102
msgid "The Makefile target extension_i18n_compile runs msgfmt for each .po"
msgstr "La cible Makefile extension_i18n_compile lance msgfmt pour chaque .po"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r86
msgid ""
"The Neo info screen is mounted rotated 180° like its keys: the caller sends "
"the image rotated"
msgstr ""
"L'écran d'information du Neo est monté pivoté de 180° comme ses touches : "
"l'appelant envoie l'image pivotée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r34
msgid ""
"The Odoo test runner keeps the guarantees of requirement_report.py: nothing "
"without the ERPLIBRE_REQUIREMENT_* variables, key never sent to Odoo nor "
"shown, HTTPS or loopback, exit code of the tests"
msgstr ""
"Le lanceur des tests Odoo garde les garanties de requirement_report.py : "
"rien sans les variables ERPLIBRE_REQUIREMENT_*, clé jamais transmise à Odoo "
"ni affichée, HTTPS ou bouclage, code de sortie des tests"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r81b
msgid ""
"The Plugins on/off entry offers to restart the deck service when it is "
"active"
msgstr ""
"L'entrée Plugins on/off propose de relancer le service du deck quand il est "
"actif"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r06
msgid "The Python deck program calls that D-Bus object path and interface"
msgstr ""
"Le programme Python du deck appelle ce chemin d'objet et cette interface "
"D-Bus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r116
msgid ""
"The README covers the indicators, preferences, GSettings keys, D-Bus with "
"gdbus examples, KeePassXC, auto-login and limitations"
msgstr ""
"Le README couvre les indicateurs, les préférences, les clés GSettings, D-Bus"
" avec des exemples gdbus, KeePassXC, la connexion automatique et les limites"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r118
msgid ""
"The README says that a change to the GSettings schema needs a compile and a "
"Shell reload"
msgstr ""
"Le README indique qu'une modification du schéma GSettings exige une "
"compilation et un rechargement du Shell"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r66
msgid ""
"The SSH terminal runs ssh <alias> or ssh <user>@<ip>, the user coming from "
"network-ssh-user or $USER"
msgstr ""
"Le terminal SSH lance ssh <alias> ou ssh <user>@<ip>, l'utilisateur venant "
"de network-ssh-user ou de $USER"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r51
msgid "The Stream Deck entry in Execute opens the submenu"
msgstr "L'entrée Stream Deck d'Exécution ouvre le sous-menu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r28
msgid ""
"The Stream Deck manager reads every workstation, deck and event, revokes "
"tokens and archives workstations"
msgstr ""
"Le gestionnaire Stream Deck lit tous les postes, decks et événements, "
"révoque les jetons et archive les postes"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r22
msgid ""
"The Stream Deck settings are Odoo Settings, stored as ir.config_parameter "
"under the prefix erplibre_streamdeck., and only a Settings administrator "
"writes them"
msgstr ""
"Les paramètres Stream Deck sont des Paramètres d'Odoo, stockés en "
"ir.config_parameter sous le préfixe erplibre_streamdeck., et seul un "
"administrateur des Paramètres les écrit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r94
msgid "The Sync preferences page has a Sync now button"
msgstr "La page de préférences Sync a un bouton Sync now"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r108
msgid "The TIMER home entry is timers.enter(ctx)"
msgstr "L'entrée d'accueil TIMER est timers.enter(ctx)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r47
msgid "The TODO Stream Deck submenu offers 'Games on/off'"
msgstr "Le sous-menu Stream Deck de TODO offre « Jeux on/off »"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r79
msgid "The TODO capture poll runs on any page"
msgstr "Le sondage de capture TODO s'exécute sur n'importe quelle page"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r68
msgid "The TODO entry reads a decimal comma as a dot and writes a dot"
msgstr ""
"L'entrée TODO lit une virgule décimale comme un point et écrit un point"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r38
msgid ""
"The TODO games menu also refuses an unknown GAMES value, after checking the "
"venv"
msgstr ""
"Le menu des jeux de TODO refuse aussi une valeur inconnue de GAMES, après la"
" vérification du venv"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r57
msgid ""
"The TODO games menu checks for the games before scanning, with an English "
"and a French line"
msgstr ""
"Le menu des jeux de TODO vérifie la présence des jeux avant de balayer, avec"
" une ligne en anglais et une en français"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r92
msgid ""
"The TODO games menu runs the chosen game through the hand-over under "
".venv.streamdeck"
msgstr ""
"Le menu des jeux de TODO lance le jeu choisi par la passation, sous "
".venv.streamdeck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r03
msgid ""
"The TODO menu shows the first docstring line as the description when "
"todo_i18n has no game_<id> entry"
msgstr ""
"Le menu TODO affiche la première ligne de la docstring comme description "
"quand todo_i18n n'a pas d'entrée game_<id>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r120
msgid "The TODO session page refreshes every second"
msgstr "La page de session TODO se rafraîchit chaque seconde"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r27
msgid ""
"The TODO-terminal launcher of the deck program keeps .venv.erplibre and "
"falls back to the system python3 without it"
msgstr ""
"Le lanceur de terminal TODO du programme du deck garde .venv.erplibre et se "
"rabat sur le python3 du système sans lui"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r93
msgid ""
"The Theming preferences page offers a ComboRow and a Browse button for an "
"SVG"
msgstr ""
"La page de préférences « Apparence » offre un ComboRow et un bouton Browse "
"pour un SVG"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r19
msgid "The UI shows a 'rebuild the app' hint when the bundle is not shipped"
msgstr ""
"L'interface affiche une indication « recompiler l'application » quand le "
"bundle n'est pas livré"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r100
msgid ""
"The VM's etages entry is written as soon as it exists; VM creation or ssh "
"failure gives FAILED(vm)/FAILED(ssh), then the next system"
msgstr ""
"L'entrée etages de la VM est écrite dès qu'elle existe ; un échec de "
"création de VM ou de ssh donne FAILED(vm)/FAILED(ssh), puis le système "
"suivant"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r54
msgid ""
"The app's own source (src/public/repo/) ships as loose files, not as an "
"archive"
msgstr ""
"Le code source de l'application elle-même (src/public/repo/) est livré en "
"fichiers épars, pas en archive"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r61
msgid "The attribute is read from the standard output of keepassxc-cli"
msgstr "L'attribut se lit sur la sortie standard de keepassxc-cli"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r31
msgid ""
"The baseline commit message is 'baseline: shipped via APK build {build_id}',"
" authored by ERPLibre Mobile <app@local>"
msgstr ""
"Le message du commit de référence est 'baseline: shipped via APK build "
"{build_id}', avec pour auteur ERPLibre Mobile <app@local>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r41
msgid "The browser opens with xdg-open URL"
msgstr "Le navigateur s'ouvre par xdg-open URL"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r11
msgid ""
"The build creates archives with the shell tar and falls back to node-tar (a "
"devDependency) when tar is absent"
msgstr ""
"La compilation crée les archives avec le tar du shell et se rabat sur node-"
"tar (une devDependency) quand tar est absent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r08
msgid ""
"The build removes its repository output directory robustly: recursive, "
"forced rmSync with 5 retries 100 ms apart"
msgstr ""
"La compilation supprime son répertoire de sortie des dépôts de façon robuste"
" : rmSync récursif et forcé, avec 5 nouvelles tentatives espacées de 100 ms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r02
msgid ""
"The build walks each repository with BINARY_EXT, MANIFEST_SKIP_DIRS and "
"MAX_BUNDLE_FILE_BYTES, stages it in os.tmpdir()/erplibre-bundle-{slug}-*, "
"runs tar -czf <slug>.tar.gz -C <stage> . and removes the stage"
msgstr ""
"La compilation parcourt chaque dépôt avec BINARY_EXT, MANIFEST_SKIP_DIRS et "
"MAX_BUNDLE_FILE_BYTES, le prépare dans os.tmpdir()/erplibre-bundle-{slug}-*,"
" lance tar -czf <slug>.tar.gz -C <stage> . et supprime la préparation"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r26
msgid ""
"The checkout root is the extension's path with /script/gnome-"
"extension/erplibre_home stripped, links followed (installed symlink and hot-"
"reload copies)"
msgstr ""
"La racine du checkout est le chemin de l'extension privé de /script/gnome-"
"extension/erplibre_home, liens suivis (lien symbolique installé et copies de"
" rechargement à chaud)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r45
msgid "The clone gets the umask mode, not mktemp's 0700"
msgstr "Le clone reçoit le mode de l'umask, pas le 0700 de mktemp"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r76
msgid "The code generator's repo init keeps the streamdeck group"
msgstr "Le repo init du générateur de code garde le groupe streamdeck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r32
msgid "The controller's Open prefs item opens the preferences window"
msgstr ""
"L'élément « Ouvrir les préférences » du contrôleur ouvre la fenêtre des "
"préférences"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r15
msgid ""
"The cron runs every 5 minutes, active from the installation, and may run "
"again at any time: a workstation is marked silent once, an activity opens "
"only when none is open for its record, type and user, and a report that "
"comes during the cron is never lost"
msgstr ""
"Le cron tourne toutes les 5 minutes, actif dès l'installation, et peut "
"repasser à tout moment : un poste est marqué muet une fois, une activité ne "
"s'ouvre que si aucune n'est ouverte pour son enregistrement, son type et son"
" utilisateur, et une remontée arrivée pendant le cron n'est jamais perdue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r09
msgid ""
"The deck changed workstation activity is closed by a person; while it is "
"open, a new move adds a note to the deck's thread instead of a second "
"activity"
msgstr ""
"L'activité « deck changé de poste » est fermée par une personne ; tant "
"qu'elle est ouverte, un nouveau déplacement ajoute une note au fil du deck "
"au lieu d'une deuxième activité"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r85
msgid ""
"The deck controller program writes <cache>/erplibre-home/controller.pid "
"while it runs and removes it at exit"
msgstr ""
"Le programme contrôleur du deck écrit <cache>/erplibre-home/controller.pid "
"pendant qu'il tourne et le retire à sa sortie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r01
msgid ""
"The deck loader test file has no extra blank line before SHAPED (flake8 "
"E303)"
msgstr ""
"Le fichier de test du chargeur du deck n'a pas de ligne vide en trop avant "
"SHAPED (flake8 E303)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r07
msgid "The deck program has no GAME_META and no --meta option"
msgstr "Le programme du deck n'a ni GAME_META ni option --meta"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r01
msgid ""
"The deck program is the erplibre_streamdeck package run as a directory: its "
"__main__.py replaces the single file erplibre_streamdeck.py"
msgstr ""
"Le programme du deck est le paquet erplibre_streamdeck lancé comme un "
"répertoire : son __main__.py remplace le fichier unique "
"erplibre_streamdeck.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r11
msgid ""
"The deck program stays in script/stream_deck/: its imports of deck_lock, "
"translator and translator_stream, and its ERPLibre root, keep working"
msgstr ""
"Le programme du deck reste dans script/stream_deck/ : ses imports de "
"deck_lock, translator et translator_stream, et sa racine ERPLibre, "
"fonctionnent toujours"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r10
msgid "The deck program's docstrings and comments do not call it a game"
msgstr ""
"Les docstrings et les commentaires du programme du deck ne l'appellent pas "
"un jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r60
msgid "The deck program, the controller and the service never look at games/"
msgstr ""
"Le programme du deck, le contrôleur et le service ne regardent jamais games/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r08
msgid ""
"The default delays are 60 minutes for a silent workstation, 10 minutes for a"
" failed deck service, 72 hours for an unplugged deck, and none for a deck "
"that changed workstation"
msgstr ""
"Les délais par défaut sont de 60 minutes pour un poste muet, 10 minutes pour"
" un service du deck en échec, 72 heures pour un deck débranché, et aucun "
"pour un deck changé de poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r67
msgid ""
"The deployment design documents keep their file names; their titles and text"
" follow the rename rule"
msgstr ""
"Les documents de conception du déploiement gardent leurs noms de fichier ; "
"leurs titres et leur texte suivent la règle de renommage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r78
msgid ""
"The design estimates the frame rate each model can reach; the plugin "
"guarantees none."
msgstr ""
"La conception estime la fréquence d'images que chaque modèle peut atteindre "
"; le plugin n'en garantit aucune."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_service_r77
msgid ""
"The desktop path of the QEMU menu on Fedora 42/44 and AlmaLinux/Rocky 10 "
"lies outside the deck service and menu; a separate fix handles it."
msgstr ""
"Le chemin du bureau du menu QEMU sur Fedora 42/44 et AlmaLinux/Rocky 10 est "
"hors du service et du menu du deck ; un correctif distinct s'en charge."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r09
msgid ""
"The device indicator's 'Start deck program' entry starts the deck program"
msgstr ""
"L'entrée « Démarrer le programme du deck » de l'indicateur device démarre le"
" programme du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r52
msgid ""
"The diagnosis lists an unknown GAMES value with the menu path as its fix"
msgstr ""
"Le diagnostic signale une valeur inconnue de GAMES avec le chemin du menu "
"comme correctif"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r70
msgid "The diagnosis names an invalid period and how to fix it"
msgstr "Le diagnostic nomme une période invalide et la façon de la corriger"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r83
msgid "The diagnosis names every id that matches no plugin file"
msgstr ""
"Le diagnostic nomme chaque identifiant qui ne correspond à aucun fichier de "
"plugin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r29
msgid ""
"The documentation follows the move: the CHANGELOG gives the old and new "
"paths and the move of the djscratch saves"
msgstr ""
"La documentation suit le déplacement : le CHANGELOG donne les anciens et les"
" nouveaux chemins et le déplacement des sauvegardes de djscratch"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r61
msgid ""
"The documentation says where the games live and how they arrive (INSTALL, "
"README, CHANGELOG)"
msgstr ""
"La documentation dit où vivent les jeux et comment ils arrivent (INSTALL, "
"README, CHANGELOG)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r41
msgid "The editable head_sha is updated on every commit"
msgstr "Le head_sha modifiable est mis à jour à chaque commit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r11
msgid "The enable-* keys of the six indicators default to true"
msgstr "Les clés enable-* des six indicateurs valent true par défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r49
msgid "The entry shows an unknown value as invalid"
msgstr "L'entrée montre une valeur inconnue comme invalide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r72
msgid "The entry shows the current valid value (Games: Enabled/Disabled)"
msgstr "L'entrée montre la valeur valide actuelle (Jeux : Activés/Désactivés)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r48
msgid ""
"The entry writes GAMES with write_settings, restarts nothing and needs no "
"unit"
msgstr ""
"L'entrée écrit GAMES avec write_settings, ne redémarre rien et n'a besoin "
"d'aucune unité"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r132
msgid "The existing tiling and hot-reload D-Bus methods stay exported"
msgstr ""
"Les méthodes D-Bus existantes de tuilage et de rechargement à chaud restent "
"exportées"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r109
msgid "The export has the shape {schema_version, settings}"
msgstr "L'export a la forme {schema_version, settings}"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r02
msgid ""
"The extension calls Odoo over HTTPS, and over plain HTTP only to this "
"machine: 127.0.0.0/8, ::1 or localhost"
msgstr ""
"L'extension appelle Odoo en HTTPS, et en HTTP simple seulement vers la "
"machine elle-même : 127.0.0.0/8, ::1 ou localhost"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r59
msgid ""
"The extension greys its gallery entry when gallery_server.py is missing"
msgstr ""
"L'extension grise son entrée de galerie quand gallery_server.py manque"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r15
msgid ""
"The extension reads /api/games, lists the games, uses the optional section "
"key and launches through /launch/<id>"
msgstr ""
"L'extension lit /api/games, liste les jeux, utilise la clé facultative "
"section et lance par /launch/<id>"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r63
msgid ""
"The extension reads no GAMES setting. With the games off, the gallery "
"refuses a launch with 403 and the extension shows the gallery's error line "
"in a notification. erplibre:doc/streamdeck_game.base.md implies it without "
"stating it as a decision."
msgstr ""
"L'extension ne lit aucun réglage GAMES. Avec les jeux désactivés, la galerie"
" refuse un lancement par un 403 et l'extension affiche la ligne d'erreur de "
"la galerie dans une notification. erplibre:doc/streamdeck_game.base.md le "
"suppose sans l'énoncer comme une décision."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r12
msgid ""
"The extension shows an Odoo inventory page in its preferences (destinations,"
" enrollment, detailed status) and a status line in the deck menu of the "
"panel"
msgstr ""
"L'extension affiche une page Inventaire Odoo dans ses préférences "
"(destinations, inscription, état détaillé) et une ligne d'état dans le menu "
"du deck du panneau"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r15
msgid ""
"The extension's GALLERY_SERVER_REL is "
"script/stream_deck/games/gallery_server.py"
msgstr ""
"Le GALLERY_SERVER_REL de l'extension est "
"script/stream_deck/games/gallery_server.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r02
msgid "The extension's UUID in metadata.json is erplibre-home@technolibre.ca"
msgstr ""
"L'UUID de l'extension dans metadata.json est erplibre-home@technolibre.ca"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r08
msgid ""
"The extension's journal lines carry the prefix [ERPLibreHome] ('enabled', "
"'mount <id> failed')"
msgstr ""
"Les lignes de journal de l'extension portent le préfixe [ERPLibreHome] "
"('enabled', 'mount <id> failed')"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r18
msgid "The extension's make variables are named ERPLIBRE_HOME_EXT_*"
msgstr "Les variables make de l'extension s'appellent ERPLIBRE_HOME_EXT_*"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r17
msgid ""
"The extension's manual checklist no longer expects 'Window Tiler' in the "
"ERPLibre submenu, which a real session hides"
msgstr ""
"La liste de vérification manuelle de l'extension n'attend plus « Window "
"Tiler » dans le sous-menu ERPLibre, qu'une vraie session cache"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r01
msgid ""
"The extension's repository is cloned at script/gnome-"
"extension/erplibre_home/ of the ERPLibre checkout"
msgstr ""
"Le dépôt de l'extension est cloné dans script/gnome-extension/erplibre_home/"
" du checkout ERPLibre"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_rename_r27
msgid ""
"The extension's repository is read on its own, in a clone or on the forge. "
"Its README names the screenshots of erplibre:script/stream_deck/screenshots/"
" as an ERPLibre path, not as a relative link."
msgstr ""
"Le dépôt de l'extension se lit seul, dans un clone ou sur la forge. Son "
"README nomme les captures d'écran de "
"erplibre:script/stream_deck/screenshots/ comme un chemin d'ERPLibre, non "
"comme un lien relatif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r13
msgid ""
"The extraction pipeline runs fetch, DecompressionStream('gzip') and "
"parseTarStream, then one Filesystem.writeFile (base64) per entry"
msgstr ""
"Le pipeline d'extraction enchaîne fetch, DecompressionStream('gzip') et "
"parseTarStream, puis un Filesystem.writeFile (base64) par entrée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r46
msgid "The film dialog accepts a position matching ^\\d+(:\\d+){0,2}$"
msgstr ""
"La boîte de dialogue du film accepte une position conforme à "
"^\\d+(:\\d+){0,2}$"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r46b
msgid "The film dialog requires a URL"
msgstr "La boîte de dialogue du film exige une URL"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r27
msgid ""
"The first pass runs every active poll; then each poll runs once per period"
msgstr ""
"Le premier passage exécute chaque sondage actif ; ensuite chaque sondage "
"s'exécute une fois par période"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r08
msgid "The gallery and the TODO games menu do not list the deck program"
msgstr ""
"La galerie et le menu des jeux de TODO ne listent pas le programme du deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r13
msgid ""
"The gallery finds the ERPLibre root three directories above it; the hand-"
"over path and the working directory follow that root"
msgstr ""
"La galerie trouve la racine d'ERPLibre trois répertoires au-dessus d'elle ; "
"le chemin de la passation et le répertoire de travail suivent cette racine"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r84
msgid "The gallery stays with the games in the streamdeck_game repository"
msgstr "La galerie reste avec les jeux dans le dépôt streamdeck_game"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r40
msgid ""
"The gallery's /launch/<id> answers 403 with {error} and reads the setting "
"again at each request"
msgstr ""
"Le /launch/<id> de la galerie répond 403 avec {error} et relit le réglage à "
"chaque requête"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r12
msgid ""
"The gallery's SCRIPT_DIR is the games directory: the gallery discovers and "
"launches game_*.py there and serves index.html"
msgstr ""
"Le SCRIPT_DIR de la galerie est le répertoire des jeux : la galerie y "
"découvre et y lance les game_*.py, et sert index.html"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r26
msgid ""
"The game_<id> i18n keys come from the file name and give the TODO "
"description"
msgstr ""
"Les clés i18n game_<id> viennent du nom de fichier et donnent la description"
" dans TODO"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r01
msgid ""
"The games and the gallery live under script/stream_deck/games/; no game is "
"left in script/stream_deck/"
msgstr ""
"Les jeux et la galerie vivent sous script/stream_deck/games/ ; aucun jeu ne "
"reste dans script/stream_deck/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r26
msgid ""
"The games come from the streamdeck_game repository at "
"https://github.com/TechnoLibre/, followed on its main branch"
msgstr ""
"Les jeux proviennent du dépôt streamdeck_game sur "
"https://github.com/TechnoLibre/, suivi sur sa branche main"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r32
msgid ""
"The games history is imported with git filter-repo (explicit path list, 17 "
"commits, --allow-unrelated-histories, a first commit with LICENSE, README "
"and .gitignore)"
msgstr ""
"L'historique des jeux est importé avec git filter-repo (liste explicite de "
"chemins, 17 commits, --allow-unrelated-histories, un premier commit avec "
"LICENSE, README et .gitignore)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r94
msgid ""
"The games manifest declares the remote named TechnoLibre, as "
"git_manifest_mobile_home.xml does"
msgstr ""
"Le manifeste des jeux déclare le remote nommé TechnoLibre, comme le fait "
"git_manifest_mobile_home.xml"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_grepo_r82
msgid ""
"The games run by their path and are not published as a Python package; "
"ERPLibre's tests load them by path through the charger helper of "
"erplibre:test/test_streamdeck_games_repo.py. No document states this non-"
"goal."
msgstr ""
"Les jeux s'exécutent par leur chemin et ne sont pas publiés comme paquet "
"Python ; les tests d'ERPLibre les chargent par leur chemin avec l'utilitaire"
" charger de erplibre:test/test_streamdeck_games_repo.py. Aucun document "
"n'énonce ce non-objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r88
msgid ""
"The games stay at script/stream_deck/games/, so no make target, menu, "
"extension or installer path changes"
msgstr ""
"Les jeux restent à script/stream_deck/games/ : aucun chemin de cible make, "
"de menu, de l'extension ou de l'installateur ne change"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r53
msgid ""
"The games step runs before the venv step, so a first install also gets the "
"games' requirements"
msgstr ""
"L'étape des jeux s'exécute avant celle du venv, pour qu'une première "
"installation reçoive aussi les dépendances des jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r09
msgid "The gettext domain, the .pot and the .mo are named erplibre-home"
msgstr "Le domaine gettext, le .pot et le .mo s'appellent erplibre-home"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r10
msgid ""
"The gettext-domain of metadata.json and that of the schema equal the .mo "
"basename"
msgstr ""
"Le gettext-domain de metadata.json et celui du schéma sont égaux au nom de "
"base du .mo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r100
msgid "The gettext-domain of metadata.json matches the .mo file name"
msgstr "Le gettext-domain de metadata.json correspond au nom du fichier .mo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r44
msgid "The hand-over checks GAMES after the usage check"
msgstr "La passation vérifie GAMES après la vérification de l'usage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r58
msgid ""
"The hand-over exits 5 before stopping anything when the games are absent"
msgstr ""
"La passation se termine avec le code 5 avant d'arrêter quoi que ce soit "
"quand les jeux sont absents"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r45
msgid ""
"The hand-over passes a game's exit code through; the tests check the stderr "
"line"
msgstr ""
"La passation transmet le code de sortie d'un jeu ; les tests vérifient la "
"ligne sur stderr"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r08
msgid "The hand-over passes any exit code of the game through"
msgstr "La passation transmet tel quel tout code de sortie du jeu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r07
msgid "The hand-over runs the game under the deck lock held as program 'game'"
msgstr ""
"La passation lance le jeu sous le verrou du deck, tenu au nom du programme "
"'game'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r85
msgid ""
"The hand-over tests reset-failed's own answer; it never calls systemctl show"
" -p LoadState (which loads the unit and always says loaded)"
msgstr ""
"La passation teste la réponse même de reset-failed ; elle n'appelle jamais "
"systemctl show -p LoadState (qui charge l'unité et répond toujours loaded)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r47
msgid ""
"The hardware and deck programs keep the name streamdeck (.venv.streamdeck, "
"streamdeck_<game>, streamdeck_gallery, streamdeck_translator_*, "
"70-streamdeck.rules, Games menu)"
msgstr ""
"Le matériel et les programmes du deck gardent le nom streamdeck "
"(.venv.streamdeck, streamdeck_<game>, streamdeck_gallery, "
"streamdeck_translator_*, 70-streamdeck.rules, menu Games)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r74
msgid "The header shows Subnet · last scan and the scanning state"
msgstr ""
"L'en-tête affiche Subnet · dernière analyse et l'état de l'analyse en cours"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r14
msgid ""
"The history enters the inventory now: Odoo records a deck plugged, a deck "
"unplugged and a change of the deck service state"
msgstr ""
"L'historique entre dès l'inventaire : Odoo enregistre un deck branché, un "
"deck débranché et un changement d'état du service deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r35
msgid ""
"The home screen re-renders on its own; home_period 0.0 means every pass, and"
" a home_tick returning False asks no render"
msgstr ""
"L'écran d'accueil se redessine de lui-même ; home_period 0.0 signifie à "
"chaque passage, et un home_tick qui rend False ne demande aucun rendu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r34
msgid "The hot-reload copy resolves to the same checkout root"
msgstr ""
"La copie de rechargement à chaud se résout à la même racine de checkout"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r22
msgid ""
"The import reads erplibre-home.json, and streamdeck-tiler.json only when "
"erplibre-home.json is absent; the fallback lives in lib/git-sync.js"
msgstr ""
"L'import lit erplibre-home.json, et streamdeck-tiler.json seulement quand "
"erplibre-home.json est absent ; le repli se trouve dans lib/git-sync.js"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r07
msgid ""
"The indicator registry registers {id, ctor, displayName, defaultEnabled} and"
" rejects a duplicate id"
msgstr ""
"Le registre des indicateurs enregistre {id, ctor, displayName, "
"defaultEnabled} et refuse un id en double"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r29
msgid ""
"The installed symlink ~/.local/share/gnome-shell/extensions/erplibre-"
"home@technolibre.ca points to script/gnome-extension/erplibre_home of the "
"checkout"
msgstr ""
"Le lien symbolique installé ~/.local/share/gnome-shell/extensions/erplibre-"
"home@technolibre.ca pointe vers script/gnome-extension/erplibre_home du "
"checkout"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r44
msgid ""
"The installer clones into a temporary sibling directory renamed once checked"
" out; a failed clone leaves nothing"
msgstr ""
"L'installateur clone dans un répertoire temporaire voisin, renommé une fois "
"l'extraction faite ; un clone raté ne laisse rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r46
msgid ""
"The installer clones the games detached on origin/main, with no local "
"branch, and marks the installed commit"
msgstr ""
"L'installateur clone les jeux en HEAD détaché sur origin/main, sans branche "
"locale, et marque le commit installé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r40
msgid ""
"The installer clones when games/ is absent or holds only real save/ and "
"__pycache__/ directories"
msgstr ""
"L'installateur clone quand games/ est absent ou ne contient que de vrais "
"répertoires save/ et __pycache__/"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r47
msgid ""
"The installer fetches at each run; a clean installer clone follows a new "
"commit of main, a new tag, and a main rewritten upstream"
msgstr ""
"L'installateur fait un fetch à chaque exécution ; un clone propre de "
"l'installateur suit un nouveau commit de main, une nouvelle étiquette et un "
"main réécrit en amont"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r84
msgid "The installer has no DECK_PLUGINS_OFF option"
msgstr "L'installateur n'a pas d'option DECK_PLUGINS_OFF"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r52
msgid ""
"The installer installs the games' requirements.txt in .venv.streamdeck; a "
"failure is reported, not fatal"
msgstr ""
"L'installateur installe le requirements.txt des jeux dans .venv.streamdeck ;"
" un échec est signalé, sans être fatal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r35
msgid "The installer neither writes nor rewrites GAMES"
msgstr "L'installateur n'écrit ni ne réécrit GAMES"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r39
msgid ""
"The installer reads the url and the revision from the manifest file, the "
"single source of the revision"
msgstr ""
"L'installateur lit l'url et la révision dans le fichier manifeste, seule "
"source de la révision"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r41
msgid ""
"The installer's extension step runs the migration before it lays the "
"symlink; the make target calls the installer and does not migrate by itself"
msgstr ""
"L'étape extension de l'installateur lance la migration avant de poser le "
"lien symbolique ; la cible make appelle l'installateur et ne migre pas "
"d'elle-même"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r56
msgid "The instance dialog marks xdotool as experimental"
msgstr "La boîte de dialogue d'instance marque xdotool comme expérimental"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r31
msgid ""
"The inventory is translated into Canadian French in Odoo and in French in "
"the extension, and the module's README is bilingual"
msgstr ""
"L'inventaire est traduit en français canadien dans Odoo et en français dans "
"l'extension, et le README du module est bilingue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r42b
msgid "The journal entry of a handle failure carries the traceback"
msgstr "L'entrée du journal d'un échec de handle porte la trace d'appels"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r41b
msgid "The key callback on_key takes the lock"
msgstr "Le rappel des touches on_key prend le verrou"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r19
msgid ""
"The legacy erplibre_path seeds paths with {label ERPLibre, path} only when "
"paths is empty"
msgstr ""
"L'ancien erplibre_path amorce paths avec {label ERPLibre, path} seulement "
"quand paths est vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r21
msgid ""
"The legacy file is renamed .bak and migration-done is set, so the migration "
"runs once"
msgstr ""
"L'ancien fichier est renommé en .bak et migration-done est posé, de sorte "
"que la migration ne s'exécute qu'une fois"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r64
msgid ""
"The loader reads the package's plugins/ directory first, then the XDG user "
"directory"
msgstr ""
"Le chargeur lit d'abord le répertoire plugins/ du paquet, puis le répertoire"
" utilisateur XDG"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r57
msgid ""
"The login method none hides Auto-login; the KeePassXC items are hidden when "
"the database or the entry is missing"
msgstr ""
"La méthode de connexion none masque Auto-login ; les éléments KeePassXC sont"
" masqués quand la base ou l'entrée manque"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r49
msgid ""
"The long test check extension-indicators greps \\[ERPLibreHome\\] (mount [^ "
"]+ failed|enabled)"
msgstr ""
"La vérification extension-indicators du test long cherche \\[ERPLibreHome\\]"
" (mount [^ ]+ failed|enabled)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r58
msgid "The long test installs with --deck-program=tiler only"
msgstr "Le test long installe avec --deck-program=tiler seulement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r88
msgid "The long test passes drapeaux_cache() to deploy_qemu.py"
msgstr "Le test long passe drapeaux_cache() à deploy_qemu.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r32
msgid ""
"The loop runs every 0.3 s; the D-Bus recheck runs every 5 s while the "
"extension is missing, and never again once it is found"
msgstr ""
"La boucle tourne toutes les 0,3 s ; la revérification D-Bus tourne toutes "
"les 5 s tant que l'extension manque, et plus jamais une fois qu'elle est "
"trouvée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r42
msgid "The make guard also stops a game target on an unknown GAMES value"
msgstr ""
"La garde de make arrête aussi une cible de jeu sur une valeur inconnue de "
"GAMES"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r41
msgid ""
"The make streamdeck_<id> guard prints the message and exits 1 on GAMES=off"
msgstr ""
"La garde de make streamdeck_<id> affiche le message et se termine avec le "
"code 1 sur GAMES=off"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r19
msgid ""
"The make targets erplibre_home_install_extension, "
"erplibre_home_enable_extension and erplibre_home_compile_locale exist"
msgstr ""
"Les cibles make erplibre_home_install_extension, "
"erplibre_home_enable_extension et erplibre_home_compile_locale existent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r20
msgid ""
"The make targets erplibre_home_uninstall_extension, erplibre_home_reload, "
"erplibre_home_reload_clean, erplibre_home_dev_nested and "
"erplibre_home_e2e_nested exist"
msgstr ""
"Les cibles make erplibre_home_uninstall_extension, erplibre_home_reload, "
"erplibre_home_reload_clean, erplibre_home_dev_nested et "
"erplibre_home_e2e_nested existent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r28
msgid ""
"The manifest declares the project at path=script/stream_deck/games with "
"groups=\"streamdeck\""
msgstr ""
"Le manifeste déclare le projet à path=script/stream_deck/games avec "
"groups=\"streamdeck\""

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r28
msgid "The master password lives only in memory, never on disk"
msgstr "Le mot de passe maître ne vit qu'en mémoire, jamais sur disque"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r25
msgid "The master-password cache is keyed by (db, keyfile, yubikey_serial)"
msgstr ""
"Le cache du mot de passe maître est indexé par (db, keyfile, yubikey_serial)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r27
msgid "The master-password cache keeps an entry 5 minutes by default"
msgstr "Le cache du mot de passe maître garde une entrée 5 minutes par défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_ext_r120
msgid ""
"The media list holds the entries the user adds; discovering a film library "
"on disk is out of scope. The README does not state this non-goal."
msgstr ""
"La liste des médias contient les entrées que l'utilisateur ajoute ; "
"découvrir une bibliothèque de films sur disque est hors du périmètre. Le "
"README n'énonce pas ce non-objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r55
msgid ""
"The mic fixture sits bottom-left on decks of 2 rows or more; the layout "
"shortcuts sit under LAYOUT when they fit"
msgstr ""
"La fixture du micro se place en bas à gauche sur les decks de 2 rangées ou "
"plus ; les raccourcis de disposition se placent sous LAYOUT quand ils y "
"tiennent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r39
msgid ""
"The migration prints one line per action and nothing for a step with nothing"
" to do; a second run changes nothing"
msgstr ""
"La migration affiche une ligne par action et rien pour une étape sans rien à"
" faire ; un deuxième passage ne change rien"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r130
msgid "The migration runs under the system python3 and always exits 0"
msgstr ""
"La migration s'exécute sous le python3 du système et se termine toujours "
"avec le code 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r44
msgid ""
"The migration script is removed in a later release, once no workstation runs"
" the former extension"
msgstr ""
"Le script de migration est retiré dans une version ultérieure, une fois "
"qu'aucun poste n'exécute plus l'ancienne extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r64
msgid ""
"The migration tests cover each step for: nothing, old only, new only, both, "
"and no bus"
msgstr ""
"Les tests de la migration couvrent chaque étape pour : rien, ancien seul, "
"nouveau seul, les deux, et sans bus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r31
msgid ""
"The missing-venv message is a msgid of po/erplibre-home.pot, translated in "
"fr.po and en.po, which do not hold 'Python venv not found at "
".venv.erplibre'; both deck indicators show it through _()"
msgstr ""
"Le message de venv manquant est un msgid de po/erplibre-home.pot, traduit "
"dans fr.po et en.po, qui ne contiennent pas 'Python venv not found at "
".venv.erplibre' ; les deux indicateurs du deck l'affichent par _()"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r68
msgid ""
"The mobile bundle includes script/stream_deck/games/ (files under 1 MB) and "
"check_bundle_transfer.py passes; the fix for duplicate packing belongs to "
"the mobile repository"
msgstr ""
"Le bundle mobile inclut script/stream_deck/games/ (fichiers de moins de 1 "
"Mo) et check_bundle_transfer.py passe ; la correction de l'empaquetage en "
"double relève du dépôt mobile"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r28
msgid ""
"The monitoring reads in Canadian French, and the README of the module "
"describes it in English and in French"
msgstr ""
"La surveillance se lit en français canadien, et le README du module la "
"décrit en anglais et en français"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r66
msgid ""
"The nested end-to-end check includes the journal line [ERPLibreHome] enabled"
msgstr ""
"La vérification de bout en bout imbriquée inclut la ligne de journal "
"[ERPLibreHome] enabled"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r14
msgid ""
"The nested shell's runtime directory is $XDG_RUNTIME_DIR/erplibre-home-"
"nested"
msgstr ""
"Le répertoire d'exécution du shell imbriqué est $XDG_RUNTIME_DIR/erplibre-"
"home-nested"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r75
msgid "The network indicator refreshes on a timer"
msgstr "L'indicateur network se rafraîchit selon une minuterie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r61
msgid ""
"The new manifest schema and services are documented in SERVICES.md and "
"BUNDLE_PIPELINE.md"
msgstr ""
"Le nouveau schéma du manifeste et les nouveaux services sont documentés dans"
" SERVICES.md et BUNDLE_PIPELINE.md"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r20
msgid ""
"The offline queue holds at most 1000 events or 30 days per destination, the "
"oldest dropped first; every report carries the running total of lost events,"
" and Odoo keeps the largest"
msgstr ""
"La file hors ligne garde au plus 1000 événements ou 30 jours par "
"destination, les plus anciens tombant en premier ; chaque remontée porte le "
"total cumulé des événements perdus, et Odoo garde le plus grand"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r07
msgid ""
"The other D-Bus clients (translator.py, hooks/erplibre-home-hook.py, "
"ERPLIBRE_HOME_DBUS_PATH and ERPLIBRE_HOME_DBUS_IFACE of the Makefile) use "
"the same names"
msgstr ""
"Les autres clients D-Bus (translator.py, hooks/erplibre-home-hook.py, "
"ERPLIBRE_HOME_DBUS_PATH et ERPLIBRE_HOME_DBUS_IFACE du Makefile) utilisent "
"les mêmes noms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r98
msgid ""
"The package conversion keeps moves and reformatting in separate commits, and"
" never runs black on whole files"
msgstr ""
"La conversion en paquet garde les déplacements et le reformatage dans des "
"commits séparés, et ne lance jamais black sur des fichiers entiers"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r11
msgid ""
"The package keeps the on-disk formats and the extension's D-Bus method names"
msgstr ""
"Le paquet garde les formats sur disque et les noms des méthodes D-Bus de "
"l'extension"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r71
msgid ""
"The plugin does not port the games or the Tiler modes. The games live in "
"their own repository, streamdeck_game, which "
"erplibre:manifest/git_manifest_streamdeck_game.xml pulls."
msgstr ""
"Le plugin ne porte ni les jeux ni les modes du Tiler. Les jeux vivent dans "
"leur propre dépôt, streamdeck_game, que tire "
"erplibre:manifest/git_manifest_streamdeck_game.xml."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r04
msgid "The plugin guard catches SystemExit and never KeyboardInterrupt"
msgstr ""
"La garde des plugins intercepte SystemExit et jamais KeyboardInterrupt"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r74
msgid ""
"The plugin has no animation API: an Owl component loops over setKeyImage, "
"and the coalescing of the writer queue absorbs the frames it cannot send in "
"time. erplibre_home_mobile:doc/NATIVE_PLUGINS.base.md states the coalescing."
msgstr ""
"Le plugin n'a pas d'API d'animation : un composant Owl boucle sur "
"setKeyImage, et la fusion de la file d'écriture absorbe les images qu'elle "
"ne peut pas envoyer à temps. erplibre_home_mobile:doc/NATIVE_PLUGINS.base.md"
" énonce la fusion."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r119
msgid ""
"The plugin is named translate.py, not translator.py, so import translator "
"reaches the sibling module"
msgstr ""
"Le plugin s'appelle translate.py et non translator.py, pour que import "
"translator atteigne le module voisin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r72
msgid ""
"The plugin leaves out what only a desktop session offers: tiling over D-Bus,"
" audio control through wpctl and the gnome-shell reload."
msgstr ""
"Le plugin laisse de côté ce que seule une session de bureau offre : le "
"tuilage par D-Bus, le contrôle audio par wpctl et le rechargement de gnome-"
"shell."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r44
msgid ""
"The position is normalised to HH:MM:SS before mpv; a parse failure logs a "
"warning"
msgstr ""
"La position est normalisée en HH:MM:SS avant mpv ; un échec d'analyse "
"journalise un avertissement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r43
msgid ""
"The position parser reads H:M:S, M:S and seconds; invalid input gives 0"
msgstr ""
"L'analyseur de position lit H:M:S, M:S et des secondes ; une entrée invalide"
" donne 0"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r90
msgid "The preferences bind the Pencil, ERPLibre, Network and Device settings"
msgstr ""
"Les préférences lient les réglages « Crayon », ERPLibre, « Réseau » et « "
"Périphérique »"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r91
msgid ""
"The preferences list groups Paths, Films, Remote and CIDR offer edit, delete"
" and drag"
msgstr ""
"Les groupes de liste des préférences Paths, Films, Remote et CIDR offrent "
"modification, suppression et glisser-déposer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r46
msgid ""
"The product's installers and tests take the name erplibre_home "
"(install_erplibre_home.sh, erplibre_home_install/uninstall, "
"long_test/install_erplibre_home.py, qemu_erplibre_home, "
"_erplibre_home_install_local)"
msgstr ""
"Les installateurs et les tests du produit prennent le nom erplibre_home "
"(install_erplibre_home.sh, erplibre_home_install/uninstall, "
"long_test/install_erplibre_home.py, qemu_erplibre_home, "
"_erplibre_home_install_local)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r33
msgid ""
"The pure logic of the inventory (payload, queue, URL policy, fingerprint, "
"change detection) lives in lib/inventory.js under node --test; the rest has "
"its manual checklist"
msgstr ""
"La logique pure de l'inventaire (charge utile, file, politique d'URL, "
"empreinte, détection de changement) vit dans lib/inventory.js sous node "
"--test ; le reste a sa liste de vérification manuelle"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r65b
msgid "The read times are exactly 1.5, 3, 5 and 8 s after the start"
msgstr "Les lectures ont lieu exactement 1,5, 3, 5 et 8 s après le démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r64
msgid ""
"The real TODO and gallery scans find exactly the clone's games; every "
"installed game has its make target"
msgstr ""
"Les vrais balayages de TODO et de la galerie trouvent exactement les jeux du"
" clone ; chaque jeu installé a sa cible make"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r18
msgid ""
"The recipient both gives two activities, one per user; the employee is the "
"employee of the workstation, and for a deck the employee of the workstation "
"that holds it, the new holder for a deck that changed workstation"
msgstr ""
"Le destinataire « les deux » donne deux activités, une par utilisateur ; "
"l'employé est celui du poste, et pour un deck celui du poste qui le tient, "
"le nouveau détenteur pour un deck changé de poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r36
msgid ""
"The refusal message names the setting, its file and how to enable the games "
"again"
msgstr ""
"Le message de refus nomme le réglage, son fichier et la façon de réactiver "
"les jeux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r05b
msgid "The refusal of an unknown DECK_PROGRAM is ONE line"
msgstr "Le refus d'un DECK_PROGRAM inconnu tient sur UNE ligne"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r132
msgid ""
"The reinstall command (installer or its reboot) failing gives "
"FAILED(reinstall)"
msgstr ""
"L'échec de la commande de réinstallation (installateur ou son redémarrage) "
"donne FAILED(reinstall)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_rename_r55
msgid ""
"The rename leaves the games as they are. They live in the streamdeck_game "
"repository, cloned at erplibre:script/stream_deck/games/, and their "
"streamdeck_<game> targets in erplibre:conf/make.streamdeck.Makefile keep "
"their names."
msgstr ""
"Le renommage laisse les jeux tels quels. Ils vivent dans le dépôt "
"streamdeck_game, cloné dans erplibre:script/stream_deck/games/, et leurs "
"cibles streamdeck_<game> de erplibre:conf/make.streamdeck.Makefile gardent "
"leurs noms."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r54
msgid ""
"The reopen goes through the hotplug path. The attempt count resets after 60 "
"s of healthy session; restartSessions and retryAttach restore the budget; "
"unplug, restart, retry and destroy cancel a pending attempt; "
"permission_missing gives up at once; reattachGaveUp is sent once, with one "
"journal line."
msgstr ""
"La réouverture passe par le chemin du branchement à chaud. Le compte des "
"tentatives revient à zéro après 60 s de session saine ; restartSessions et "
"retryAttach rétablissent le budget ; le débranchement, le redémarrage, la "
"nouvelle tentative et la destruction annulent une tentative en attente ; "
"permission_missing abandonne aussitôt ; reattachGaveUp est envoyé une fois, "
"avec une ligne de journal."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r54
msgid "The repository's home button orders 10 to 90 reproduce the home row"
msgstr ""
"Les ordres 10 à 90 des boutons d'accueil du dépôt reproduisent la rangée "
"d'accueil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r13
msgid ""
"The requirements of the inventory live in the registry, domain Inventory, "
"each done one with the tests that prove it"
msgstr ""
"Les requis de l'inventaire vivent dans le registre, domaine Inventaire, "
"chacun de ceux qui sont faits avec les tests qui le prouvent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r24
msgid ""
"The requirements of the monitoring live in the registry, domain Monitoring, "
"apart from the inventory, each done one with the tests that prove it"
msgstr ""
"Les requis de la surveillance vivent dans le registre, domaine Surveillance,"
" à part de l'inventaire, chacun de ceux qui sont faits avec les tests qui le"
" prouvent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r73
msgid "The scan runs asynchronously when the menu opens and on manual refresh"
msgstr ""
"L'analyse s'exécute de façon asynchrone à l'ouverture du menu et au "
"rafraîchissement manuel"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r70
msgid ""
"The scan runs nmap -p22 --open -oG - when it is enabled and on PATH, else nc"
" -z -w1 over the /24"
msgstr ""
"L'analyse lance nmap -p22 --open -oG - quand il est activé et dans le PATH, "
"sinon nc -z -w1 sur le /24"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r109
msgid "The scenarios never assert two ticks of different periods in one pass"
msgstr ""
"Les scénarios n'affirment jamais deux ticks de périodes différentes dans un "
"même passage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r04
msgid ""
"The schema id org.gnome.shell.extensions.erplibre-home, the dconf path "
"/org/gnome/shell/extensions/erplibre-home/, the schema file name and the "
"settings-schema of metadata.json agree"
msgstr ""
"L'identifiant de schéma org.gnome.shell.extensions.erplibre-home, le chemin "
"dconf /org/gnome/shell/extensions/erplibre-home/, le nom du fichier de "
"schéma et le settings-schema de metadata.json concordent"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r69
msgid "The settings are read once at start and reused after a replug"
msgstr ""
"Les réglages sont lus une fois au démarrage et réutilisés après un "
"rebranchement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r98
msgid "The shell and the deck read only a dot: '0,5' gives 1"
msgstr "Le shell et le deck ne lisent que le point : « 0,5 » donne 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r33
msgid ""
"The shell function deck_games_enabled returns 0 when the games are enabled, "
"1 for off and 2 for an unknown value"
msgstr ""
"La fonction shell deck_games_enabled rend 0 quand les jeux sont activés, 1 "
"pour off et 2 pour une valeur inconnue"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r62
msgid ""
"The shell function deck_session_refresh_sec prints the valid value as "
"written"
msgstr ""
"La fonction shell deck_session_refresh_sec affiche la valeur valide telle "
"qu'écrite"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r107
msgid "The shutdown holds the lock when it is free; SHUTDOWN_LOCK_SEC = 5"
msgstr "L'arrêt tient le verrou quand il est libre ; SHUTDOWN_LOCK_SEC = 5"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r106
msgid ""
"The shutdown proceeds without the lock after 5 s, with one journal line"
msgstr ""
"L'arrêt se poursuit sans le verrou après 5 s, avec une ligne au journal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r14
msgid ""
"The silent delay is at least 30 minutes, two missed reports, so that one "
"missed report is never a silence; the unplugged delay is at least 1 hour and"
" the failed service delay at least 0 minutes"
msgstr ""
"Le délai de poste muet est d'au moins 30 minutes, deux remontées manquées, "
"pour qu'une seule remontée manquée ne soit jamais un silence ; le délai de "
"débranchement est d'au moins 1 heure et celui du service en échec d'au moins"
" 0 minute"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r75
msgid "The split renames no earlier design document to follow the new paths."
msgstr ""
"La séparation ne renomme aucun document de conception antérieur pour suivre "
"les nouveaux chemins."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_defects_r87
msgid ""
"The start-time liveness check belongs to the deck. erplibre-home-gnome-"
"extension:lib/claude-state.js has no start-time check, and erplibre-home-"
"gnome-extension:hooks/README.base.md describes only the /proc existence "
"check, not this non-goal."
msgstr ""
"La vérification de vie par l'heure de démarrage appartient au deck. "
"erplibre-home-gnome-extension:lib/claude-state.js n'a aucune vérification de"
" l'heure de démarrage, et erplibre-home-gnome-extension:hooks/README.base.md"
" décrit seulement la vérification d'existence dans /proc, pas ce non-"
"objectif."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r51
msgid ""
"The status shows 'Games: on/off' even without a unit, and an unknown value "
"as 'Games: unknown value <v>'"
msgstr ""
"L'état montre « Jeux : on/off » même sans unité, et une valeur inconnue sous"
" la forme « Jeux : valeur inconnue <v> »"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r22
msgid ""
"The streamdeck_erplibre and streamdeck_tiler targets are declared .PHONY"
msgstr ""
"Les cibles streamdeck_erplibre et streamdeck_tiler sont déclarées .PHONY"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r24
msgid ""
"The streamdeck_tiler_unittest target keeps its name and discovers "
"test_erplibre_streamdeck*.py"
msgstr ""
"La cible streamdeck_tiler_unittest garde son nom et découvre "
"test_erplibre_streamdeck*.py"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r71
msgid "The subnet comes from ip -4 -j route, on the default-route interface"
msgstr ""
"Le sous-réseau provient de ip -4 -j route, sur l'interface de la route par "
"défaut"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r66
msgid ""
"The summary says to log out and back in: under Wayland, GNOME Shell loads a "
"new extension only at session start"
msgstr ""
"Le bilan dit de se déconnecter puis de se reconnecter : sous Wayland, GNOME "
"Shell ne charge une nouvelle extension qu'à l'ouverture de session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r107
msgid ""
"The sync commits 'auto sync <host> <date>' and pushes when a remote exists"
msgstr ""
"La synchronisation commite 'auto sync <host> <date>' et pousse quand un "
"dépôt distant existe"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r105b
msgid "The sync debounce delay is 5 s"
msgstr "Le délai de regroupement de la synchronisation est de 5 s"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r25
msgid ""
"The tar parser reads the ustar octal size, type flag and prefix+name in "
"512-byte blocks with padding, stops at the 1024-zero end marker and rejects "
"truncation; a TarEntry is {name, size, isDirectory, isFile, mode, content?}"
msgstr ""
"L'analyseur tar lit la taille octale ustar, le type et prefix+name par blocs"
" de 512 octets avec remplissage, s'arrête au marqueur de fin de 1024 zéros "
"et refuse la troncature ; un TarEntry vaut {name, size, isDirectory, isFile,"
" mode, content?}"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r37
msgid ""
"The tiling timeout, the translator's voice-activity (VAD) timeout and the "
"recording timeout are page ticks"
msgstr ""
"Le délai du tuilage, le délai de détection d'activité vocale (VAD) du "
"traducteur et le délai d'enregistrement sont des ticks de page"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r37
msgid ""
"The timers poll runs on the timer page and the home screen, not on the reset"
" confirmation"
msgstr ""
"Le sondage des minuteries s'exécute sur la page des minuteries et sur "
"l'accueil, pas sur la confirmation de remise à zéro"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r81
msgid "The timers, Sound page, microphone and Bluetooth polls use RepeatLog"
msgstr ""
"Les sondages des minuteries, de la page Son, du micro et du Bluetooth "
"utilisent RepeatLog"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r23
msgid ""
"The translate plugin keeps its own recording and transcription threads: none"
" of its work moves to a job"
msgstr ""
"Le plugin de traduction garde ses propres fils d'enregistrement et de "
"transcription : aucun de ses travaux ne devient une tâche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r114
msgid ""
"The translator's shutdown stops a recording in progress and removes its WAV "
"file"
msgstr ""
"L'arrêt du traducteur interrompt un enregistrement en cours et supprime son "
"fichier WAV"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r115
msgid "The translator's shutdown terminates its streaming process"
msgstr "L'arrêt du traducteur termine son processus de diffusion en continu"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r45
msgid "The umask is read once at import; a write never calls os.umask"
msgstr ""
"L'umask est lu une fois à l'importation ; une écriture n'appelle jamais "
"os.umask"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r55
msgid ""
"The unit stores no script path; erplibre_home_deck.sh resolves the program "
"at each start"
msgstr ""
"L'unité ne stocke aucun chemin de script ; erplibre_home_deck.sh résout le "
"programme à chaque démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r22
msgid "The user can re-extract a corrupt repository by hand from the UI"
msgstr ""
"L'utilisateur peut réextraire à la main un dépôt corrompu depuis l'interface"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r13
msgid ""
"The venv is created by --stream-deck only; a base install has no venv; the "
"system python3 runs the migration"
msgstr ""
"Le venv n'est créé que par --stream-deck ; une installation de base n'a pas "
"de venv ; le python3 du système exécute la migration"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mon_r27
msgid ""
"The workstation and deck forms show their thread and activities, the fleet "
"shows Silent since and filters the silent workstations, and the history "
"names each event by its label and filters on it"
msgstr ""
"Les fiches poste et deck montrent leur fil et leurs activités, le parc "
"montre Muet depuis et filtre les postes muets, et l'historique nomme chaque "
"événement par son libellé et filtre dessus"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r19
msgid ""
"The workstation reports every 15 minutes and at each change, each call "
"bounded by 10 seconds, never two reports at once to one destination"
msgstr ""
"Le poste remonte toutes les 15 minutes et à chaque changement, chaque appel "
"borné à 10 secondes, jamais deux remontées en même temps vers une même "
"destination"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r17
msgid ""
"The workstation token is 32 random bytes returned once at enrollment; Odoo "
"keeps only its SHA-256, which no employee reads, and the employee or the "
"manager revokes it from the workstation"
msgstr ""
"Le jeton du poste est fait de 32 octets aléatoires rendus une fois à "
"l'inscription ; Odoo n'en garde que le SHA-256, qu'aucun employé ne lit, et "
"l'employé ou le gestionnaire le révoque depuis le poste"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_inv_r03
msgid ""
"The workstation token lives in the GNOME keyring, bound to the URL and "
"database it serves; the API key or the password serves the enrollment only "
"and is never kept"
msgstr ""
"Le jeton du poste vit dans le trousseau GNOME, lié à l'URL et à la base "
"qu'il sert ; la clé d'API ou le mot de passe ne sert qu'à l'inscription et "
"n'est jamais gardé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r20
msgid ""
"The writer runs one job at a time in offer order; take() blocks while the "
"queue is empty"
msgstr ""
"L'écrivain exécute une tâche à la fois dans l'ordre de dépôt ; take() bloque"
" tant que la file est vide"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r17
msgid "These options without --stream-deck are a usage error, exit 1"
msgstr ""
"Ces options sans --stream-deck sont une erreur d'utilisation, code de sortie"
" 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r49
msgid ""
"Tiler and controller read argv with argparse before importing the Stream "
"Deck library; -h/--help exit 0 with exit codes; unknown argument: usage on "
"stderr, exit 2; neither takes the lock nor opens the deck"
msgstr ""
"Le tiler et le contrôleur lisent argv avec argparse avant d'importer la "
"bibliothèque Stream Deck ; -h/--help affiche les codes de sortie et se "
"termine avec le code 0 ; argument inconnu : usage sur stderr, code de sortie"
" 2 ; ni l'un ni l'autre ne prend le verrou ni n'ouvre le deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r27
msgid ""
"Tiler and controller take the lock with flock LOCK_EX|LOCK_NB at start, "
"before opening the deck; a second holder prints holder program and PID and "
"exits 2"
msgstr ""
"Le tiler et le contrôleur prennent le verrou par flock LOCK_EX|LOCK_NB au "
"démarrage, avant d'ouvrir le deck ; un second détenteur affiche le programme"
" et le PID du détenteur et se termine avec le code 2"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r15
msgid ""
"Tiler survives an unplug: shuts plugins down, keeps process and lock, polls,"
" rebuilds the kernel when the deck returns; controller unchanged"
msgstr ""
"Le tiler survit à un débranchement : il arrête les plugins, garde son "
"processus et le verrou, sonde, puis reconstruit le noyau au retour du deck ;"
" le contrôleur est inchangé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r77
msgid ""
"Timer handlers make no D-Bus call; refresh and export read in their job"
msgstr ""
"Les gestionnaires des minuteries ne font aucun appel D-Bus ; le "
"rafraîchissement et l'exportation lisent dans leur tâche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r09
msgid "Toggling an enable-<id> key or reordering button-order applies live"
msgstr ""
"Basculer une clé enable-<id> ou réordonner button-order s'applique à chaud"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r06
msgid ""
"TransportV1 on Original v1 and Mini, TransportV2 on Original v2, MK.2, XL, "
"XL v2, Plus and Neo"
msgstr ""
"TransportV1 sur Original v1 et Mini, TransportV2 sur Original v2, MK.2, XL, "
"XL v2, Plus et Neo"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r01
msgid ""
"Two levels: the base (extension, schemas, translations, enabled; no device "
"access, no venv) installs alone; --stream-deck always installs the base too"
msgstr ""
"Deux niveaux : la base (extension, schémas, traductions, activée ; ni accès "
"au périphérique ni venv) s'installe seule ; --stream-deck installe toujours "
"la base aussi"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r24
msgid ""
"TypeScript renders at native size: JPEG for JPEG decks, PNG for BMP decks"
msgstr ""
"TypeScript fait le rendu à la taille native : JPEG pour les decks JPEG, PNG "
"pour les decks BMP"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r112
msgid "USB unplug and replug of the deck on real hardware"
msgstr "Débranchement et rebranchement USB du deck sur du vrai matériel"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r61
msgid "Uninstall entry: Stream Deck level / everything"
msgstr "Entrée Désinstallation : niveau Stream Deck / tout"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r72
msgid ""
"Uninstall keeps only the root refusal: no family or GNOME version check"
msgstr ""
"La désinstallation ne garde que le refus de root : aucune vérification de "
"famille ni de version de GNOME"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r74
msgid "Uninstall removes both .wants links"
msgstr "La désinstallation retire les deux liens .wants"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r01
msgid ""
"Unit name erplibre-home-streamdeck.service in $XDG_CONFIG_HOME/systemd/user/"
" (default ~/.config)"
msgstr ""
"Nom de l'unité erplibre-home-streamdeck.service dans "
"$XDG_CONFIG_HOME/systemd/user/ (par défaut ~/.config)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_service_r07
msgid ""
"Unit text: [Unit] PartOf/After graphical-session.target, "
"StartLimitIntervalSec=60, StartLimitBurst=5; [Service] Type=simple, "
"WorkingDirectory, PYTHONUNBUFFERED=1, ExecCondition --check, ExecStart, "
"Restart=on-failure, RestartSec=3, RestartPreventExitStatus=2 3, "
"SuccessExitStatus=143, TimeoutStopSec=10"
msgstr ""
"Texte de l'unité : [Unit] PartOf/After graphical-session.target, "
"StartLimitIntervalSec=60, StartLimitBurst=5 ; [Service] Type=simple, "
"WorkingDirectory, PYTHONUNBUFFERED=1, ExecCondition --check, ExecStart, "
"Restart=on-failure, RestartSec=3, RestartPreventExitStatus=2 3, "
"SuccessExitStatus=143, TimeoutStopSec=10"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r07
msgid ""
"Unit text: [Unit] PartOf/After graphical-session.target, "
"StartLimitIntervalSec=60, StartLimitBurst=5; [Service] Type=simple, "
"WorkingDirectory, PYTHONUNBUFFERED=1, ExecCondition --check, ExecStart, "
"Restart=on-failure, RestartSec=3…"
msgstr ""
"Texte de l'unité : [Unit] PartOf/After graphical-session.target, "
"StartLimitIntervalSec=60, StartLimitBurst=5 ; [Service] Type=simple, "
"WorkingDirectory, PYTHONUNBUFFERED=1, ExecCondition --check, ExecStart, "
"Restart=on-failure, RestartSec=3…"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r08
msgid "Unit uses the absolute path of the checkout the install runs from"
msgstr ""
"L'unité utilise le chemin absolu du checkout d'où l'installation est lancée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r05
msgid "Unknown DECK_PROGRAM: entry point refuses it, exit 1"
msgstr "DECK_PROGRAM inconnu : le point d'entrée le refuse, code de sortie 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r79
msgid "Unknown ids in DECK_PLUGINS_OFF have no effect on the deck"
msgstr ""
"Les identifiants inconnus de DECK_PLUGINS_OFF n'ont aucun effet sur le deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r51
msgid "Unknown product ID: log a warning and skip the device"
msgstr ""
"Identifiant de produit inconnu : journaliser un avertissement et ignorer "
"l'appareil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r88
msgid "Unplug closes the session and sends deckDisconnected usb_lost"
msgstr "Le débranchement ferme la session et envoie deckDisconnected usb_lost"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r110
msgid ""
"Unplugging and replugging the deck: shutdowns, a new kernel, a retried open,"
" back-off, exit 3 only at start"
msgstr ""
"Débranchement et rebranchement du deck : arrêts, nouveau noyau, ouverture "
"retentée, espacement des essais, code de sortie 3 seulement au démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,description:erplibre_streamdeck_devops_requirement.req_sd_plugin_r110
msgid ""
"Unplugging the deck runs the shutdowns, journals one line and polls for the "
"deck. A deck plugged back gets a new kernel. A failed open is closed, "
"retried and journaled once. A deck that vanishes again at once backs off. A "
"reset failure is one journal line. Exit 3 happens only at start."
msgstr ""
"Débrancher le deck exécute les arrêts, inscrit une ligne au journal et sonde"
" l'arrivée du deck. Un deck rebranché reçoit un nouveau noyau. Une ouverture"
" ratée est fermée, retentée et inscrite au journal une fois. Un deck qui "
"disparaît de nouveau aussitôt espace ses essais. Un échec de "
"réinitialisation tient en une ligne du journal. Le code de sortie 3 ne "
"survient qu'au démarrage."

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r97
msgid "User plugins run with the user's rights, and the README says so"
msgstr ""
"Les plugins de l'utilisateur s'exécutent avec les droits de l'utilisateur, "
"et le README le dit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r43
msgid "Uses set -euo pipefail"
msgstr "Utilise set -euo pipefail"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r07
msgid "V1 key image pages of 8191 bytes with the generation-1 header"
msgstr ""
"Pages V1 de l'image d'une touche de 8191 octets avec l'en-tête de génération"
" 1"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r08
msgid ""
"V2 key image pages of 1024 bytes with the generation-2 header, the last page"
" zero-padded"
msgstr ""
"Pages V2 de l'image d'une touche de 1024 octets avec l'en-tête de génération"
" 2, la dernière page complétée par des zéros"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r95
msgid ""
"VMs one at a time, each destroyed before the next unless --garder, in-"
"process with detruire_etage1 + retirer_alias, never detruire(); etages "
"rewritten"
msgstr ""
"Une VM à la fois, chacune détruite avant la suivante sauf avec --garder, "
"dans le processus par detruire_etage1 + retirer_alias, jamais detruire() ; "
"etages réécrit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r71
msgid ""
"Visible local work (changes, untracked even with showUntrackedFiles=no, "
"unpushed commits, stash, linked worktrees) stops the update; nothing is "
"deleted"
msgstr ""
"Du travail local visible (modifications, fichiers non suivis même avec "
"showUntrackedFiles=no, commits non poussés, stash, worktrees liés) arrête la"
" mise à jour ; rien n'est supprimé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r63
msgid ""
"Wake-on-key-press is coupled with keepAwake; at boot the app never writes "
"keepAwake, turns off a wake-on-key-press stored without it, and journals "
"that once"
msgstr ""
"Le réveil par touche est couplé à keepAwake ; au démarrage, l'application "
"n'écrit jamais keepAwake, désactive un réveil par touche enregistré sans lui"
" et le journalise une fois"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_rename_r45
msgid ""
"Wayland loads a new UUID only at login; the install target says to log out "
"and back in"
msgstr ""
"Wayland ne charge un nouvel UUID qu'à l'ouverture de session ; la cible "
"d'installation dit de fermer puis de rouvrir la session"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r04
msgid "What the deck shows matches its reference files at every geometry"
msgstr ""
"Ce que le deck affiche correspond à ses fichiers de référence à chaque "
"géométrie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r35
msgid "When git init fails, .git and the SQLite row are deleted"
msgstr "Quand git init échoue, .git et la ligne SQLite sont supprimés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_grepo_r70
msgid ""
"When repo list -p --all names the path, a plain clone without visible local "
"work moves to games.plain-clone-<date>/, and save/ is copied back"
msgstr ""
"Quand repo list -p --all nomme le chemin, un clone ordinaire sans travail "
"local visible est déplacé dans games.plain-clone-<date>/, et save/ est "
"recopié"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r15
msgid ""
"When the Cache is evicted (sentinel gone), the next ensureExtracted re-"
"extracts lazily, on view, never at startup"
msgstr ""
"Quand le Cache est évincé (témoin disparu), le prochain ensureExtracted "
"réextrait paresseusement, à l'affichage, jamais au démarrage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r34
msgid ""
"When the promotion copy fails partway, the partial Documents/repos/{slug} is"
" deleted"
msgstr ""
"Quand la copie de promotion échoue en cours de route, le "
"Documents/repos/{slug} partiel est supprimé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r87
msgid "While a game holds the deck, Status names game as the holder"
msgstr "Pendant qu'un jeu tient le deck, État nomme game comme détenteur"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r36
msgid ""
"While a game runs, a deck program started outside it (the service) exits 2 "
"naming game"
msgstr ""
"Pendant qu'un jeu tourne, un programme du deck lancé hors de lui (le "
"service) se termine avec le code 2 en nommant game"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r19
msgid "While one plugin is busy, the other plugins and pages work as usual"
msgstr ""
"Pendant qu'un plugin est occupé, les autres plugins et pages fonctionnent "
"normalement"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r64b
msgid "Wildcard stanzas are left out of the Configured section"
msgstr "Les blocs à joker sont exclus de la section Configured"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r43
msgid ""
"With GAMES off or unknown, the hand-over writes one stderr line and exits 4,"
" stopping nothing and running nothing"
msgstr ""
"Avec GAMES à off ou inconnu, la passation écrit une ligne sur stderr et se "
"termine avec le code 4, sans rien arrêter ni rien lancer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r37
msgid ""
"With GAMES=off, the TODO games menu shows a message in French or English and"
" returns, without scanning or launching anything"
msgstr ""
"Avec GAMES=off, le menu des jeux de TODO affiche un message en français ou "
"en anglais et revient, sans rien balayer ni lancer"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r81
msgid "With no deck, a non-clickable '(no Stream Deck found)' line shows"
msgstr ""
"Sans deck, une ligne non cliquable « (aucun Stream Deck détecté) » s'affiche"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r31
msgid "With no key recorded, the whole deck shows the flash"
msgstr "Sans touche enregistrée, tout le deck affiche le flash"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r77
msgid "With no network, the dropdown shows '(no network detected)'"
msgstr "Sans réseau, le menu déroulant affiche '(no network detected)'"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_gsplit_r39
msgid ""
"With the games refused, the gallery's main() prints the reason on stderr, "
"exits 1 and does not listen"
msgstr ""
"Avec les jeux refusés, le main() de la galerie écrit la raison sur stderr, "
"se termine avec le code 1 et n'écoute pas"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r21
msgid ""
"Without a user manager: unit written, calls run under the session-bus rule, "
"failure reported not fatal, summary says to run systemctl --user enable "
"after login"
msgstr ""
"Sans gestionnaire utilisateur : l'unité est écrite, les appels passent par "
"la règle du bus de session, l'échec est signalé sans être fatal, et le bilan"
" dit de lancer systemctl --user enable après la connexion"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r15
msgid ""
"Without a visual Stream Deck, app.py prints 'No visual Stream Deck found.' "
"and exits with NO_DECK_EXIT (3)"
msgstr ""
"Sans Stream Deck visuel, app.py affiche 'No visual Stream Deck found.' et se"
" termine avec le code NO_DECK_EXIT (3)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r123
msgid "Without an argument, exit 2 still means a busy lock"
msgstr "Sans argument, le code de sortie 2 signifie toujours un verrou occupé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r87
msgid "Without lsusb, a notification asks to install usbutils"
msgstr "Sans lsusb, une notification demande d'installer usbutils"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r28
msgid ""
"Without the deck venv the device and controller indicators still mount "
"(panel whole)"
msgstr ""
"Sans le venv du deck, les indicateurs device et controller se montent quand "
"même (panneau complet)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r84b
msgid ""
"Without the deck's service unit, Restart kills the PID of the pidfile, then "
"relaunches after 500 ms"
msgstr ""
"Sans l'unité de service du deck, Restart tue le PID du fichier pidfile, puis"
" relance après 500 ms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r54
msgid ""
"Without the instance's .venv.erplibre, auto-login falls back to xdotool "
"instead of being disabled"
msgstr ""
"Sans le .venv.erplibre de l'instance, la connexion automatique se rabat sur "
"xdotool au lieu d'être désactivée"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r35
msgid "Without the unit the helper only runs the command (no systemctl)"
msgstr ""
"Sans l'unité, l'outil ne fait que lancer la commande (aucun systemctl)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r13
msgid ""
"Without then, a job flashes OK on a truthy result and ERR on a falsy one"
msgstr ""
"Sans then, une tâche fait clignoter OK sur un résultat vrai et ERR sur un "
"résultat faux"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r14
msgid "Without then, a job whose work raises flashes ERR"
msgstr "Sans then, une tâche dont work lève une exception fait clignoter ERR"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r39
msgid "Write methods settle as plain calls, never kept alive"
msgstr ""
"Les méthodes d'écriture se règlent comme des appels simples, jamais "
"maintenus en vie"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r19
msgid ""
"WriterQueue coalescing: a new job for a slot removes the pending one, which "
"resolves {dropped:true}; the newest wins"
msgstr ""
"Fusion dans WriterQueue : une nouvelle tâche pour un emplacement retire "
"celle en attente, qui se résout en {dropped:true} ; la plus récente "
"l'emporte"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r65
msgid "XDG_CONFIG_HOME unset or empty means ~/.config"
msgstr "XDG_CONFIG_HOME absente ou vide signifie ~/.config"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r12
msgid "XL v2 shares every XL value, bezel ratio included"
msgstr "Le XL v2 partage toutes les valeurs du XL, ratio du cadre compris"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r54
msgid ""
"[8] asks deck program, autostart (no default), restart after game (yes "
"default), --with-extras (no default); each answer becomes an option; command"
" printed once before it runs; 0 installs nothing (defaults later taken from "
"the settings in place)"
msgstr ""
"[8] demande le programme du deck, le démarrage auto (sans défaut), la "
"relance après un jeu (oui par défaut) et --with-extras (sans défaut) ; "
"chaque réponse devient une option ; la commande s'affiche une fois avant de "
"tourner ; 0 n'installe rien (les défauts sont ensuite pris dans les réglages"
" en place)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_service_r71
msgid ""
"[Install] section: WantedBy=graphical-session.target sys-subsystem-erplibre-"
"streamdeck.device"
msgstr ""
"Section [Install] : WantedBy=graphical-session.target sys-subsystem-"
"erplibre-streamdeck.device"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r99
msgid "_() returns its input when no .mo is loaded"
msgstr "_() renvoie son entrée quand aucun .mo n'est chargé"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r12
msgid ""
"__main__ puts script/stream_deck/ first on sys.path, so the package, "
"deck_lock and translator resolve from any working directory"
msgstr ""
"__main__ place script/stream_deck/ en tête de sys.path, pour que le paquet, "
"deck_lock et translator se résolvent depuis n'importe quel répertoire de "
"travail"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r13
msgid ""
"__main__ removes the package directory from sys.path, so no package module "
"shadows a top-level one"
msgstr ""
"__main__ retire le répertoire du paquet de sys.path, pour qu'aucun module du"
" paquet ne masque un module de premier niveau"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r50
msgid ""
"alive(pid, born_by, slack_ms=5000): a process is alive when it runs and "
"started no later than born_by plus the slack"
msgstr ""
"alive(pid, born_by, slack_ms=5000) : un processus est vivant quand il tourne"
" et a démarré au plus tard à born_by plus la marge"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r06
msgid "amd64 only (arm64, s390x, ppc64le out of scope)"
msgstr "amd64 seulement (arm64, s390x, ppc64le hors du périmètre)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r103
msgid ""
"app.build restores the style, loads the plugins, returns the kernel and "
"starts no thread"
msgstr ""
"app.build restaure le style, charge les plugins, rend le noyau et ne lance "
"aucun fil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r65
msgid ""
"app.build takes a settings dict; ctx.setting(name, default=None) reads it"
msgstr ""
"app.build prend un dictionnaire settings ; ctx.setting(name, default=None) "
"le lit"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r103b
msgid "app.build takes no lock file and installs no signal handler"
msgstr ""
"app.build ne prend aucun fichier de verrou et n'installe aucun gestionnaire "
"de signal"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r39
msgid ""
"app.main builds the kernel, renders, installs the key callback, then runs "
"the shutdowns, resets and closes the deck"
msgstr ""
"app.main construit le noyau, fait le rendu, installe le rappel des touches, "
"puis exécute les arrêts, réinitialise et ferme le deck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_plugin_r39b
msgid "app.main starts the loop in its own thread"
msgstr "app.main lance la boucle dans son propre fil"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r113
msgid ""
"base-idempotent / stream-deck-idempotent: second run exits 0 AND leaves the "
"mtimes unchanged"
msgstr ""
"base-idempotent / stream-deck-idempotent : la seconde exécution se termine "
"avec le code 0 ET laisse les mtimes inchangés"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_deploy_r112
msgid ""
"base-no-udev and base-no-venv checks: the base install leaves neither the "
"udev rule nor .venv.streamdeck"
msgstr ""
"Contrôles base-no-udev et base-no-venv : l'installation de base ne laisse ni"
" la règle udev ni .venv.streamdeck"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r52
msgid ""
"build_id is git rev-parse --short HEAD, or else the package.json version "
"plus a timestamp"
msgstr ""
"build_id vaut git rev-parse --short HEAD, ou à défaut la version de "
"package.json plus un horodatage"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_ext_r08
msgid ""
"button-order sets the indicator order; unknown ids are ignored and "
"registered ids it omits are appended"
msgstr ""
"button-order fixe l'ordre des indicateurs ; les id inconnus sont ignorés et "
"les id enregistrés qu'il omet sont ajoutés à la fin"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r49
msgid ""
"capacitorFsAdapter dispatches each Node fs method to Capacitor against "
"Directory.Data, with the leading '/' stripped"
msgstr ""
"capacitorFsAdapter transmet chaque méthode fs de Node à Capacitor sur "
"Directory.Data, en retirant le '/' initial"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_defects_r85
msgid "check_golden has the mode STREAMDECK_GOLDEN=update-from-package"
msgstr "check_golden offre le mode STREAMDECK_GOLDEN=update-from-package"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r53
msgid "claimInterface forces the claim (forceClaim=true)"
msgstr "claimInterface force la prise de l'interface (forceClaim=true)"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r52
msgid ""
"claimInterface() false: permissionDenied with reason interface_busy, retried"
" once after 500 ms"
msgstr ""
"claimInterface() renvoie false : permissionDenied avec la raison "
"interface_busy, une nouvelle tentative après 500 ms"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r89
msgid "clearAllKeys clears every key, like reset"
msgstr "clearAllKeys efface toutes les touches, comme reset"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r34
msgid ""
"clearKey checks the key index and sends the encoder's black image at native "
"size in wire format"
msgstr ""
"clearKey vérifie l'indice de la touche et envoie l'image noire de l'encodeur"
" à la taille native, au format de transmission"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_mobplug_r65
msgid ""
"clearPendingWrites drops the queued writes of a deck and resolves the "
"{dropped} count"
msgstr ""
"clearPendingWrites abandonne les écritures en file d'un deck et se résout "
"avec leur nombre {dropped}"

#. module: erplibre_streamdeck_devops_requirement
#: model:devops.requirement,name:erplibre_streamdeck_devops_requirement.req_sd_bundle_r39
