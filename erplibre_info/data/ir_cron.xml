<odoo noupdate="1">
    <!-- Inactive at install. A queued run activates it until the run is
         done; the periodic snapshot of erplibre_info_git keeps it active
         while that option is on. -->
    <record id="ir_cron_erplibre_code" model="ir.cron">
        <field name="name">ERPLibre: code environment</field>
        <field name="model_id" ref="model_erplibre_code_run" />
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False" />
    </record>
</odoo>
