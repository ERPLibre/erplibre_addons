<odoo>
    <record id="erplibre_code_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.confirm.wizard.form</field>
        <field name="model">erplibre.code.confirm.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="action" invisible="1" />
                <div class="alert alert-warning" role="alert" invisible="action != 'apply'">
                    The repositories below are rebased on their upstream, each in
                    a new dated branch. A repository that conflicts is put back
                    where it was. Nothing is pushed.
                </div>
                <div class="alert alert-warning" role="alert" invisible="action != 'pull_apply'">
                    Each repository gets a backup branch on its HEAD, then
                    integrates its target with the chosen strategy. A conflicting
                    repository is put back where it was. Nothing is pushed.
                </div>
                <div class="alert alert-warning" role="alert" invisible="action != 'pull_restore'">
                    The repository moves back to the backup commit.
                </div>
                <div class="alert alert-warning" role="alert" invisible="action != 'deps_install'">
                    poetry install --no-root runs in the Odoo virtual environment.
                </div>
                <div class="alert alert-warning" role="alert" invisible="action not in ('restart', 'restart_upgrade')">
                    The server stops and starts again: every user loses the
                    request in progress.
                </div>
                <group>
                    <field name="run_id" invisible="not run_id" />
                    <field name="backup_id" invisible="not backup_id" />
                    <field name="plan_paths" invisible="action not in ('apply', 'pull_apply')" />
                    <field name="shallow_paths" invisible="action != 'pull_apply' or not shallow_paths" />
                    <field name="approve_deepen" invisible="action != 'pull_apply' or not shallow_paths" />
                    <field name="clone_paths" invisible="action != 'pull_apply' or not clone_paths" />
                    <field name="approve_clone" invisible="action != 'pull_apply' or not clone_paths" />
                    <field name="module_ids" widget="many2many_tags" invisible="action != 'restart_upgrade'" />
                    <field name="database_name" />
                    <field name="typed_database_name" />
                    <field name="understood" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-danger"
                        invisible="not understood"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
