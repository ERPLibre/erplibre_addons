<odoo>
    <!-- The ERPLibre page and its block. They hold only the server
         actions here, a developer-mode setting: both share their group, so
         that outside the developer mode no empty page and no empty block
         show. A module that adds settings for everyone gives the page and
         the block their group. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.erplibre.info</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ERPLibre" string="ERPLibre" name="erplibre_info" groups="base.group_no_one">
                    <field name="erplibre_server_actions_allowed" invisible="1" />
                    <!-- shows the server actions block, or the warning that they are off -->
                    <block
                        title="Odoo modules environment"
                        name="erplibre_code_environment"
                        groups="base.group_no_one"
                    >
                        <setting
                            id="erplibre_server_actions"
                            string="Server actions"
                            help="Developer mode, Settings group and erplibre_info_allow_server_actions = True in the Odoo configuration file."
                            groups="base.group_no_one"
                        >
                            <div
                                class="mt8"
                                name="erplibre_server_actions_buttons"
                                invisible="not erplibre_server_actions_allowed"
                            >
                                <button
                                    name="action_erplibre_restart"
                                    type="object"
                                    string="Restart the server"
                                    class="btn-secondary"
                                    icon="fa-power-off"
                                />
                                <button
                                    name="action_erplibre_open_runs"
                                    type="object"
                                    string="Runs"
                                    class="btn-link"
                                    icon="fa-arrow-right"
                                />
                            </div>
                            <div class="text-warning mt8" invisible="erplibre_server_actions_allowed">
                                <field name="erplibre_server_actions_problem" />
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="erplibre_info_config_settings_action" model="ir.actions.act_window">
        <field name="name">ERPLibre settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'erplibre_info', 'bin_size': False}</field>
    </record>
</odoo>
