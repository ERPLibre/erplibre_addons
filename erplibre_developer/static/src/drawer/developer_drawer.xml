<templates xml:space="preserve">
    <t t-name="erplibre_developer.DeveloperDrawer">
        <div
            t-if="state.open and state.inspecting"
            class="o_erplibre_dev_inspect_banner d-flex flex-wrap align-items-center gap-2 px-3 py-1"
            role="status"
        >
            <i class="fa fa-crosshairs" aria-hidden="true" />
            <span class="flex-grow-1">Inspect mode: click a field of the page · Esc to quit</span>
            <button class="btn btn-sm o_erplibre_dev_inspect_quit" t-on-click="toggleInspect">Quit</button>
        </div>
        <aside
            t-if="state.open"
            class="o_erplibre_dev_drawer d-flex flex-column bg-view border-start shadow"
            t-att-class="{'o_erplibre_dev_compact': state.density === 'compact'}"
            role="complementary"
            aria-label="Developer panel"
        >
            <header class="o_erplibre_dev_header d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                <span class="o_erplibre_dev_header_icon flex-shrink-0" aria-hidden="true">
                    <i class="fa fa-code" />
                </span>
                <div class="flex-grow-1 overflow-hidden">
                    <h2 class="o_erplibre_dev_title mb-0">Developer panel</h2>
                    <div
                        class="small text-muted d-flex flex-wrap align-items-center gap-1 o_erplibre_dev_view_title"
                        t-if="info"
                    >
                        <code class="o_erplibre_dev_chip" t-esc="info.model" />
                        <span aria-hidden="true">·</span>
                        <code class="o_erplibre_dev_chip" t-esc="info.view_type" />
                        <t t-if="info.view">
                            <span aria-hidden="true">·</span>
                            <code class="o_erplibre_dev_chip text-break" t-esc="info.view.xml_id or info.view.name" />
                        </t>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 flex-shrink-0 o_erplibre_dev_header_buttons">
                    <button
                        class="btn btn-sm o_erplibre_dev_icon_btn o_erplibre_dev_inspect"
                        t-att-aria-pressed="state.inspecting ? 'true' : 'false'"
                        t-att-disabled="(offView or !state.target) and !state.inspecting"
                        aria-label="Inspect"
                        title="Inspect: click a field of the page to select it"
                        t-on-click="toggleInspect"
                    >
                        <i class="fa fa-crosshairs" aria-hidden="true" />
                    </button>
                    <button
                        class="btn btn-sm o_erplibre_dev_icon_btn o_erplibre_dev_follow"
                        t-att-aria-pressed="state.follow ? 'true' : 'false'"
                        aria-label="Follow navigation"
                        title="Follow navigation: the panel describes each view the page opens"
                        t-on-click="toggleFollow"
                    >
                        <i class="fa fa-thumb-tack" aria-hidden="true" />
                    </button>
                    <button
                        class="btn btn-sm o_erplibre_dev_icon_btn o_erplibre_dev_width"
                        t-att-aria-pressed="state.wide ? 'true' : 'false'"
                        aria-label="Width"
                        title="Width: narrow or wide panel"
                        t-on-click="toggleWide"
                    >
                        <i class="fa fa-arrows-h" aria-hidden="true" />
                    </button>
                    <button
                        class="btn btn-sm o_erplibre_dev_icon_btn o_erplibre_dev_refresh"
                        aria-label="Reload"
                        title="Reload"
                        t-on-click="refresh"
                    >
                        <i class="fa fa-refresh" aria-hidden="true" />
                    </button>
                    <button
                        class="btn btn-sm o_erplibre_dev_icon_btn o_erplibre_dev_close"
                        aria-label="Close"
                        title="Close"
                        t-on-click="close"
                    >
                        <i class="fa fa-times" aria-hidden="true" />
                    </button>
                </div>
            </header>
            <div
                t-if="offView and !state.follow"
                class="o_erplibre_dev_offview d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom small"
                role="status"
            >
                <span class="flex-grow-1">
                    The page shows another view: Inspect and the highlight are off until the panel follows it.
                </span>
                <button class="btn btn-sm btn-secondary o_erplibre_dev_follow_again" t-on-click="followAgain">
                    <i class="fa fa-thumb-tack" aria-hidden="true" />
                    Follow again
                </button>
            </div>
            <div
                t-if="moduleChips.length"
                class="o_erplibre_dev_modules d-flex flex-wrap align-items-center gap-1 px-3 py-2 border-bottom"
                role="group"
                aria-label="Filter by module"
            >
                <span class="o_erplibre_dev_modules_label me-1">Modules</span>
                <button
                    class="btn btn-sm rounded-pill o_erplibre_dev_module_chip o_erplibre_dev_module_all"
                    t-att-class="{'o_erplibre_dev_chip_on': !state.moduleFilter}"
                    t-att-aria-pressed="state.moduleFilter ? 'false' : 'true'"
                    t-on-click="() => this.pickModule(null)"
                >
                    All
                </button>
                <button
                    t-foreach="moduleChips"
                    t-as="chip"
                    t-key="chip.name"
                    class="btn btn-sm rounded-pill o_erplibre_dev_module_chip"
                    t-att-class="state.moduleFilter === chip.name ? 'o_erplibre_dev_chip_on o_tag o_tag_color_' + chip.color : ''"
                    t-att-data-module="chip.name"
                    t-att-aria-pressed="state.moduleFilter === chip.name ? 'true' : 'false'"
                    t-on-click="() => this.pickModule(chip.name)"
                >
                    <span t-attf-class="o_erplibre_dev_dot o_tag o_tag_color_{{ chip.color }}" aria-hidden="true" />
                    <t t-esc="chip.name" />
                </button>
            </div>
            <div class="px-3 pt-2">
                <div
                    class="o_erplibre_dev_tabs d-flex gap-1 p-1 rounded-2"
                    role="tablist"
                    aria-label="Panel sections"
                    t-on-keydown="onTabKeydown"
                >
                    <button
                        t-foreach="tabs"
                        t-as="tab"
                        t-key="tab.id"
                        type="button"
                        role="tab"
                        class="btn btn-sm flex-grow-1 o_erplibre_dev_tab"
                        t-att-class="{'active': state.tab === tab.id}"
                        t-att-id="'o_erplibre_dev_tab_' + tab.id"
                        t-att-aria-selected="state.tab === tab.id ? 'true' : 'false'"
                        aria-controls="o_erplibre_dev_panel"
                        t-att-tabindex="state.tab === tab.id ? '0' : '-1'"
                        t-att-data-tab="tab.id"
                        t-att-title="tab.title"
                        t-on-click="() => this.selectTab(tab.id)"
                    >
                        <t t-esc="tab.label" />
                        <span
                            t-if="tab.count !== false"
                            class="o_erplibre_dev_tab_count ms-1"
                            t-esc="tab.count"
                        />
                    </button>
                </div>
            </div>
            <div
                id="o_erplibre_dev_panel"
                class="o_erplibre_dev_body flex-grow-1 overflow-auto p-3"
                role="tabpanel"
                t-att-aria-labelledby="'o_erplibre_dev_tab_' + state.tab"
            >
                <div t-if="data.loading" class="text-muted">
                    <i class="fa fa-spinner fa-spin" />
                    Loading…
                </div>
                <div t-elif="data.error" class="alert alert-warning o_erplibre_dev_error" t-esc="data.error" />
                <t t-elif="info">
                    <ViewsTab t-if="state.tab === 'views'" info="info" data="data" dev="dev" />
                    <FieldsTab t-elif="state.tab === 'fields'" info="info" data="data" dev="dev" />
                    <CodeTab
                        t-elif="state.tab === 'code'"
                        info="info"
                        data="data"
                        dev="dev"
                        loadCode.bind="loadCode"
                        loadRepoDetails.bind="loadRepoDetails"
                    />
                    <ActionsTab
                        t-elif="state.tab === 'actions'"
                        info="info"
                        data="data"
                        dev="dev"
                        loadCommits.bind="loadCommits"
                    />
                </t>
            </div>
            <footer
                class="o_erplibre_dev_footer d-flex flex-wrap align-items-center gap-2 px-3 py-1 border-top small text-muted"
            >
                <span class="flex-grow-1 o_erplibre_dev_status">
                    <t t-if="serverVersion">
                        Odoo
                        <t t-esc="serverVersion" />
                        ·
                    </t>
                    <t t-if="snapshotDate">
                        snapshot of
                        <span class="o_erplibre_dev_footer_snapshot" t-esc="snapshotDate" />
                    </t>
                    <t t-else="">no ERPLibre snapshot</t>
                </span>
                <div class="o_erplibre_dev_density d-inline-flex p-1 rounded-2" role="group" aria-label="Density">
                    <button
                        class="btn btn-sm o_erplibre_dev_density_compact"
                        t-att-class="{'active': state.density === 'compact'}"
                        t-att-aria-pressed="state.density === 'compact' ? 'true' : 'false'"
                        t-on-click="() => this.setDensity('compact')"
                    >
                        Compact
                    </button>
                    <button
                        class="btn btn-sm o_erplibre_dev_density_comfortable"
                        t-att-class="{'active': state.density !== 'compact'}"
                        t-att-aria-pressed="state.density !== 'compact' ? 'true' : 'false'"
                        t-on-click="() => this.setDensity('comfortable')"
                    >
                        Comfortable
                    </button>
                </div>
            </footer>
        </aside>
    </t>
</templates>
