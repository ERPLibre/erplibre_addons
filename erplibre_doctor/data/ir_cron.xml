<odoo noupdate="1">
    <!-- Active at install; Settings › ERPLibre › Doctor turns it off. -->
    <record id="ir_cron_erplibre_doctor" model="ir.cron">
        <field name="name">ERPLibre: doctor</field>
        <field name="model_id" ref="model_erplibre_doctor_report" />
        <field name="state">code</field>
        <field name="code">model._cron_run_analysis()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
