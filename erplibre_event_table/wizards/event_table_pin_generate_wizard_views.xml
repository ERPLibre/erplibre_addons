<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_table_pin_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">event.table.pin.generate.wizard.form</field>
        <field name="model">event.table.pin.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Combinations">
                <field name="plan_id" invisible="1" />
                <field name="pin_count" invisible="1" />
                <div class="alert alert-info" role="alert">
                    <field name="pin_summary" nolabel="1" />
                </div>
                <group>
                    <field name="mode" widget="radio" nolabel="1" />
                </group>
                <div class="text-muted" invisible="mode != 'keep'">
                    A pin reserves a table, not a seat: seat numbers are
                    recomputed for the whole table, so a requested seat
                    number may not be the one given.
                </div>
                <div class="text-muted" invisible="mode != 'reset'">
                    The reserved places stay on the plan and are ignored
                    for this generation only.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Generate" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
