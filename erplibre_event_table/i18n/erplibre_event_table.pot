#. module: erplibre_event_table
#: model:mail.template,body_html:erplibre_event_table.mail_template_participant_tables
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Verdana, Arial, sans-serif; font-size: 14px; color: #454748;\">\n"
"                    Hello\n"
"                    <t t-out=\"object.name or ''\">Ana Bloom</t>\n"
"                    ,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <t t-set=\"rows\" t-value=\"object._report_rows()\"/>\n"
"                    <t t-if=\"rows\">\n"
"                        Here are your tables for\n"
"                        <strong t-out=\"object.event_id.name or ''\">Spring Forum</strong>\n"
"                        .\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <table border=\"0\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"border-bottom: 1px solid #cccccc;\">\n"
"                                    <strong>Round</strong>\n"
"                                </td>\n"
"                                <td style=\"border-bottom: 1px solid #cccccc;\">\n"
"                                    <strong>Table</strong>\n"
"                                </td>\n"
"                                <td t-if=\"object.plan_id.assign_seats\" style=\"border-bottom: 1px solid #cccccc;\">\n"
"                                    <strong>Seat</strong>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr t-foreach=\"rows\" t-as=\"row\">\n"
"                                <td>\n"
"                                    <span class=\"o_event_table_mail_round\" t-out=\"row['round']\">1</span>\n"
"                                </td>\n"
"                                <td>\n"
"                                    <span class=\"o_event_table_mail_number\" t-out=\"row['table_number']\">3</span>\n"
"                                </td>\n"
"                                <td t-if=\"object.plan_id.assign_seats\">\n"
"                                    <span class=\"o_event_table_mail_seat\" t-out=\"row['seat_number']\">2</span>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </t>\n"
"                    <p t-else=\"\">No table assigned yet.</p>\n"
"                    <br/>\n"
"                    <t t-if=\"object.event_id.address_id\">\n"
"                        <span t-out=\"object.event_id.address_id.name or ''\">Forum Hall</span>\n"
"                        <br/>\n"
"                    </t>\n"
"                    <t t-out=\"object.event_id.date_begin\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;tz_name&quot;: object.event_id.date_tz, &quot;format&quot;: &quot;long&quot;}\">April 2, 2026 9:00 AM</t>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    See you soon.\n"
"                </div>\n"
"            "
msgstr ""

