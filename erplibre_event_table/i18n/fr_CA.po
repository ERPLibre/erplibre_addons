"<div style=\"margin: 0px; padding: 0px; font-family: Verdana, Arial, sans-"
"serif; font-size: 14px; color: #454748;\">\n"
"                    Hello\n"
"                    <t t-out=\"object.name or ''\">Ana Bloom</t>\n"
"                    ,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <t t-set=\"rows\" t-value=\"object._report_rows()\"/>\n"
"                    <t t-if=\"rows\">\n"
"                        Here are your tables for\n"
"                        <strong t-out=\"object.event_id.name or ''\">Spring "
"Forum</strong>\n"
"                        .\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <table border=\"0\" cellpadding=\"4\" "
