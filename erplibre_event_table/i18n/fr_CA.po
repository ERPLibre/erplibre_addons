"                                    <strong>Round</strong>\n"
"                                </td>\n"
"                                <td style=\"border-bottom: 1px solid #cccccc;"
"\">\n"
"                                    <strong>Table</strong>\n"
"                                </td>\n"
"                                <td t-if=\"object.plan_id.assign_seats\" "
"style=\"border-bottom: 1px solid #cccccc;\">\n"
"                                    <strong>Seat</strong>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr t-foreach=\"rows\" t-as=\"row\">\n"
"                                <td>\n"
"                                    <span class=\"o_event_table_mail_round\" "
"t-out=\"row['round']\">1</span>\n"
"                                </td>\n"
"                                <td>\n"
"                                    <span "
"class=\"o_event_table_mail_number\" t-out=\"row['table_number']\">3</span>\n"
"                                </td>\n"
"                                <td t-if=\"object.plan_id.assign_seats\">\n"
"                                    <span class=\"o_event_table_mail_seat\" "
"t-out=\"row['seat_number']\">2</span>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </t>\n"
"                    <p t-else=\"\">No table assigned yet.</p>\n"
"                    <br/>\n"
"                    <t t-if=\"object.event_id.address_id\">\n"
"                        <span t-out=\"object.event_id.address_id.name or "
