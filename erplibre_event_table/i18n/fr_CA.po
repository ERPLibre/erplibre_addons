#. module: erplibre_event_table
#. odoo-python
#: code:addons/erplibre_event_table/models/event_table_plan.py:0
msgid ""
"%(name)s is pinned in round %(round)s but is seated nowhere in it. Remove "
"the pin, or put the participant back in the plan."
msgstr ""
"%(name)s a une place réservée au tour %(round)s, mais n'y est assis nulle "
"part. Retirez la réservation, ou remettez le participant dans le plan."

#. module: erplibre_event_table
#. odoo-python
#: code:addons/erplibre_event_table/models/event_table_plan.py:0
msgid ""
"%(name)s is pinned in round %(round)s, and this plan has %(count)s rounds. "
"Remove that pin or add rounds."
msgstr ""
"%(name)s a une place réservée au tour %(round)s, et ce plan compte %(count)s "
"tours. Retirez cette réservation ou ajoutez des tours."

#. module: erplibre_event_table
#. odoo-python
#: code:addons/erplibre_event_table/models/event_table_plan.py:0
msgid ""
"%(name)s is pinned to two different tables in round %(round)s. Keep one of "
"the two pins."
msgstr ""
"%(name)s a une place réservée à deux tables différentes au tour %(round)s. "
"Gardez l'une des deux réservations."

#. module: erplibre_event_table
#. odoo-python
#: code:addons/erplibre_event_table/models/event_table_participant.py:0
msgid "%(name)s removed from the plan."
msgstr "%(name)s est retiré du plan."

#. module: erplibre_event_table
#. odoo-python
#: code:addons/erplibre_event_table/models/event_table_plan.py:0
msgid ""
"%(pinned)s people are pinned to table %(table)s in round %(round)s, which "
"seats %(seats)s of them there. Remove pins, or make the table bigger."
msgstr ""
"%(pinned)s personnes ont une place réservée à la table %(table)s au tour %"
"(round)s, qui en accueille %(seats)s. Retirez des réservations, ou "
"agrandissez la table."

#. module: erplibre_event_table
#: model:ir.model.fields,help:erplibre_event_table.field_event_table_pin__seat_number
msgid ""
"0 when no seat is requested. A pin reserves the table; the seat number is a "
"wish seating may not be able to grant."
msgstr ""
"0 quand aucun siège n'est demandé. Une réservation retient la table ; le "
"numéro de siège est un souhait que le placement ne peut pas toujours exaucer."

#. module: erplibre_event_table
#: model:ir.model.fields,help:erplibre_event_table.field_event_table_assignment__seat_number
msgid "0 when seats are not assigned."
msgstr "0 quand les sièges ne sont pas attribués."

#. module: erplibre_event_table
#: model:mail.template,body_html:erplibre_event_table.mail_template_participant_tables
