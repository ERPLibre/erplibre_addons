<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_event_view_form_table" model="ir.ui.view">
        <field name="name">event.event.form.rotating.tables</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_add_table_participants"
                    type="object"
                    class="btn-secondary"
                    string="Add Rotating Table Participants"
                    invisible="not use_rotating_tables and not table_plan_count"
                    groups="event.group_event_user"
                />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_view_table_plans"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-circle-o"
                    invisible="not use_rotating_tables and not table_plan_count"
                >
                    <field name="table_plan_count" widget="statinfo" string="Rotating Tables" />
                </button>
            </div>
            <xpath expr="//group[@name='right_event_details']/field[@name='badge_format']" position="before">
                <field name="use_rotating_tables" />
            </xpath>
        </field>
    </record>
</odoo>
