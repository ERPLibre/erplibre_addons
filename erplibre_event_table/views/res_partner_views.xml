<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form_table" model="ir.ui.view">
        <field name="name">res.partner.form.rotating.tables</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Restricted to event users: they are the only ones allowed to
                 read event.table.assignment, so the button would land on an
                 access error for anyone else. -->
            <div name="button_box" position="inside">
                <button
                    name="action_view_table_assignments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-circle-o"
                    groups="event.group_event_user"
                    invisible="table_plan_count == 0"
                >
                    <field name="table_plan_count" widget="statinfo" string="Rotating Tables" />
                </button>
            </div>
        </field>
    </record>
</odoo>
