<odoo>
    <record id="erplibre_code_cross_version_view_list" model="ir.ui.view">
        <field name="name">erplibre.code.cross.version.list</field>
        <field name="model">erplibre.code.cross.version</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date" />
                <field name="repo_path" />
                <field name="module_name" />
                <field name="other_versions" />
                <field name="to_port_count" />
                <field name="error" optional="hide" />
            </list>
        </field>
    </record>

    <record id="erplibre_code_cross_version_view_form" model="ir.ui.view">
        <field name="name">erplibre.code.cross.version.form</field>
        <field name="model">erplibre.code.cross.version</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary" />
                    <button name="action_load_full_diff" type="object" string="Load the full diff" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="repo_path" />
                            <field name="module_name" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="other_versions" />
                            <field name="to_port_count" />
                            <field name="error" invisible="not error" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Report" name="report">
                            <field name="report_html" nolabel="1" />
                        </page>
                        <page string="Full diff" name="full_diff" invisible="not full_diff_date">
                            <group>
                                <field name="full_diff_date" />
                                <field name="full_diff_truncated" />
                            </group>
                            <field name="full_diff" nolabel="1" class="font-monospace" />
                        </page>
                        <page string="JSON" name="json" groups="base.group_no_one">
                            <field name="data_json" nolabel="1" class="font-monospace" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="erplibre_code_cross_version_view_search" model="ir.ui.view">
        <field name="name">erplibre.code.cross.version.search</field>
        <field name="model">erplibre.code.cross.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="repo_path" />
                <field name="module_name" />
                <filter name="to_port" string="With commits to port" domain="[('to_port_count', '>', 0)]" />
            </search>
        </field>
    </record>

    <record id="erplibre_code_cross_version_action" model="ir.actions.act_window">
        <field name="name">Across Odoo versions</field>
        <field name="res_model">erplibre.code.cross.version</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Nothing compared yet</p>
            <p>
                Open a repository or an installed module of a snapshot and
                click "Other Odoo versions".
            </p>
        </field>
    </record>
</odoo>
