    <!-- One reflection of Sam to France in each state. The confirmed one
         carries a precision of France hiding the Goals theme, which Sam
         has still to guess. -->
    <record id="demo_reflet_draft" model="linkup.reflet">
        <field name="author_id" ref="demo_user_sam" />
        <field name="category_id" ref="linkup_category_vulnerability" />
        <field name="you_said">Que tu hésites à reprendre le projet seule.</field>
        <field name="state">draft</field>
    </record>
    <record id="demo_reflet_sent" model="linkup.reflet">
        <field name="author_id" ref="demo_user_sam" />
        <field name="recipient_id" ref="demo_user_france" />
        <field name="link_id" ref="demo_link_sam_france" />
        <field name="category_id" ref="linkup_category_emotions" />
        <field name="you_said">Que la réunion d'hier t'a fatiguée.</field>
        <field name="understood">Que tu as besoin d'une pause avant la suite.</field>
        <field name="real_world_declared" eval="True" />
        <field name="real_world_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')" />
        <field name="state">sent</field>
        <field name="sent_date" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
    <record id="demo_reflet_confirmed" model="linkup.reflet">
        <field name="author_id" ref="demo_user_sam" />
        <field name="recipient_id" ref="demo_user_france" />
        <field name="link_id" ref="demo_link_sam_france" />
        <field name="category_id" ref="linkup_category_needs" />
        <field name="you_said">Que tu cherches du temps pour ton jardin.</field>
        <field name="understood">Que tu as besoin de calme cette saison.</field>
        <field name="real_world_declared" eval="True" />
        <field name="real_world_date" eval="(DateTime.today() - timedelta(days=21)).strftime('%Y-%m-%d')" />
        <field name="state">confirmed</field>
        <field name="response_state">precision</field>
        <field name="sent_date" eval="(DateTime.now() - timedelta(days=20)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="read_date" eval="(DateTime.now() - timedelta(days=20)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="answered_date" eval="(DateTime.now() - timedelta(days=20)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
    <record id="demo_reflet_precision" model="linkup.reflet">
        <field name="kind">precision</field>
        <field name="author_id" ref="demo_user_france" />
        <field name="recipient_id" ref="demo_user_sam" />
        <field name="link_id" ref="demo_link_sam_france" />
        <field name="parent_id" ref="demo_reflet_confirmed" />
        <field name="body_text">Je voudrais trouver quelqu'un pour faire avancer le potager du quartier.</field>
        <field name="state">sent</field>
        <field name="guess_state">pending</field>
        <field name="round_index">1</field>
        <field name="sent_date" eval="(DateTime.now() - timedelta(days=19)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
    <record id="demo_reflet_precision_secret" model="linkup.reflet.secret">
        <field name="reflet_id" ref="demo_reflet_precision" />
        <field name="category_ids" eval="[Command.set([ref('linkup_category_goals')])]" />
        <field name="primary_category_id" ref="linkup_category_goals" />
    </record>
    <record id="demo_reflet_rejected" model="linkup.reflet">
        <field name="author_id" ref="demo_user_sam" />
        <field name="recipient_id" ref="demo_user_france" />
        <field name="link_id" ref="demo_link_sam_france" />
        <field name="category_id" ref="linkup_category_observation" />
        <field name="you_said">Que tu étais au marché samedi.</field>
        <field name="understood">Que tu y vas chaque semaine.</field>
        <field name="real_world_declared" eval="True" />
        <field name="state">rejected</field>
        <field name="sent_date" eval="(DateTime.now() - timedelta(days=10)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="answered_date" eval="(DateTime.now() - timedelta(days=9)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
    <record id="demo_link_sam_france" model="linkup.link">
        <field name="turn_reflet_id" ref="demo_reflet_precision" />
    </record>

    <!-- The carrier messages of the reflections above, in the direct
         conversation of Sam and France, in the order of the exchange. -->
    <function model="linkup.reflet" name="_linkup_demo_post_carriers">
        <value
            eval="[ref('demo_reflet_confirmed'), ref('demo_reflet_precision'), ref('demo_reflet_rejected'), ref('demo_reflet_sent')]"
        />
    </function>
</odoo>
