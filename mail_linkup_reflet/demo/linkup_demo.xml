    <!-- Links of Sam and of France, as drawn on their Reflet views. -->
    <record id="demo_link_sam_jacques" model="linkup.link">
        <field name="user_a_id" ref="demo_user_sam" />
        <field name="user_b_id" ref="demo_user_jacques" />
        <field name="state">active</field>
        <field name="first_link_date" eval="(DateTime.now() - timedelta(days=20)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="last_interaction_date" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
