#. module: mail_linkup_reflet
#: model:mail.template,body_html:mail_linkup_reflet.mail_template_linkup_invitation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hello,</p>\n"
"    <p>\n"
"        A person you met, <strong t-out=\"object.inviter_id.partner_id.name or ''\">Sam</strong>, would like to make you a reflection on LinkUp.\n"
"    </p>\n"
"    <p>\n"
"        A reflection puts into words what this person understood of your exchange in person. Its text is not in this email: you will read it in LinkUp once signed up through this link.\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"ctx.get('linkup_invite_url')\" style=\"background-color: #2B5C9E; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 6px;\">See the reflection and sign up</a>\n"
"    </p>\n"
"    <p style=\"font-size: 12px;\">\n"
"        Personal link, valid <t t-out=\"ctx.get('linkup_expiry_days') or ''\">14</t> days, for a single signup.\n"
"    </p>\n"
"    <p style=\"font-size: 12px;\">\n"
"        <t t-if=\"ctx.get('linkup_privacy_url')\">\n"
"            <a t-att-href=\"ctx.get('linkup_privacy_url')\">Privacy policy</a> ·\n"
"        </t>\n"
"        <a t-att-href=\"ctx.get('linkup_optout_url')\">Never receive a LinkUp invitation again</a> ·\n"
"        <a t-att-href=\"ctx.get('linkup_other_lang_url')\">Version française</a>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

