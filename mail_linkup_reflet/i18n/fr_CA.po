#. module: mail_linkup_reflet
#: model:linkup.category,example_do:mail_linkup_reflet.linkup_category_emotions
msgid "“I feel anger when I see that the rule is not respected.”"
msgstr ""
"« J'ai de la colère lorsque je vois que la règle n'est pas respectée. »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_do:mail_linkup_reflet.linkup_category_needs
msgid "“I need to eat, I feel weak.”"
msgstr "« J'ai besoin de manger, je me sens faible. »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_do:mail_linkup_reflet.linkup_category_observation
msgid "“I notice that Jean is not here.”"
msgstr "« J'observe que Jean n'est pas là. »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_do:mail_linkup_reflet.linkup_category_action
msgid "“I would like you to put on the winter tyres.”"
msgstr "« Je souhaite que tu poses les pneus d'hiver. »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_dont:mail_linkup_reflet.linkup_category_observation
msgid "“Jean is late again, like every day! We can never count on him!”"
msgstr ""
"« Jean est encore en retard, comme tous les jours ! On ne peut pas compter "
"sur lui ! »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_do:mail_linkup_reflet.linkup_category_goals
msgid "“My goal really is to find someone to move this situation forward…”"
msgstr ""
"« Mon but est vraiment de trouver une personne pour faire avancer cette "
"situation… »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_dont:mail_linkup_reflet.linkup_category_action
msgid "“Once again it is up to me to remind you to put on the winter tyres!”"
msgstr ""
"« Encore une fois c'est à moi de te rappeler qu'il faut que tu poses les "
"pneus d'hiver ! »"

#. module: mail_linkup_reflet
#. odoo-javascript
#: code:addons/mail_linkup_reflet/static/src/core/common/reflet_actions.xml:0
msgid "“So if I understand correctly…”"
msgstr "« Donc si je comprends bien… »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_dont:mail_linkup_reflet.linkup_category_needs
msgid "“You never want me to eat, or what?”"
msgstr "« Tu ne veux jamais que je mange ou quoi ? »"

#. module: mail_linkup_reflet
#: model:linkup.category,example_dont:mail_linkup_reflet.linkup_category_emotions
msgid "“You really are stupid not to respect the rules, where is your head?”"
msgstr ""
"« T'es vraiment imbécile à ne pas respecter les règles, mais où as-tu la "
"tête ? »"
