<odoo>
    <!-- "Channel settings" of Discuss: whether a channel is published to
         every LinkUp member or on invitation only. A LinkUp administrator
         or the creator of the channel changes it; the server refuses it
         to anybody else (discuss_channel_publish.py). -->
    <record id="discuss_channel_view_form" model="ir.ui.view">
        <field name="name">discuss.channel.form.inherit.mail_linkup_reflet</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <field name="group_ids" position="after">
                <field name="linkup_can_publish" invisible="1" />
                <field
                    name="linkup_published"
                    invisible="channel_type != 'channel' or parent_channel_id"
                    readonly="not linkup_can_publish"
                />
            </field>
        </field>
    </record>
</odoo>
