<odoo>

    <record id="view_devops_requirement_category_list" model="ir.ui.view">
        <field name="name">devops.requirement.category.list</field>
        <field name="model">devops.requirement.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_devops_requirement_category_form" model="ir.ui.view">
        <field name="name">devops.requirement.category.form</field>
        <field name="model">devops.requirement.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_devops_requirement_category" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">devops.requirement.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_devops_requirement_phase_list" model="ir.ui.view">
        <field name="name">devops.requirement.phase.list</field>
        <field name="model">devops.requirement.phase</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_devops_requirement_phase_form" model="ir.ui.view">
        <field name="name">devops.requirement.phase.form</field>
        <field name="model">devops.requirement.phase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_devops_requirement_phase" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">devops.requirement.phase</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
